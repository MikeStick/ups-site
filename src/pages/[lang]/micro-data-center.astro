---
// 微模块数据中心栏目页（/micro-data-center/）：首屏 → 三种形态 → 配置器（IT 柜数 + 单柜功率 + 后备时间 → 形态、精密空调、UPS、电池、电池柜、布局图）
// → IDM2 设计特点 → 三种典型方案 → 子系统（通道部件 / 机柜 / 配电 / 监控）→ 配置表 → 技术特点 → FAQ → 询价。只询价，不显示价格。
// 产品来自客户档案系统：型号 IDM-S / IDM-R / IDM2-D（或品类名带"微模块"）。画册文字在 idm-data.mjs，配置器在 idm-engine.mjs。
import Base from '../../layouts/Base.astro';
import { LANGS, SITE } from '../../config.mjs';
import { IDMT } from '../../lib/idm-i18n.mjs';
import { IDM } from '../../lib/idm-data.mjs';
import { IDM_MODELS, idmKey } from '../../lib/idm-engine.mjs';
import { pacSpec } from '../../lib/pac-engine.mjs';
import { cabSpec } from '../../lib/cab-engine.mjs';
import { vrlaModule } from '../../lib/vrla-engine.mjs';
import { isIdm, isPac, isBattCab, isVrla12, isDem } from '../../lib/category.mjs';
import all from '../../data/products.json';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const T = IDMT[lang];
const tr = (x: any) => (x && typeof x === 'object' && !Array.isArray(x) ? x[lang] ?? x.en : x);
const idmProducts = all.filter(isIdm);
const slugOf: Record<string, string> = Object.fromEntries(idmProducts.map((p) => [idmKey(p.model), p.slug]).filter(([k]) => k));
const imgOf: Record<string, string> = Object.fromEntries(idmProducts.filter((p) => p.images && p.images[0]).map((p) => [idmKey(p.model), p.images[0].thumb || p.images[0].src]));
const pic = (m: string) => imgOf[m] || `/img/idm/${m.toLowerCase()}.webp`;
// 配置器联动：精密空调 / 电池柜 / 12V 电池的产品页链接
const links: Record<string, string> = {};
for (const p of all.filter(isPac)) { const s = pacSpec(p); if (s) links[s.model] = p.slug; }
for (const p of all.filter(isBattCab)) { const s = cabSpec(p); if (s) links[s.model] = p.slug; }
for (const p of all.filter(isDem)) links['SK-DEM'] = p.slug;
const batts = all.filter(isVrla12).map((p) => vrlaModule(p)).filter((m) => m.v === 12 && m.ah)
  .map((m) => ({ model: m.model, slug: m.slug || '', v: m.v, ah: m.ah, rate: m.rate, kg: m.kg || 0, series: m.series, tables: m.tables }));
const cfg = { lang, wa: SITE.whatsapp, t: T, links, batts, forms: Object.fromEntries(IDM_MODELS.map((m) => [m, tr(T.forms[m][0])])) };
const CAT = { en: '/docs/SKE_IDM2_Catalogue_EN.pdf', es: '/docs/SKE_IDM2_Catalogue_ES.pdf', ru: '/docs/SKE_IDM2_Catalogue_RU.pdf' }[lang];
const wa = (msg: string) => `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(msg)}`;
const dec = (x: number | string) => (lang === 'en' ? String(x) : String(x).replace('.', ','));
const kwU = lang === 'ru' ? 'кВт' : 'kW';
// 三种典型方案的平面图（I = IT 柜，A = 列间空调，P = 精密配电柜，U = UPS，B = 蓄电池，R = 房间级空调）
const SCN_PLAN = [
  { rows: ['PUBAIIIIAII', 'IIIAIIIIAII'], side: '' },
  { rows: ['IIAIIIIAIP', 'IIAIIIIAII'], side: 'U' },
  { rows: ['IIIIIIIIIP', 'IIIIIIIIII'], side: 'URR' },
];
const scnPacLink = (series: string, m: number) => {
  const want = `${series}${String(m).padStart(3, '0')}`;
  const k = Object.keys(links).find((x) => x.replace(/[()]/g, '').startsWith(want));
  return k ? `/${lang}/p/${links[k]}/` : '';
};
const PARTS_IMG = ['p-sky', 'p-trough', 'p-ladder', 'p-base', 'p-ctrl'];
const WHY_ICONS = [
  '<path d="M15 3l10 4v7c0 6-4 10-10 13C9 24 5 20 5 14V7z"/><path d="M10 15l3 3 7-7"/>',
  '<path d="M17 3L7 17h7l-2 10 10-14h-7z"/>',
  '<rect x="4" y="6" width="22" height="18" rx="2"/><path d="M4 12h22M11 6v18"/>',
];
const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: T.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
const crumbLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: T.crumbs, item: `${site}/${lang}/` },
  { '@type': 'ListItem', position: 2, name: T.title, item: `${site}/${lang}/micro-data-center/` },
] };
const cellCls: Record<string, string> = { I: 'i', A: 'a', P: 'p', U: 'u', B: 'b', R: 'r' };
---
<Base lang={lang} title={`${T.title} · ${SITE.name}`} description={T.metaDesc} path="micro-data-center/">
<div class="off rbp idmp">
  <nav class="crumbs"><a href={`/${lang}/`}>{T.crumbs}</a> / {T.title}</nav>

  <section class="hero">
    <div class="hero-in">
      <div>
        <span class="eyebrow">{T.eyebrow}</span>
        <h1>{T.h1a}<em>{T.h1b}</em></h1>
        <p>{T.lead}</p>
        <div class="hero-cta">
          <a class="btn primary" href="#configurator">{T.ctaCfg}</a>
          <a class="btn ghost" href="#forms">{T.ctaForms}</a>
          <a class="btn ghost" href={CAT} target="_blank" rel="noopener">{T.ctaCat} ↓</a>
        </div>
      </div>
      <div class="hero-img"><img src="/img/idm/hero.webp" alt="SKE IDM Ⅱ" /></div>
    </div>
    <div class="hero-facts">
      <div><b class="num">≤ 48</b><span>{T.facts.racks}</span></div>
      <div><b class="num">3–600 {lang === 'ru' ? 'кВА' : 'kVA'}</b><span>{T.facts.ups}</span></div>
      <div><b class="num">&lt; {dec(1.5)}</b><span>{T.facts.pue}</span></div>
      <div><b class="num">3 {lang === 'ru' ? 'ч' : 'h'}</b><span>{T.facts.deploy}</span></div>
    </div>
  </section>

  <section class="block" id="forms">
    <div class="head"><span class="eyebrow">{T.formsEyebrow}</span><h2>{T.formsH}</h2></div>
    <div class="forms">
      {IDM_MODELS.map((m) => {
        const f = T.forms[m]; const href = slugOf[m] ? `/${lang}/p/${slugOf[m]}/` : '#configurator';
        return (
          <article class="form">
            <a class="fimg" href={href}><img src={pic(m)} alt={m} loading="lazy" /></a>
            <div class="fb">
              <small>{f[1]}</small>
              <h3><a href={href}>{m}</a> <span>{f[0]}</span></h3>
              <em class="num">{f[3]}</em>
              <p>{tr(IDM.ov[m])}</p>
              <ul>{IDM.feat[m].slice(0, 4).map((x) => <li>{tr(x)}</li>)}</ul>
              <div class="pact">
                {slugOf[m] && <a class="btn sm line" href={href}>{T.details}</a>}
                {SITE.whatsapp && <a class="btn sm dark" href={wa(T.qMsg.replace('{m}', m))} target="_blank" rel="noopener">{T.quote}</a>}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="block" id="configurator" data-idmc>
    <script type="application/json" data-idmc-cfg set:html={JSON.stringify(cfg)} />
    <div class="head"><span class="eyebrow">{T.cfgEyebrow}</span><h2>{T.cfgH}</h2><p>{T.cfgP}</p></div>
    <div class="stage">
      <div class="ctl">
        <div class="grp"><div class="gh"><span class="n">1</span><b>{T.qRacks}</b></div>
          <label class="numin"><input type="number" min="1" max="96" step="1" value="12" inputmode="numeric" data-racks /><span>×</span></label></div>
        <div class="grp"><div class="gh"><span class="n">2</span><b>{T.qKw}</b></div>
          <label class="numin"><input type="number" min="0.5" max="30" step="0.5" value="5" inputmode="decimal" data-kw /><span>{kwU}</span></label>
          <small class="hint">{T.hintKw}</small></div>
        <div class="grp"><div class="gh"><span class="n">3</span><b>{T.qMin}</b></div>
          <div class="chips">{[10, 15, 30, 60].map((m) => <button type="button" class:list={['chip', { on: m === 15 }]} data-min={m}>{m} {T.min}</button>)}</div>
          <label class="chk"><input type="checkbox" checked data-red /> {T.qRed}</label>
          <label class="chk"><input type="checkbox" data-rh /> {T.qRh}</label></div>
      </div>
      <div class="out">
        <div class="room" data-room></div>
        <div class="rows" data-rows></div>
        <div class="notes" data-notes></div>
        {SITE.whatsapp && <a class="btn primary" data-qsel href="#" target="_blank" rel="noopener">{T.quoteSel}</a>}
      </div>
    </div>
  </section>

  <section class="block" id="design">
    <div class="head"><span class="eyebrow">IDM2</span><h2>{tr(IDM.h.D_DESIGN_H)}</h2></div>
    <div class="design">
      <img src={`/img/idm/explode-${lang}.webp`} alt="IDM2" loading="lazy" />
      <div><h3>{tr(IDM.h.TECH_H)}</h3><ul class="dots">{IDM.tech.map((x) => <li>{tr(x)}</li>)}</ul></div>
    </div>
  </section>

  <section class="block" id="solutions">
    <div class="head"><span class="eyebrow">{T.scnEyebrow}</span><h2>{T.scnH}</h2><p>{tr(IDM.cold)}</p></div>
    <div class="scns">
      {SCN_PLAN.map((pl, i) => {
        const P = IDM.scnPac[i];
        return (
          <div class="card scn">
            <b class="sn">{String(i + 1).padStart(2, '0')}</b>
            <h3>{T.scn[i]}</h3>
            <div class="plan">
              <div class="rowsw">
                <div class="pr">{pl.rows[0].split('').map((c) => <i class={cellCls[c]}></i>)}</div>
                <div class="aisle"></div>
                <div class="pr">{pl.rows[1].split('').map((c) => <i class={cellCls[c]}></i>)}</div>
              </div>
              {pl.side && <div class="side">{pl.side.split('').map((c) => <i class={cellCls[c]}></i>)}</div>}
            </div>
            <dl>
              <dt>UPS</dt><dd>{tr(IDM.scnUps[i])}</dd>
              <dt>{T.rCool}</dt>
              <dd class="mods">{P.models.map((m, j) => { const h = scnPacLink(P.series, m); return h ? <a href={h}>{P.series}{m}</a> : <span>{P.series}{m}</span>; })}</dd>
            </dl>
          </div>
        );
      })}
    </div>
    <div class="legend">{Object.entries({ i: T.legend.I, a: T.legend.A, p: T.legend.P, u: T.legend.U, b: T.legend.B, r: T.legend.R }).map(([k, v]) => <span><i class={k}></i>{v}</span>)}</div>
  </section>

  <section class="block" id="subsystems" data-tabs>
    <div class="head"><span class="eyebrow">{T.sysEyebrow}</span><h2>{T.sysH}</h2></div>
    <div class="vtabs">{Object.entries(T.tabs).map(([k, v], i) => <button type="button" class:list={{ on: i === 0 }} data-tab={k}>{v}</button>)}</div>
    <div class="pane" data-pane="cool">
      <div class="parts">{IDM.parts.map((p, i) => <div class="card part"><img src={`/img/idm/${PARTS_IMG[i]}.webp`} alt="" loading="lazy" /><h3>{tr(p.h)}</h3><p>{tr(p.d)}</p></div>)}</div>
      <div class="card wide"><h3>{tr(IDM.h.CONT_H)}</h3><p>{tr(IDM.cont)}</p></div>
    </div>
    <div class="pane" data-pane="cab" hidden>
      <div class="split"><img src="/img/idm/cabinet.webp" alt="" loading="lazy" class="draw" />
        <div><h3>{tr(IDM.h.CAB_H)}</h3><p>{tr(IDM.cabIntro)}</p><h3>{tr(IDM.h.CABP_H)}</h3><ul class="dots">{IDM.cabp.map((x) => <li>{tr(x)}</li>)}</ul></div></div>
    </div>
    <div class="pane" data-pane="pwr" hidden>
      <div class="pw">
        <div class="card"><img src="/img/idm/ppd.webp" alt="" loading="lazy" /><h3>{tr(IDM.h.PPD_H)}</h3><p>{tr(IDM.ppd)}</p><ul class="dots">{IDM.ppdFn.map((x) => <li>{tr(x)}</li>)}</ul></div>
        <div class="card"><img src="/img/idm/pdm.webp" alt="" loading="lazy" /><h3>{tr(IDM.h.PDM_H)}</h3><p>{tr(IDM.pdm)}</p></div>
        <div class="card"><img src="/img/idm/pdu.webp" alt="" loading="lazy" /><h3>{tr(IDM.h.PDU_H)}</h3><p>{tr(IDM.pdu.ov)}</p><ul class="dots">{IDM.pdu.fe.map((x) => <li>{tr(x)}</li>)}</ul></div>
        <div class="card"><img src="/img/idm/ipdu.webp" alt="" loading="lazy" /><h3>{tr(IDM.h.IPDU_H)}</h3><p>{tr(IDM.ipdu)}</p></div>
      </div>
    </div>
    <div class="pane" data-pane="mon" hidden>
      <div class="pw">
        <div class="card"><img src="/img/idm/mon-cab.webp" alt="" loading="lazy" /><h3>{tr(IDM.h.CMF_H)}</h3><ul class="dots">{IDM.cmf.map((x) => <li>{tr(x)}</li>)}</ul></div>
        <div class="card"><img src="/img/idm/mon-v3.webp" alt="" loading="lazy" /><h3>{tr(IDM.h.MMF_H)}</h3>{IDM.mmf.map((x) => <p><b>{tr(x.h)}:</b> {tr(x.d)}</p>)}</div>
        <div class="card"><img src="/img/idm/dcim.webp" alt="" loading="lazy" /><h3>{tr(IDM.h.DCIM_H)}</h3><p>{tr(IDM.v3)}</p><div class="tags">{IDM.dcimSys.map((x) => <span>{tr(x)}</span>)}</div><ul class="dots">{IDM.dcimFn.map((x) => <li>{tr(x)}</li>)}</ul></div>
      </div>
    </div>
  </section>

  <section class="block" id="tables">
    <div class="head"><span class="eyebrow">{T.bomEyebrow}</span><h2>{T.bomH}</h2><p>{T.bomP}</p></div>
    {IDM_MODELS.map((m, mi) => (
      <details class="tblock" open={mi === 2}>
        <summary>{m} <span>{T.forms[m][0]}</span></summary>
        <div class="tbl-wrap">
          <table>
            <thead><tr><th>{T.th.sys}</th><th>{T.th.item}</th><th>{T.th.unit}</th><th>{T.th.qty}</th><th>{T.th.spec}</th></tr></thead>
            <tbody>
              {IDM.bom[m].map((g) => g.items.map((it, i) => (
                <tr>{i === 0 && <th rowspan={g.items.length} class="sys">{tr(g.sys)}</th>}<td>{tr(it.name)}</td><td>{tr(it.unit)}</td><td class="num">{it.qty}</td><td>{tr(it.val)}</td></tr>
              )))}
            </tbody>
          </table>
          <p class="tnote">{tr(IDM.h.NOTE)}</p>
        </div>
      </details>
    ))}
  </section>

  <section class="block">
    <div class="head"><span class="eyebrow">{T.whyEyebrow}</span><h2>{T.whyH}</h2></div>
    <div class="feats">{IDM.adv.map((g, i) => <div class="card feat"><svg viewBox="0 0 30 30" aria-hidden="true" set:html={WHY_ICONS[i]} /><h3>{tr(g.h)}</h3><ul class="dots">{g.items.map((x) => <li>{tr(x)}</li>)}</ul></div>)}</div>
    <ul class="tf">{IDM.tf.map((x) => <li>{tr(x).replace(/[;；]$/, '')}</li>)}</ul>
  </section>

  <section class="block" id="faq">
    <div class="head"><span class="eyebrow">{T.faqEyebrow}</span><h2>{T.faqH}</h2></div>
    <div class="faq">{T.faq.map(([q, a], i) => <details class="card" open={i === 0}><summary>{q}</summary><p>{a}</p></details>)}</div>
  </section>

  <section class="cta">
    <div class="cta-box">
      <div><h2>{T.ctaH}</h2><p>{T.ctaP}</p></div>
      <div class="btns">
        {SITE.whatsapp && <a class="btn dark" href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">WhatsApp {SITE.whatsappDisplay}</a>}
        {SITE.email && <a class="btn line" href={`mailto:${SITE.email}`}>{SITE.email}</a>}
        <a class="btn line" href={CAT} target="_blank" rel="noopener">{T.catalogue}</a>
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(crumbLd)} />
</div>
</Base>

<script>
  import { idmPlan } from '../../lib/idm-engine.mjs';
  // 配置器：IT 柜数 + 单柜功率 + 后备时间 + N+1 / 恒温恒湿 → 形态、空调、UPS、电池、电池柜，右侧画俯视布局
  const root = document.querySelector('[data-idmc]') as HTMLElement | null;
  if (root) {
    const c = JSON.parse(root.querySelector('[data-idmc-cfg]')!.textContent || '{}'), T = c.t;
    const $ = (s: string) => root.querySelector(s) as HTMLElement;
    const fmt = (s: string, o: any) => String(s).replace(/\{(\w+)\}/g, (_: string, k: string) => (o[k] !== undefined ? o[k] : ''));
    const dec = (x: number) => (c.lang === 'en' ? String(x) : String(x).replace('.', ','));
    const kwU = c.lang === 'ru' ? 'кВт' : 'kW', mU = c.lang === 'ru' ? 'м' : 'm';
    const link = (m: string) => (c.links[m] ? `<a href="/${c.lang}/p/${c.links[m]}/">${m}</a>` : m);
    const st: any = { min: 15 };
    const COL: any = { I: 'i', A: 'a', P: 'p', U: 'u', S: 's', B: 'b' };
    const draw = (p: any) => {
      const u = 22, acW = p.cooling && p.cooling.w ? (p.cooling.w / 600) * u : u / 2, h = 30, gap = 2;
      const w = (k: string) => (k === 'A' ? acW : u);
      const rowW = (r: string[]) => r.reduce((s, k) => s + w(k) + gap, 0);
      const rows = p.layout.rows as string[][];
      const maxW = Math.max(...rows.map(rowW));
      const bq = p.cabinets ? Math.min(p.cabinets.qty, 6) : 0;
      let svg = '', y = 4;
      const drawRow = (r: string[], yy: number) => { let x = 0; r.forEach((k, i) => { svg += `<rect class="${COL[k]}" x="${x}" y="${yy}" width="${w(k)}" height="${h}" rx="2" style="--d:${i * 25}ms"/>`; x += w(k) + gap; }); };
      if (p.form === 'S') {
        svg += `<rect class="s" x="0" y="4" width="${u * 2}" height="${h * 2}" rx="3"/><rect class="scr" x="${u * 0.6}" y="18" width="${u * 0.8}" height="10" rx="1"/>`;
        y = 4 + h * 2;
      } else {
        drawRow(rows[0], y); y += h;
        if (rows[1]) { svg += `<rect class="aisle" x="0" y="${y + 3}" width="${maxW - gap}" height="${h * 0.9}"/>`; y += h * 0.9 + 6; drawRow(rows[1], y); y += h; }
        else { svg += `<rect class="aisle" x="0" y="${y + 3}" width="${maxW - gap}" height="${h * 0.5}"/>`; y += h * 0.5 + 6; }
      }
      const x0 = (p.form === 'S' ? u * 2 : maxW) + 16;
      for (let i = 0; i < bq; i++) svg += `<rect class="b" x="${x0 + (i % 2) * (u + gap)}" y="${4 + Math.floor(i / 2) * (h * 0.7 + gap)}" width="${u}" height="${h * 0.7}" rx="2"/>`;
      const W = x0 + (bq ? 2 * (u + gap) : 0);
      return `<svg viewBox="-2 0 ${W + 4} ${Math.max(y, 4 + Math.ceil(bq / 2) * (h * 0.7 + gap)) + 6}" role="img">${svg}</svg>`;
    };
    const run = () => {
      const racks = Math.max(1, parseInt(($('[data-racks]') as HTMLInputElement).value) || 1);
      const kw = Math.max(0.5, parseFloat(String(($('[data-kw]') as HTMLInputElement).value).replace(',', '.')) || 1);
      const red = ($('[data-red]') as HTMLInputElement).checked, rh = ($('[data-rh]') as HTMLInputElement).checked;
      const p = idmPlan({ racks, kw, minutes: st.min, redundancy: red, rh, batts: c.batts });
      const L = T.legend;
      const used = new Set(p.layout.rows.flat()); if (p.cabinets) used.add('B');
      const leg = ['S', 'I', 'A', 'P', 'U', 'B'].filter((k) => used.has(k)).map((k) => `<span><i class="${COL[k]}"></i>${L[k]}</span>`).join('');
      $('[data-room]').innerHTML = `<div class="tag">${T.res}: <b>${p.model}</b> · ${c.forms[p.model]}</div>${draw(p)}<div class="lg">${leg}</div>`;
      const row = (a: string, v: string) => `<div><span>${a}</span><b>${v}</b></div>`;
      const cool = p.cooling ? (p.form === 'S' ? `${link(p.cooling.model)} <small>${T.inCab}</small>` : `${fmt(T.coolN, { n: p.cooling.n, m: link(p.cooling.model) })}${p.cooling.spare ? ` <small>${fmt(T.coolSpare, { s: p.cooling.spare })}</small>` : ''}`) : '—';
      const ups = p.ups.type === 'rack' ? fmt(T.upsRack, { k: p.ups.kva }) : fmt(T.upsMod, { n: p.ups.modules, m: p.ups.module, k: p.ups.kva });
      const bat = !p.battery ? '—' : p.battery.internal ? T.battInt : `${p.battery.total} × ${p.battery.slug ? `<a href="/${c.lang}/p/${p.battery.slug}/">${p.battery.model}</a>` : p.battery.model} <small>${fmt(T.battRun, { t: p.battery.runtime })}${p.battery.est ? ` · ${T.est}` : ''}</small>`;
      $('[data-rows]').innerHTML = row(T.rForm, `${p.model}${p.modules > 1 ? ` × ${p.modules}` : ''}`) + row(T.rLoad, `${dec(p.total)} ${kwU}`) + row(T.rCool, cool) + row(T.rUps, ups) + row(T.rBatt, bat)
        + (p.cabinets ? row(T.rCab, fmt(T.cabs, { q: p.cabinets.qty, m: link(p.cabinets.model) })) : '') + (p.form !== 'S' ? row(T.rMon, `${p.modules} × ${link('SK-DEM')}`) : '') + (p.form === 'D' ? row(T.rLen, `${dec(p.length)} ${mU}`) : '');
      const N: any = { density: T.nDensity, multi: fmt(T.nMulti, { n: p.modules }), length: T.nLength, rack: T.nRack, battery: T.nBattery, cells: fmt(T.nCells, { lang: c.lang }) };
      $('[data-notes]').innerHTML = p.notes.map((k: string) => `<p>⚠ ${N[k] || ''}</p>`).join('');
      const q = $('[data-qsel]') as HTMLAnchorElement | null;
      if (q) q.href = `https://wa.me/${c.wa}?text=${encodeURIComponent(fmt(T.qSel, { r: racks, kw, min: st.min, m: p.model, c: p.cooling ? `${p.cooling.n + p.cooling.spare} × ${p.cooling.model}` : '-', u: `${p.ups.kva} kVA` }))}`;
    };
    root.querySelectorAll('[data-min]').forEach((b: any) => b.addEventListener('click', () => { st.min = +b.dataset.min; root.querySelectorAll('[data-min]').forEach((x: any) => x.classList.toggle('on', x === b)); run(); }));
    ['[data-racks]', '[data-kw]'].forEach((s) => $(s).addEventListener('input', run));
    ['[data-red]', '[data-rh]'].forEach((s) => $(s).addEventListener('change', run));
    // 从产品页过来：?m=IDM-S / IDM-R / IDM2-D → 填入该形态的典型值
    const m = new URLSearchParams(location.search).get('m');
    const preset: any = { 'IDM-S': [1, 6], 'IDM-R': [6, 5], 'IDM2-D': [20, 6] };
    if (m && preset[m]) { ($('[data-racks]') as HTMLInputElement).value = preset[m][0]; ($('[data-kw]') as HTMLInputElement).value = preset[m][1]; }
    run();
  }
  // 子系统页签
  const tabs = document.querySelector('[data-tabs]');
  if (tabs) tabs.querySelectorAll('[data-tab]').forEach((b: any) => b.addEventListener('click', () => {
    tabs.querySelectorAll('[data-tab]').forEach((x: any) => x.classList.toggle('on', x === b));
    tabs.querySelectorAll('[data-pane]').forEach((p: any) => (p.hidden = p.dataset.pane !== b.dataset.tab));
  }));
</script>

