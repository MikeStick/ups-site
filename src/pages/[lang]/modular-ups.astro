  .sock span { font-size: 12px; color: var(--muted); line-height: 1.35; }

  /* 对比 */
  .vs { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; }
  @media (max-width: 760px) { .vs { grid-template-columns: minmax(0, 1fr); } }
  .vs .card h3 { font-size: 26px; margin: 6px 0 8px; }
