  .vs li { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 10px; border-top: 1px dashed var(--line); padding-top: 8px; }
  .vs li span { color: var(--muted); }
  .vs .best { font-size: 13px; color: var(--accent); font-weight: 600; margin-top: 10px; }

  /* 参数表 */
  .tbl-wrap { overflow-x: auto; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; }
  table { border-collapse: collapse; width: 100%; min-width: 640px; font-size: 14px; }
  th, td { text-align: left; padding: 10px 14px; border-top: 1px solid var(--line); }
  thead th { border-top: 0; font: 600 12px var(--mono); text-transform: uppercase; color: var(--muted); background: var(--bg); }
  tbody th { font-weight: 600; white-space: nowrap; }
  td.num { font-family: var(--mono); }

  /* OEM */
  .oem { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; align-items: stretch; }
  @media (max-width: 860px) { .oem { grid-template-columns: minmax(0, 1fr); } }
  .oem-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .oem-list div { border: 1px solid var(--line); border-radius: 10px; padding: 12px; background: var(--surface); }
  .oem-list b { display: block; font-size: 15px; }
  .oem-list span { font-size: 13px; color: var(--muted); }
  .oem-cta { background: var(--ink); color: #fff; border-radius: 12px; padding: 24px; display: grid; gap: 12px; align-content: center; }
  .oem-cta h3 { font-size: 30px; }
  .oem-cta p { margin: 0; color: #c9d4d1; }

  .apps { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; }
  @media (max-width: 860px) { .apps { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .app { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 14px; display: grid; gap: 8px; justify-items: start; font-size: 14px; }
  .app svg { width: 30px; height: 30px; color: var(--accent); fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  .cta { padding-block: 56px; }
  .cta-box { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 28px; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 18px; align-items: center; }
  @media (max-width: 760px) { .cta-box { grid-template-columns: minmax(0, 1fr); padding: 20px; } }
  .cta-box h2 { font-size: clamp(26px, 3.6vw, 38px); }
  .cta-box p { margin: 6px 0 0; color: var(--muted); }
  .cta-box .btns { display: flex; gap: 10px; flex-wrap: wrap; }
  footer { margin-top: 0; }
  .note { margin-top: 10px; }
  .pimg img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 4%; box-sizing: border-box; }
  .pimg :global(svg) { width: 70%; }
  .pbody h3 a { color: inherit; text-decoration: none; }
  .tbl-wrap a { color: var(--ink); }
  .sock :global(svg) { width: 56px; height: 56px; }
  .app svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .dev svg { fill: none; }
  /* —— 机架式专用 —— */
  .pimg .tags { position: absolute; left: 10px; top: 10px; display: flex; gap: 6px; }
  .pimg .tag { position: static; }
  .tag.std { background: var(--ok-soft); color: var(--ok); }
  .tag.lr { background: #e2ecfb; color: #1f4f9a; }
  .tag.u { background: var(--ink); color: #fff; }
  .tag.li { background: #e3f4f8; color: #0e6a80; }
  .tag.vs-li { background: var(--ok-soft); color: var(--ok); }
  .tag.on { background: var(--accent); color: #fff; }
  .pimg :global(svg) { width: 84%; }
  .rt { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; margin-top: 14px; padding-top: 14px; border-top: 1px dashed var(--line); }
  .rt > span { font-size: 13px; font-weight: 600; }
  .rt-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .rec :global(a b i) { font-style: normal; font: 600 10.5px var(--mono); text-transform: uppercase; color: var(--muted); margin-left: 4px; }
  .rec :global(a) { flex-wrap: wrap; }
  .rec :global(a span) { text-align: right; }

  .how { display: grid; gap: 14px; }
  .how-tabs { display: flex; gap: 6px; flex-wrap: wrap; }
  .how-fig { overflow-x: auto; }
  .how-fig svg { width: 100%; min-width: 560px; height: auto; display: block; }
  .how-text { margin: 0; font-size: 15px; color: var(--ink); background: var(--bg); border-radius: 8px; padding: 10px 14px; }
  .how .blk rect, .how .blk circle { fill: #fff; stroke: #b9c6c2; stroke-width: 2; transition: .25s; }
  .how .blk text, .how .sw text { font: 600 15px var(--body); fill: var(--ink); text-anchor: middle; }
  .how .blk text.sm, .how .sw text { font: 600 12px var(--mono); fill: var(--muted); text-transform: uppercase; }
  .how .w { fill: none; stroke: #d3dbd8; stroke-width: 5; stroke-linecap: round; transition: stroke .25s; }
  .how .w-bc, .how .w-bd { stroke-width: 0; }
  .how .sw circle { fill: #fff; stroke: #b9c6c2; stroke-width: 2; }
  .how .cut { display: none; }
  .how .cut path { stroke: #c0392b; stroke-width: 4; stroke-linecap: round; }
  @keyframes flow { to { stroke-dashoffset: -28; } }
  /* 正常：市电 → 整流 → 直流母线 → 逆变 → 负载，同时给电池充电 */
  .how[data-mode="normal"] :is(.w-in, .w-rd, .w-di, .w-out, .w-bc) { stroke: var(--accent); stroke-width: 5; stroke-dasharray: 10 4; animation: flow 1s linear infinite; }
  .how[data-mode="normal"] :is(.b-mains, .b-rect, .b-dc, .b-inv, .b-load, .b-batt) :is(rect, circle) { stroke: var(--accent); }
  /* 市电中断：电池 → 逆变 → 负载 */
  .how[data-mode="battery"] :is(.w-bd, .w-di, .w-out) { stroke: var(--charge); stroke-width: 5; stroke-dasharray: 10 4; animation: flow 1s linear infinite; }
  .how[data-mode="battery"] :is(.b-batt, .b-dc, .b-inv, .b-load) :is(rect, circle) { stroke: var(--charge); }
  .how[data-mode="battery"] .b-mains rect { stroke-dasharray: 5 4; }
  .how[data-mode="battery"] .cut { display: block; }
  /* 旁路：市电直接 → 负载 */
  .how[data-mode="bypass"] .w-byp { stroke: #1f4f9a; stroke-dasharray: 10 4; animation: flow 1s linear infinite; }
  .how[data-mode="bypass"] :is(.b-mains, .b-load) rect, .how[data-mode="bypass"] .sw circle { stroke: #1f4f9a; }
  .how[data-mode="bypass"] .sw circle { fill: #1f4f9a; }

  .feats { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 14px; }
  @media (max-width: 1000px) { .feats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .feats { grid-template-columns: minmax(0, 1fr); } }
  .feat { display: grid; gap: 8px; align-content: start; }
  .feat .fi { font: 700 14px var(--mono); color: var(--charge); }
  .feat h3 { font-size: 24px; }
  .feat p { margin: 0; font-size: 14px; color: var(--muted); }
  .vs .card.hi { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .see { margin: 14px 0 0; font-size: 14px; font-weight: 600; }
/* —— 模块化专用 —— */
  .mod .pimg :global(svg) { width: 62%; }
  .vs.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (max-width: 760px) { .vs.two { grid-template-columns: minmax(0, 1fr); } }
  .bld-in { display: grid; gap: 18px; align-content: start; }
  .bld-f { display: grid; gap: 8px; }
  .bld-f > span { font-size: 13px; font-weight: 600; }
  .bld-num { display: flex; align-items: center; gap: 8px; }
  .bld-num input { width: 140px; font: 600 22px var(--mono); padding: 8px 12px; border: 1px solid var(--line); border-radius: 8px; }
  .bld-num b { font: 600 15px var(--mono); color: var(--muted); }
  .bld-f input[type="range"] { width: 100%; accent-color: var(--accent); }
  .bld-out { display: grid; gap: 14px; align-content: start; }
  .bld-title { margin: 0; font: 700 22px/1.2 var(--display); text-transform: uppercase; }
  .bld-title :global(a) { color: var(--ink); text-decoration: none; }
  .bld-row { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 18px; align-items: start; }
  @media (max-width: 520px) { .bld-row { grid-template-columns: minmax(0, 1fr); justify-items: center; } }
  .cab:empty { display: none; }
  .cab { background: #1f2526; border-radius: 10px; padding: 10px; width: 150px; box-shadow: inset 0 0 0 2px #333c3d; }
  .cab :global(.cab-top) { height: 30px; border-radius: 5px; background: #0c1a14; margin-bottom: 8px; display: grid; place-items: center; }
  .cab :global(.cab-top span) { width: 40%; height: 6px; border-radius: 3px; background: #5ef0a0; opacity: .7; }
  .cab :global(.cab-slots) { display: grid; gap: 5px; }
  .cab :global(.cab-slots.two) { grid-template-columns: 1fr 1fr; }
  .cab :global(.slot) { display: flex; align-items: center; gap: 6px; height: 26px; padding: 0 8px; border-radius: 4px; border: 0; font: 600 10.5px var(--mono); color: #cfd6d4; cursor: pointer; transition: background .25s, box-shadow .25s; }
  .cab :global(.slot i) { width: 7px; height: 7px; border-radius: 50%; flex: none; }
  .cab :global(.slot.act) { background: #2f3a3b; } .cab :global(.slot.act i) { background: #3ee08a; box-shadow: 0 0 6px #3ee08a; }
  .cab :global(.slot.red) { background: #3a3523; } .cab :global(.slot.red i) { background: var(--charge); }
  .cab :global(.slot.fut) { background: transparent; box-shadow: inset 0 0 0 1.5px #6b7775; color: #8d9997; cursor: default; } .cab :global(.slot.fut i) { background: transparent; box-shadow: inset 0 0 0 1.5px #8d9997; }
  .cab :global(.slot.free) { background: #171b1c; cursor: default; } .cab :global(.slot.free i) { background: #2c3335; }
  .cab :global(.slot.fail) { background: #5a1f1f; } .cab :global(.slot.fail i) { background: #ff4d4d; box-shadow: 0 0 6px #ff4d4d; }
  .cab :global(.slot.takeover) { background: #2f3a3b; } .cab :global(.slot.takeover i) { background: #3ee08a; box-shadow: 0 0 6px #3ee08a; }
  .cab :global(.slot:not(:disabled):hover) { box-shadow: inset 0 0 0 1.5px #fff; }
  .bld-info { display: grid; gap: 12px; }
  .bld-facts { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; font-size: 14px; }
  .bld-facts :global(li) { border-top: 1px dashed var(--line); padding-top: 6px; }
  .bld-facts :global(li:first-child) { border-top: 0; padding-top: 0; }
  .legend { display: flex; flex-wrap: wrap; gap: 6px 12px; font-size: 12px; color: var(--muted); }
  .legend span { display: inline-flex; align-items: center; gap: 5px; }
  .legend i { width: 12px; height: 12px; border-radius: 3px; }
  .legend i.act { background: #3ee08a; } .legend i.red { background: var(--charge); } .legend i.fut { box-shadow: inset 0 0 0 1.5px #6b7775; } .legend i.free { background: #2c3335; } .legend i.fail { background: #ff4d4d; }
  .bld-fail { margin: 0; font-size: 13px; color: var(--muted); padding: 8px 10px; border-radius: 8px; background: var(--bg); }
  .bld-fail.ok { color: var(--ok); background: var(--ok-soft); }
  .bld-fail.bad { color: #a5480b; background: #fdeee2; }
  [data-reset] { justify-self: start; }
  [data-reset][hidden] { display: none; }
  .bld-alt { display: grid; gap: 6px; }
  .bld-alt :global(a) { display: flex; justify-content: space-between; gap: 10px; padding: 9px 12px; border: 1px solid var(--line); border-radius: 9px; text-decoration: none; color: var(--ink); font-size: 14px; }
  .bld-alt :global(a span) { color: var(--muted); font: 13px var(--mono); }
  /* —— 选型器 —— */
  .cfgr { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; align-items: start; }
  @media (max-width: 960px) { .cfgr { grid-template-columns: minmax(0, 1fr); } }
  .steps { display: grid; gap: 10px; }
  .stp { display: grid; gap: 12px; padding: 16px 18px; }
  .stp-h { display: flex; align-items: center; gap: 10px; }
  .stp-h b { font-size: 15px; }
  .sn { width: 24px; height: 24px; border-radius: 50%; background: var(--ink); color: #fff; display: grid; place-items: center; font: 700 12px var(--mono); flex: none; }
  .kinds { display: grid; grid-template-columns: .6fr 1fr 1fr; gap: 8px; }
  @media (max-width: 520px) { .kinds { grid-template-columns: minmax(0, 1fr); } }
  .kind { display: grid; gap: 4px; align-content: start; justify-items: start; text-align: left; padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); color: var(--ink); cursor: pointer; font: 14px var(--body); }
  .kind svg { width: 34px; height: 34px; fill: none; stroke: var(--accent); stroke-width: 2; }
  .kind span { font-size: 12px; color: var(--muted); line-height: 1.35; }
  .kind small, .chip small { font: 11px var(--mono); color: var(--muted); }
  .kind.on { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); background: var(--ok-soft); }
  .chip.on small { color: #cfd6d4; }
  .kind:disabled, .chip:disabled { opacity: .4; cursor: not-allowed; }
  .chip[hidden] { display: none; }
  .ld { display: grid; grid-template-columns: 1.4fr 1fr; gap: 14px; align-items: start; }
  .cab:has(.two) { width: 200px; }
  .cab :global(.slot span) { white-space: nowrap; }
  @media (max-width: 520px) { .ld { grid-template-columns: minmax(0, 1fr); } }
  .res { position: sticky; top: 14px; display: grid; gap: 14px; }
  @media (max-width: 960px) { .res { position: static; } }
  .res-body { display: grid; gap: 14px; }
