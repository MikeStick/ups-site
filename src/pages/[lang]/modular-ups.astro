---
// 模块化 UPS 栏目页：系统配置器（负载 + 未来负载 + 冗余 → 选机柜、显示每个槽位，可点模块模拟故障）+ 机柜列表 + 卖点 + 与传统塔式对比 + 参数表 + 应用 + 项目询价。只询价，不显示价格。
// 产品来自客户档案系统，类型 = 模块化UPS；单模块容量 / 最多模块数填在产品的"功率模块容量""最多模块数"里。
import Base from '../../layouts/Base.astro';
import { LANGS, SITE } from '../../config.mjs';
import { MT, REDUNDANCY } from '../../lib/modular-i18n.mjs';
import { specValue } from '../../lib/offline-i18n.mjs';
import { isModular, moduleOf, capacityOf, fmtCap, seriesName } from '../../lib/category.mjs';
import all from '../../data/products.json';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const T = MT[lang];
const kva = (v) => `${+(v / 1000).toFixed(1)} kVA`;
const pfOf = (p) => { const v = parseFloat(String(p.outputPowerFactor || p.powerFactor || '').replace(',', '.')); return v > 0 && v <= 1 ? v : 0; };
const list = all.filter(isModular).map((p) => {
  const c = capacityOf(p), m = moduleOf(p);
  return { p, va: c.va, w: c.w, m, pf: pfOf(p), s: seriesName(p) };
}).sort((a, b) => a.s.localeCompare(b.s) || a.va - b.va);
const vas = list.map((x) => x.va).filter(Boolean);
const rangeTxt = vas.length ? (Math.min(...vas) === Math.max(...vas) ? kva(vas[0]) : `${Math.min(...vas) / 1000}–${Math.max(...vas) / 1000} kVA`) : '30–600 kVA';
const modSizes = [...new Set(list.map((x) => x.m.va).filter(Boolean))].sort((a, b) => a - b);
const modJoin = modSizes.map((v) => String(v / 1000)).join(' · ');
const modTxt = modSizes.length ? modJoin + ' kVA' : '25 · 50 kVA';
const wa = (msg) => `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(msg)}`;
const qMsg = { en: 'Hello, I would like a quote for the {m}:', es: 'Hola, quisiera una cotización del {m}:', ru: 'Здравствуйте, прошу цену на {m}:' }[lang];
// 配置器只用填了"功率模块容量"的机柜
const builderModels = list.filter((x) => x.m.w && x.m.n).map((x) => ({ m: x.p.model, slug: x.p.slug, va: x.va || x.m.va * x.m.n, mw: x.m.w, mva: x.m.va, n: x.m.n }));
const cfg = { models: builderModels, lang, t: { kw: T.kw, none: T.bNone, tooBig: T.bTooBig, result: T.bResult, split: T.bSplit, free: T.bFree, pct: T.bLoadPct, fut: T.bFutureNote, alt: T.bAlt, failOk: T.failOk, failNo: T.failNo, tryFail: T.tryFail, redHint: T.redHint, slots: T.slots } };
const compareRows = ['outputPower', 'upsModuleCapacity', 'upsModuleCount', 'phase', 'inputVoltageRange', 'inputPowerFactor', 'outputVoltage', 'outputPowerFactor', 'efficiencyAcMode', 'harmonicDistortion', 'parallelUnits', 'dimensions', 'netWeight']
  .filter((f) => list.some((x) => specValue(x.p, f, lang)));
const cell = (p, f) => (specValue(p, f, lang) || '—').replace(/\*/g, ' × ');
const APP_ICONS = [
  '<rect x="5" y="3" width="9" height="24" rx="1.5"/><rect x="16" y="3" width="9" height="24" rx="1.5"/><path d="M8 8h3M8 12h3M19 8h3M19 12h3"/>',
  '<rect x="4" y="6" width="22" height="20" rx="2"/><path d="M15 10v10M10 15h10"/>',
  '<path d="M4 26h22M6 26V12l9-6 9 6v14M10 26v-8M15 26v-8M20 26v-8"/>',
  '<path d="M15 27V12M9 27l6-15 6 15M7 9a11 11 0 0 1 16 0M10 12a6.5 6.5 0 0 1 10 0"/>',
  '<path d="M3 26V14l7 4v-4l7 4v-4l7 4V6h3v20Z"/>',
  '<path d="M4 18l9-2 6-10 3 1-3 9 7-1 2 3-22 4Z"/><path d="M4 26h22"/>',
];
const slotSvg = (i) => '<rect x="68" y="' + (58 + i * 21) + '" width="64" height="16" rx="2" fill="' + (i < 4 ? '#3a4446' : '#2c3335') + '"/><circle cx="76" cy="' + (66 + i * 21) + '" r="2.4" fill="' + (i < 4 ? '#5ef0a0' : '#4a5553') + '"/>';
const CAB_SVG = '<svg viewBox="0 0 200 200" aria-hidden="true"><rect x="58" y="14" width="84" height="176" rx="6" fill="#23292a"/><rect x="70" y="26" width="60" height="22" rx="3" fill="#7dd3fc" opacity=".85"/>' + [0, 1, 2, 3, 4, 5].map(slotSvg).join('') + '</svg>';
const RED = { 0: 'N', 1: 'N+1', 2: 'N+2' };
---
<Base lang={lang} title={`${T.title} · ${SITE.name}`} description={T.metaDesc} path="modular-ups/">
<div class="off rack mod" data-mod>
  <script type="application/json" data-mod-cfg set:html={JSON.stringify(cfg)} />
  <nav class="crumbs"><a href={`/${lang}/`}>{T.crumbs}</a> / {T.title}</nav>

  <section class="hero">
    <div class="hero-in">
      <div>
        <span class="eyebrow">{T.eyebrow}</span>
        <h1>{T.h1a}<em>{T.h1b}</em></h1>
        <p>{T.lead}</p>
        <div class="hero-cta">
          <a class="btn primary" href="#models">{T.ctaModels}</a>
          {builderModels.length > 0 && <a class="btn ghost" href="#builder">{T.ctaBuilder}</a>}
        </div>
      </div>
      <div class="hero-facts">
        <div><b class="num">{rangeTxt}</b><span>{T.facts.range}</span></div>
        <div><b class="num">{modTxt}</b><span>{T.facts.module}</span></div>
        <div><b class="num">N+X</b><span>{T.facts.red}</span></div>
        <div><b class="num">Hot-swap</b><span>{T.facts.swap}</span></div>
      </div>
    </div>
  </section>

  {builderModels.length > 0 && (
    <section class="block" id="builder">
      <div class="head"><span class="eyebrow">{T.bEyebrow}</span><h2>{T.bH}</h2><p>{T.bP}</p></div>
      <div class="sizer">
        <div class="card bld-in">
          <label class="bld-f"><span>{T.bLoad}</span>
            <span class="bld-num"><input type="number" inputmode="decimal" min="1" step="1" value="60" data-load /> <b>{T.kw}</b></span>
            <input type="range" min="5" max="600" step="5" value="60" data-range aria-label={T.bLoad} />
          </label>
          <label class="bld-f"><span>{T.bFuture}</span>
            <span class="bld-num"><input type="number" inputmode="decimal" min="0" step="1" placeholder="—" data-future /> <b>{T.kw}</b></span>
          </label>
          <div class="bld-f"><span>{T.bRed}</span>
            <div class="rt-chips" data-red>{REDUNDANCY.map((x) => <button type="button" class:list={['chip', { on: x === 1 }]} data-v={x}>{RED[x]}</button>)}</div>
            <small class="muted" data-redhint>{T.redHint[1]}</small>
          </div>
          <p class="muted">{T.battNote}</p>
        </div>
        <div class="card bld-out">
          <p class="bld-title" data-title>{T.bNone}</p>
          <div class="bld-row">
            <div class="cab" data-cab aria-live="polite"></div>
            <div class="bld-info">
              <ul class="bld-facts" data-facts></ul>
              <div class="legend">
                <span><i class="act"></i>{T.legend.act}</span><span><i class="red"></i>{T.legend.red}</span>
                <span><i class="fut"></i>{T.legend.fut}</span><span><i class="free"></i>{T.legend.free}</span><span><i class="fail"></i>{T.legend.fail}</span>
              </div>
              <p class="bld-fail" data-failmsg>{T.tryFail}</p>
              <button type="button" class="chip" data-reset hidden>{T.reset}</button>
            </div>
          </div>
          <div class="bld-alt" data-alt></div>
        </div>
      </div>
    </section>
  )}

  <section class="block" id="models">
    <div class="head"><span class="eyebrow">{T.modelsEyebrow}</span><h2>{T.modelsH}</h2></div>
    {list.length === 0 ? <p class="empty">{T.noModels}</p> : (
      <>
        <div class="filters">
          <div class="fgroup" data-f="cap"><span>{T.fCap}</span><button type="button" class="chip on" data-v="">{T.fAll}</button><button type="button" class="chip" data-v="1">{T.cap1}</button><button type="button" class="chip" data-v="2">{T.cap2}</button><button type="button" class="chip" data-v="3">{T.cap3}</button></div>
          {modSizes.length > 1 && <div class="fgroup" data-f="mod"><span>{T.fMod}</span><button type="button" class="chip on" data-v="">{T.fAll}</button>{modSizes.map((v) => <button type="button" class="chip" data-v={v}>{v / 1000} kVA</button>)}</div>}
        </div>
        <div class="grid">
          {list.map((x) => {
            const p = x.p, img = p.images && p.images[0];
            const eff = specValue(p, 'efficiencyAcMode', lang), ph = specValue(p, 'phase', lang);
            return (
              <article class="pcard" data-va={x.va} data-mod={x.m.va || ''}>
                <a class="pimg" href={`/${lang}/p/${p.slug}/`}>
                  {img ? <img src={img.thumb || img.src} alt={p.model} loading="lazy" /> : <Fragment set:html={CAB_SVG} />}
                  {x.m.n > 0 && <span class="tags"><span class="tag u">{T.slots.replace('{n}', x.m.n)}</span></span>}
                </a>
                <div class="pbody">
                  <h3><a href={`/${lang}/p/${p.slug}/`}>{p.model}</a></h3>
                  {fmtCap(x) && <span class="va">{fmtCap(x)}</span>}
                  <ul>
                    {x.m.va > 0 && <li>{T.cModules} <b>{x.m.n ? `${x.m.n} × ` : ''}{kva(x.m.va)}</b></li>}
                    {ph && <li>{T.cPhase} <b>{ph}</b></li>}
                    {x.pf > 0 && <li>{T.cPf} <b>{x.pf}</b></li>}
                    {eff && <li>{T.cEff} <b>{eff}</b></li>}
                  </ul>
                  <div class="pact">
                    <a class="btn sm line" href={`/${lang}/p/${p.slug}/`}>{T.details}</a>
                    <a class="btn sm dark" href={wa(qMsg.replace('{m}', p.model))} target="_blank" rel="noopener">{T.quote}</a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
        <p class="empty" data-empty hidden>{T.noMatch}</p>
      </>
    )}
  </section>

  <section class="block">
    <div class="head"><span class="eyebrow">{T.whyEyebrow}</span><h2>{T.whyH}</h2></div>
    <div class="feats">{T.feats.map(([a, b], i) => <div class="card feat"><span class="fi num">0{i + 1}</span><h3>{a}</h3><p>{b}</p></div>)}</div>
  </section>

  <section class="block">
    <div class="head"><span class="eyebrow">{T.vsEyebrow}</span><h2>{T.vsH}</h2></div>
    <div class="vs two">
      {(['tower', 'mod'] as const).map((k) => (
        <div class:list={['card', { hi: k === 'mod' }]}><span class:list={['tag', k === 'mod' ? 'on' : 'vs-li']}>{T.vs[k].tag}</span><h3>{T.vs[k].h}</h3>
          <ul>{T.vs[k].rows.map(([a, b]) => <li><span>{a}</span>{b}</li>)}</ul>
          <p class="best">{T.vs[k].best}</p></div>
      ))}
    </div>
  </section>

  {list.length > 0 && compareRows.length > 0 && (
    <section class="block">
      <div class="head"><span class="eyebrow">{T.compareEyebrow}</span><h2>{T.compareH}</h2></div>
      <div class="tbl-wrap"><table>
        <thead><tr><th>{T.spec.model}</th>{list.map((x) => <th><a href={`/${lang}/p/${x.p.slug}/`}>{x.p.model}</a></th>)}</tr></thead>
        <tbody>
          {compareRows.map((f) => <tr><th>{T.spec[f]}</th>{list.map((x) => <td class="num">{f === 'outputPower' && !specValue(x.p, f, lang) ? fmtCap(x) || '—' : cell(x.p, f)}</td>)}</tr>)}
        </tbody>
      </table></div>
    </section>
  )}

  <section class="block">
    <div class="head"><span class="eyebrow">{T.appsEyebrow}</span><h2>{T.appsH}</h2></div>
    <div class="apps">{T.apps.map((a, i) => <div class="app"><svg viewBox="0 0 30 30" aria-hidden="true" set:html={APP_ICONS[i]} />{a}</div>)}</div>
  </section>

  <section class="block">
    <div class="head"><span class="eyebrow">{T.projEyebrow}</span><h2>{T.projH}</h2></div>
    <div class="oem">
      <div class="oem-list">{T.proj.map(([a, b]) => <div><b>{a}</b><span>{b}</span></div>)}</div>
      <div class="oem-cta">
        <h3>{T.projCtaH}</h3>
        <p>{T.projCtaP}</p>
        {SITE.whatsapp && <div><a class="btn primary" href={wa(T.projMsg)} target="_blank" rel="noopener">{T.projCta}</a></div>}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="cta-box">
      <div><h2>{T.ctaH}</h2><p>{T.ctaP}</p></div>
      <div class="btns">
        {SITE.whatsapp && <a class="btn dark" href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">WhatsApp {SITE.whatsappDisplay}</a>}
        {SITE.email && <a class="btn line" href={`mailto:${SITE.email}`}>{SITE.email}</a>}
      </div>
    </div>
  </section>
</div>
</Base>

<script is:inline>
(function () {
  var root = document.querySelector('[data-mod]'); if (!root) return;
  var c = JSON.parse(root.querySelector('[data-mod-cfg]').textContent);
  var $ = function (s) { return root.querySelector(s); };
  // 列表筛选：容量区间 + 模块规格；选了容量后按容量从小到大
  var f = { cap: '', mod: '' };
  var grid = $('.grid');
  var cards = grid ? Array.prototype.slice.call(grid.querySelectorAll('.pcard')) : [];
  cards.forEach(function (el, i) { el.dataset.ord = i; });
  function filter() {
    if (grid) { var l = cards.slice(); if (f.cap) l.sort(function (a, b) { return (a.dataset.va - b.dataset.va) || (a.dataset.ord - b.dataset.ord); }); l.forEach(function (el) { grid.appendChild(el); }); }
    var n = 0;
    cards.forEach(function (el) {
      var va = +el.dataset.va;
      var ok = (!f.mod || el.dataset.mod === f.mod) && (!f.cap || (f.cap === '1' ? va <= 100000 : f.cap === '2' ? va > 100000 && va <= 300000 : va > 300000));
      el.hidden = !ok; if (ok) n++;
    });
    var e = $('[data-empty]'); if (e) e.hidden = n > 0;
  }
  root.querySelectorAll('[data-f]').forEach(function (g) {
    g.addEventListener('click', function (e) {
      var b = e.target.closest('.chip'); if (!b) return;
      g.querySelectorAll('.chip').forEach(function (x) { x.classList.toggle('on', x === b); });
      f[g.dataset.f] = b.dataset.v; filter();
    });
  });

  // 系统配置器
  if (!$('[data-cab]')) return;
  var red = 1, failed = -1, cur = null;
  var kvaTxt = function (v) { return (+(v / 1000).toFixed(1)) + ' kVA'; };
  function fmt(s, o) { return s.replace(/\{(\w+)\}/g, function (_, k) { return o[k] !== undefined ? o[k] : ''; }); }
  function plan(load, future) {
    var X = red, L = load * 1000, F = Math.max(load, future || 0) * 1000;
    var ok = c.models.map(function (m) {
      var act = Math.max(1, Math.ceil(L / m.mw)), need = act + X, fneed = Math.max(1, Math.ceil(F / m.mw)) + X;
      return { m: m, act: act, need: need, fneed: fneed, fits: need <= m.n, ffits: fneed <= m.n };
    }).filter(function (o) { return o.fits; }).sort(function (a, b) { return (b.ffits - a.ffits) || (a.m.va - b.m.va) || (b.m.mw - a.m.mw); });
    return ok;
  }
  function draw() {
    var load = parseFloat($('[data-load]').value) || 0, future = parseFloat($('[data-future]').value) || 0;
    var cab = $('[data-cab]'), facts = $('[data-facts]'), title = $('[data-title]'), alt = $('[data-alt]');
    failed = -1; $('[data-reset]').hidden = true; $('[data-failmsg]').textContent = c.t.tryFail; $('[data-failmsg]').className = 'bld-fail';
    if (!(load > 0)) { title.textContent = c.t.none; cab.innerHTML = ''; facts.innerHTML = ''; alt.innerHTML = ''; cur = null; return; }
    var opts = plan(load, future);
    if (!opts.length) {
      var maxKw = Math.max.apply(null, c.models.map(function (m) { return (m.n - red) * m.mw / 1000; }));
      title.textContent = fmt(c.t.tooBig, { kw: Math.max(0, Math.round(maxKw)) }); cab.innerHTML = ''; facts.innerHTML = ''; alt.innerHTML = ''; cur = null; return;
    }
    var o = cur = opts[0], m = o.m;
    title.innerHTML = '<a href="/' + c.lang + '/p/' + m.slug + '/">' + fmt(c.t.result, { m: m.m, n: o.need, mod: kvaTxt(m.mva) }) + '</a>';
    var futureAdd = o.ffits ? o.fneed - o.need : 0, free = m.n - o.need - futureAdd;
    var html = '<div class="cab-top"><span></span></div><div class="cab-slots' + (m.n > 10 ? ' two' : '') + '">';
    for (var i = 0; i < m.n; i++) {
      var st = i < o.act ? 'act' : i < o.need ? 'red' : i < o.need + futureAdd ? 'fut' : 'free';
      html += '<button type="button" class="slot ' + st + '" data-i="' + i + '"' + (st === 'act' || st === 'red' ? '' : ' disabled') + '><i></i><span>' + (st === 'free' ? '' : kvaTxt(m.mva)) + '</span></button>';
    }
    cab.innerHTML = html + '</div>';
    var pct = Math.round(load * 1000 / (o.need * m.mw) * 100);
    var li = ['<li><b>' + fmt(c.t.split, { a: o.act, r: red }) + '</b></li>', '<li>' + fmt(c.t.pct, { p: pct }) + '</li>'];
    if (futureAdd > 0) li.push('<li>' + fmt(c.t.fut, { kw: Math.max(load, future), n: futureAdd }) + '</li>');
    if (free > 0) li.push('<li>' + fmt(c.t.free, { f: free }) + '</li>');
    facts.innerHTML = li.join('');
    var more = opts.slice(1, 3);
    alt.innerHTML = more.length ? '<span class="muted">' + c.t.alt + '</span>' + more.map(function (x) {
      return '<a href="/' + c.lang + '/p/' + x.m.slug + '/"><b>' + x.m.m + '</b><span>' + x.need + ' × ' + kvaTxt(x.m.mva) + ' · ' + fmt(c.t.slots, { n: x.m.n }) + '</span></a>';
    }).join('') : '';
  }
  // 点模块模拟故障：有冗余 → 负载继续；没有冗余 → 转旁路
  $('[data-cab]').addEventListener('click', function (e) {
    var b = e.target.closest('.slot'); if (!b || b.disabled || failed >= 0) return;
    failed = +b.dataset.i; b.classList.add('fail');
    var msg = $('[data-failmsg]');
    msg.textContent = red > 0 ? c.t.failOk : c.t.failNo; msg.className = 'bld-fail ' + (red > 0 ? 'ok' : 'bad');
    if (red > 0) { var r = $('[data-cab] .slot.red'); if (r && r !== b) r.classList.add('takeover'); }
    $('[data-reset]').hidden = false;
  });
  $('[data-reset]').addEventListener('click', draw);
  var load = $('[data-load]'), range = $('[data-range]');
  load.addEventListener('input', function () { range.value = Math.min(600, Math.max(5, +load.value || 5)); draw(); });
  range.addEventListener('input', function () { load.value = range.value; draw(); });
  $('[data-future]').addEventListener('input', draw);
  $('[data-red]').addEventListener('click', function (e) {
    var b = e.target.closest('.chip'); if (!b) return;
    this.querySelectorAll('.chip').forEach(function (x) { x.classList.toggle('on', x === b); });
    red = +b.dataset.v; $('[data-redhint]').textContent = c.t.redHint[red]; draw();
  });
  draw();
})();
</script>

<style>
  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: 0 18px; border-radius: 8px; font-weight: 600; text-decoration: none; border: 1px solid transparent; cursor: pointer; font-family: var(--body); font-size: 15px; }
  .btn.primary { background: var(--charge); color: var(--ink); }
  .btn.ghost { color: #fff; border-color: #4b5f5b; background: transparent; }
  .btn.dark { background: var(--accent); color: #fff; }
  .btn.line { background: var(--surface); color: var(--ink); border-color: var(--line); }
  .btn.sm { min-height: 38px; padding: 0 14px; font-size: 14px; }
  .eyebrow { font: 600 13px var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--charge); }
  .crumbs { font-size: 13px; color: var(--muted); margin: 18px 0 0; }
  .crumbs a { color: var(--muted); }
  section.block { padding-block: 56px 0; }
  .head { display: grid; gap: 10px; margin-bottom: 22px; max-width: 760px; }
  .head h2 { font-size: clamp(28px, 4.2vw, 42px); }
  .head p { margin: 0; color: var(--muted); }

  /* 首屏 */
  .hero { background: var(--ink); color: #fff; position: relative; overflow: hidden; margin-top: 14px; border-radius: 16px; }
  .hero::after { content: ""; position: absolute; inset: 0; background: repeating-linear-gradient(90deg, rgba(255,255,255,.035) 0 1px, transparent 1px 64px), repeating-linear-gradient(0deg, rgba(255,255,255,.035) 0 1px, transparent 1px 64px); pointer-events: none; }
  .hero-in { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: 28px; padding: 44px 40px; align-items: center; }
  @media (max-width: 860px) { .hero-in { grid-template-columns: minmax(0, 1fr); padding: 28px 20px; } }
  .hero h1 { font-size: clamp(36px, 5.6vw, 62px); margin: 10px 0 14px; }
  .hero h1 em { font-style: normal; color: var(--charge); }
  .hero p { margin: 0; color: #c9d4d1; font-size: 17px; max-width: 560px; }
  .hero-cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 22px; }
