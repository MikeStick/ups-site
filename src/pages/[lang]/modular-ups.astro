---
// 模块化 UPS 栏目页（给技术工程师用的选型页）：
// ① 机柜类型（立式 / 机架式）→ ② 电气制式（3进3出 / 3进1出 / 1进1出）→ ③ 功率模块规格 → ④ 负载 + 未来负载 + 冗余 → ⑤ 后备时间（可选）
// 每一步只列出实际有的选项（带数量），右侧实时给出配置：机柜、模块数量、槽位图（可点模块模拟故障）、关键参数、电池估算，一键发送 / 复制配置。
// 下方"匹配的机柜"表列出所有符合条件的机柜，点一行就换成那个机柜。
// 产品来自客户档案系统：类型 = 模块化UPS（立式）/ 机架式模块化UPS；需要填"功率模块容量""最多模块数"。
import Base from '../../layouts/Base.astro';
import { LANGS, SITE } from '../../config.mjs';
import { MT, MW, REDUNDANCY, MOD_RUNTIMES } from '../../lib/modular-i18n.mjs';
import { BATT_AH } from '../../lib/rack-i18n.mjs';
import { specValue } from '../../lib/offline-i18n.mjs';
import { isModular, isRackModular, moduleOf, capacityOf, fmtCap, seriesName } from '../../lib/category.mjs';
import all from '../../data/products.json';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const T = MT[lang];
const W = MW[lang];
// 电气制式：从"相数"里读出 输入相数 + 输出相数（3-phase input / 1-phase output、3/3、三进三出……）
function phaseOf(p) {
  const t = String(p.phase || '').toLowerCase().replace(/三/g, '3').replace(/单/g, '1');
  let m = t.match(/(\d)\s*(?:-|\s)?(?:phase|ph|相|进)[^\d]*(\d)\s*(?:-|\s)?(?:phase|ph|相|出)/);
  if (!m) m = t.match(/(\d)\s*[/:]\s*(\d)/);
  if (m && /^[13]$/.test(m[1]) && /^[13]$/.test(m[2])) return m[1] + m[2];
  if (/3\s*-?\s*(phase|ph|相)/.test(t)) return '33';
  if (/1\s*-?\s*(phase|ph|相)/.test(t)) return '11';
  return '';
}
// 电池直流电压：±240V → 480，384V → 384
const dcV = (p) => { const t = String(p.batteryVoltage || ''); const m = t.match(/(\d{2,3})(?:\.\d+)?\s*V/i); return m ? +m[1] * (/±/.test(t) ? 2 : 1) : 0; };
const sv = (p, f) => (specValue(p, f, lang) || '').replace(/\*/g, ' × ');
const frames = all.filter(isModular).map((p) => {
  const c = capacityOf(p), m = moduleOf(p);
  return {
    m: p.model, slug: p.slug, k: isRackModular(p) ? 'rack' : 'tower', ph: phaseOf(p), va: c.va || m.va * m.n, cap: fmtCap(c) || sv(p, 'outputPower'),
    mva: m.va, mw: m.w, n: m.n, vb: dcV(p), s: seriesName(p),
    d: { volt: sv(p, 'outputVoltage'), eff: sv(p, 'efficiencyAcMode'), pf: sv(p, 'outputPowerFactor'), thd: sv(p, 'harmonicDistortion'), dims: sv(p, 'dimensions'),
      weight: sv(p, 'netWeight'), modDims: sv(p, 'upsModuleDimensions'), modW: sv(p, 'upsModuleWeight'), parallel: sv(p, 'parallelUnits') },
  };
}).filter((f) => f.mw && f.n).sort((a, b) => a.va - b.va || a.s.localeCompare(b.s));
const cfg = { frames, lang, wa: SITE.whatsapp, ah: BATT_AH, t: { ...W, kind: { tower: W.tower, rack: W.rack }, redHint: T.redHint, failOk: T.failOk, failNo: T.failNo, tryFail: T.tryFail, kw: T.kw, slots: T.slots } };
const RED = { 0: 'N', 1: 'N+1', 2: 'N+2' };
const wa = (msg) => `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(msg)}`;
const rtLabel = (m) => (m === 0 ? W.rtNone : `${m} min`);
---
<Base lang={lang} title={`${T.title} · ${SITE.name}`} description={T.metaDesc} path="modular-ups/">
<div class="off rack mod" data-mod>
  <script type="application/json" data-mod-cfg set:html={JSON.stringify(cfg)} />
  <nav class="crumbs"><a href={`/${lang}/`}>{T.crumbs}</a> / {T.title}</nav>

  <section class="hero">
    <div class="hero-in">
      <div>
        <span class="eyebrow">{T.eyebrow}</span>
        <h1>{T.h1a}<em>{T.h1b}</em></h1>
        <p>{T.lead}</p>
        <div class="hero-cta">
          <a class="btn primary" href="#builder">{T.ctaBuilder}</a>
        </div>
      </div>
      <div class="hero-facts">
        <div><b class="num">{W.range}</b><span>{T.facts.range}</span></div>
        <div><b class="num">{W.modules}</b><span>{T.facts.module}</span></div>
        <div><b class="num">N+X</b><span>{T.facts.red}</span></div>
        <div><b class="num">Hot-swap</b><span>{T.facts.swap}</span></div>
      </div>
    </div>
  </section>

  <section class="block" id="builder">
    <div class="head"><span class="eyebrow">{W.selEyebrow}</span><h2>{W.selH}</h2><p>{W.selP}</p></div>
    {frames.length === 0 ? <p class="empty">{T.noModels}</p> : (
      <>
        <div class="cfgr">
          <div class="steps">
            <div class="card stp">
              <div class="stp-h"><span class="sn">1</span><b>{W.s1}</b></div>
              <div class="kinds" data-step="k">
                <button type="button" class="kind on" data-v=""><b>{W.any}</b><small data-cnt></small></button>
                <button type="button" class="kind" data-v="tower"><svg viewBox="0 0 40 40" aria-hidden="true"><rect x="12" y="3" width="16" height="34" rx="2"/><path d="M15 12h10M15 17h10M15 22h10M15 27h10"/></svg><b>{W.tower}</b><span>{W.towerD}</span><small data-cnt></small></button>
                <button type="button" class="kind" data-v="rack"><svg viewBox="0 0 40 40" aria-hidden="true"><rect x="3" y="13" width="34" height="14" rx="2"/><path d="M8 17v6M12 17v6M16 17v6M20 17v6"/></svg><b>{W.rack}</b><span>{W.rackD}</span><small data-cnt></small></button>
              </div>
            </div>
            <div class="card stp">
              <div class="stp-h"><span class="sn">2</span><b>{W.s2}</b></div>
              <div class="rt-chips" data-step="ph">
                <button type="button" class="chip on" data-v="">{W.any}</button>
                {['33', '31', '11'].map((v) => <button type="button" class="chip" data-v={v}>{W.ph[v]} <small data-cnt></small></button>)}
              </div>
            </div>
            <div class="card stp">
              <div class="stp-h"><span class="sn">3</span><b>{W.s3}</b></div>
              <div class="rt-chips" data-step="mod">
                <button type="button" class="chip on" data-v="">{W.any}</button>
                {[...new Set(frames.map((f) => f.mva))].sort((a, b) => a - b).map((v) => <button type="button" class="chip" data-v={v}>{+(v / 1000).toFixed(1)} kVA <small data-cnt></small></button>)}
              </div>
            </div>
            <div class="card stp">
              <div class="stp-h"><span class="sn">4</span><b>{W.s4}</b></div>
              <div class="ld">
                <label class="bld-f"><span>{T.bLoad}</span>
                  <span class="bld-num"><input type="number" inputmode="decimal" min="1" step="1" value="60" data-load /> <b>{T.kw}</b></span>
                  <input type="range" min="5" max="1200" step="5" value="60" data-range aria-label={T.bLoad} />
                </label>
                <label class="bld-f"><span>{T.bFuture}</span>
                  <span class="bld-num"><input type="number" inputmode="decimal" min="0" step="1" placeholder="—" data-future /> <b>{T.kw}</b></span>
                </label>
              </div>
              <div class="bld-f"><span>{T.bRed}</span>
                <div class="rt-chips" data-red>{REDUNDANCY.map((x) => <button type="button" class:list={['chip', { on: x === 1 }]} data-v={x}>{RED[x]}</button>)}</div>
                <small class="muted" data-redhint>{T.redHint[1]}</small>
              </div>
            </div>
            <div class="card stp">
              <div class="stp-h"><span class="sn">5</span><b>{W.s5}</b></div>
              <div class="rt-chips" data-rt>{MOD_RUNTIMES.map((m) => <button type="button" class:list={['chip', { on: m === 0 }]} data-v={m}>{rtLabel(m)}</button>)}</div>
            </div>
          </div>

          <div class="card res">
            <span class="eyebrow">{W.resEyebrow}</span>
            <p class="bld-title" data-title>{W.resEmpty}</p>
            <div class="res-body" data-body hidden>
              <div class="bld-row">
                <div class="cab" data-cab aria-live="polite"></div>
                <div class="bld-info">
                  <div class="legend">
                    <span><i class="act"></i>{T.legend.act}</span><span><i class="red"></i>{T.legend.red}</span>
                    <span><i class="fut"></i>{T.legend.fut}</span><span><i class="free"></i>{T.legend.free}</span><span><i class="fail"></i>{T.legend.fail}</span>
                  </div>
                  <p class="bld-fail" data-failmsg>{T.tryFail}</p>
                  <button type="button" class="chip" data-reset hidden>{T.reset}</button>
                </div>
              </div>
              <dl class="res-dl" data-dl></dl>
              <div class="res-act">
                {SITE.whatsapp && <a class="btn primary" data-send href="#" target="_blank" rel="noopener">{W.send}</a>}
                <button type="button" class="btn line" data-copy>{W.copy}</button>
                <a class="btn line" data-details href="#">{W.details}</a>
              </div>
              <p class="muted">{T.battNote}</p>
            </div>
          </div>
        </div>

        <div class="match">
          <div class="match-h"><b>{W.matchH} <span data-mcount></span></b><span class="muted">{W.matchP}</span></div>
          <div class="tbl-wrap"><table>
            <thead><tr>{W.cols.map((c) => <th>{c}</th>)}</tr></thead>
            <tbody data-rows></tbody>
          </table></div>
        </div>
      </>
    )}
  </section>

  <section class="block">
    <div class="head"><span class="eyebrow">{T.whyEyebrow}</span><h2>{T.whyH}</h2></div>
    <div class="feats">{T.feats.map(([a, b], i) => <div class="card feat"><span class="fi num">0{i + 1}</span><h3>{a}</h3><p>{b}</p></div>)}</div>
  </section>

  <section class="block">
    <div class="head"><span class="eyebrow">{T.projEyebrow}</span><h2>{T.projH}</h2></div>
    <div class="oem">
      <div class="oem-list">{T.proj.map(([a, b]) => <div><b>{a}</b><span>{b}</span></div>)}</div>
      <div class="oem-cta">
        <h3>{T.projCtaH}</h3>
        <p>{T.projCtaP}</p>
        {SITE.whatsapp && <div><a class="btn primary" href={wa(T.projMsg)} target="_blank" rel="noopener">{T.projCta}</a></div>}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="cta-box">
      <div><h2>{T.ctaH}</h2><p>{T.ctaP}</p></div>
      <div class="btns">
        {SITE.whatsapp && <a class="btn dark" href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">WhatsApp {SITE.whatsappDisplay}</a>}
        {SITE.email && <a class="btn line" href={`mailto:${SITE.email}`}>{SITE.email}</a>}
      </div>
    </div>
  </section>
</div>
</Base>

<script is:inline>
(function () {
  var root = document.querySelector('[data-mod]'); if (!root) return;
  var c = JSON.parse(root.querySelector('[data-mod-cfg]').textContent);
  var $ = function (s) { return root.querySelector(s); };
  var $$ = function (s) { return Array.prototype.slice.call(root.querySelectorAll(s)); };
  if (!$('[data-rows]')) return;
  var T = c.t, F = c.frames;
  var st = { k: '', ph: '', mod: '', red: 1, rt: 0, pick: '' };
  var failed = -1, lastText = '';
  function fmt(s, o) { return String(s).replace(/\{(\w+)\}/g, function (_, k) { return o[k] !== undefined ? o[k] : ''; }); }
  function kva(v) { return (+(v / 1000).toFixed(1)) + ' kVA'; }
  function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;'); }
  // 第 n 步可选项：只按前面几步筛选
  function pass(f, upto) {
    if (upto > 0 && st.k && f.k !== st.k) return false;
    if (upto > 1 && st.ph && f.ph && f.ph !== st.ph) return false;
    if (upto > 2 && st.mod && String(f.mva) !== st.mod) return false;
    return true;
  }
  var order = ['k', 'ph', 'mod'];
  function refreshSteps() {
    order.forEach(function (key, i) {
      var box = $('[data-step="' + key + '"]');
      var base = F.filter(function (f) { return pass(f, i); });
      box.querySelectorAll('[data-v]').forEach(function (b) {
        var v = b.dataset.v;
        var n = v === '' ? base.length : base.filter(function (f) { return key === 'k' ? f.k === v : key === 'ph' ? (!f.ph || f.ph === v) : String(f.mva) === v; }).length;
        var cnt = b.querySelector('[data-cnt]'); if (cnt) cnt.textContent = n ? fmt(T.frames, { n: n }) : T.none0;
        b.disabled = v !== '' && n === 0;
        b.hidden = key !== 'k' && v !== '' && n === 0 && !F.some(function (f) { return key === 'ph' ? f.ph === v : String(f.mva) === v; });
        if (b.disabled && st[key] === v) { st[key] = ''; }
      });
      box.querySelectorAll('[data-v]').forEach(function (b) { b.classList.toggle('on', b.dataset.v === st[key]); });
    });
  }
  function plan(f, L, Fu) {
    var act = Math.max(1, Math.ceil(L * 1000 / f.mw)), need = act + st.red, fneed = Math.max(1, Math.ceil(Math.max(L, Fu) * 1000 / f.mw)) + st.red;
    return { f: f, act: act, need: need, fneed: fneed, fits: need <= f.n, ffits: fneed <= f.n };
  }
  function battTxt(L, f) {
    if (!st.rt) return '';
    var wh = L * 1000 * st.rt / 60 / 0.95 / 0.8, s = fmt(T.batt, { kwh: Math.ceil(wh / 100) / 10, m: st.rt });
    if (f.vb) {
      var per = Math.max(1, Math.round(f.vb / 12)), ah = wh / f.vb, strings = 1;
      while (ah / strings > 200) strings++;
      var size = c.ah.filter(function (a) { return a >= ah / strings; })[0] || 200;
      s += ' · ' + fmt(T.battBlocks, { b: per * strings, ah: size });
    }
    return s;
  }
  function render() {
    refreshSteps();
    var L = parseFloat($('[data-load]').value) || 0, Fu = parseFloat($('[data-future]').value) || 0;
    var cand = F.filter(function (f) { return pass(f, 3); });
    var plans = cand.map(function (f) { return plan(f, L, Fu); });
    var ok = plans.filter(function (p) { return p.fits; }).sort(function (a, b) { return (b.ffits - a.ffits) || (a.f.va - b.f.va) || (b.f.mw - a.f.mw); });
    var sel = L > 0 ? (ok.filter(function (p) { return p.f.slug === st.pick; })[0] || ok[0]) : null;
    // 匹配的机柜表
    $('[data-mcount]').textContent = '(' + cand.length + ')';
    $('[data-rows]').innerHTML = plans.map(function (p) {
      var f = p.f, on = sel && sel.f.slug === f.slug, dim = L > 0 && !p.fits;
      return '<tr data-slug="' + f.slug + '" class="' + (on ? 'sel' : '') + (dim ? ' dim' : '') + '"><td><b>' + esc(f.m) + '</b>' + (on ? ' <span class="tag on">' + T.selected + '</span>' : '') + '</td><td>' + T.kind[f.k] +
        '</td><td class="num">' + esc(f.cap || kva(f.va)) + '</td><td class="num">' + kva(f.mva) + '</td><td class="num">' + f.n + '</td><td>' + (f.ph ? T.ph[f.ph] : '—') +
        '</td><td class="num">' + esc(f.d.eff || '—') + '</td><td class="num">' + esc(f.d.dims || '—') + '</td></tr>';
    }).join('');
    // 配置结果
    var title = $('[data-title]'), body = $('[data-body]');
    failed = -1; $('[data-reset]').hidden = true; $('[data-failmsg]').textContent = T.tryFail; $('[data-failmsg]').className = 'bld-fail';
    if (!(L > 0)) { title.textContent = T.resEmpty; body.hidden = true; return; }
    if (!sel) { title.textContent = T.noMatch; body.hidden = true; return; }
    body.hidden = false;
    var f = sel.f, futureAdd = sel.ffits ? sel.fneed - sel.need : 0, free = f.n - sel.need - futureAdd;
    title.innerHTML = '<a href="/' + c.lang + '/p/' + f.slug + '/">' + esc(f.m) + '</a> · ' + sel.need + ' × ' + kva(f.mva);
    var html = '<div class="cab-top"><span></span></div><div class="cab-slots' + (f.n > 10 ? ' two' : '') + '">';
    for (var i = 0; i < f.n; i++) {
      var s = i < sel.act ? 'act' : i < sel.need ? 'red' : i < sel.need + futureAdd ? 'fut' : 'free';
      html += '<button type="button" class="slot ' + s + '" data-i="' + i + '"' + (s === 'act' || s === 'red' ? '' : ' disabled') + '><i></i><span>' + (s === 'free' ? '' : kva(f.mva)) + '</span></button>';
    }
    $('[data-cab]').innerHTML = html + '</div>';
    var R = T.rows, rows = [
      [R.frame, f.m], [R.type, T.kind[f.k]], [R.system, f.cap || kva(f.va)], [R.modules, fmt(T.slots, { n: f.n }) + ' × ' + kva(f.mva)],
      [R.installed, fmt(T.installed, { n: sel.need, mod: kva(f.mva), a: sel.act, r: st.red })],
      [R.free, String(Math.max(0, f.n - sel.need))],
      [R.share, Math.round(L * 1000 / (sel.need * f.mw) * 100) + '%'],
    ];
    if (Fu > L) rows.push([R.growth, sel.ffits ? fmt(T.growth, { n: sel.fneed - sel.need, kw: Fu }) : T.growthNo]);
    if (st.rt) rows.push([R.battery, battTxt(L, f)]);
    if (f.ph) rows.push([R.phase, T.ph[f.ph]]);
    [['volt', R.volt], ['eff', R.eff], ['pf', R.pf], ['thd', R.thd], ['dims', R.dims], ['weight', R.weight], ['modDims', R.modDims], ['modW', R.modW], ['parallel', R.parallel]]
      .forEach(function (x) { if (f.d[x[0]]) rows.push([x[1], f.d[x[0]]]); });
    $('[data-dl]').innerHTML = rows.map(function (r) { return '<div><dt>' + esc(r[0]) + '</dt><dd>' + esc(r[1]) + '</dd></div>'; }).join('');
    var head = [[T.msgLoad, L + ' kW'], Fu > L ? [T.msgFuture, Fu + ' kW'] : null, [T.msgRed, ['N', 'N+1', 'N+2'][st.red]], st.rt ? [T.msgRt, st.rt + ' min'] : null].filter(Boolean);
    lastText = T.msgHead + '\n' + head.concat(rows.slice(0, 7)).map(function (r) { return '• ' + r[0] + ': ' + r[1]; }).join('\n') + '\n' + location.origin + '/' + c.lang + '/p/' + f.slug + '/';
    var send = $('[data-send]'); if (send) send.href = 'https://wa.me/' + c.wa + '?text=' + encodeURIComponent(lastText);
    $('[data-details]').href = '/' + c.lang + '/p/' + f.slug + '/';
  }
  // 步骤 1–3
  order.forEach(function (key) {
    $('[data-step="' + key + '"]').addEventListener('click', function (e) {
      var b = e.target.closest('[data-v]'); if (!b || b.disabled) return;
      st[key] = b.dataset.v; st.pick = ''; render();
    });
  });
  // 步骤 4–5
  var load = $('[data-load]'), range = $('[data-range]');
  load.addEventListener('input', function () { range.value = Math.min(1200, Math.max(5, +load.value || 5)); render(); });
  range.addEventListener('input', function () { load.value = range.value; render(); });
  $('[data-future]').addEventListener('input', render);
  $('[data-red]').addEventListener('click', function (e) {
    var b = e.target.closest('.chip'); if (!b) return;
    this.querySelectorAll('.chip').forEach(function (x) { x.classList.toggle('on', x === b); });
    st.red = +b.dataset.v; $('[data-redhint]').textContent = T.redHint[st.red]; render();
  });
  $('[data-rt]').addEventListener('click', function (e) {
    var b = e.target.closest('.chip'); if (!b) return;
    this.querySelectorAll('.chip').forEach(function (x) { x.classList.toggle('on', x === b); });
    st.rt = +b.dataset.v; render();
  });
  // 表格：点一行换成那个机柜
  $('[data-rows]').addEventListener('click', function (e) {
    var tr = e.target.closest('tr'); if (!tr || tr.classList.contains('dim')) return;
    st.pick = tr.dataset.slug; render();
    $('.res').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
  // 点模块模拟故障
  $('[data-cab]').addEventListener('click', function (e) {
    var b = e.target.closest('.slot'); if (!b || b.disabled || failed >= 0) return;
    failed = +b.dataset.i; b.classList.add('fail');
    var msg = $('[data-failmsg]');
    msg.textContent = st.red > 0 ? T.failOk : T.failNo; msg.className = 'bld-fail ' + (st.red > 0 ? 'ok' : 'bad');
    if (st.red > 0) { var r = $('[data-cab] .slot.red'); if (r && r !== b) r.classList.add('takeover'); }
    $('[data-reset]').hidden = false;
  });
  $('[data-reset]').addEventListener('click', render);
  $('[data-copy]').addEventListener('click', function () {
    var b = this, done = function () { var o = b.textContent; b.textContent = T.copied; setTimeout(function () { b.textContent = o; }, 1500); };
    try { navigator.clipboard.writeText(lastText).then(done, function () {}); } catch (e) {}
  });
  render();
})();
</script>

<style>
  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: 0 18px; border-radius: 8px; font-weight: 600; text-decoration: none; border: 1px solid transparent; cursor: pointer; font-family: var(--body); font-size: 15px; }
  .btn.primary { background: var(--charge); color: var(--ink); }
  .btn.ghost { color: #fff; border-color: #4b5f5b; background: transparent; }
  .btn.dark { background: var(--accent); color: #fff; }
  .btn.line { background: var(--surface); color: var(--ink); border-color: var(--line); }
  .btn.sm { min-height: 38px; padding: 0 14px; font-size: 14px; }
  .eyebrow { font: 600 13px var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--charge); }
  .crumbs { font-size: 13px; color: var(--muted); margin: 18px 0 0; }
