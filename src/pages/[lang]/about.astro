---
// About Us（B 版）。文字在 src/lib/about-i18n.mjs；照片和近期动态在客户档案系统「网站管理」里维护（构建时拉到 src/data/site.json），没上传的照片位置自动隐藏或显示图标。
import Base from '../../layouts/Base.astro';
import { LANGS, SITE } from '../../config.mjs';
import { AT, STATS, FAMILIES, SERIES, NEWS } from '../../lib/about-i18n.mjs';
import site from '../../data/site.json';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const T = AT[lang];
const ph = (k) => { const a = site.assets && site.assets[k]; return a && a[0] ? a[0].src : null; };
// 近期动态：网站管理里有内容就用它，没有就显示官网的 3 条默认动态
const news = Array.isArray(site.news) && site.news.length
  ? site.news.map((n) => ({ d: n.date, title: (n.title && (n.title[lang] || n.title.en)) || '', text: (n.text && (n.text[lang] || n.text.en)) || '', yt: n.youtube }))
  : NEWS.map((n) => ({ d: n.d, title: T.news[n.k][0], text: T.news[n.k][1], yt: null }));
const introPhotos = ['line', 'rd', 'warehouse'].filter((k) => ph(k));
// 图集（生产线、研发、仓库）：第一张是首图，点开可翻看全部，带标题
const capOf = (im) => (im.caption && (im.caption[lang] || im.caption.en)) || '';
const gallery = (k) => (site.assets[k] || []).map((im) => ({ src: im.src, cap: capOf(im) }));
const facPhotos = ['smt', 'assembly', 'aging', 'qc'].filter((k) => ph(k));
const certPhotos = ['cert_iso9001', 'cert_iso14001', 'cert_iso45001', 'cert_cqc', 'cert_tlc', 'cert_hitech'].filter((k) => ph(k));
const CERT_NAMES = { cert_iso9001: 'ISO 9001', cert_iso14001: 'ISO 14001', cert_iso45001: 'ISO 45001', cert_cqc: 'CQC', cert_tlc: 'TLC', cert_hitech: T.honCnList[0] };
const facGallery = facPhotos.map((k) => ({ src: ph(k), cap: T.facPhotos[k] }));
// 滚动带：照片少于 4 张时重复几遍，保证宽屏上也能铺满、循环不留空
const facLoop = facPhotos.length ? Array.from({ length: Math.ceil(4 / facPhotos.length) }, () => facPhotos.map((k, i) => [k, i])).flat() : [];
const certGallery = certPhotos.map((k) => ({ src: ph(k), cap: CERT_NAMES[k] }));
const wa = (msg) => `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(msg)}`;
// 产品家族图标（没有照片时显示）
const ICONS = {
  dc: '<rect x="10" y="16" width="36" height="24" rx="4"/><path d="M46 24h4v8h-4M16 22v12M22 22v12M28 22v12"/>',
  backup: '<rect x="14" y="10" width="28" height="36" rx="3"/><circle cx="28" cy="20" r="3"/><path d="M20 32h16M20 38h16"/>',
  hf: '<rect x="12" y="8" width="32" height="40" rx="3"/><path d="M18 30c3-8 5-8 8 0s5 8 8 0 4-6 5-4"/>',
  if: '<rect x="8" y="12" width="40" height="32" rx="3"/><path d="M18 20v16M24 20v16M32 20v16M38 20v16M18 28h20"/>',
  modular: '<rect x="12" y="8" width="32" height="10" rx="2"/><rect x="12" y="23" width="32" height="10" rx="2"/><rect x="12" y="38" width="32" height="10" rx="2"/><path d="M18 13h8M18 28h8M18 43h8"/>',
  rack: '<rect x="8" y="20" width="40" height="16" rx="2"/><path d="M14 28h12M40 26v4M4 20v16M52 20v16"/>',
  inverter: '<circle cx="28" cy="24" r="7"/><path d="M28 8v5M28 35v5M12 24h5M39 24h5M17 13l3 3M36 32l3 3M39 13l-3 3M20 32l-3 3M14 48h28"/>',
  battery: '<rect x="12" y="14" width="32" height="34" rx="3"/><path d="M22 10h12v4H22zM30 22l-6 10h8l-6 10"/>',
};
const APP_ICONS = [
  '<path d="M4 12l12-7 12 7M6 12v12M12 12v12M20 12v12M26 12v12M3 26h26"/>',
  '<rect x="7" y="4" width="18" height="24" rx="2"/><path d="M11 10h10M11 15h10M11 20h10"/>',
  '<path d="M16 4v8M10 9l6 3 6-3M8 28l8-16 8 16M11 22h10"/>',
  '<path d="M18 3L8 18h7l-2 11 11-16h-7z"/>',
  '<path d="M16 4c5 6 7 10 7 14a7 7 0 01-14 0c0-4 2-8 7-14z"/>',
  '<path d="M4 26V14l7 4v-4l7 4v-4l7 4V6h3v20z"/>',
  '<path d="M4 22h24l-3 6H7zM8 22V12h10v10M18 16h6l2 6"/>',
  '<path d="M5 15l11-9 11 9v12H5zM13 27v-7h6v7"/>',
];
const WHY_ICONS = [
  ['#dcf1e2', '#0f6b5c', '<path d="M12 30V18l10-6 10 6v12H12zM19 30v-7h6v7"/>'],
  ['#fbefc6', '#7a5a00', '<path d="M14 29l8-14 8 14z"/>'],
  ['#dcf1e2', '#0f6b5c', '<circle cx="22" cy="22" r="8"/><path d="M22 10v4M22 30v4M10 22h4M30 22h4"/>'],
];
---
<Base lang={lang} title={`${T.title} · ${SITE.name}`} description={T.metaDesc} path="about/" full>
<div class="about">
  <section class:list={['hero', { nophoto: !ph('hero') }]}>
    <div class="wrap">
      <div>
        <span class="eyebrow">{T.eyebrow}</span>
        <h1>{T.h1a}<em>{T.h1b}</em></h1>
        <p>{T.lead}</p>
        <div class="hero-cta">
          <a class="btn primary" href={`/${lang}/`}>{T.ctaMini}</a>
          <a class="btn ghost" href={`/${lang}/custom/`}>{T.ctaCustom}</a>
        </div>
      </div>
      {ph('hero') && <div class="ph"><img src={ph('hero')} alt="" loading="eager" /></div>}
    </div>
  </section>

  <div class="wrap stats">
    <div class="stats-grid">
      {STATS.map((s) => <div class="stat"><b class="num">{s.n}{s.u && <small>{s.u}</small>}</b><span>{T.stats[s.k]}</span></div>)}
    </div>
  </div>

  <nav class="toc wrap" aria-label="On this page">
    {Object.entries(T.toc).map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
  </nav>

  <section class="block wrap" id="who">
    <div class:list={['intro', { solo: !introPhotos.length }]}>
      <div>
        <div class="head"><span class="eyebrow">{T.whoEyebrow}</span><h2>{T.whoH}</h2></div>
        <p class="lead">{T.whoLead}</p>
        <p>{T.whoP1}</p>
        <p>{T.whoP2}</p>
      </div>
      {introPhotos.length > 0 && (
        <div class:list={['intro-photos', `n${introPhotos.length}`]}>
          {introPhotos.map((k) => {
            const g = gallery(k);
            return (
              <button type="button" class="ph gal" data-gallery={JSON.stringify(g)} data-title={T.photo[k]} aria-label={`${T.photo[k]} (${g.length})`}>
                <img src={g[0].src} alt={g[0].cap || T.photo[k]} loading="lazy" />
                <span class="gal-cap"><b>{T.photo[k]}</b>{g.length > 1 && <em>{g.length} ▸</em>}</span>
              </button>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <section class="block wrap" id="range">
    <div class="head"><span class="eyebrow">{T.rangeEyebrow}</span><h2>{T.rangeH}</h2><p>{T.rangeP}</p></div>
    <div class="range-grid">
      {FAMILIES.map((f) => (
        <article class:list={['rcard', { focus: f.online }]}>
          {ph(`fam_${f.key}`)
            ? <div class="ph light"><img src={ph(`fam_${f.key}`)} alt={T.fam[f.key][0]} loading="lazy" /></div>
            : <div class="ricon"><svg viewBox="0 0 56 56" aria-hidden="true" set:html={ICONS[f.key]} /></div>}
          <div class="rbody">
            {f.online && <span class="tag">{T.orderOnline}</span>}
            <h3>{T.fam[f.key][0]}</h3>
            <span class="range num">{f.key === 'backup' ? T.rangeHome : f.key === 'rack' ? `19" ${T.rangeRack}` : f.key === 'inverter' ? T.rangeInv : f.range}</span>
            <p>{T.fam[f.key][1]}</p>
            {f.online
              ? <a href={`/${lang}/`}>{T.browse}</a>
              : <a href={wa(`${T.fam[f.key][0]} — ${T.quote.replace(' →', '')}`)} target="_blank" rel="noopener">{T.quote}</a>}
          </div>
        </article>
      ))}
    </div>

    <div class="series">
      <h3>{T.seriesH}</h3>
      <div class="series-table" role="table">
        <div role="row" class="th">{T.seriesCols.map((c) => <span role="columnheader">{c}</span>)}</div>
        {SERIES.map((r) => (
          <div role="row"><b role="cell">{r.s}</b><span role="cell">{T.series[r.k][0]}</span><span role="cell" class="num">{r.p}</span><span role="cell">{T.series[r.k][1]}</span></div>
        ))}
      </div>
    </div>
  </section>

  <section class="block wrap" id="apps">
    <div class="head"><span class="eyebrow">{T.appsEyebrow}</span><h2>{T.appsH}</h2></div>
    <div class="apps">
      {T.apps.map((a, i) => <div class="app"><svg viewBox="0 0 32 32" aria-hidden="true" set:html={APP_ICONS[i]} /><b>{a}</b></div>)}
    </div>
  </section>

  <section class="block wrap" id="factory">
    <div class="head"><span class="eyebrow">{T.facEyebrow}</span><h2>{T.facH}</h2></div>
    {facPhotos.length > 0 && (
      <!-- 车间照片自动滚动播放：鼠标悬停 / 手指按住时暂停，点击查看大图 -->
      <div class="marquee" data-gallery-list={JSON.stringify(facGallery)} data-title={T.facEyebrow}>
        <div class="marquee-track" style={`--n:${facLoop.length}`}>
          {[0, 1].map((half) => facLoop.map(([k, i], j) => {
            const dup = half > 0 || j >= facPhotos.length;
            return (
            <figure aria-hidden={dup ? 'true' : undefined}>
              <button type="button" class="ph light" data-open={i} tabindex={dup ? -1 : 0} aria-label={T.facPhotos[k]}><img src={ph(k)} alt={dup ? '' : T.facPhotos[k]} loading="lazy" /></button>
              <figcaption>{T.facPhotos[k]}</figcaption>
            </figure>
            );
          }))}
        </div>
      </div>
    )}
    <ol class="flow">
      {T.flow.map(([h, d], i) => <li><b>{String(i + 1).padStart(2, '0')}</b><strong>{h}</strong><span>{d}</span></li>)}
    </ol>
  </section>

  <section class="block wrap" id="honors">
    <div class="head"><span class="eyebrow">{T.honEyebrow}</span><h2>{T.honH}</h2></div>
    <div class="honor-grid">
      <div class="honor"><h3>{T.honMgmt}</h3><div class="badges">{['ISO 9001', 'ISO 14001', 'ISO 45001'].map((b) => <span class="badge">{b}</span>)}</div></div>
      <div class="honor"><h3>{T.honProd}</h3><div class="badges">{['CE', 'RoHS', 'UL', 'FCC', 'PSE', 'IEC'].map((b) => <span class="badge">{b}</span>)}</div></div>
      <div class="honor"><h3>{T.honCn}</h3><ul class="ticks">{T.honCnList.map((x) => <li>{x}</li>)}</ul></div>
      <div class="honor"><h3>{T.honSw}</h3><p><b class="big num">10</b>{T.honSwText}</p></div>
    </div>
    {certPhotos.length > 0 && (
      <!-- 证书：单击放大 -->
      <div class="cert-strip" data-gallery-list={JSON.stringify(certGallery)} data-title={T.honEyebrow}>
        {certPhotos.map((k, i) => <button type="button" class="ph light cert" data-open={i} aria-label={CERT_NAMES[k]}><img src={ph(k)} alt={CERT_NAMES[k]} loading="lazy" /></button>)}
      </div>
    )}
  </section>

  <section class="block wrap" id="service">
    <div class="head"><span class="eyebrow">{T.svcEyebrow}</span><h2>{T.svcH}</h2></div>
    <div class="service">
      {T.svc.map(([h, d], i) => <div class="svc"><b class="num">0{i + 1}</b><h3>{h}</h3><p>{d}</p></div>)}
    </div>
  </section>

  <section class="block wrap">
    <div class="head"><span class="eyebrow">{T.whyEyebrow}</span><h2>{T.whyH}</h2></div>
    <div class="why">
      {T.why.map(([h, d], i) => (
        <div class="why-item">
          <svg viewBox="0 0 44 44" aria-hidden="true"><rect x="2" y="2" width="40" height="40" rx="10" fill={WHY_ICONS[i][0]} /><g fill="none" stroke={WHY_ICONS[i][1]} stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round" set:html={WHY_ICONS[i][2]} /></svg>
          <div><h3>{h}</h3><p>{d}</p></div>
        </div>
      ))}
    </div>
  </section>

  <section class="values" id="culture">
    <div class="wrap">
      <div>
        <span class="eyebrow">{T.culEyebrow}</span>
        <h2>{T.culHa}<em>{T.culHb}</em>{T.culHc}</h2>
        <dl class="vm">{T.vm.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      </div>
      <div class="value-list">{T.values.map(([k, v]) => <div><b>{k}</b><span>{v}</span></div>)}</div>
    </div>
  </section>

  <section class="block wrap" id="news">
    <div class="head"><span class="eyebrow">{T.newsEyebrow}</span><h2>{T.newsH}</h2></div>
    <ol class="timeline">
      {news.map((n) => (
        <li class:list={{ hasvideo: !!n.yt }}>
          <time class="num">{n.d}</time>
          <div>
            <b>{n.title}</b>{n.text && <span>{n.text}</span>}
            {n.yt && (
              <button type="button" class="yt" data-yt={n.yt} aria-label={`▶ ${n.title}`}>
                <img src={`https://i.ytimg.com/vi/${n.yt}/hqdefault.jpg`} alt="" loading="lazy" />
                <i aria-hidden="true"><svg viewBox="0 0 68 48"><path d="M66.5 7.7a8.5 8.5 0 00-6-6C55.3.3 34 .3 34 .3s-21.3 0-26.5 1.4a8.5 8.5 0 00-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.5 8.5 0 006 6C12.7 47.7 34 47.7 34 47.7s21.3 0 26.5-1.4a8.5 8.5 0 006-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3z" fill="#f00"/><path d="M45 24L27 14v20" fill="#fff"/></svg></i>
              </button>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <div class="lb" data-lb hidden role="dialog" aria-modal="true">
    <button type="button" class="lb-x" data-lb-close aria-label="×">×</button>
    <button type="button" class="lb-nav prev" data-lb-prev aria-label="‹">‹</button>
    <figure><img alt="" data-lb-img /><figcaption><b data-lb-title></b> <span data-lb-cap></span> <em class="num" data-lb-count></em></figcaption></figure>
    <button type="button" class="lb-nav next" data-lb-next aria-label="›">›</button>
  </div>

  <section class="wrap cta">
    <div class="cta-box">
      <div><h2>{T.ctaH}</h2><p>{T.ctaP}</p></div>
      <div class="btns">
        {SITE.whatsapp && <a class="btn dark" href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">WhatsApp {SITE.whatsappDisplay}</a>}
        {SITE.email && <a class="btn line" href={`mailto:${SITE.email}`}>{SITE.email}</a>}
      </div>
    </div>
  </section>
</div>
</Base>

<script is:inline>
  // 图集查看：点首图打开，左右切换（按钮 / 方向键 / 手机左右滑），Esc 或点背景关闭
  (function () {
    var lb = document.querySelector('[data-lb]'); if (!lb) return;
    var img = lb.querySelector('[data-lb-img]'), list = [], i = 0, title = '';
    function show() {
      var it = list[i]; img.src = it.src; img.alt = it.cap || title;
      lb.querySelector('[data-lb-title]').textContent = title;
      lb.querySelector('[data-lb-cap]').textContent = it.cap ? '· ' + it.cap : '';
      lb.querySelector('[data-lb-count]').textContent = list.length > 1 ? (i + 1) + ' / ' + list.length : '';
      lb.querySelector('[data-lb-prev]').hidden = lb.querySelector('[data-lb-next]').hidden = list.length < 2;
    }
    function open(g, t, start) { list = g; i = start || 0; title = t; show(); lb.hidden = false; document.body.style.overflow = 'hidden'; }
    function close() { lb.hidden = true; document.body.style.overflow = ''; }
    function go(d) { i = (i + d + list.length) % list.length; show(); }
    document.querySelectorAll('.about [data-gallery]').forEach(function (b) {
      b.addEventListener('click', function () { open(JSON.parse(b.dataset.gallery), b.dataset.title); });
    });
    // 车间滚动图和证书：单击放大
    document.querySelectorAll('.about [data-gallery-list]').forEach(function (box) {
      var g = JSON.parse(box.dataset.galleryList);
      box.addEventListener('click', function (e) {
        var b = e.target.closest('[data-open]'); if (!b) return;
        open(g, box.dataset.title, +b.dataset.open);
      });
    });
    lb.querySelector('[data-lb-prev]').addEventListener('click', function (e) { e.stopPropagation(); go(-1); });
    lb.querySelector('[data-lb-next]').addEventListener('click', function (e) { e.stopPropagation(); go(1); });
    lb.addEventListener('click', function (e) { if (e.target === lb || e.target.closest('[data-lb-close]')) close(); });
    document.addEventListener('keydown', function (e) {
      if (lb.hidden) return;
      if (e.key === 'Escape') close(); else if (e.key === 'ArrowLeft') go(-1); else if (e.key === 'ArrowRight') go(1);
    });
    var x0 = null;
    lb.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; }, { passive: true });
    lb.addEventListener('touchend', function (e) { if (x0 === null) return; var dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40 && list.length > 1) go(dx < 0 ? 1 : -1); x0 = null; });
  })();

  // 点击视频封面才加载 YouTube 播放器，页面打开时不加载任何视频脚本
  document.querySelectorAll('.about [data-yt]').forEach(function (b) {
    b.addEventListener('click', function () {
      var f = document.createElement('iframe');
      f.src = 'https://www.youtube-nocookie.com/embed/' + b.dataset.yt + '?autoplay=1&rel=0';
      f.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      f.allowFullscreen = true; f.title = b.getAttribute('aria-label') || 'YouTube';
      var w = document.createElement('div'); w.className = 'yt-frame'; w.appendChild(f);
      b.replaceWith(w);
    });
  });
</script>

<style>
  .about .ph img { position: relative; width: 100%; height: 100%; object-fit: cover; }
  .hero.nophoto .wrap { grid-template-columns: minmax(0, 1fr); }
  .hero.nophoto .wrap > div { max-width: 820px; }
  .intro.solo { grid-template-columns: minmax(0, 1fr); }
  .intro.solo > div { max-width: 820px; }
  .intro-photos.n1, .intro-photos.n2 { grid-template-rows: auto; }
  .intro-photos.n1 { grid-template-columns: minmax(0, 1fr); }
  .intro-photos.n1 .ph:first-child, .intro-photos.n2 .ph:first-child { grid-row: auto; aspect-ratio: 4 / 3; }
  .ricon { aspect-ratio: 1 / 1; display: grid; place-items: center; background: linear-gradient(135deg, #eef3f1, #e1e9e6); }
  .ricon svg { width: 56px; height: 56px; fill: none; stroke: var(--accent); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .rcard.focus .ricon { background: linear-gradient(135deg, #dcf1e2, #c9e8d3); }
  .app { min-width: 0; }
  .value-list div { min-width: 0; }
  .value-list b { overflow-wrap: anywhere; hyphens: auto; font-size: clamp(17px, 4.6vw, 22px) !important; }
  .app b { min-width: 0; overflow-wrap: anywhere; hyphens: auto; }
  .about h1, .about h2, .about h3 { overflow-wrap: break-word; hyphens: auto; }
  .app svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .cta { padding-block: 56px 0; }
  .gal { padding: 0; border: 0; cursor: zoom-in; width: 100%; }
  .ph .gal-cap { position: absolute; left: 0; right: 0; bottom: 0; display: flex; justify-content: space-between; align-items: end; gap: 8px; padding: 22px 12px 10px; background: linear-gradient(transparent, rgba(0,0,0,.6)); color: #fff; font-size: 13px; text-align: left; }
  .ph .gal-cap em { font-style: normal; font: 600 12px var(--mono); background: rgba(255,255,255,.2); padding: 2px 8px; border-radius: 99px; white-space: nowrap; }
  .lb { position: fixed; inset: 0; z-index: 100; background: rgba(10,14,13,.96); display: grid; grid-template-columns: 56px minmax(0, 1fr) 56px; align-items: center; padding: 16px 8px; }
  .lb[hidden] { display: none; }
  .lb figure { margin: 0; display: grid; gap: 10px; justify-items: center; }
  .lb img { max-width: 100%; max-height: 78vh; object-fit: contain; border-radius: 8px; }
  .lb figcaption { color: #e6ecea; font-size: 14px; text-align: center; }
  .lb figcaption em { font-style: normal; color: #a9b8b4; margin-left: 6px; }
  .lb-nav { width: 44px; height: 44px; border-radius: 50%; border: 0; background: rgba(255,255,255,.14); color: #fff; font-size: 28px; line-height: 1; cursor: pointer; justify-self: center; }
  .lb-nav[hidden] { visibility: hidden; display: block; }
  .lb-x { position: absolute; top: 12px; right: 14px; width: 44px; height: 44px; border-radius: 50%; border: 0; background: rgba(255,255,255,.14); color: #fff; font-size: 26px; cursor: pointer; }
