---
// 铅酸电池柜栏目页（/batteries/battery-cabinet/）：首屏 → 电池 + 电池柜联动选型（按负载和后备时间 / 按已选电池）→ 型号卡片（按层数筛选）
// → 内部结构与接线图 → 参数对照表 → 特点 → 常见问题 → 询价。只询价，不显示价格。
// 产品来自客户档案系统：型号 C-1 … C-40（或品类名带"电池柜 / 电池箱"）。参数按型号查 cab-specs.mjs（由画册抄录）。
// 联动：选型用 vrla-engine 的 upsBackup（12V 电池放电表）挑电池，再用 cab-engine 的 cabFor 配柜子；
// 12V 电池产品页的横幅链到本页 #planner?dc=…&ah=…（打开时自动切到"按电池"并带入容量）。
import CatSearch from '../../../components/CatSearch.astro';
import { SF, csData } from '../../../lib/search-i18n.mjs';
import Base from '../../../layouts/Base.astro';
import { LANGS, SITE } from '../../../config.mjs';
import { CAB } from '../../../lib/cab-i18n.mjs';
import { CAB_LIST, cabSpec } from '../../../lib/cab-engine.mjs';
import { vrlaModule, VR_GENERIC, UPS_DC } from '../../../lib/vrla-engine.mjs';
import { isBattCab, isVrla12 } from '../../../lib/category.mjs';
import all from '../../../data/products.json';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const T = CAB[lang];
const list = all.filter(isBattCab).map((p) => ({ p, c: cabSpec(p) })).filter((x) => x.c);
const slugOf = Object.fromEntries(list.map(({ p, c }) => [c.model, p.slug]));
const imgOf = Object.fromEntries(list.map(({ p, c }) => [c.model, p.images && p.images[0] ? p.images[0].thumb || p.images[0].src : '']));
const pic = (m: string) => imgOf[m] || `/img/cab/${m.toLowerCase()}.webp`;
// 选型用的 12V 电池：已发布的 12V 铅酸产品（带放电表）；还没有时用常见规格
const batt = all.filter(isVrla12).map((p) => vrlaModule(p)).filter((m) => m.v === 12 && m.ah);
const mods = (batt.length ? batt : VR_GENERIC).map((m) => ({ model: m.model, slug: m.slug || '', v: m.v, ah: m.ah, rate: m.rate, kg: m.kg || 0, series: m.series, tables: m.tables }));
const DCS = [...UPS_DC.filter((v) => v >= 24), 480];
const cabs = CAB_LIST.map((c) => ({ ...c, slug: slugOf[c.model] || '' }));
const cfg = { lang, wa: SITE.whatsapp, mods, cabs, t: T };
const tier = (c: any) => (c.layers === 1 ? 'box' : c.layers <= 3 ? 'mid' : 'tall');
const dec = (x: number | string) => (lang === 'en' ? String(x) : String(x).replace('.', ','));
const U = T.u;
const dm = (s: string) => s.replace(/×/g, ' × ');
const wa = (msg: string) => `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(msg)}`;
const WHY_ICONS = [
  '<rect x="4" y="8" width="10" height="16" rx="1.5"/><path d="M14 16h4M18 11h8v10h-8z"/>',
  '<rect x="8" y="3" width="14" height="24" rx="1.5"/><path d="M8 11h14M8 19h14"/>',
  '<rect x="5" y="9" width="20" height="16" rx="2"/><path d="M9 9V6M21 9V6M15 13l-3 5h6l-3 5"/>',
  '<path d="M4 10l11-6 11 6-11 6zM4 10v10l11 6 11-6V10M15 16v10"/>',
];
const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: T.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
const crumbLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: T.crumbs, item: `${site}/${lang}/` },
  { '@type': 'ListItem', position: 2, name: T.title, item: `${site}/${lang}/batteries/battery-cabinet/` },
] };
const first = CAB_LIST.find((c) => c.model === 'C-16') || CAB_LIST[0];
---
<Base lang={lang} title={`${T.title} · ${SITE.name}`} description={T.metaDesc} path="batteries/battery-cabinet/">
<div class="off rbp cabp">
  <nav class="crumbs"><a href={`/${lang}/`}>{T.crumbs}</a> / {T.crumbBatt} / {T.title}</nav>

  <section class="hero" style="--bg:url(/img/cab/hero.webp)">
    <div class="hero-in">
      <div>
        <span class="eyebrow">{T.eyebrow}</span>
        <h1>{T.h1a}<em>{T.h1b}</em></h1>
        <p>{T.lead}</p>
        <div class="hero-cta">
          <a class="btn primary" href="#planner">{T.ctaPlan}</a>
          <a class="btn ghost" href="#models">{T.ctaModels}</a>
        </div>
      </div>
      <div class="hero-facts">
        <div><b class="num">{CAB_LIST.length}</b><span>{T.facts.models}</span></div>
        <div><b class="num">12–480 {U.v}</b><span>{T.facts.dc}</span></div>
        <div><b class="num">1–40</b><span>{T.facts.n}</span></div>
        <div><b class="num">≤ 120 {U.ah}</b><span>{T.facts.ah}</span></div>
      </div>
    </div>
  </section>

  <section class="block" id="planner" data-cabp>
    <script type="application/json" data-cabp-cfg set:html={JSON.stringify(cfg)} />
    <div class="head"><span class="eyebrow">{T.planEyebrow}</span><h2>{T.planH}</h2><p>{T.planP}</p></div>
    <div class="stage">
      <div class="ctl">
        <div class="chips modes"><button type="button" class="chip on" data-mode="load">{T.modeLoad}</button><button type="button" class="chip" data-mode="batt">{T.modeBatt}</button></div>
        <div class="grp">
          <div class="gh"><span class="n">1</span><b>{T.dcQ}</b></div>
          <div class="chips">{DCS.map((v) => <button type="button" class:list={['chip', { on: v === 192 }]} data-dc={v}>{v} {U.v}</button>)}</div>
          <small class="hint">{T.hintDc}</small>
        </div>
        <div class="grp" data-show="load">
          <div class="gh"><span class="n">2</span><b>{T.loadQ}</b></div>
          <label class="numin"><input type="number" min="0.1" step="0.5" value="10" inputmode="decimal" data-kw /><span>kW</span></label>
        </div>
        <div class="grp" data-show="load">
          <div class="gh"><span class="n">3</span><b>{T.minQ}</b></div>
          <div class="chips">{[10, 15, 30, 60, 120].map((m) => <button type="button" class:list={['chip', { on: m === 30 }]} data-min={m}>{m} {T.min}</button>)}</div>
        </div>
        <div class="grp" data-show="batt" hidden>
          <div class="gh"><span class="n">2</span><b>{T.ahQ}</b></div>
          <div class="chips">{[17, 24, 38, 65, 100, 120, 150, 200].map((a) => <button type="button" class:list={['chip', { on: a === 100 }]} data-ah={a}>{a} {U.ah}</button>)}</div>
        </div>
        <div class="grp" data-show="batt" hidden>
          <div class="gh"><span class="n">3</span><b>{T.strQ}</b></div>
          <div class="chips">{[1, 2, 3, 4].map((s) => <button type="button" class:list={['chip', { on: s === 1 }]} data-str={s}>{s}</button>)}</div>
        </div>
      </div>
      <div class="out">
        <div class="room" data-room></div>
        <div class="rows" data-rows></div>
        <div class="alts" data-alts></div>
        {SITE.whatsapp && <a class="btn primary" data-qsel href="#" target="_blank" rel="noopener">{T.quoteSel}</a>}
      </div>
    </div>
  </section>

  <section class="block" id="models" data-cabm>
    <div class="head"><span class="eyebrow">{T.modelsEyebrow}</span><h2>{T.modelsH}</h2></div>
      <CatSearch lang={lang} facets={[{ k: 'dcv', label: SF[lang].dcv, unit: 'V' }]} ex="192V" />
    <div class="filters">
      <div class="vtabs">
        <button type="button" class="on" data-tr="all">{T.tabAll} <small>{CAB_LIST.length}</small></button>
        {(['box', 'mid', 'tall'] as const).map((k) => <button type="button" data-tr={k}>{k === 'box' ? T.tabBox : k === 'mid' ? T.tabMid : T.tabTall} <small>{CAB_LIST.filter((c) => tier(c) === k).length}</small></button>)}
      </div>
    </div>
    <div class="grid">
      {CAB_LIST.map((c) => {
        const slug = slugOf[c.model];
        const href = slug ? `/${lang}/p/${slug}/` : '';
        return (
          <article class="pcard" data-t={tier(c)} data-cs={csData(c, { dcv: c.dcv })}>
            {href ? <a class="pimg" href={href}><img src={pic(c.model)} alt={c.model} loading="lazy" /><span class="tags"><span class="tag pb">{c.dcv} {U.v} DC</span></span></a>
              : <div class="pimg"><img src={pic(c.model)} alt={c.model} loading="lazy" /><span class="tags"><span class="tag pb">{c.dcv} {U.v} DC</span></span></div>}
            <div class="pbody">
              <h3>{href ? <a href={href}>{c.model}</a> : c.model}</h3>
              <span class="va">{T.batts.replace('{n}', c.n)}</span>
              <ul>
                <li>{T.layers} <b>{c.layers}</b></li>
                <li>{T.fits} <b>12 {U.v} ≤ {c.maxAh} {U.ah}</b></li>
                <li>{T.size} <b>{dm(c.size)}</b></li>
              </ul>
              <div class="pact">
                {href && <a class="btn sm line" href={href}>{T.details}</a>}
                <button type="button" class="btn sm line" data-see={c.model}>{T.insideEyebrow}</button>
                {SITE.whatsapp && <a class="btn sm dark" href={wa(T.qMsg.replace('{m}', c.model))} target="_blank" rel="noopener">{T.quote}</a>}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="block" id="inside" data-cabi>
    <div class="head"><span class="eyebrow">{T.insideEyebrow}</span><h2>{T.insideH}</h2><p>{T.insideP}</p></div>
    <div class="vtabs mt">{CAB_LIST.map((c) => <button type="button" class:list={{ on: c.model === first.model }} data-im={c.model} data-v={c.dcv}>{c.model}</button>)}</div>
    <div class="inside">
      <figure class="card"><figcaption>{T.stH}</figcaption><img data-st src={`/img/cab/${first.model.toLowerCase()}-st.webp`} alt="" loading="lazy" /></figure>
      <figure class="card"><figcaption data-wrh data-tpl={T.wrH}>{T.wrH.replace('{v}', first.dcv)}</figcaption><img data-wr data-lang={lang} src={`/img/cab/${first.model.toLowerCase()}-wr-${lang}.webp`} alt="" loading="lazy" /></figure>
    </div>
  </section>

  <section class="block" id="tables">
    <div class="head"><span class="eyebrow">{T.tblH}</span><h2>{T.tblH}</h2><p>{T.tblP}</p></div>
    <div class="tbl-wrap card0">
      <table>
        <thead><tr><th>{T.th.model}</th><th>{T.th.n}</th><th>{T.th.dc}</th><th>{T.th.lay}</th><th>{T.th.ah}</th><th>{T.th.size}</th><th>{T.th.pack}</th><th>{T.th.net}</th><th>{T.th.gross}</th></tr></thead>
        <tbody>
          {CAB_LIST.map((c) => (
            <tr>
              <th>{slugOf[c.model] ? <a href={`/${lang}/p/${slugOf[c.model]}/`}>{c.model}</a> : c.model}</th>
              <td class="num">{c.n}</td><td class="num">{c.dcv}</td><td class="num">{c.layers}</td><td class="num">{c.maxAh}</td>
              <td class="num">{dm(c.size)}</td><td class="num">{dm(c.pack)}</td><td class="num">{dec(c.net)}</td><td class="num">{dec(c.gross)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="block">
    <div class="head"><span class="eyebrow">{T.whyEyebrow}</span><h2>{T.whyH}</h2></div>
    <div class="feats">
      {T.why.map(([h, d], i) => <div class="card feat"><svg viewBox="0 0 30 30" aria-hidden="true" set:html={WHY_ICONS[i]} /><h3>{h}</h3><p>{d}</p></div>)}
    </div>
  </section>

  <section class="block" id="faq">
    <div class="head"><span class="eyebrow">{T.faqEyebrow}</span><h2>{T.faqH}</h2></div>
    <div class="faq">{T.faq.map(([q, a], i) => <details class="card" open={i === 0}><summary>{q}</summary><p>{a}</p></details>)}</div>
  </section>

  <section class="cta">
    <div class="cta-box">
      <div><h2>{T.ctaH}</h2><p>{T.ctaP}</p></div>
      <div class="btns">
        {SITE.whatsapp && <a class="btn dark" href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">WhatsApp {SITE.whatsappDisplay}</a>}
        {SITE.email && <a class="btn line" href={`mailto:${SITE.email}`}>{SITE.email}</a>}
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(crumbLd)} />
</div>
</Base>

<script>
  import { upsBackup } from '../../../lib/vrla-engine.mjs';
  import { cabFor } from '../../../lib/cab-engine.mjs';
  // 电池 + 电池柜联动：① 按负载：UPS 直流电压 + 负载 + 后备时间 → 12V 电池型号 × 节数 × 串数 → 柜子；② 按电池：直流电压 + 容量 + 串数 → 柜子
  const root = document.querySelector('[data-cabp]') as HTMLElement | null;
  if (root) {
    const c = JSON.parse(root.querySelector('[data-cabp-cfg]')!.textContent || '{}'), T = c.t, U = T.u;
    const $ = (s: string) => root.querySelector(s) as HTMLElement;
    const fmt = (s: string, o: any) => String(s).replace(/\{(\w+)\}/g, (_: string, k: string) => (o[k] !== undefined ? o[k] : ''));
    const dec = (x: number) => (c.lang === 'en' ? String(x) : String(x).replace('.', ','));
    const st: any = { mode: 'load', dc: 192, min: 30, ah: 100, str: 1 };
    const link = (m: string, slug: string) => (slug ? `<a href="/${c.lang}/p/${slug}/">${m}</a>` : m);
    const cabLink = (cab: any) => link(cab.model, (c.cabs.find((x: any) => x.model === cab.model) || {}).slug || '');
    // 柜子正视图：每层一排电池格，装了电池的实心，空位虚线；C-32 / C-40 前后两排，画前排 4 个
    const drawCab = (cab: any, filled: number, x: number) => {
      const W = 64, lay = cab.layers, H = 22 + lay * 22, perRow = cab.deep === 2 ? 4 : cab.per[0];
      let g = `<rect class="body" x="${x}" y="${96 - H}" width="${W}" height="${H}" rx="3"/>`;
      let k = 0;
      for (let l = 0; l < lay; l++) {
        const y = 96 - 8 - (l + 1) * 22 + 4, bw = (W - 10 - (perRow - 1) * 2) / perRow;
        for (let i = 0; i < perRow; i++) {
          const take = cab.deep === 2 ? 2 : 1, on = k < filled; k += take;
          g += `<rect class="b${on ? '' : ' e'}" x="${x + 5 + i * (bw + 2)}" y="${y}" width="${bw}" height="16" rx="1.5" style="--d:${(l * perRow + i) * 12}ms"/>`;
        }
      }
      return g + `<text x="${x + W / 2}" y="${96 - H - 6}" text-anchor="middle">${cab.model}</text>`;
    };
    const draw = (cab: any, qty: number, perString: number, n: number) => {
      const show = Math.min(qty, 6), gap = 14, W = 64;
      let svg = '';
      for (let i = 0; i < show; i++) {
        const idx = i % perString, filled = idx < perString - 1 ? cab.n : n - cab.n * (perString - 1);
        svg += drawCab(cab, filled, i * (W + gap));
      }
      const w = show * (W + gap) - gap + (qty > show ? 40 : 0);
      if (qty > show) svg += `<text class="more" x="${show * (W + gap)}" y="70">+${qty - show}</text>`;
      return `<svg viewBox="-4 -34 ${w + 8} 134" role="img">${svg}</svg>`;
    };
    const row = (a: string, v: string) => `<div><span>${a}</span><b>${v}</b></div>`;
    const q = () => $('[data-qsel]') as HTMLAnchorElement | null;
    const none = (msg: string, batt = '?', cab = '?') => {
      $('[data-room]').innerHTML = `<p class="none">${msg}</p>`; $('[data-rows]').innerHTML = ''; $('[data-alts]').innerHTML = '';
      const a = q(); if (a) a.href = `https://wa.me/${c.wa}?text=${encodeURIComponent(fmt(T.qSel, { dc: st.dc, batt, cab }))}`;
    };
    const show = (r: any, battTxt: string, battModel: string, total: number, ah: number, kgB: number, extra: string) => {
      const b = r.best, cab = b.cab;
      $('[data-room]').innerHTML = `<div class="tag">${fmt(T.cabsN, { q: b.qty, m: cabLink(cab) })}</div>${draw(cab, b.qty, b.perString, st.dc / 12)}`;
      const notes = [b.perString > 1 ? fmt(T.perStr, { k: b.perString }) : '', b.empty ? fmt(T.empty, { e: b.empty }) : ''].filter(Boolean).join(' · ');
      const kwh = Math.round(total * 12 * ah / 100) / 10;
      const kg = Math.round(b.qty * cab.net + total * kgB);
      $('[data-rows]').innerHTML = row(T.rBatt, battTxt) + row(T.rCab, `${b.qty} × ${cabLink(cab)}${notes ? `<small>${notes}</small>` : ''}`) + extra
        + row(T.rEnergy, `${dec(kwh)} ${U.kwh}`) + row(T.rSize, `${cab.size.replace(/×/g, ' × ')} ${U.mm}`) + (kgB ? row(T.rKg, `≈ ${kg} ${U.kg}`) : '');
      $('[data-alts]').innerHTML = r.alts.length ? `<span>${T.alt}</span>` + r.alts.map((o: any) => `<em>${o.qty} × ${cabLink(o.cab)}</em>`).join('') : '';
      const a = q(); if (a) a.href = `https://wa.me/${c.wa}?text=${encodeURIComponent(fmt(T.qSel, { dc: st.dc, batt: `${total} × ${battModel}`, cab: `${b.qty} × ${cab.model}` }))}`;
    };
    const run = () => {
      const n = st.dc / 12;
      if (st.mode === 'batt') {
        const r = cabFor({ n, ah: st.ah, strings: st.str });
        const m = c.mods.filter((x: any) => x.ah === st.ah).sort((a: any, b: any) => a.rate - b.rate)[0];
        const name = m ? m.model : `12 V ${st.ah} Ah`;
        if (r.none) return none(r.none === 'ah' ? T.noneAh : T.noneN, `${n * st.str} × ${name}`);
        return show(r, `${n * st.str} × ${m ? link(m.model, m.slug) : name}<small>${fmt(T.strings, { s: st.str, n })}</small>`, name, n * st.str, st.ah, m ? m.kg : 0, '');
      }
      const kw = Math.max(0, parseFloat(String(($('[data-kw]') as HTMLInputElement).value).replace(',', '.')) || 0);
      if (kw <= 0) return none('');
      const fit = c.mods.filter((m: any) => m.ah <= 120);
      const res = upsBackup({ loadW: kw * 1000, minutes: st.min, dcV: st.dc, models: fit });
      if (!res || res.none) {
        const big = upsBackup({ loadW: kw * 1000, minutes: st.min, dcV: st.dc, models: c.mods });
        return none(big && !big.none ? T.noneAh : T.noneLoad, big && big.best ? `${big.best.total} × ${big.best.mod.model}` : '?');
      }
      const o = res.best, r = cabFor({ n: o.n, ah: o.mod.ah, strings: o.strings });
      if (r.none) return none(T.noneN);
      const runTxt = `${o.runtime >= 600 ? '> 600' : o.runtime} ${T.min}${o.est ? `<small>${T.est}</small>` : ''}`;
      show(r, `${o.total} × ${link(o.mod.model, o.mod.slug)}<small>${fmt(T.strings, { s: o.strings, n: o.n })}</small>`, o.mod.model, o.total, o.mod.ah, o.mod.kg, row(T.rRun, runTxt));
    };
    const bind = (attr: string, set: (v: string) => void) => root.querySelectorAll(`[${attr}]`).forEach((x: any) => x.addEventListener('click', () => { set(x.getAttribute(attr)); root.querySelectorAll(`[${attr}]`).forEach((y: any) => y.classList.toggle('on', y === x)); run(); }));
    const setMode = (m: string) => { st.mode = m; root.querySelectorAll('[data-show]').forEach((g: any) => (g.hidden = g.dataset.show !== m)); };
    bind('data-mode', setMode);
    bind('data-dc', (v) => (st.dc = +v)); bind('data-min', (v) => (st.min = +v)); bind('data-ah', (v) => (st.ah = +v)); bind('data-str', (v) => (st.str = +v));
    $('[data-kw]').addEventListener('input', run);
    // 从 12V 电池产品页过来：?dc=192&ah=100&s=2 → 切到"按电池"
    const sp = new URLSearchParams(location.search);
    const pick = (attr: string, v: string | null) => { const b = v && root.querySelector(`[${attr}="${v}"]`) as HTMLElement | null; if (b) b.click(); };
    if (sp.get('ah')) { pick('data-mode', 'batt'); pick('data-ah', sp.get('ah')); pick('data-str', sp.get('s')); }
    pick('data-dc', sp.get('dc'));
    run();
    if (sp.get('ah') || sp.get('dc')) root.scrollIntoView();
  }
  // 型号筛选（单层 / 2–3 层 / 4–5 层）；"内部结构"按钮跳到下面的结构 + 接线图
  const box = document.querySelector('[data-cabm]') as HTMLElement | null;
  if (box) {
    box.querySelectorAll('[data-tr]').forEach((b: any) => b.addEventListener('click', () => {
      box.querySelectorAll('[data-tr]').forEach((x: any) => x.classList.toggle('on', x === b));
      box.querySelectorAll('.pcard').forEach((r: any) => (r.hidden = b.dataset.tr !== 'all' && r.dataset.t !== b.dataset.tr));
    }));
  }
  const ins = document.querySelector('[data-cabi]') as HTMLElement | null;
  if (ins) {
    const st = ins.querySelector('[data-st]') as HTMLImageElement, wr = ins.querySelector('[data-wr]') as HTMLImageElement, wh = ins.querySelector('[data-wrh]') as HTMLElement;
    const sel = (m: string) => {
      const b = ins.querySelector(`[data-im="${m}"]`) as HTMLElement | null; if (!b) return;
      ins.querySelectorAll('[data-im]').forEach((x: any) => x.classList.toggle('on', x === b));
      const k = m.toLowerCase();
      st.src = `/img/cab/${k}-st.webp`; wr.src = `/img/cab/${k}-wr-${wr.dataset.lang}.webp`; wh.textContent = wh.dataset.tpl!.replace('{v}', b.dataset.v!);
    };
    ins.querySelectorAll('[data-im]').forEach((b: any) => b.addEventListener('click', () => sel(b.dataset.im)));
    document.querySelectorAll('[data-see]').forEach((b: any) => b.addEventListener('click', () => { sel(b.dataset.see); ins.scrollIntoView({ behavior: 'smooth' }); }));
  }
</script>

