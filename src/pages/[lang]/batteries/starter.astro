---
// 启动电池栏目页（/batteries/starter/）：首屏 → 按车型三张卡片 → 尺寸匹配 + JIS 型号解读 → 型号卡片（按车型筛选）
// → 端子类型 → 外形图（逐个型号）→ 参数表 → 特点 → 常见问题 → 询价。只询价，不显示价格。
// 型号参数来自规格书（starter-specs.mjs）；客户档案系统里发布了同型号产品时，卡片 / 表格链到产品页并用产品主图。
import Base from '../../../layouts/Base.astro';
import { LANGS, SITE } from '../../../config.mjs';
import { STB, stCap, stSize } from '../../../lib/starter-i18n.mjs';
import { STARTER_LIST, STARTER_GROUPS, starterKey } from '../../../lib/starter-specs.mjs';
import { isStarter } from '../../../lib/category.mjs';
import all from '../../../data/products.json';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const T = STB[lang];
const U = T.u;
const pub = all.filter(isStarter);
const slugOf = Object.fromEntries(pub.map((p) => [starterKey(p.model), p.slug]).filter(([k]) => k));
const imgOf = Object.fromEntries(pub.map((p) => [starterKey(p.model), p.images && p.images[0] ? p.images[0].thumb || p.images[0].src : '']).filter(([k]) => k));
const pic = (m: string) => imgOf[m] || `/img/starter/${m.toLowerCase()}.webp`;
const href = (m: string) => (slugOf[m] ? `/${lang}/p/${slugOf[m]}/` : '');
const dec = (x: number | string) => (lang === 'en' ? String(x) : String(x).replace('.', ','));
const wa = (msg: string) => `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(msg)}`;
const byG = (g: string) => STARTER_LIST.filter((s) => s.g === g);
const GIMG: Record<string, string> = { car: '80d26xl', truck: 'n180', efb: 'efb-225g51r' };
const ccaMin = Math.min(...STARTER_LIST.map((s) => s.cca)), ccaMax = Math.max(...STARTER_LIST.map((s) => s.cca));
const cfg = { lang, wa: SITE.whatsapp, t: T, list: STARTER_LIST.map((s) => ({ ...s, cap: stCap(s, lang), size: stSize(s, lang), href: href(s.m) })) };
const WHY_ICONS = [
  '<rect x="5" y="9" width="20" height="16" rx="2"/><path d="M10 9V6h3v3M17 9V6h3v3M11 17h8"/>',
  '<path d="M15 3v24M6 8l18 14M24 8L6 22"/>',
  '<rect x="3" y="12" width="17" height="9" rx="1.5"/><path d="M20 15h4l3 3v3h-7M7 24a2 2 0 1 0 0 .1M22 24a2 2 0 1 0 0 .1"/>',
  '<rect x="4" y="7" width="22" height="9" rx="2"/><path d="M8 20c1.5 2 3 2 4.5 0s3-2 4.5 0 3 2 4.5 0"/>',
];
const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: T.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
const crumbLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: T.crumbs, item: `${site}/${lang}/` },
  { '@type': 'ListItem', position: 2, name: T.title, item: `${site}/${lang}/batteries/starter/` },
] };
const TERMS = ['1', '3', '4'];
---
<Base lang={lang} title={`${T.title} · ${SITE.name}`} description={T.metaDesc} path="batteries/starter/">
<div class="off rbp stp">
  <nav class="crumbs"><a href={`/${lang}/`}>{T.crumbs}</a> / {T.crumbBatt} / {T.title}</nav>

  <section class="hero" style="--bg:url(/img/starter/hero.webp)">
    <div class="hero-in">
      <div>
        <span class="eyebrow">{T.eyebrow}</span>
        <h1>{T.h1a}<em>{T.h1b}</em></h1>
        <p>{T.lead}</p>
        <div class="hero-cta">
          <a class="btn primary" href="#finder">{T.ctaFind}</a>
          <a class="btn ghost" href="#models">{T.ctaModels}</a>
        </div>
      </div>
      <div class="hero-facts">
        <div><b class="num">{STARTER_LIST.length}</b><span>{T.facts.models}</span></div>
        <div><b class="num">{ccaMin}–{ccaMax} {U.a}</b><span>{T.facts.cca}</span></div>
        <div><b class="num">JIS · DIN · N</b><span>{T.facts.sizes}</span></div>
        <div><b class="num">12 {U.v}</b><span>{T.facts.v}</span></div>
      </div>
    </div>
  </section>

  <section class="block" id="use">
    <div class="head"><span class="eyebrow">{T.useEyebrow}</span><h2>{T.useH}</h2></div>
    <div class="uses">
      {STARTER_GROUPS.map((g) => (
        <a class="use" href="#models" data-go={g}>
          <div class="ui"><img src={`/img/starter/${GIMG[g]}.webp`} alt="" loading="lazy" /></div>
          <div class="ub">
            <b>{T.use[g][0]}</b>
            <span>{T.use[g][1]}</span>
            <small>{byG(g).map((s) => s.m).join(' · ')}</small>
            <i>{T.useCta.replace('{n}', String(byG(g).length))} →</i>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="block" id="finder" data-stf>
    <script type="application/json" data-stf-cfg set:html={JSON.stringify(cfg)} />
    <div class="head"><span class="eyebrow">{T.finderEyebrow}</span><h2>{T.finderH}</h2><p>{T.finderP}</p></div>
    <div class="stage">
      <div class="ctl">
        <div class="grp">
          <div class="gh"><span class="n">1</span><b>{T.fUse}</b></div>
          <div class="chips"><button type="button" class="chip on" data-g="">{T.any}</button>{STARTER_GROUPS.map((g) => <button type="button" class="chip" data-g={g}>{T.groupName[g]}</button>)}</div>
        </div>
        <div class="grp">
          <div class="gh"><span class="n">2</span><b>{T.fL} · {T.fW} · {T.fH}</b></div>
          <div class="dims">
            <label class="numin"><input type="number" min="0" step="1" value="280" inputmode="numeric" data-d="l" aria-label={T.fL} /><span>L</span></label>
            <label class="numin"><input type="number" min="0" step="1" value="180" inputmode="numeric" data-d="w" aria-label={T.fW} /><span>W</span></label>
            <label class="numin"><input type="number" min="0" step="1" value="230" inputmode="numeric" data-d="h" aria-label={T.fH} /><span>H</span></label>
            <em>{U.mm}</em>
          </div>
        </div>
        <div class="grp">
          <div class="gh"><span class="n">3</span><b>{T.fCca}</b></div>
          <div class="chips">{[0, 300, 500, 600, 750, 900, 1000].map((a) => <button type="button" class:list={['chip', { on: a === 500 }]} data-cca={a}>{a ? `≥ ${a} ${U.a}` : T.any}</button>)}</div>
        </div>
        <div class="jis card-d">
          <b>{T.jisH}</b>
          <small>{T.jisP}</small>
          <input type="text" maxlength="12" placeholder="80D26L" data-jis aria-label={T.jisH} />
          <div class="jout" data-jout></div>
        </div>
      </div>
      <div class="out">
        <div class="rtag" data-rn></div>
        <div class="res" data-res></div>
        {SITE.whatsapp && <a class="btn primary" data-qsel href="#" target="_blank" rel="noopener">{T.quoteSel}</a>}
      </div>
    </div>
  </section>

  <section class="block" id="models" data-stm>
    <div class="head"><span class="eyebrow">{T.modelsEyebrow}</span><h2>{T.modelsH}</h2></div>
    <div class="filters">
      <div class="vtabs">
        <button type="button" class="on" data-tr="all">{T.tabAll} <small>{STARTER_LIST.length}</small></button>
        {STARTER_GROUPS.map((g) => <button type="button" data-tr={g}>{T.groupName[g]} <small>{byG(g).length}</small></button>)}
      </div>
    </div>
    <div class="grid">
      {STARTER_LIST.map((s) => {
        const h = href(s.m);
        return (
          <article class="pcard" data-t={s.g}>
            {h ? <a class="pimg" href={h}><img src={pic(s.m)} alt={`${s.m} 12V`} loading="lazy" /><span class="tags"><span class="tag pb">{T.stdName[s.std]}</span></span></a>
              : <div class="pimg"><img src={pic(s.m)} alt={`${s.m} 12V`} loading="lazy" /><span class="tags"><span class="tag pb">{T.stdName[s.std]}</span></span></div>}
            <div class="pbody">
              <h3>{h ? <a href={h}>{s.m}</a> : s.m}</h3>
              <span class="va">{s.cca} {U.a} <small>CCA</small></span>
              <ul>
                <li>{s.ah ? T.cap : T.rc} <b>{stCap(s, lang)}</b></li>
                <li>{T.size} <b>{stSize(s, lang)} {U.mm}</b></li>
                <li>{T.kg} <b>{dec(s.kg)} {U.kg}</b></li>
                <li>{T.term} <b>{T.terms[s.ter][0]}</b></li>
              </ul>
              <div class="pact">
                {h && <a class="btn sm line" href={h}>{T.details}</a>}
                <button type="button" class="btn sm line" data-see={s.m}>{T.drawing}</button>
                {SITE.whatsapp && <a class="btn sm dark" href={wa(T.qMsg.replace('{m}', s.m))} target="_blank" rel="noopener">{T.quote}</a>}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="block" id="terminals">
    <div class="head"><span class="eyebrow">{T.termEyebrow}</span><h2>{T.termH}</h2><p>{T.termP}</p></div>
    <div class="terms">
      {TERMS.map((k) => (
        <div class="card term">
          <div class="ti"><img src={`/img/starter/term-${k}.webp`} alt="" loading="lazy" /></div>
          <h3>{T.terms[k][0]} <small>({k})</small></h3>
          <p>{T.terms[k][1]}</p>
          <small class="used">{T.termUsed} {STARTER_LIST.filter((s) => s.ter === k).map((s) => s.m).join(', ')}</small>
        </div>
      ))}
    </div>
  </section>

  <section class="block" id="drawings" data-std>
    <div class="head"><span class="eyebrow">{T.dwEyebrow}</span><h2>{T.dwH}</h2><p>{T.dwP}</p></div>
    <div class="vtabs mt">{STARTER_LIST.map((s, i) => <button type="button" class:list={{ on: i === 0 }} data-im={s.m}>{s.m}</button>)}</div>
    <div class="dwrap card">
      <img data-dw src={`/img/starter/${STARTER_LIST[0].m.toLowerCase()}-dw.webp`} alt="" loading="lazy" />
      <img data-dc src="/img/starter/efb-225g51r-dc.webp" alt="" loading="lazy" hidden />
    </div>
  </section>

  <section class="block" id="tables">
    <div class="head"><span class="eyebrow">{T.tblH}</span><h2>{T.tblH}</h2><p>{T.tblP}</p></div>
    <div class="tbl-wrap card0">
      <table>
        <thead><tr><th>{T.th.model}</th><th>{T.th.use}</th><th>{T.th.std}</th><th>{T.th.cap}</th><th>{T.th.cca}</th><th>{T.th.size}</th><th>{T.th.kg}</th><th>{T.th.term}</th><th>{T.th.pol}</th><th>{T.th.fix}</th></tr></thead>
        <tbody>
          {STARTER_LIST.map((s) => (
            <tr>
              <th>{href(s.m) ? <a href={href(s.m)}>{s.m}</a> : s.m}</th>
              <td>{T.groupName[s.g]}</td><td>{T.stdName[s.std]}</td>
              <td class="num">{s.ah ? `${s.ah} ${U.ah} (20HR)` : `RC ${s.rc} ${U.min}`}</td><td class="num">{s.cca}</td>
              <td class="num">{stSize(s, lang)}</td><td class="num">{dec(s.kg)}</td><td>{T.terms[s.ter][0]} ({s.ter})</td><td class="num">{s.pol}</td><td class="num">{s.fix}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="block">
    <div class="head"><span class="eyebrow">{T.whyEyebrow}</span><h2>{T.whyH}</h2></div>
    <div class="feats">
      {T.why.map(([h, d], i) => <div class="card feat"><svg viewBox="0 0 30 30" aria-hidden="true" set:html={WHY_ICONS[i]} /><h3>{h}</h3><p>{d}</p></div>)}
    </div>
  </section>

  <section class="block" id="faq">
    <div class="head"><span class="eyebrow">{T.faqEyebrow}</span><h2>{T.faqH}</h2></div>
    <div class="faq">{T.faq.map(([q, a], i) => <details class="card" open={i === 0}><summary>{q}</summary><p>{a}</p></details>)}</div>
  </section>

  <section class="cta">
    <div class="cta-box">
      <div><h2>{T.ctaH}</h2><p>{T.ctaP}</p></div>
      <div class="btns">
        {SITE.whatsapp && <a class="btn dark" href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">WhatsApp {SITE.whatsappDisplay}</a>}
        {SITE.email && <a class="btn line" href={`mailto:${SITE.email}`}>{SITE.email}</a>}
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(crumbLd)} />
</div>
</Base>

<script>
  // 尺寸匹配：电池槽空间（长 / 宽 / 高上限）+ 最低 CCA + 车型 → 放得下的型号，空余最少的排前面
  const root = document.querySelector('[data-stf]') as HTMLElement | null;
  if (root) {
    const c = JSON.parse(root.querySelector('[data-stf-cfg]')!.textContent || '{}'), T = c.t, U = T.u;
    const $ = (s: string) => root.querySelector(s) as HTMLElement;
    const fmt = (s: string, o: any) => String(s).replace(/\{(\w+)\}/g, (_: string, k: string) => (o[k] !== undefined ? o[k] : ''));
    const num = (x: number) => (c.lang === 'en' ? String(x) : String(x).replace('.', ','));
    const st: any = { g: '', cca: 500 };
    const val = (k: string) => Math.max(0, parseFloat(String(($(`[data-d="${k}"]`) as HTMLInputElement).value).replace(',', '.')) || 0);
    const link = (s: any) => (s.href ? `<a href="${s.href}">${s.m}</a>` : s.m);
    const run = () => {
      const l = val('l'), w = val('w'), h = val('h');
      const fit = c.list.filter((s: any) => (!st.g || s.g === st.g) && s.cca >= st.cca && (!l || s.L <= l) && (!w || s.W <= w) && (!h || s.H <= h))
        .map((s: any) => ({ s, spare: (l ? l - s.L : 0) + (w ? w - s.W : 0) + (h ? h - s.H : 0) }))
        .sort((a: any, b: any) => a.spare - b.spare || a.s.cca - b.s.cca);
      $('[data-rn]').textContent = fit.length ? fmt(T.resN, { n: fit.length }) : '';
      $('[data-res]').innerHTML = fit.length ? fit.map(({ s }: any) => `<div class="r"><img src="/img/starter/${s.m.toLowerCase()}.webp" alt="" loading="lazy"><div><b>${link(s)}</b><span>${s.cca} ${U.a} CCA · ${s.cap}</span><small><bdi dir="ltr">${s.size} ${U.mm}</bdi> · ${T.groupName[s.g]}</small>${l && w && h ? `<small class="sp">${fmt(T.spare, { l: num(+(l - s.L).toFixed(1)), w: num(+(w - s.W).toFixed(1)), h: num(+(h - s.H).toFixed(1)) })}</small>` : ''}</div></div>`).join('')
        : `<p class="none">${T.none}</p>`;
      const a = root.querySelector('[data-qsel]') as HTMLAnchorElement | null;
      if (a) a.href = `https://wa.me/${c.wa}?text=${encodeURIComponent(fmt(T.qSel, { l, w, h, cca: st.cca, m: fit.slice(0, 3).map((x: any) => x.s.m).join(', ') || '?' }))}`;
    };
    const bind = (attr: string, set: (v: string) => void) => root.querySelectorAll(`[${attr}]`).forEach((x: any) => x.addEventListener('click', () => { set(x.getAttribute(attr)); root.querySelectorAll(`[${attr}]`).forEach((y: any) => y.classList.toggle('on', y === x)); run(); }));
    bind('data-g', (v) => (st.g = v)); bind('data-cca', (v) => (st.cca = +v));
    root.querySelectorAll('[data-d]').forEach((x) => x.addEventListener('input', run));
    // JIS 型号解读：80D26L → 性能 80 / 宽高组 D / 长 26 cm / L 版；同组同长度的 JIS 型号列出来
    const jin = $('[data-jis]') as HTMLInputElement, jout = $('[data-jout]');
    const jis = () => {
      const v = jin.value.trim().toUpperCase().replace(/\s+/g, '');
      if (!v) { jout.innerHTML = ''; return; }
      const m = v.match(/^(\d{2,3})([A-H])(\d{2})([A-Z]*?)([LR])?$/);
      if (!m) { jout.innerHTML = `<p class="bad">${T.jisBad}</p>`; return; }
      const same = c.list.filter((s: any) => s.std === 'JIS' && (s.m.match(/^\d{2,3}([A-H])(\d{2})/) || []).slice(1).join('') === m[2] + m[3]);
      const row = (k: string, x: string) => `<div><span>${k}</span><b>${x}</b></div>`;
      jout.innerHTML = row(T.jisPerf, m[1]) + row(T.jisGrp, m[2]) + row(T.jisLen, `≈ ${m[3]} cm`) + (m[5] ? row(T.jisPol, fmt(T.jisPolV, { x: m[5] })) : '')
        + `<p>${same.length ? `${T.jisMatch} ${same.map(link).join(', ')}` : T.jisNo}</p>`;
    };
    jin.addEventListener('input', jis);
    run();
  }
  // 车型卡片 / 筛选按钮；"外形图"按钮跳到下面的图纸
  const box = document.querySelector('[data-stm]') as HTMLElement | null;
  const filt = (g: string) => {
    if (!box) return;
    box.querySelectorAll('[data-tr]').forEach((x: any) => x.classList.toggle('on', x.dataset.tr === g));
    box.querySelectorAll('.pcard').forEach((r: any) => (r.hidden = g !== 'all' && r.dataset.t !== g));
  };
  box?.querySelectorAll('[data-tr]').forEach((b: any) => b.addEventListener('click', () => filt(b.dataset.tr)));
  document.querySelectorAll('[data-go]').forEach((a: any) => a.addEventListener('click', () => filt(a.dataset.go)));
  const dw = document.querySelector('[data-std]') as HTMLElement | null;
  if (dw) {
    const img = dw.querySelector('[data-dw]') as HTMLImageElement, dc = dw.querySelector('[data-dc]') as HTMLImageElement;
    const sel = (m: string) => {
      const b = dw.querySelector(`[data-im="${m}"]`) as HTMLElement | null; if (!b) return;
      dw.querySelectorAll('[data-im]').forEach((x: any) => x.classList.toggle('on', x === b));
      img.src = `/img/starter/${m.toLowerCase()}-dw.webp`; img.alt = m; dc.hidden = m !== 'EFB-225G51R';
    };
    dw.querySelectorAll('[data-im]').forEach((b: any) => b.addEventListener('click', () => sel(b.dataset.im)));
    document.querySelectorAll('[data-see]').forEach((b: any) => b.addEventListener('click', () => { sel(b.dataset.see); dw.scrollIntoView({ behavior: 'smooth' }); }));
  }
</script>

<style>
  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: 0 18px; border-radius: 8px; font-weight: 600; text-decoration: none; border: 1px solid transparent; cursor: pointer; font-family: var(--body); font-size: 15px; }
  .btn.primary { background: var(--charge); color: var(--ink); }
  .btn.ghost { color: #fff; border-color: #4b5f5b; background: transparent; }
  .btn.dark { background: var(--accent); color: #fff; }
  .btn.line { background: var(--surface); color: var(--ink); border-color: var(--line); }
  .btn.sm { min-height: 38px; padding: 0 12px; font-size: 14px; }
  .crumbs { font-size: 13px; color: var(--muted); margin: 18px 0 0; }
  .crumbs a { color: var(--muted); }
  .rbp :global(.head) { display: grid; gap: 10px; margin-bottom: 22px; max-width: 760px; }
  .rbp :global(.head h2) { font-size: clamp(28px, 4.2vw, 42px); }
  .rbp :global(.head p) { margin: 0; color: var(--muted); }
  .rbp :global(section.block) { padding-block: 56px 0; }
  .rbp :global(.eyebrow) { font: 600 13px var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--charge); }
  :global(html[dir='rtl']) .rbp :global(.eyebrow) { letter-spacing: 0; font-family: inherit; }

  .hero { color: #fff; position: relative; overflow: hidden; margin-top: 14px; border-radius: 16px; background: linear-gradient(90deg, rgba(10,20,34,.92) 0%, rgba(10,20,34,.7) 45%, rgba(10,20,34,0) 75%), var(--bg) center right / cover, #0f1a2a; }
  :global(html[dir='rtl']) .hero { background: linear-gradient(270deg, rgba(10,20,34,.94) 0%, rgba(10,20,34,.85) 55%, rgba(10,20,34,.4) 100%), var(--bg) center right / cover, #0f1a2a; }
  .hero-in { position: relative; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); gap: 28px; padding: 56px 40px; align-items: end; }
  @media (max-width: 860px) { .hero-in { grid-template-columns: minmax(0, 1fr); padding: 28px 20px; } .hero { background: linear-gradient(180deg, rgba(10,20,34,.9), rgba(10,20,34,.75)), var(--bg) center right / cover, #0f1a2a; } }
  .hero h1 { font-size: clamp(34px, 5.4vw, 60px); margin: 10px 0 14px; }
  .hero h1 em { font-style: normal; color: #ffb547; }
  .hero p { margin: 0; color: #cfd8e3; font-size: 17px; max-width: 600px; }
  .hero-cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 22px; }
