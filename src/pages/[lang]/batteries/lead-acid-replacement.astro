---
// 锂电替换铅酸电池栏目页（/batteries/lead-acid-replacement/）：替换查找器（换一块电池 / 组一个电池组）→ 型号表（按 12 / 24 / 48 V 页签筛选）
// → 卖点 → LiFePO4 vs 铅酸 → 应用 → 常见问题（FAQ 结构化数据）→ 询价。只询价，不显示价格。
// 产品来自客户档案系统，细分品类 = 锂电替换铅酸电池（型号如 LFP-12V7AH）。
import Base from '../../../layouts/Base.astro';
import PbrVisual from '../../../components/PbrVisual.astro';
import { LANGS, SITE } from '../../../config.mjs';
import { PB } from '../../../lib/pbr-i18n.mjs';
import { classOf } from '../../../lib/pbr-engine.mjs';
import { isPbReplace, pbModule, seriesName } from '../../../lib/category.mjs';
import all from '../../../data/products.json';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const T = PB[lang];
const list = all.filter(isPbReplace).map((p) => ({ p, b: pbModule(p), s: seriesName(p) })).sort((a, b) => a.b.v - b.b.v || a.b.ah - b.b.ah || a.s.localeCompare(b.s));
const CLS = [12, 24, 48].filter((c) => list.some((x) => classOf(x.b.v) === c));
const vsx = [...new Set(list.map((x) => x.b.v).filter(Boolean))].sort((a, b) => a - b);
const vTxt = vsx.length ? vsx.map((v) => `${v}`).join(' / ') + ' V' : '12.8 / 25.6 / 51.2 V';
const ahs = list.map((x) => x.b.ah).filter(Boolean);
const ahTxt = ahs.length ? `${Math.min(...ahs)}–${Math.max(...ahs)} Ah` : '4–200 Ah';
const wa = (msg: string) => `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(msg)}`;
const qMsg = { en: 'Hello, I would like a quote for the {m}:', es: 'Hola, quisiera una cotización del {m}:', ru: 'Здравствуйте, прошу цену на {m}:' }[lang];
const APP_ICONS = [
  '<rect x="8" y="3" width="14" height="24" rx="2"/><path d="M15 8l-3 6h6l-3 6"/>',
  '<path d="M3 24l5-12h14l5 12zM10 12l-2 12M20 12l2 12M5 18h20"/><circle cx="24" cy="5" r="2.5"/>',
  '<path d="M3 20h20l4-5H8L5 9H3zM8 24h.01M20 24h.01"/>',
  '<path d="M15 3l10 4v7c0 6-4 10-10 13C9 24 5 20 5 14V7z"/>',
  '<path d="M15 26V12M9 26h12M7 9a11 11 0 0 1 16 0M10 12a6 6 0 0 1 10 0"/>',
  '<path d="M6 24l12-12M16 6l8 8-4 4-8-8zM4 26l4-4"/>',
];
const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: T.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
const crumbLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: T.crumbs, item: `${site}/${lang}/` },
  { '@type': 'ListItem', position: 2, name: T.title, item: `${site}/${lang}/batteries/lead-acid-replacement/` },
] };
---
<Base lang={lang} title={`${T.title} · ${SITE.name}`} description={T.metaDesc} path="batteries/lead-acid-replacement/">
<div class="off rbp pbp">
  <nav class="crumbs"><a href={`/${lang}/`}>{T.crumbs}</a> / {T.crumbBatt} / {T.title}</nav>

  <section class="hero">
    <div class="hero-in">
      <div>
        <span class="eyebrow">{T.eyebrow}</span>
        <h1>{T.h1a}<em>{T.h1b}</em></h1>
        <p>{T.lead}</p>
        <div class="hero-cta">
          <a class="btn primary" href="#builder">{T.ctaFinder}</a>
          {list.length > 0 && <a class="btn ghost" href="#models">{T.ctaModels}</a>}
        </div>
      </div>
      <div class="hero-facts">
        <div><b class="num">{vTxt}</b><span>{T.facts.v}</span></div>
        <div><b class="num">{ahTxt}</b><span>{T.facts.ah}</span></div>
        <div><b class="num">{list.length || 24}</b><span>{T.facts.models}</span></div>
        <div><b class="num">≈ 90%</b><span>{T.facts.use}</span></div>
      </div>
    </div>
  </section>

  <PbrVisual lang={lang} />

  {list.length > 0 && (
    <section class="block" id="models" data-pbm>
      <div class="head"><span class="eyebrow">{T.modelsEyebrow}</span><h2>{T.modelsH}</h2></div>
      <div class="vtabs" role="tablist">
        <button type="button" class="on" data-vt="all">{T.tabAll} <small>{list.length}</small></button>
        {CLS.map((c) => <button type="button" data-vt={c}>{c} V <small>{list.filter((x) => classOf(x.b.v) === c).length}</small></button>)}
      </div>
      <div class="tbl-wrap"><table class="mt">
        <thead><tr><th>{T.th.model}</th><th>{T.th.v}</th><th>{T.th.ah}</th><th>{T.th.wh}</th><th>{T.th.a}</th><th>{T.th.dims}</th><th>{T.th.kg}</th><th></th></tr></thead>
        <tbody>
          {list.map(({ p, b }) => (
            <tr data-c={classOf(b.v)}>
              <th><a href={`/${lang}/p/${p.slug}/`}>{p.model}</a></th>
              <td class="num">{b.v} V</td><td class="num">{b.ah} Ah</td><td class="num">{b.wh} Wh</td>
              <td class="num">{b.maxA ? `${b.maxA} A` : '—'}</td><td class="num">{b.dims.length ? b.dims.join(' × ') : '—'}</td><td class="num">{b.kg ? `${b.kg} kg` : '—'}</td>
              <td>{SITE.whatsapp && <a class="btn sm dark" href={wa(qMsg.replace('{m}', p.model))} target="_blank" rel="noopener">{T.quote}</a>}</td>
            </tr>
          ))}
        </tbody>
      </table></div>
    </section>
  )}

  <section class="block">
    <div class="head"><span class="eyebrow">{T.featEyebrow}</span><h2>{T.featH}</h2></div>
    <div class="feats">{T.feats.map(([a, b], i) => <div class="card feat"><span class="fi num">0{i + 1}</span><h3>{a}</h3><p>{b}</p></div>)}</div>
  </section>

  <section class="block">
    <div class="head"><span class="eyebrow">{T.vsEyebrow}</span><h2>{T.vsH}</h2></div>
    <div class="vs">
      {(['li', 'pb'] as const).map((k) => (
        <div class:list={['card', { hi: k === 'li' }]}>
          <span class:list={['tag', k === 'li' ? 'k' : 'pb']}>{T.vs[k].tag}</span>
          <h3>{T.vs[k].h}</h3>
          <ul>{T.vs[k].rows.map(([a, b]) => <li><span>{a}</span><b>{b}</b></li>)}</ul>
          <p class="best">{T.vs[k].best}</p>
        </div>
      ))}
    </div>
    <p class="see"><a href={`/${lang}/batteries/rack-lithium/`}>{T.seeRack}</a><a href={`/${lang}/batteries/wall-lithium/`}>{T.seeWall}</a><a href={`/${lang}/batteries/hv-cabinet/`}>{T.seeHv}</a></p>
  </section>

  <section class="block">
    <div class="head"><span class="eyebrow">{T.appsEyebrow}</span><h2>{T.appsH}</h2></div>
    <div class="apps">{T.apps.map((a, i) => <div class="app"><svg viewBox="0 0 30 30" aria-hidden="true" set:html={APP_ICONS[i]} /><span>{a}</span></div>)}</div>
  </section>

  <section class="block" id="faq">
    <div class="head"><span class="eyebrow">{T.faqEyebrow}</span><h2>{T.faqH}</h2></div>
    <div class="faq">{T.faq.map(([q, a], i) => <details class="card" open={i === 0}><summary>{q}</summary><p>{a}</p></details>)}</div>
  </section>

  <section class="block">
    <div class="head"><span class="eyebrow">{T.projEyebrow}</span><h2>{T.projH}</h2></div>
    <div class="oem">
      <div class="oem-list">{T.proj.map(([a, b]) => <div><b>{a}</b><span>{b}</span></div>)}</div>
      <div class="oem-cta">
        <h3>{T.projCtaH}</h3>
        <p>{T.projCtaP}</p>
        {SITE.whatsapp && <div><a class="btn primary" href={wa(T.projMsg)} target="_blank" rel="noopener">{T.projCta}</a></div>}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="cta-box">
      <div><h2>{T.ctaH}</h2><p>{T.ctaP}</p></div>
      <div class="btns">
        {SITE.whatsapp && <a class="btn dark" href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">WhatsApp {SITE.whatsappDisplay}</a>}
        {SITE.email && <a class="btn line" href={`mailto:${SITE.email}`}>{SITE.email}</a>}
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(crumbLd)} />
</div>
</Base>

<script>
  // 型号表按电压页签筛选
  const box = document.querySelector('[data-pbm]');
  if (box) box.querySelectorAll('[data-vt]').forEach((b) => b.addEventListener('click', () => {
    const v = (b as HTMLElement).dataset.vt;
    box.querySelectorAll('[data-vt]').forEach((x) => x.classList.toggle('on', x === b));
    box.querySelectorAll('tr[data-c]').forEach((r) => ((r as HTMLElement).hidden = v !== 'all' && (r as HTMLElement).dataset.c !== v));
  }));
</script>

<style>
  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: 0 18px; border-radius: 8px; font-weight: 600; text-decoration: none; border: 1px solid transparent; cursor: pointer; font-family: var(--body); font-size: 15px; }
  .btn.primary { background: var(--charge); color: var(--ink); }
  .btn.ghost { color: #fff; border-color: #4b5f5b; background: transparent; }
  .btn.dark { background: var(--accent); color: #fff; }
  .btn.line { background: var(--surface); color: var(--ink); border-color: var(--line); }
  .btn.sm { min-height: 38px; padding: 0 14px; font-size: 14px; }
  .crumbs { font-size: 13px; color: var(--muted); margin: 18px 0 0; }
  .crumbs a { color: var(--muted); }
  .rbp :global(.head) { display: grid; gap: 10px; margin-bottom: 22px; max-width: 760px; }
  .rbp :global(.head h2) { font-size: clamp(28px, 4.2vw, 42px); }
  .rbp :global(.head p) { margin: 0; color: var(--muted); }
  .rbp :global(section.block) { padding-block: 56px 0; }
  .rbp :global(.eyebrow) { font: 600 13px var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--charge); }

  .hero { background: var(--ink); color: #fff; position: relative; overflow: hidden; margin-top: 14px; border-radius: 16px; }
  .hero::after { content: ""; position: absolute; inset: 0; background: repeating-linear-gradient(90deg, rgba(255,255,255,.035) 0 1px, transparent 1px 64px), repeating-linear-gradient(0deg, rgba(255,255,255,.035) 0 1px, transparent 1px 64px); pointer-events: none; }
  .hero::before { content: ""; position: absolute; right: -80px; top: -80px; width: 420px; height: 420px; border-radius: 50%; background: radial-gradient(closest-side, rgba(94,240,160,.22), transparent); pointer-events: none; }
  .hero-in { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: 28px; padding: 44px 40px; align-items: center; }
  @media (max-width: 860px) { .hero-in { grid-template-columns: minmax(0, 1fr); padding: 28px 20px; } }
  .hero h1 { font-size: clamp(36px, 5.6vw, 62px); margin: 10px 0 14px; }
  .hero h1 em { font-style: normal; color: #5ef0a0; }
  .hero p { margin: 0; color: #c9d4d1; font-size: 17px; max-width: 580px; }
  .hero-cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 22px; }
  .hero-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .hero-facts div { border: 1px solid #33443f; border-radius: 12px; padding: 14px; }
  .hero-facts b { display: block; font: 700 24px/1.1 var(--display); color: #5ef0a0; }
  .hero-facts span { font-size: 13px; color: #a9b8b4; }

  .card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 20px; }
  .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 460px) { .grid { grid-template-columns: minmax(0, 1fr); } }
  .pcard { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; display: grid; grid-template-rows: auto 1fr; }
  .pimg { aspect-ratio: 1 / 1; overflow: hidden; background: #fff; display: grid; place-items: center; position: relative; border-bottom: 1px solid var(--line); }
  .pimg img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 4%; box-sizing: border-box; }
  .pimg :global(svg) { width: 78%; }
  .pimg .tags { position: absolute; left: 10px; top: 10px; display: flex; gap: 6px; }
  .tag { font: 600 11px var(--mono); text-transform: uppercase; letter-spacing: .05em; padding: 3px 8px; border-radius: 99px; background: var(--charge-soft); color: #7a5a00; }
  .tag.k { background: var(--ok-soft); color: var(--ok); }
  .tag.pb { background: #ece7df; color: #5b4636; }
  .tag.u { background: var(--ink); color: #fff; }
  .pbody { padding: 14px 16px 16px; display: grid; gap: 8px; align-content: start; }
  .pbody h3 { font-size: 24px; }
  .pbody h3 a { color: inherit; text-decoration: none; }
  .pbody .va { font: 600 15px var(--mono); }
  .pbody ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 3px; font-size: 13px; color: var(--muted); }
  .pbody ul b { color: var(--ink); font-weight: 500; }
  .pact { display: flex; gap: 8px; margin-top: 4px; }
  .pact .btn { flex: 1; }

  .feats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  @media (max-width: 1000px) { .feats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .feats { grid-template-columns: minmax(0, 1fr); } }
  .feat { display: grid; gap: 8px; align-content: start; }
  .feat .fi { font: 700 14px var(--mono); color: var(--ok); }
  .feat h3 { font-size: 22px; }
  .feat p { margin: 0; font-size: 14px; color: var(--muted); }

  .vs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  @media (max-width: 760px) { .vs { grid-template-columns: minmax(0, 1fr); } }
  .vs .card h3 { font-size: 26px; margin: 6px 0 8px; }
  .vs .card.hi { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .vs ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; font-size: 14px; }
  .vs li { display: grid; grid-template-columns: 130px minmax(0, 1fr); gap: 10px; border-top: 1px dashed var(--line); padding-top: 8px; }
  .vs li span { color: var(--muted); }
  .vs li b { font-weight: 500; }
  .vs .best { font-size: 13px; color: var(--accent); font-weight: 600; margin: 10px 0 0; }
  .see { margin: 14px 0 0; font-size: 14px; font-weight: 600; display: flex; gap: 8px 22px; flex-wrap: wrap; }

  .tbl-wrap { overflow-x: auto; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; }
  table { border-collapse: collapse; width: 100%; min-width: 640px; font-size: 14px; }
  th, td { text-align: left; padding: 10px 14px; border-top: 1px solid var(--line); }
  thead th { border-top: 0; font: 600 12px var(--mono); text-transform: uppercase; color: var(--muted); background: var(--bg); }
  tbody th { font-weight: 600; white-space: nowrap; }
  td.num { font-family: var(--mono); }
  .tbl-wrap a { color: var(--ink); }

  .apps { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; }
  @media (max-width: 860px) { .apps { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 460px) { .apps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .app { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 14px; display: grid; gap: 8px; justify-items: start; font-size: 14px; }
  .app svg { width: 30px; height: 30px; color: var(--accent); fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  .faq { display: grid; gap: 10px; max-width: 860px; }
  .faq details { padding: 16px 20px; }
  .faq summary { cursor: pointer; font-weight: 700; font-size: 16px; }
  .faq p { margin: 10px 0 0; color: var(--muted); font-size: 15px; }

  .oem { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; align-items: stretch; }
  @media (max-width: 860px) { .oem { grid-template-columns: minmax(0, 1fr); } }
  .oem-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .oem-list div { border: 1px solid var(--line); border-radius: 10px; padding: 12px; background: var(--surface); }
  .oem-list b { display: block; font-size: 15px; }
  .oem-list span { font-size: 13px; color: var(--muted); }
  .oem-cta { background: var(--ink); color: #fff; border-radius: 12px; padding: 24px; display: grid; gap: 12px; align-content: center; }
  .oem-cta h3 { font-size: 30px; }
  .oem-cta p { margin: 0; color: #c9d4d1; }

  .cta { padding-block: 56px; }
  .cta-box { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 28px; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 18px; align-items: center; }
  @media (max-width: 760px) { .cta-box { grid-template-columns: minmax(0, 1fr); padding: 20px; } }
  .cta-box h2 { font-size: clamp(26px, 3.6vw, 38px); }
  .cta-box p { margin: 6px 0 0; color: var(--muted); }
  .cta-box .btns { display: flex; gap: 10px; flex-wrap: wrap; }
  .vtabs { display: flex; gap: 6px; flex-wrap: wrap; margin: 0 0 12px; }
  .vtabs button { padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface, #fff); color: var(--ink); font: 600 13.5px var(--body); cursor: pointer; }
  .vtabs button small { font: 600 11px var(--mono); color: var(--muted); margin-left: 4px; }
  .vtabs button.on { background: #0f2a25; color: #fff; border-color: #0f2a25; } .vtabs button.on small { color: #5ef0a0; }
  .mt th a { color: inherit; } .mt td .btn { white-space: nowrap; }
  .tag.pb { background: #e5e7eb; color: #1f2937; }
</style>
