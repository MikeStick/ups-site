---
import Base from '../../../layouts/Base.astro';
import Gallery from '../../../components/Gallery.astro';
import OrderConsole from '../../../components/OrderConsole.astro';
import RuntimeCalc from '../../../components/RuntimeCalc.astro';
import { LANGS, SITE } from '../../../config.mjs';
import { UI, term, specRows, tiersOf } from '../../../i18n.mjs';
import { CT } from '../../../lib/custom-i18n.mjs';
import QuoteConsole from '../../../components/QuoteConsole.astro';
import SeriesHtml from '../../../components/SeriesHtml.astro';
import { tplHtmlBlocks } from '../../../lib/tpl-html.mjs';
import PackingList from '../../../components/PackingList.astro';
import { isOffline, isRack, isModular, primary, moduleOf, isLongRun, rackKind, rackUnits, capacityOf, fmtCap, seriesOf } from '../../../lib/category.mjs';
import { RT, RACK_SPEC_FIELDS } from '../../../lib/rack-i18n.mjs';
import { MT, MOD_SPEC_FIELDS } from '../../../lib/modular-i18n.mjs';
import { OT, SPEC_FIELDS, specValue } from '../../../lib/offline-i18n.mjs';
import { socketsText } from '../../../lib/sockets.mjs';
import products from '../../../data/products.json';

export function getStaticPaths() {
  return LANGS.flatMap((lang) => products.map((p) => ({ params: { lang, slug: p.slug }, props: { p } })));
}

const { lang } = Astro.params;
const { p } = Astro.props;
const t = UI[lang];
// 离线式 / 在线互动式 UPS：询价面板 + 专用参数表；其余（Mini UPS）走原来的下单面板
// 机架式 UPS 也走询价面板（选输出电压，不选插座）+ 机架式专用参数表
const P0 = primary(p); // 产品页按主品类决定参数表和询价面板（同时属于的其他品类只影响出现在哪些栏目）
const rack = isRack(P0);
// 模块化 UPS：询价面板（三相电压）+ 模块化专用参数表，横幅换成"系统配置器"
const modular = isModular(P0);
const M = MT[lang];
const mod = modular ? moduleOf(p) : null;
const offline = isOffline(P0) || rack || modular;
const R = RT[lang];
const U = rack ? rackUnits(p) : 0;
const O = OT[lang];
// 同系列：只取当前产品详情 HTML 表格里列出的型号（表格里有当前型号的那张），按表格顺序；
// 模板里没有这样的表格时才退回按型号前缀自动归组
const nmModel = (x) => String(x || '').toUpperCase().replace('MIMI', 'MINI').replace(/[^A-Z0-9/.]/g, ''); // 去掉空格、横线、不可见字符
function tableSeries() {
  const byKey = new Map(products.map((x) => [nmModel(x.model), x]));
  const me = nmModel(p.model);
  const lists = [];
  for (const tp of Array.isArray(p.templateHtml) ? p.templateHtml : []) {
    const h = tp.html && (tp.html[lang] || tp.html.en);
    for (const b of tplHtmlBlocks(h || '')) {
      if (b.t === 'table' && Array.isArray(b.models)) lists.push(b.models);
      // 第一行不是 <th> 的表格会被当成普通表格（grid）：型号通常在第一行，取第一行；第一行没有就取全部单元格
      else if (b.t === 'grid' && Array.isArray(b.rows) && b.rows.length) lists.push(b.rows[0].map((c) => c.text), b.rows.flat().map((c) => c.text));
    }
  }
  // 详情图片里的原样 HTML 片段：表格可能是 <table>，也可能是 div 拼的网格，所以直接从文字里找型号（如 RM 20/10X-P）
  for (const x of Array.isArray(p.templateDetail) ? p.templateDetail : []) {
    const h = x && x.html ? (typeof x.html === 'string' ? x.html : (x.html[lang] || x.html.en || '')) : '';
    if (!h) continue;
    const text = h.replace(/<(style|script)[\s\S]*?<\/\1>/gi, ' ').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ');
    const found = text.match(/\b[A-Z]{2,5}\s?-?\d+(?:[\/.]\d+)?[A-Z0-9]*(?:-[A-Za-z]{1,6})?/g);
    if (found && found.length) lists.push(found);
  }
  // 表格里的型号可能少写了后缀（例如表里写 RM 20/10X-P，产品是 RM 20/10X-PI）：
  // 先精确匹配；否则找出当前型号对应的那一列（表里写法是当前型号的前缀），把同样缺的后缀补到其它列上再匹配
  const cands = [];
  for (const l of lists) {
    const ks = l.map(nmModel).filter(Boolean);
    let sfx = null;
    if (ks.includes(me)) sfx = '';
    else {
      const hit = ks.filter((k) => k.length >= 4 && me.startsWith(k) && me.length - k.length <= 3).sort((a, b) => b.length - a.length)[0];
      if (hit) sfx = me.slice(hit.length);
    }
    if (sfx === null) continue;
    const out = [];
    for (const k of ks) { const x = byKey.get(k + sfx); if (x && !out.includes(x)) out.push(x); }
    if (out.some((x) => x.slug === p.slug) && out.length >= 2) cands.push(out);
  }
  // 当前型号出现在好几张表里（比如一张全系列总表 + 一张同机柜参数表）：取最小的那张，也就是最贴近当前型号的那组
  if (cands.length) return cands.sort((a, b) => a.length - b.length)[0];
  // 有详情表格但表格里找不到当前型号：不显示同系列（不再退回自动归组，避免混进别的机柜型号）
  return lists.length ? [] : null;
}
const tSeries = tableSeries();
const series = tSeries ? (tSeries.length >= 2 ? tSeries : []) : seriesOf(p, products);
const seriesLabel = { en: 'Same series', es: 'Misma serie', ru: 'Та же серия' }[lang];
const rows = modular
  ? [[M.spec.model, p.model], ...MOD_SPEC_FIELDS.map((f) => [M.spec[f], (f === 'outputPower' && !specValue(p, f, lang) ? fmtCap(capacityOf(p)) : specValue(p, f, lang)).replace(/\*/g, ' × ')]).filter(([, v]) => v)]
  : rack
  ? [[R.spec.model, p.model], [R.spec.variant, rackKind(p) === 'li' ? (isLongRun(p) ? `${R.li} · ${R.lr}` : R.li) : isLongRun(p) ? R.lr : R.std], ...(U ? [[R.spec.rackU, `${U}U`]] : []),
     ...RACK_SPEC_FIELDS.map((f) => [R.spec[f], (f === 'outputPower' && !specValue(p, f, lang) ? fmtCap(capacityOf(p)) : specValue(p, f, lang)).replace(/\*/g, ' × ')]).filter(([, v]) => v)]
  : offline
  ? [[O.spec.model, p.model], ...SPEC_FIELDS.map((f) => [O.spec[f], specValue(p, f, lang).replace(/\*/g, ' × ')]).filter(([, v]) => v),
     ...(socketsText(p.sockets) ? [[O.spec.sockets, socketsText(p.sockets)]] : [])]
  : specRows(p, lang);
const tiers = tiersOf(p);
// 产品自己的详情图在前，引用的详情模板图片（工厂、认证、包装等）接在后面，无缝拼成一整列
// 模板里有 HTML 片段时按 templateDetail 的顺序（图片和 HTML 穿插），否则沿用 templateImages
const tplSeq = Array.isArray(p.templateDetail) && p.templateDetail.length
  ? p.templateDetail.map((x) => (x.img ? { im: x.img } : { html: (x.html && (x.html[lang] || x.html.en)) || '' })).filter((x) => x.im || x.html)
  : (Array.isArray(p.templateImages) ? p.templateImages : []).map((im) => ({ im }));
const detailAll = [...(Array.isArray(p.detailImages) ? p.detailImages : []).map((im) => ({ im })), ...tplSeq];
// HTML 片段放进隔离的 iframe（sandbox 只允许脚本、不同源）：保留原来的排版样式，又碰不到网站本身；高度由片段里注入的小脚本报给父页面
const HH_SCRIPT = '<script>(function(){function s(){try{parent.postMessage({skeHtmlH:Math.ceil(document.documentElement.getBoundingClientRect().height)},"*")}catch(e){}}addEventListener("load",s);if(window.ResizeObserver)new ResizeObserver(s).observe(document.documentElement);setTimeout(s,300);setTimeout(s,1500);})()</' + 'script>';
const htmlDoc = (h) => {
  const base = '<base target="_blank">';
  if (/<html[\s>]/i.test(h)) {
    let d = /<head[^>]*>/i.test(h) ? h.replace(/<head[^>]*>/i, (m) => m + base) : h.replace(/<html[^>]*>/i, (m) => m + '<head>' + base + '</head>');
    return /<\/body>/i.test(d) ? d.replace(/<\/body>/i, HH_SCRIPT + '</body>') : d + HH_SCRIPT;
  }
  return '<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">' + base +
    '<style>html,body{margin:0;padding:0}body{font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:#15211f}img{max-width:100%;height:auto}</style></head><body>' + h + HH_SCRIPT + '</body></html>';
};
const group = p.sale && p.sale.mode === 'group';
const stock = p.sale && !group ? Number(p.sale.stock) || 0 : 0;
const desc = (p.description && (p.description[lang] || p.description.en)) || '';
// 卖点：优先用接口给的当前语言译文，没有就退回英文
const features = ((p.sellingPointsI18n && (p.sellingPointsI18n[lang] || p.sellingPointsI18n.en)) ||
  (p.sellingPoints || '').split('\n')).map((s) => String(s).trim()).filter((s) => s && !/[\u4e00-\u9fff]/.test(s));
const typeName = term(p.type, lang);
// 型号下方的关键参数：没写介绍时右侧也有内容，客户一眼看到功率/电池/输出口
const portTypes = (Array.isArray(p.outputPorts) ? p.outputPorts : []).map((o) => o.type).filter(Boolean);
const cap = capacityOf(p);
const highlights = modular ? [
  fmtCap(cap) || specValue(p, 'outputPower', lang),
  mod.va ? `${mod.n ? mod.n + ' × ' : ''}${+(mod.va / 1000).toFixed(1)} kVA` : '',
  specValue(p, 'phase', lang), 'N+X · Hot-swap',
].filter(Boolean) : rack ? [
  fmtCap(cap) || specValue(p, 'outputPower', lang),
  U ? `${U}U` : '', `${R.spec.transferTimeAcToBattery.split(' (')[0]} ${specValue(p, 'transferTimeAcToBattery', lang) || '0 ms'}`,
  isLongRun(p) ? R.extBatt : rackKind(p) === 'li' ? R.li : R.std,
].filter(Boolean) : offline ? [
  fmtCap(cap) || specValue(p, 'outputPower', lang),
  specValue(p, 'transferTime', lang), specValue(p, 'waveform', lang),
].filter(Boolean) : [
  p.outputPower,
  p.batterySpec && String(p.batterySpec).replace(/\*/g, '×'),
  portTypes.length && portTypes.join(' / '),
].filter((x) => x && !/[\u4e00-\u9fff]/.test(x));
const title = `${p.model}${typeName ? ' ' + typeName : ''} · ${SITE.name}`;
const wa = SITE.whatsapp ? `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(t.quoteMsg(p.model))}` : '';
const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Product', name: p.model, brand: p.brand ? { '@type': 'Brand', name: p.brand } : undefined,
  description: desc || undefined, image: (p.images || []).map((im) => site + im.src),
  offers: !offline && tiers.length ? { '@type': 'AggregateOffer', priceCurrency: 'USD', lowPrice: tiers[tiers.length - 1].price, highPrice: tiers[0].price } : undefined,
};
---
<Base lang={lang} title={title} description={desc.slice(0, 155)} path={`p/${p.slug}/`}>
  <nav class="crumbs">{modular ? <a href={`/${lang}/modular-ups/`}>{M.title}</a> : rack ? <a href={`/${lang}/rack-ups/`}>{R.title}</a> : offline ? <a href={`/${lang}/offline-ups/`}>{O.title}</a> : <a href={`/${lang}/`}>{t.allProducts}</a>} / <span>{p.model}</span></nav>

  <div class="layout">
    <div class="gallery-col"><Gallery images={p.images} youtube={p.youtube} alt={p.model} lang={lang} /></div>

    <section class="summary">
      {typeName && <span class="type">{typeName}</span>}
      <h1>{p.model}</h1>
      {series.length > 0 && (
        <nav class="series" aria-label={seriesLabel}>
          <span>{seriesLabel}</span>
          {series.map((s) => s.slug === p.slug
            ? <b aria-current="page">{s.model}</b>
            : <a href={`/${lang}/p/${s.slug}/`}>{s.model}</a>)}
        </nav>
      )}
      {highlights.length > 0 && <ul class="highlights">{highlights.map((h) => <li>{h}</li>)}</ul>}
      {desc && <p class="desc">{desc}</p>}

      {p.sale && !offline && (
        <div class={`sale ${group ? 'group' : 'stock'}`}>
          <div class="sale-head">
            <span class={`pill ${group ? 'group' : 'stock'}`}>{group ? t.group : t.stock}</span>
            {!group && stock > 0 && <span class="stock-qty">{t.stockQty(stock)}</span>}
          </div>
          <p>{group ? t.groupRules : t.stockRules}</p>
        </div>
      )}

      {modular ? (
        <a class="custom-banner" href={`/${lang}/modular-ups/#visual`}>
          <span>{M.banner}</span><b>{M.bannerCta} →</b>
        </a>
      ) : offline ? (
        <a class="custom-banner" href={`/${lang}/custom/?tab=oem&model=${p.slug}`}>
          <span>{rack ? R.banner : O.banner}</span><b>{rack ? R.bannerCta : O.bannerCta} →</b>
        </a>
      ) : (
        <a class="custom-banner" href={`/${lang}/custom/?from=${p.slug}`}>
          <span>{CT[lang].banner}</span><b>{CT[lang].bannerCta} →</b>
        </a>
      )}
    </section>

    {offline ? (
      <QuoteConsole p={p} lang={lang} />
    ) : tiers.length > 0 ? (
      <OrderConsole p={p} lang={lang} />
    ) : (
      <div class="buy-fallback">
        <p class="plug">{t.plugNote}</p>
        <div class="cta">
          {wa && <a class="btn primary" href={wa} target="_blank" rel="noopener">{t.askQuote}</a>}
          {SITE.email && <a class="btn" href={`mailto:${SITE.email}?subject=${encodeURIComponent(p.model)}`}>{t.askEmail}</a>}
        </div>
      </div>
    )}
  </div>

  <div class="details">
    {features.length > 0 && (
      <section class="card">
        <h2>{t.features}</h2>
        <ul class="features">{features.map((f) => <li>{f}</li>)}</ul>
      </section>
    )}
    {!offline && <RuntimeCalc p={p} lang={lang} />}
    <section class="card">
      <h2>{t.specs}</h2>
      <dl class="specs">
        {rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </section>
    <PackingList p={p} lang={lang} />
    {detailAll.length > 0 && (
      <section class="card detail-imgs">
        <h2>{t.details}</h2>
        <div class="detail-stack">
          {detailAll.map((x, i) => x.im ? (
            <img src={x.im.src} alt={`${p.model} ${i + 1}`} loading="lazy" decoding="async" width={x.im.w} height={x.im.h} />
          ) : (
            <iframe class="detail-html" title={`${p.model} ${i + 1}`} sandbox="allow-scripts allow-popups" srcdoc={htmlDoc(x.html)} loading="lazy" data-detail-html></iframe>
          ))}
        </div>
      </section>
    )}
    {(Array.isArray(p.templateHtml) ? p.templateHtml : []).map((tp) => (
      <SeriesHtml html={(tp.html && (tp.html[lang] || tp.html.en)) || ''} model={p.model} lang={lang} />
    ))}
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script is:inline>
  // 详情里的 HTML 片段：按片段内容自动调整 iframe 高度
  (function () {
    var frames = document.querySelectorAll('[data-detail-html]');
    if (!frames.length) return;
    addEventListener('message', function (e) {
      var h = e.data && e.data.skeHtmlH; if (!h) return;
      for (var i = 0; i < frames.length; i++) if (frames[i].contentWindow === e.source) frames[i].style.height = Math.min(h, 20000) + 'px';
    });
  })();
  </script>
</Base>

<style>
  .series { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 8px 0 4px; font-size: 13px; }
  .series span { color: var(--muted); margin-right: 2px; }
  .series a, .series b { padding: 4px 11px; border: 1px solid var(--line); border-radius: 99px; text-decoration: none; color: var(--ink); background: var(--surface); font-weight: 500; }
  .series a:hover { border-color: var(--ink); }
  .series b { background: var(--ink); color: var(--surface); border-color: var(--ink); }
  .crumbs { font-size: 13px; color: var(--muted); margin: 20px 0 14px; }
  .crumbs a { color: var(--muted); }
  /* 桌面：左 图片（与右侧顶部对齐，随页面正常滚动）| 右 型号信息 + 价格数量；下方通栏：插头；再下：发货 | 结算 */
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 36px; row-gap: 20px; align-items: start;
    grid-template-areas: "gallery info" "gallery buy" "plugs plugs" "ship checkout"; }
  .gallery-col { grid-area: gallery; min-width: 0; }
  .summary { grid-area: info; }
  .buy-fallback { grid-area: buy; display: grid; gap: 16px; }
  @media (max-width: 860px) {
    .layout { grid-template-columns: minmax(0, 1fr); row-gap: 18px; grid-template-areas: "gallery" "info" "buy" "plugs" "ship" "checkout"; }
  }
  .summary { display: grid; gap: 16px; min-width: 0; align-content: start; }
  .type { font-size: 13px; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }
  .summary h1 { font-size: clamp(36px, 5.5vw, 56px); margin: -8px 0 0; }
  .desc { margin: 0; max-width: 62ch; }
  .highlights { list-style: none; margin: -4px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .highlights li { font-size: 14px; font-weight: 500; padding: 5px 12px; border-radius: 6px; background: var(--surface); border: 1px solid var(--line); font-variant-numeric: tabular-nums; }
  .custom-banner { display: flex; justify-content: space-between; align-items: center; gap: 6px 14px; flex-wrap: wrap; padding: 11px 14px; border-radius: 10px; border: 1px dashed var(--accent); text-decoration: none; color: var(--ink); font-size: 14px; }
  .custom-banner b { color: var(--accent); white-space: nowrap; }
  .custom-banner:hover { background: var(--surface); }
  .sale { border-radius: 10px; padding: 14px 16px; border: 1px solid var(--line); background: var(--surface); }
  .sale p { margin: 8px 0 0; font-size: 14px; color: var(--muted); }
  .sale-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .stock-qty { font-size: 14px; font-weight: 500; color: var(--ok); }
  .pill { font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; padding: 3px 9px; border-radius: 99px; }
  .pill.stock { background: var(--ok-soft); color: var(--ok); }
  .pill.group { background: var(--charge-soft); color: var(--warn); }
  .tiers h2, .details h2 { font-size: 22px; margin: 0 0 10px; }
  .tiers table { width: 100%; border-collapse: collapse; font-size: 15px; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
  .tiers th, .tiers td { text-align: left; padding: 9px 14px; border-bottom: 1px solid var(--line); }
  .tiers th { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 600; }
  .tiers td:last-child, .tiers th:last-child { text-align: right; }
  .tiers tr:last-child td { border-bottom: 0; }
  .note { font-size: 12px; color: var(--muted); margin: 6px 0 0; }
  .plug { margin: 0; font-size: 14px; padding-left: 12px; border-left: 3px solid var(--charge); }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: 0 20px; border-radius: 8px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); text-decoration: none; font-weight: 600; }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .details { display: grid; gap: 20px; margin-top: 40px; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 22px; min-width: 0; }
  .details h2 { font-size: 24px; margin: 0 0 14px; }
  .features { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 10px 28px; }
  .features li { position: relative; padding-left: 22px; }
  .features li::before { content: ""; position: absolute; left: 0; top: .55em; width: 10px; height: 10px; border-radius: 2px; background: var(--charge); }
  .specs { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 32px; }
  @media (max-width: 700px) { .specs { grid-template-columns: minmax(0, 1fr); } }
  .specs div { display: grid; grid-template-columns: minmax(0, 46%) minmax(0, 1fr); gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .specs dt { color: var(--muted); }
  /* 详情图：按顺序上下拼接，不留缝（详情图通常是一整张长图切成几段） */
  .detail-stack { max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; }
  .detail-stack img { width: 100%; height: auto; display: block; }
  .detail-stack .detail-html { width: 100%; height: 600px; border: 0; display: block; background: #fff; }
  .specs dd { margin: 0; font-weight: 500; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
</style>
