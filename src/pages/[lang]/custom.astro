---
// 定制页：ODM 完全定制（重点，默认打开）/ OEM 标准款贴牌。提交方式：生成规格单 → WhatsApp / 邮件。
// 链接参数：?from=<产品slug> 用该产品的输出口、功率、电池作为 ODM 起点；?tab=oem&model=<slug> 直接打开 OEM 并选好型号。
import Base from '../../layouts/Base.astro';
import { LANGS, SITE } from '../../config.mjs';
import { CT, CERTS, PORT_TYPES, CHEM, CAP_PRESETS, POWER_PRESETS, MAX_RATED_W, SAMPLE_FEE, OEM_MOQ, MAX_PORTS } from '../../lib/custom-i18n.mjs';
import { powerW, totalMah, EFFICIENCY } from '../../lib/power.mjs';
import products from '../../data/products.json';
import { isOffline } from '../../lib/category.mjs';
import { OT } from '../../lib/offline-i18n.mjs';
import { PLUGS, PLUG_ICON } from '../../lib/plugs.mjs';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const T = CT[lang];

// 从产品输出口文字里解析出 ODM 起点（解析不了的项留空，客户自己选）
const num = (s) => { const m = String(s || '').replace(',', '.').match(/\d+(?:\.\d+)?/); return m ? +m[0] : null; };
const portType = (s) => { const x = String(s || '').toUpperCase(); return /USB-?C|TYPE-?C/.test(x) ? 'USBC' : x.includes('USB') ? 'USBA' : x.includes('POE') ? 'POE' : 'DC'; };
const amps = (s) => { const t = String(s || ''); const n = num(t); if (n === null) return null; return /mA/i.test(t) ? n / 1000 : n; };
const lite = products.map((p) => ({
  slug: p.slug,
  model: p.model,
  thumb: (p.images && p.images[0] && (p.images[0].thumb || p.images[0].src)) || null,
  offline: isOffline(p),
  img: (p.images && p.images[0] && p.images[0].src) || null,
  w: Math.min(MAX_RATED_W, powerW(p) || 0) || null,
  chem: /LFP|LIFEPO4/i.test(`${p.model} ${p.batterySpec || ''}`) ? 'LFP' : 'LI',
  mah: totalMah(p) || null,
  ports: (Array.isArray(p.outputPorts) ? p.outputPorts : []).slice(0, MAX_PORTS)
    .map((o) => ({ t: portType(o.type), v: num(o.voltage), a: amps(o.current) })),
}));

const cfg = {
  T, offFee: OT[lang].qOem.split(' · ')[1] || '', PORT_TYPES, CHEM, maxW: MAX_RATED_W, maxPorts: MAX_PORTS, oemMoq: OEM_MOQ, fee: SAMPLE_FEE, eff: EFFICIENCY,
  wa: SITE.whatsapp, email: SITE.email, products: lite,
};
const tpl = (s, o) => s.replace(/\{(\w+)\}/g, (_, k) => (o[k] ?? ''));
---
<Base lang={lang} title={`${T.title} · ${SITE.name}`} description={T.lead} path="custom/">
  <div class="cz" data-cz>
    <script type="application/json" data-cz-cfg set:html={JSON.stringify(cfg)} />

    <header class="cz-head">
      <h1>{T.title}</h1>
      <p>{T.lead}</p>
    </header>

    <div class="cz-tabs" role="tablist">
      <button type="button" role="tab" class="on" data-tab="odm" aria-selected="true">{T.tabOdm}</button>
      <button type="button" role="tab" data-tab="oem" aria-selected="false">{T.tabOem}</button>
    </div>

    <!-- ===================== ODM ===================== -->
    <section class="cz-panel" data-panel="odm">
      <p class="cz-sub">{T.odmSub}</p>
      <p class="cz-from" data-from hidden></p>
      <div class="cz-pv-mobile" aria-hidden="true"><div class="cz-pv-svg" data-preview></div></div>

      <div class="cz-grid">
        <div class="cz-main">
          <div class="cz-card">
            <h2><span>1</span>{T.s1}</h2>
            <div class="cz-locked"><b class="num">{T.inputFixed}</b><span>🔒</span></div>
            <p class="cz-hint">{T.inputNote}</p>
            <div class="cz-field">
              <span class="cz-label">{T.plugTitle}</span>
              <span class="cz-hint">{T.plugHint}</span>
              <div class="cz-plugs">
                {PLUGS.map(([k, name, type]) => (
                  <label class="cz-plug">
                    <input type="checkbox" data-plug={k} checked={k === 'US'} />
                    <span class="cz-plug-ico" set:html={PLUG_ICON[k]} />
                    <span class="cz-plug-name"><b>{k === 'OT' ? T.plugOther : `${name} · ${T.typeWord} ${type}`}</b><small>{T.plugWhere[k]}</small></span>
                  </label>
                ))}
              </div>
              <input type="text" maxlength="60" placeholder={T.plugOtherPh} data-plug-other hidden aria-label={T.plugOther} />
            </div>
          </div>

          <div class="cz-card">
            <h2><span>2</span>{T.s2}</h2>
            <p class="cz-hint">{tpl(T.s2Hint, { max: MAX_RATED_W })}</p>
            <div class="cz-chips" data-power-chips>
              {POWER_PRESETS.map((w) => <button type="button" data-w={w}><span class="num">{w}</span> {T.w}</button>)}
            </div>
            <div class="cz-inline">
              <input type="number" inputmode="decimal" min="1" max={MAX_RATED_W} step="1" data-rated aria-label={T.s2} />
              <span>{T.w}</span>
            </div>
            <p class="cz-err" data-rated-err hidden></p>
            <p class="cz-hint">{T.s2Share}</p>
          </div>

          <div class="cz-card">
            <h2><span>3</span>{T.s3}</h2>
            <label class="cz-inline">
              <span>{T.count}</span>
              <select data-count>
                {Array.from({ length: MAX_PORTS }, (_, i) => <option value={i + 1} selected={i === 1}>{i + 1}</option>)}
              </select>
            </label>
            <div class="cz-ports" data-ports></div>
            <div class="cz-portsum" data-portsum hidden></div>
          </div>

          <div class="cz-card">
            <h2><span>4</span>{T.s4}</h2>
            <div class="cz-field">
              <span class="cz-label">{T.chem}</span>
              <div class="cz-seg">
                <label><input type="radio" name="chem" value="LI" checked /> {T.chemLi}</label>
                <label><input type="radio" name="chem" value="LFP" /> {T.chemLfp}</label>
              </div>
            </div>
            <div class="cz-field">
              <span class="cz-label">{T.cap}</span>
              <div class="cz-chips" data-cap-chips>
                {CAP_PRESETS.map((m) => <button type="button" data-mah={m}><span class="num">{m}</span> {T.mah}</button>)}
              </div>
              <div class="cz-inline">
                <input type="number" inputmode="numeric" min="500" max="200000" step="100" data-mah-input aria-label={T.cap} />
                <span>{T.mah}</span>
                <b class="num cz-wh" data-wh></b>
              </div>
              <p class="cz-run num" data-run hidden></p>
            </div>
            <details class="cz-helper">
              <summary>{T.helper}</summary>
              <div class="cz-inline wrap">
                <span>{T.myLoad}</span>
                <input type="number" inputmode="decimal" min="1" max="200" step="1" value="16" data-h-load aria-label={T.myLoad} /> <span>{T.w}</span>
                <span>{T.hours}</span>
                <input type="number" inputmode="decimal" min="0.5" max="48" step="0.5" value="4" data-h-hours aria-label={T.hoursUnit} /> <span>{T.hoursUnit}</span>
                <button type="button" class="cz-btn small" data-h-apply></button>
              </div>
            </details>
          </div>

          <div class="cz-card">
            <h2><span>5</span>{T.s5} <em>· {T.s5Opt}</em></h2>
            <div class="cz-checks">
              <label><input type="checkbox" data-odm-item="logo" /> {T.logo}</label>
              <label><input type="checkbox" data-odm-item="box" /> {T.box}</label>
              <label><input type="checkbox" data-odm-item="manual" /> {T.manual}</label>
            </div>
            <div class="cz-two">
              <label class="cz-field"><span class="cz-label">{T.material}</span>
                <select data-odm-material><option value="plastic">{T.plastic}</option><option value="metal">{T.metal}</option></select>
              </label>
              <label class="cz-field"><span class="cz-label">{T.color}</span>
                <select data-odm-color>{Object.entries(T.colors).map(([k, v]) => <option value={k}>{v}</option>)}</select>
              </label>
            </div>
            <input type="text" maxlength="60" placeholder={T.colorPh} data-odm-color-other hidden aria-label={T.color} />
            <div class="cz-logo" data-logo-box hidden>
              <label class="cz-btn small cz-upload">
                <input type="file" accept="image/png,image/jpeg,image/svg+xml,image/webp" data-logo-file hidden />
                {T.logoUpload}
              </label>
              <p class="cz-hint" data-logo-ok hidden>{T.logoUploaded} <button type="button" class="cz-link" data-logo-remove>{T.logoRemove}</button></p>
            </div>
          </div>

          <div class="cz-card">
            <h2><span>6</span>{T.s6}</h2>
            <div class="cz-two">
              <label class="cz-field"><span class="cz-label">{T.qty}</span>
                <span class="cz-inline"><input type="number" inputmode="numeric" min="1000" step="100" placeholder="1000" data-odm-qty /> <span>{T.pcs}</span></span>
                <span class="cz-hint">{T.qtyHint}</span>
              </label>
              <label class="cz-field"><span class="cz-label">{T.target} <em>· {T.optional}</em></span>
                <input type="number" inputmode="decimal" min="0" step="0.1" data-odm-target />
              </label>
              <label class="cz-field"><span class="cz-label">{T.country} <em>· {T.optional}</em></span>
                <input type="text" maxlength="40" data-odm-country />
              </label>
            </div>
            <label class="cz-field"><span class="cz-label">{T.notes} <em>· {T.optional}</em></span>
              <textarea rows="3" maxlength="600" placeholder={T.notesPh} data-odm-notes></textarea>
            </label>
          </div>
        </div>

        <aside class="cz-side">
          <div class="cz-card cz-pv">
            <span class="cz-label">{T.pvTitle}</span>
            <div class="cz-pv-svg" data-preview role="img" aria-label={T.pvTitle}></div>
            <div class="cz-pv-tags" data-pv-tags></div>
            <p class="cz-hint">{T.pvNote}</p>
          </div>
          <div class="cz-card cz-summary">
            <div class="cz-fee">
              <b>{T.feeTitle}</b>
              <span>{T.feeText}</span>
            </div>
            <ul class="cz-spec num" data-odm-spec></ul>
            <p class="cz-missing" data-odm-missing hidden></p>
            <div class="cz-cta">
              {SITE.whatsapp && <a class="cz-btn primary" data-odm-wa href="#" target="_blank" rel="noopener">{T.send}</a>}
              {SITE.email && <a class="cz-btn" data-odm-mail href="#">{T.sendMail}</a>}
            </div>
          </div>
        </aside>
      </div>
    </section>

    <!-- ===================== OEM ===================== -->
    <section class="cz-panel" data-panel="oem" hidden>
      <p class="cz-sub">{T.oemSub}</p>
      <div class="cz-grid">
        <div class="cz-main">
          <div class="cz-card">
            <div class="cz-two">
              <div class="cz-field"><label class="cz-label" for="oem-model">{T.oemModel}</label>
                <div class="cz-oem-pick">
                  <div class="cz-thumb-wrap">
                    <button type="button" class="cz-thumb" data-oem-thumb aria-label={T.oemModel} disabled><span>?</span></button>
                    <div class="cz-thumb-pop" data-oem-pop aria-hidden="true"></div>
                  </div>
                  <select id="oem-model" data-oem-model>
                    <option value="">{T.oemPick}</option>
                    {products.map((p) => <option value={p.slug}>{p.model}</option>)}
                  </select>
                </div>
              </div>
              <label class="cz-field"><span class="cz-label">{T.oemQty}</span>
                <span class="cz-inline"><input type="number" inputmode="numeric" min={OEM_MOQ} step="100" value={OEM_MOQ} data-oem-qty /> <span>{T.pcs}</span></span>
                <span class="cz-hint strong">{tpl(T.oemMoq, { n: OEM_MOQ })}</span>
                <span class="cz-hint strong" data-oem-fee hidden></span>
              </label>
            </div>
          </div>
          <div class="cz-card">
            <h2>{T.oemWhat}</h2>
            <div class="cz-checks">
              <label><input type="checkbox" data-oem-item="logo" checked /> {T.logo}</label>
              <label><input type="checkbox" data-oem-item="box" /> {T.box}</label>
              <label><input type="checkbox" data-oem-item="manual" /> {T.manual}</label>
              <label><input type="checkbox" data-oem-item="cert" /> {T.cert} <em class="cz-opt">· {T.optional}</em></label>
            </div>
            <div class="cz-field" data-oem-cert-box hidden>
              <span class="cz-hint">{T.certHint}</span>
              <div class="cz-chips" data-oem-certs>
                {CERTS.map((x) => <label class="cz-chip"><input type="checkbox" value={x} /> {x}</label>)}
              </div>
              <input type="text" maxlength="80" placeholder={T.certOtherPh} data-oem-cert-other aria-label={T.cert} />
            </div>
            <p class="cz-hint" data-oem-logo-note>{T.oemLogoNote}</p>
            <label class="cz-field"><span class="cz-label">{T.notes} <em>· {T.optional}</em></span>
              <textarea rows="3" maxlength="600" data-oem-notes></textarea>
            </label>
          </div>
        </div>
        <aside class="cz-side">
          <div class="cz-card cz-summary">
            <ul class="cz-spec num" data-oem-spec></ul>
            <p class="cz-missing" data-oem-missing hidden></p>
            <div class="cz-cta">
              {SITE.whatsapp && <a class="cz-btn primary" data-oem-wa href="#" target="_blank" rel="noopener">{T.send}</a>}
              {SITE.email && <a class="cz-btn" data-oem-mail href="#">{T.sendMail}</a>}
            </div>
          </div>
        </aside>
      </div>
    </section>

    <div class="cz-lightbox" data-lightbox hidden role="dialog" aria-modal="true">
      <button type="button" class="cz-lb-close" data-lb-close aria-label="×">×</button>
      <img alt="" data-lb-img />
    </div>
  </div>
</Base>

<script is:inline>
(function () {
  var root = document.querySelector('[data-cz]');
  if (!root) return;
  var c = JSON.parse(root.querySelector('[data-cz-cfg]').textContent);
  var T = c.T;
  var $ = function (s, el) { return (el || root).querySelector(s); };
  var $$ = function (s, el) { return Array.prototype.slice.call((el || root).querySelectorAll(s)); };
  var fmt = function (s, o) { return s.replace(/\{(\w+)\}/g, function (_, k) { return o[k] != null ? o[k] : ''; }); };
  var r1 = function (n) { return Math.round(n * 10) / 10; };
  var parseNum = function (s) { var n = parseFloat(String(s == null ? '' : s).replace(',', '.')); return isFinite(n) ? n : null; };
  var hm = function (hours) {
    if (!(hours > 0)) return '—';
    var m = Math.round(hours * 60), h = Math.floor(m / 60), mm = m % 60;
    return h ? (h + ' ' + T.h + (mm ? ' ' + mm + ' ' + T.min : '')) : (mm + ' ' + T.min);
  };
  var setLinks = function (wa, mail, ok, subject, msg) {
    [wa, mail].forEach(function (a) { if (a) { a.classList.toggle('disabled', !ok); a.setAttribute('aria-disabled', ok ? 'false' : 'true'); } });
    if (wa) wa.href = 'https://wa.me/' + c.wa + '?text=' + encodeURIComponent(msg);
    if (mail) mail.href = 'mailto:' + c.email + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(msg);
  };
  root.addEventListener('click', function (e) { if (e.target.closest('.cz-btn.disabled')) e.preventDefault(); });

  /* ---------- tabs ---------- */
  function showTab(name) {
    $$('[data-tab]').forEach(function (b) { var on = b.dataset.tab === name; b.classList.toggle('on', on); b.setAttribute('aria-selected', on ? 'true' : 'false'); });
    $$('[data-panel]').forEach(function (p) { p.hidden = p.dataset.panel !== name; });
  }
  $$('[data-tab]').forEach(function (b) { b.addEventListener('click', function () { showTab(b.dataset.tab); }); });

  /* ---------- ODM ---------- */
  var ratedEl = $('[data-rated]'), countEl = $('[data-count]'), portsEl = $('[data-ports]');
  var mahEl = $('[data-mah-input]');

  function optionList(values, unit) {
    return '<option value="">' + T.choose + '</option>' +
      values.map(function (v) { return '<option value="' + v + '">' + String(v).replace('.', lang === 'en' ? '.' : ',') + ' ' + unit + '</option>'; }).join('') +
      '<option value="other">' + T.other + '</option>';
  }
  var lang = document.documentElement.lang || 'en';

  function buildRow(i) {
    var row = document.createElement('div');
    row.className = 'cz-port';
    row.dataset.port = i;
    row.innerHTML =
      '<div class="cz-port-head"><b>' + fmt(T.port, { n: i + 1 }) + '</b><span class="num cz-port-w" data-pw></span></div>' +
      '<div class="cz-port-body">' +
        '<label class="cz-field"><span class="cz-label">' + T.type + '</span><select data-pt><option value="">' + T.choose + '</option>' +
          Object.keys(c.PORT_TYPES).map(function (k) { return '<option value="' + k + '">' + T.types[k] + '</option>'; }).join('') + '</select></label>' +
        '<label class="cz-field" data-vbox hidden><span class="cz-label">' + T.voltage + '</span><select data-pv></select>' +
          '<input type="number" inputmode="decimal" min="1" max="60" step="0.1" placeholder="' + T.ph.v + '" data-pvo hidden></label>' +
        '<label class="cz-field" data-abox hidden><span class="cz-label">' + T.current + '</span><select data-pa></select>' +
          '<input type="number" inputmode="decimal" min="0.1" max="20" step="0.1" placeholder="' + T.ph.a + '" data-pao hidden></label>' +
      '</div>' +
      '<p class="cz-err" data-perr hidden></p>';
    var pt = $('[data-pt]', row), pv = $('[data-pv]', row), pa = $('[data-pa]', row);
    pt.addEventListener('change', function () { fillType(row, pt.value); update(); });
    pv.addEventListener('change', function () { $('[data-pvo]', row).hidden = pv.value !== 'other'; if (pv.value === 'other') $('[data-pvo]', row).focus(); revealA(row); update(); });
    pa.addEventListener('change', function () { $('[data-pao]', row).hidden = pa.value !== 'other'; if (pa.value === 'other') $('[data-pao]', row).focus(); update(); });
    $('[data-pvo]', row).addEventListener('input', function () { revealA(row); update(); });
    $('[data-pao]', row).addEventListener('input', update);
    return row;
  }
  // 选了接口类型 → 出现电压；USB-A 只有 5V，直接选好
  function fillType(row, type) {
    var def = c.PORT_TYPES[type];
    var vbox = $('[data-vbox]', row), abox = $('[data-abox]', row), pv = $('[data-pv]', row), pa = $('[data-pa]', row);
    $('[data-pvo]', row).hidden = true; $('[data-pvo]', row).value = '';
    $('[data-pao]', row).hidden = true; $('[data-pao]', row).value = '';
    if (!def) { vbox.hidden = true; abox.hidden = true; return; }
    pv.innerHTML = def.otherV ? optionList(def.v, 'V') : def.v.map(function (v) { return '<option value="' + v + '">' + v + ' V</option>'; }).join('');
    pa.innerHTML = optionList(def.a, 'A');
    vbox.hidden = false;
    abox.hidden = true;
    revealA(row);
  }
  // 选好电压 → 出现电流
  function revealA(row) { $('[data-abox]', row).hidden = portV(row) === null; }
  function portV(row) {
    var pv = $('[data-pv]', row);
    if ($('[data-vbox]', row).hidden) return null;
    if (pv.value === 'other') { var n = parseNum($('[data-pvo]', row).value); return n; }
    return parseNum(pv.value);
  }
  function portA(row) {
    var pa = $('[data-pa]', row);
    if ($('[data-abox]', row).hidden) return null;
    if (pa.value === 'other') return parseNum($('[data-pao]', row).value);
    return parseNum(pa.value);
  }
  function setPort(row, p) {
    if (!p || !c.PORT_TYPES[p.t]) return;
    var def = c.PORT_TYPES[p.t];
    $('[data-pt]', row).value = p.t; fillType(row, p.t);
    if (p.v != null) {
      var pv = $('[data-pv]', row);
      if (def.v.indexOf(p.v) >= 0) pv.value = String(p.v);
      else if (def.otherV) { pv.value = 'other'; $('[data-pvo]', row).hidden = false; $('[data-pvo]', row).value = p.v; }
      revealA(row);
    }
    if (p.a != null && !$('[data-abox]', row).hidden) {
      var pa = $('[data-pa]', row);
      if (def.a.indexOf(p.a) >= 0) pa.value = String(p.a);
      else { pa.value = 'other'; $('[data-pao]', row).hidden = false; $('[data-pao]', row).value = p.a; }
    }
  }
  function syncRows() {
    var n = +countEl.value, rows = $$('[data-port]', portsEl);
    for (var i = rows.length; i < n; i++) portsEl.appendChild(buildRow(i));
    rows.slice(n).forEach(function (r) { r.remove(); });
  }

  function chips(sel, attr, val) { $$(sel + ' button').forEach(function (b) { b.classList.toggle('on', +b.dataset[attr] === val); }); }
  $$('[data-power-chips] button').forEach(function (b) { b.addEventListener('click', function () { ratedEl.value = b.dataset.w; update(); }); });
  $$('[data-cap-chips] button').forEach(function (b) { b.addEventListener('click', function () { mahEl.value = b.dataset.mah; update(); }); });
  ratedEl.addEventListener('input', update);
  mahEl.addEventListener('input', update);
  countEl.addEventListener('change', function () { syncRows(); update(); });
  $$('input[name="chem"]').forEach(function (r) { r.addEventListener('change', update); });
  ['[data-odm-qty]', '[data-odm-target]', '[data-odm-country]', '[data-odm-notes]', '[data-odm-color-other]'].forEach(function (s) { $(s).addEventListener('input', update); });
  $$('[data-odm-item]').forEach(function (x) { x.addEventListener('change', update); });
  $('[data-odm-material]').addEventListener('change', update);
  $('[data-odm-color]').addEventListener('change', function () { $('[data-odm-color-other]').hidden = this.value !== 'other'; update(); });

  // 客户的 logo 只在浏览器里显示到预览上，不会上传到任何地方
  var logoData = null;
  $('[data-logo-file]').addEventListener('change', function () {
    var f = this.files && this.files[0];
    if (!f || f.size > 5 * 1024 * 1024) return;
    var rd = new FileReader();
    rd.onload = function () { logoData = rd.result; $('[data-logo-ok]').hidden = false; update(); };
    rd.readAsDataURL(f);
  });
  $('[data-logo-remove]').addEventListener('click', function () { logoData = null; $('[data-logo-file]').value = ''; $('[data-logo-ok]').hidden = true; update(); });

  /* ---------- 实时预览：根据选择画出机器的示意图 ---------- */
  var COLORS = { black: '#23292a', white: '#eef1f0', gray: '#8c9593' };
  function shade(hex, k) {
    var n = parseInt(hex.slice(1), 16), r = n >> 16, g = (n >> 8) & 255, b = n & 255;
    var f = function (x) { return Math.max(0, Math.min(255, Math.round(k < 0 ? x * (1 + k) : x + (255 - x) * k))); };
    return '#' + ((1 << 24) + (f(r) << 16) + (f(g) << 8) + f(b)).toString(16).slice(1);
  }
  function toHex(css) {
    var cv = document.createElement('canvas').getContext('2d');
    cv.fillStyle = '#000'; cv.fillStyle = css;
    var v = cv.fillStyle;
    return /^#[0-9a-f]{6}$/i.test(v) ? v : null;
  }
  var esc = function (t) { return String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;'); };
  function portIcon(t, cx, cy, ink, hole) {
    if (t === 'DC') return '<circle cx="' + cx + '" cy="' + cy + '" r="7" fill="' + hole + '" stroke="' + ink + '" stroke-width="1.2"/><circle cx="' + cx + '" cy="' + cy + '" r="2" fill="' + ink + '"/>';
    if (t === 'USBA') return '<rect x="' + (cx - 9) + '" y="' + (cy - 4.5) + '" width="18" height="9" rx="1" fill="' + hole + '" stroke="' + ink + '" stroke-width="1.2"/><rect x="' + (cx - 6) + '" y="' + (cy - 3) + '" width="12" height="3" fill="' + ink + '"/>';
    if (t === 'USBC') return '<rect x="' + (cx - 7.5) + '" y="' + (cy - 3.5) + '" width="15" height="7" rx="3.5" fill="' + hole + '" stroke="' + ink + '" stroke-width="1.2"/><rect x="' + (cx - 4) + '" y="' + (cy - 1) + '" width="8" height="2" rx="1" fill="' + ink + '"/>';
    if (t === 'POE') return '<path d="M' + (cx - 9) + ' ' + (cy - 7) + 'h18v10h-4v4h-10v-4h-4z" fill="' + hole + '" stroke="' + ink + '" stroke-width="1.2"/><path d="M' + (cx - 6) + ' ' + (cy - 5) + 'v3M' + (cx - 3) + ' ' + (cy - 5) + 'v3M' + cx + ' ' + (cy - 5) + 'v3M' + (cx + 3) + ' ' + (cy - 5) + 'v3M' + (cx + 6) + ' ' + (cy - 5) + 'v3" stroke="#c9a227" stroke-width="1"/>';
    return '<rect x="' + (cx - 9) + '" y="' + (cy - 7) + '" width="18" height="14" rx="3" fill="none" stroke="' + ink + '" stroke-width="1" stroke-dasharray="3 2"/>';
  }
  function renderPreview(st) {
    var n = st.ports.length;
    var W = Math.max(230, Math.min(420, 70 + n * 46));
    var mahK = Math.min(1, (st.mah || 10000) / 60000);
    var D = Math.round(52 + 48 * mahK);        // 顶面深度：电池越大机器越"厚实"
    var H = Math.round(54 + 16 * mahK);        // 正面高度
    var dx = Math.round(D * 0.55), x0 = 14, y0 = 14;
    var base = st.color, metal = st.metal;
    var top = shade(base, metal ? 0.18 : 0.1), front = base, side = shade(base, -0.25);
    var light = (function () { var v = parseInt(base.slice(1), 16); return ((v >> 16) * 0.3 + ((v >> 8) & 255) * 0.59 + (v & 255) * 0.11) > 150; })();
    var ink = light ? '#2b3331' : '#e9eeec', hole = light ? '#cfd6d4' : '#0d1110';
    var fy = y0 + D;                            // 正面上边
    var o = [];
    o.push('<defs>');
    o.push('<linearGradient id="pvTop" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="' + shade(top, 0.08) + '"/><stop offset="1" stop-color="' + shade(top, -0.06) + '"/></linearGradient>');
    o.push('<linearGradient id="pvFront" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="' + shade(front, 0.05) + '"/><stop offset="1" stop-color="' + shade(front, -0.12) + '"/></linearGradient>');
    if (metal) o.push('<pattern id="pvBrush" width="6" height="2" patternUnits="userSpaceOnUse"><rect width="6" height="1" fill="#fff" opacity=".07"/></pattern>');
    o.push('</defs>');
    // 阴影
    o.push('<ellipse cx="' + (x0 + (W + dx) / 2) + '" cy="' + (fy + H + 10) + '" rx="' + ((W + dx) / 2) + '" ry="7" fill="#000" opacity=".12"/>');
    // 顶面、侧面、正面
    var topPts = [[x0, fy], [x0 + W, fy], [x0 + W + dx, y0], [x0 + dx, y0]];
    var sidePts = [[x0 + W, fy], [x0 + W + dx, y0], [x0 + W + dx, y0 + H], [x0 + W, fy + H]];
    var pts = function (a) { return a.map(function (p) { return p.join(','); }).join(' '); };
    o.push('<polygon points="' + pts(topPts) + '" fill="url(#pvTop)" stroke="' + shade(base, -0.35) + '" stroke-width="1" stroke-linejoin="round"/>');
    if (metal) o.push('<polygon points="' + pts(topPts) + '" fill="url(#pvBrush)"/>');
    o.push('<polygon points="' + pts(sidePts) + '" fill="' + side + '" stroke="' + shade(base, -0.4) + '" stroke-width="1" stroke-linejoin="round"/>');
    o.push('<rect x="' + x0 + '" y="' + fy + '" width="' + W + '" height="' + H + '" rx="' + (metal ? 2 : 7) + '" fill="url(#pvFront)" stroke="' + shade(base, -0.35) + '" stroke-width="1"/>');
    if (metal) o.push('<rect x="' + x0 + '" y="' + fy + '" width="' + W + '" height="' + H + '" rx="2" fill="url(#pvBrush)"/>');
    // 顶面内容：logo、电量灯、容量
    var skew = 'matrix(1,0,' + (-dx / D).toFixed(3) + ',1,' + (x0 + dx) + ',' + y0 + ')';
    o.push('<g transform="' + skew + '">');
    if (st.logoData) {
      o.push('<image href="' + st.logoData + '" x="' + (W * 0.2) + '" y="' + (D * 0.18) + '" width="' + (W * 0.6) + '" height="' + (D * 0.5) + '" preserveAspectRatio="xMidYMid meet"/>');
    } else if (st.logo) {
      o.push('<rect x="' + (W * 0.25) + '" y="' + (D * 0.2) + '" width="' + (W * 0.5) + '" height="' + (D * 0.42) + '" rx="4" fill="none" stroke="' + ink + '" stroke-width="1" stroke-dasharray="4 3" opacity=".7"/>');
      o.push('<text x="' + (W / 2) + '" y="' + (D * 0.41 + 5) + '" text-anchor="middle" font-family="Barlow Condensed, Arial Narrow, sans-serif" font-weight="700" font-size="16" fill="' + ink + '" opacity=".8">' + esc(T.logoText) + '</text>');
    }
    for (var i = 0; i < 4; i++) o.push('<rect x="' + (14 + i * 9) + '" y="' + (D - 14) + '" width="6" height="4" rx="1" fill="' + (i < 3 ? '#3ccf7a' : (light ? '#b9c2bf' : '#3d4644')) + '"/>');
    if (st.mah) o.push('<text x="' + (W - 12) + '" y="' + (D - 9) + '" text-anchor="end" font-family="IBM Plex Mono, monospace" font-size="8.5" fill="' + ink + '" opacity=".75">' + st.mah + 'mAh' + (st.chem === 'LFP' ? ' LiFePO4' : '') + '</text>');
    o.push('</g>');
    // 正面：额定功率、电源键、输出口
    o.push('<text x="' + (x0 + 10) + '" y="' + (fy + 15) + '" font-family="IBM Plex Mono, monospace" font-size="9" fill="' + ink + '" opacity=".8">' + (st.rated ? 'MAX ' + st.rated + 'W' : 'MINI UPS') + '</text>');
    o.push('<circle cx="' + (x0 + W - 16) + '" cy="' + (fy + 15) + '" r="5" fill="none" stroke="' + ink + '" stroke-width="1.2"/><path d="M' + (x0 + W - 16) + ' ' + (fy + 11) + 'v4" stroke="' + ink + '" stroke-width="1.2"/>');
    var gap = W / (n + 1), py = fy + H * 0.55;
    st.ports.forEach(function (p, k) {
      var cx = x0 + gap * (k + 1);
      o.push(portIcon(p.t, cx, py, ink, hole));
      var lab = p.t ? (p.v != null ? p.v + 'V' : '') + (p.a != null ? ' ' + p.a + 'A' : '') : '';
      if (lab) o.push('<text x="' + cx + '" y="' + (py + 17) + '" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="' + (n > 6 ? 7 : 8) + '" fill="' + ink + '">' + esc(lab.trim()) + '</text>');
    });
    // 电源线：从侧面引出，末端标插头规格
    var cx0 = x0 + W + dx * 0.5, cy0 = fy - D * 0.5 + H * 0.7, cordEnd = cx0 + 46;
    o.push('<path d="M' + cx0 + ' ' + cy0 + ' C ' + (cx0 + 22) + ' ' + cy0 + ', ' + (cx0 + 12) + ' ' + (cy0 + 34) + ', ' + cordEnd + ' ' + (cy0 + 34) + '" fill="none" stroke="#2b3331" stroke-width="3" stroke-linecap="round"/>');
    o.push('<rect x="' + cordEnd + '" y="' + (cy0 + 27) + '" width="18" height="14" rx="3" fill="#2b3331"/><rect x="' + (cordEnd + 18) + '" y="' + (cy0 + 29) + '" width="6" height="2" fill="#9aa5a2"/><rect x="' + (cordEnd + 18) + '" y="' + (cy0 + 37) + '" width="6" height="2" fill="#9aa5a2"/>');
    if (st.plugs && st.plugs.length) o.push('<text x="' + (cordEnd + 9) + '" y="' + (cy0 + 54) + '" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="8.5" fill="#2b3331">' + esc(st.plugs.join('/')) + '</text>');
    var vbW = Math.max(x0 + W + dx + 14, cordEnd + 34), vbH = Math.max(fy + H + 22, cy0 + 60);
    var svg = '<svg viewBox="0 0 ' + vbW + ' ' + vbH + '" xmlns="http://www.w3.org/2000/svg">' + o.join('') + '</svg>';
    // 页面上有两份预览（手机顶部 / 电脑侧栏），渐变的 id 必须各不相同，否则隐藏的那份会让另一份的渐变失效
    $$('[data-preview]').forEach(function (el, i) { el.innerHTML = svg.replace(/pv(Top|Front|Brush)/g, 'pv$1' + i); });
    var tags = [];
    tags.push(st.metal ? T.metal : T.plastic);
    if (st.box) tags.push(T.pvBox);
    if (st.manual) tags.push(T.pvManual);
    $('[data-pv-tags]').innerHTML = tags.map(function (t) { return '<span>' + esc(t) + '</span>'; }).join('');
  }

  // 续航反推容量：负载 W × 小时 ÷ 效率 ÷ 单体电压 → mAh，向上取到 1000
  function helperMah() {
    var load = parseNum($('[data-h-load]').value), hrs = parseNum($('[data-h-hours]').value);
    if (!(load > 0) || !(hrs > 0)) return null;
    var cellV = c.CHEM[$('input[name="chem"]:checked').value];
    return Math.ceil(load * hrs / c.eff / cellV * 1000 / 1000) * 1000;
  }
  function updHelper() { var m = helperMah(); var b = $('[data-h-apply]'); b.disabled = !m; b.textContent = fmt(T.apply, { mah: m || '—' }); }
  $('[data-h-load]').addEventListener('input', updHelper);
  $('[data-h-hours]').addEventListener('input', updHelper);
  $('[data-h-apply]').addEventListener('click', function () { var m = helperMah(); if (m) { mahEl.value = m; update(); } });

  function plugState() {
    var other = $('[data-plug-other]');
    var on = $$('[data-plug]').filter(function (x) { return x.checked; }).map(function (x) { return x.dataset.plug; });
    other.hidden = on.indexOf('OT') < 0;
    var names = on.map(function (k) { return k === 'OT' ? other.value.trim() : (k === 'IN' ? 'India' : k); });
    return { codes: on, names: names, ok: on.length > 0 && names.every(Boolean) };
  }
  $$('[data-plug]').forEach(function (x) { x.addEventListener('change', update); });
  $('[data-plug-other]').addEventListener('input', update);

  function update() {
    var missing = [];
    var plugs = plugState();
    if (!plugs.ok) missing.push(T.mPlug);
    var rated = parseNum(ratedEl.value);
    var ratedOk = rated !== null && rated > 0 && rated <= c.maxW;
    chips('[data-power-chips]', 'w', rated);
    var rErr = $('[data-rated-err]');
    rErr.hidden = ratedEl.value === '' || ratedOk;
    rErr.textContent = '≤ ' + c.maxW + ' ' + T.w;
    if (!ratedOk) missing.push(T.mPower);

    // 输出口：每一个都必须填完整；单个口功率不能超过额定功率
    var portsOk = true, sumW = 0, portLines = [];
    $$('[data-port]', portsEl).forEach(function (row, i) {
      var type = $('[data-pt]', row).value, v = portV(row), a = portA(row), err = '';
      if (!type || v === null || a === null) err = T.errIncomplete;
      else if (!(v >= 1 && v <= 60)) err = T.errV;
      else if (!(a >= 0.1 && a <= 20)) err = T.errA;
      var w = (!err) ? r1(v * a) : null;
      if (!err && ratedOk && w > rated) err = fmt(T.errOver, { w: rated });
      var touched = !!type;
      var e = $('[data-perr]', row);
      e.hidden = !err || !touched; e.textContent = err;
      row.classList.toggle('bad', !!err && touched);
      row.classList.toggle('ok', !err);
      $('[data-pw]', row).textContent = w !== null ? fmt(T.portPower, { w: w }) : '';
      if (err) portsOk = false;
      else { sumW += w; portLines.push((i + 1) + '. ' + T.types[type] + ' ' + v + 'V ' + a + 'A (' + w + 'W)'); }
    });
    if (!portsOk) missing.push(T.mPorts);
    var ps = $('[data-portsum]');
    ps.hidden = !(portsOk && ratedOk);
    if (portsOk && ratedOk) {
      sumW = r1(sumW);
      ps.innerHTML = '<b class="num">' + fmt(T.sumPorts, { w: sumW }) + '</b><span>' + (sumW > rated ? fmt(T.sumShare, { r: rated }) : T.sumFit) + '</span>';
      ps.className = 'cz-portsum ' + (sumW > rated ? 'share' : 'fit');
    }

    // 电池
    var chem = $('input[name="chem"]:checked').value, mah = parseNum(mahEl.value);
    var mahOk = mah !== null && mah >= 500 && mah <= 200000;
    chips('[data-cap-chips]', 'mah', mah);
    var wh = mahOk ? r1(mah / 1000 * c.CHEM[chem]) : null;
    $('[data-wh]').textContent = wh ? fmt(T.energy, { wh: wh }) : '';
    var run = $('[data-run]');
    run.hidden = !(wh && ratedOk);
    if (wh && ratedOk) run.textContent = fmt(T.runFull, { r: rated, t: hm(wh * c.eff / rated) });
    if (!mahOk) missing.push(T.mBattery);
    updHelper();

    var qty = parseNum($('[data-odm-qty]').value);
    if (!(qty >= 1000)) missing.push(T.qtyMin); // 量产起订量 1000 台

    // 外观与品牌
    var items = $$('[data-odm-item]').filter(function (x) { return x.checked; }).map(function (x) { return T.short[x.dataset.odmItem]; });
    var mat = $('[data-odm-material]').value === 'metal' ? T.metal : T.plastic;
    var colK = $('[data-odm-color]').value, colTxt = colK === 'other' ? ($('[data-odm-color-other]').value.trim() || T.colors.other) : T.colors[colK];
    var target = parseNum($('[data-odm-target]').value), country = $('[data-odm-country]').value.trim(), notes = $('[data-odm-notes]').value.trim();

    // 预览用的数据：没填完的输出口也画出来（虚线或只显示类型），客户边选边看
    $('[data-logo-box]').hidden = !$('[data-odm-item="logo"]').checked;
    var colorHex = colK === 'other' ? (toHex($('[data-odm-color-other]').value.trim()) || '#4a6fa5') : COLORS[colK];
    renderPreview({
      ports: $$('[data-port]', portsEl).map(function (row) { var t = $('[data-pt]', row).value; return { t: t, v: t ? portV(row) : null, a: t ? portA(row) : null }; }),
      rated: ratedOk ? rated : null, mah: mahOk ? mah : null, chem: chem, plugs: plugs.names.filter(Boolean),
      color: colorHex, metal: $('[data-odm-material]').value === 'metal',
      logo: $('[data-odm-item="logo"]').checked, logoData: $('[data-odm-item="logo"]').checked ? logoData : null,
      box: $('[data-odm-item="box"]').checked, manual: $('[data-odm-item="manual"]').checked,
    });

    var chemName = chem === 'LFP' ? 'LiFePO4' : (lang === 'es' ? 'Litio-ion' : lang === 'ru' ? 'Li-ion' : 'Li-ion');
    var spec = [
      [T.lInput, T.inputFixed],
      [T.lPlug, plugs.ok ? plugs.names.join(', ') : '—'],
      [T.lRated, ratedOk ? rated + ' ' + T.w : '—'],
      [T.lOutputs, portsOk ? portLines.join('\n') : '—'],
      [T.lBattery, mahOk ? chemName + ', ' + mah + ' mAh (' + wh + ' Wh)' : '—'],
      [T.lLook, mat + ', ' + colTxt],
    ];
    if (items.length) spec.push([T.lBrand, items.join(', ')]);
    spec.push([T.lQty, qty > 0 ? qty + ' ' + T.pcs : '—']);
    if (target > 0) spec.push([T.lTarget, '$' + target]);
    if (country) spec.push([T.lCountry, country]);
    if (notes) spec.push([T.lNotes, notes]);

    $('[data-odm-spec]').innerHTML = spec.map(function (s) {
      return '<li><span>' + s[0] + '</span><b>' + String(s[1]).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\n/g, '<br>') + '</b></li>';
    }).join('');
    var ok = missing.length === 0;
    var miss = $('[data-odm-missing]');
    miss.hidden = ok; miss.textContent = fmt(T.missing, { list: missing.join(', ') });

    var msg = T.msgOdm + '\n' + spec.map(function (s) {
      return '• ' + s[0] + ': ' + (String(s[1]).indexOf('\n') >= 0 ? '\n   ' + String(s[1]).split('\n').join('\n   ') : s[1]);
    }).join('\n') + '\n\n' + T.msgFee;
    setLinks($('[data-odm-wa]'), $('[data-odm-mail]'), ok, 'ODM · ' + (ratedOk ? rated + 'W' : '') + ' · ' + (qty || '') , msg);
  }

  /* ---------- OEM ---------- */
  var oemModel = $('[data-oem-model]'), oemQty = $('[data-oem-qty]');
  function updateOem() {
    var missing = [];
    var slug = oemModel.value, prod = c.products.filter(function (p) { return p.slug === slug; })[0];
    if (!prod) missing.push(T.mModel);
    var qty = parseNum(oemQty.value);
    if (!(qty >= c.oemMoq)) missing.push(fmt(T.oemMoq, { n: c.oemMoq }));
    var chosen = $$('[data-oem-item]').filter(function (x) { return x.checked; }).map(function (x) { return x.dataset.oemItem; });
    // 缩略图：所选型号的第一张产品图
    var th = $('[data-oem-thumb]'), pop = $('[data-oem-pop]');
    var big = prod ? (prod.img || prod.thumb) : null;
    if (th.dataset.slug !== slug) {
      th.dataset.slug = slug;
      th.innerHTML = prod && prod.thumb ? '<img src="' + prod.thumb + '" alt="">' : '<span>?</span>';
      pop.innerHTML = big ? '<img src="' + big + '" alt="" loading="lazy">' : '';
      th.disabled = !big;
      th.dataset.big = big || '';
    }
    // 认证证书（可选）：勾选后至少选一个证书或手动填写
    $('[data-oem-logo-note]').hidden = chosen.indexOf('logo') < 0;
    var certOn = chosen.indexOf('cert') >= 0;
    $('[data-oem-cert-box]').hidden = !certOn;
    var certs = $$('[data-oem-certs] input').filter(function (x) { return x.checked; }).map(function (x) { return x.value; });
    var certOther = $('[data-oem-cert-other]').value.trim();
    if (certOther) certs.push(certOther);
    if (certOn && !certs.length) missing.push(T.mCert);
    // 认证本身不算"定制项"：至少还要选 logo / 包装盒 / 说明书 之一
    if (!chosen.filter(function (k) { return k !== 'cert'; }).length) missing.push(T.mItems);
    var labels = chosen.map(function (k) {
      if (k === 'cert') return T.short.cert + ': ' + (certs.length ? certs.join(', ') : '—');
      return T.short[k];
    });
    var notes = $('[data-oem-notes]').value.trim();
    var spec = [[T.lModel, prod ? prod.model : '—'], [T.oemQty, qty > 0 ? qty + ' ' + T.pcs : '—'], [T.lCustom, labels.length ? labels.join('\n') : '—']];
    // 离线式 UPS 贴牌：样品费 3000 美元，批量订单退还
    var feeEl = $('[data-oem-fee]');
    feeEl.hidden = !(prod && prod.offline); feeEl.textContent = c.offFee ? c.offFee.charAt(0).toUpperCase() + c.offFee.slice(1) : '';
    if (prod && prod.offline && c.offFee) spec.push([T.feeTitle.split(':')[0], c.offFee]);
    if (notes) spec.push([T.lNotes, notes]);
    $('[data-oem-spec]').innerHTML = spec.map(function (s) {
      return '<li><span>' + s[0] + '</span><b>' + String(s[1]).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\n/g, '<br>') + '</b></li>';
    }).join('');
    var ok = missing.length === 0, miss = $('[data-oem-missing]');
    miss.hidden = ok; miss.textContent = fmt(T.missing, { list: missing.join(', ') });
    var msg = T.msgOem + '\n' + spec.map(function (s) {
      return '• ' + s[0] + ': ' + (String(s[1]).indexOf('\n') >= 0 ? '\n   ' + String(s[1]).split('\n').join('\n   ') : s[1]);
    }).join('\n');
    setLinks($('[data-oem-wa]'), $('[data-oem-mail]'), ok, 'OEM · ' + (prod ? prod.model : '') + ' · ' + (qty || ''), msg);
  }
  // 缩略图：鼠标悬停显示大图（CSS），点击全屏查看
  var lb = $('[data-lightbox]');
  function closeLb() { lb.hidden = true; document.body.style.overflow = ''; }
  $('[data-oem-thumb]').addEventListener('click', function () {
    if (!this.dataset.big) return;
    $('[data-lb-img]').src = this.dataset.big;
    lb.hidden = false; document.body.style.overflow = 'hidden';
    $('[data-lb-close]').focus();
  });
  lb.addEventListener('click', function (e) { if (e.target === lb || e.target.closest('[data-lb-close]')) closeLb(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !lb.hidden) closeLb(); });
  oemModel.addEventListener('change', updateOem);
  oemQty.addEventListener('input', updateOem);
  $$('[data-oem-item]').forEach(function (x) { x.addEventListener('change', updateOem); });
  $$('[data-oem-certs] input').forEach(function (x) { x.addEventListener('change', updateOem); });
  ['[data-oem-cert-other]', '[data-oem-notes]'].forEach(function (s) { $(s).addEventListener('input', updateOem); });

  /* ---------- 起点：?from=产品 / ?tab=oem&model=产品 ---------- */
  var q = new URLSearchParams(location.search);
  var from = c.products.filter(function (p) { return p.slug === q.get('from'); })[0];
  if (from) {
    if (from.w) ratedEl.value = from.w;
    if (from.ports.length) countEl.value = String(from.ports.length);
    syncRows();
    $$('[data-port]', portsEl).forEach(function (row, i) { setPort(row, from.ports[i]); });
    if (from.mah) mahEl.value = from.mah;
    var chemInput = $('input[name="chem"][value="' + from.chem + '"]'); if (chemInput) chemInput.checked = true;
    var f = $('[data-from]'); f.hidden = false; f.textContent = fmt(T.fromProduct, { m: from.model });
  } else {
    syncRows();
  }
  if (q.get('model')) oemModel.value = q.get('model');
  if (q.get('tab') === 'oem') showTab('oem');
  update();
  updateOem();
})();
</script>

