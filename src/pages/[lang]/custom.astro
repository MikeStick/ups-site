  .cz-tabs button.on { background: var(--ink); color: #fff; border-color: var(--ink); }
  .cz-sub { margin: 0 0 14px; color: var(--muted); }
  .cz-from { margin: -6px 0 14px; font-size: 14px; background: var(--charge-soft); border-radius: 8px; padding: 9px 12px; }
  .cz-grid { display: grid; gap: 20px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 961px) { .cz-grid { grid-template-columns: minmax(0, 1fr) 360px; align-items: start; } .cz-side { position: sticky; top: 16px; } }
  .cz-main { display: grid; gap: 16px; min-width: 0; }
  .cz-card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 20px; display: grid; gap: 12px; min-width: 0; }
  .cz-card h2 { font-size: 22px; margin: 0; display: flex; align-items: center; flex-wrap: wrap; gap: 4px 10px; }
  .cz-card h2 span { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--accent); color: #fff; font-size: 16px; }
  .cz-card h2 em { font: 400 14px var(--body); text-transform: none; color: var(--muted); }
  .cz-hint { margin: 0; font-size: 13px; color: var(--muted); }
  .cz-hint.strong { color: var(--warn); font-weight: 600; }
  .cz-label { font-size: 13px; font-weight: 600; }
  .cz-label em { font-style: normal; font-weight: 400; color: var(--muted); }
  .cz-field { display: grid; gap: 6px; min-width: 0; }
  .cz-two { display: grid; gap: 12px; align-items: start; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .cz-inline { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 14px; }
  .cz input[type="number"], .cz input[type="text"], .cz select, .cz textarea {
    font: 15px var(--body); padding: 9px 11px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--ink); min-width: 0;
  }
  .cz input[type="number"] { width: 130px; font-family: var(--mono); }
  .cz textarea { width: 100%; resize: vertical; }
  .cz-locked { display: flex; justify-content: space-between; align-items: center; padding: 11px 14px; border-radius: 8px; background: var(--bg); border: 1px dashed var(--line); color: var(--muted); }
  .cz-locked b { color: var(--ink); }
  .cz-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .cz-chips button { font: 14px var(--body); padding: 7px 12px; border-radius: 99px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer; }
  .cz-chips button.on { border-color: var(--accent); background: var(--accent); color: #fff; }
  .cz-err { margin: 0; font-size: 12.5px; font-weight: 600; color: var(--warn); }
  .cz-ports { display: grid; gap: 10px; }
  .cz-port { border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; display: grid; gap: 8px; }
  .cz-port.ok { border-color: var(--accent); }
  .cz-port.bad { border-color: var(--warn); }
  .cz-port-head { display: flex; justify-content: space-between; gap: 10px; font-size: 14px; }
  .cz-port-w { color: var(--accent); font-weight: 600; }
  .cz-port-body { display: grid; gap: 10px; align-items: start; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
  .cz-port-body input { width: 100% !important; }
  .cz-portsum { display: grid; gap: 4px; font-size: 13.5px; border-radius: 8px; padding: 10px 12px; }
  .cz-portsum.fit { background: var(--ok-soft); }
  .cz-portsum.share { background: var(--charge-soft); }
  .cz-seg { display: grid; gap: 6px; }
  .cz-seg label, .cz-checks label { display: flex; gap: 8px; align-items: center; font-size: 14px; cursor: pointer; }
  .cz-checks { display: grid; gap: 8px; }
  .cz-wh { color: var(--accent); }
  .cz-run { margin: 0; font-size: 13.5px; color: var(--ok); font-weight: 600; }
  .cz-helper summary { cursor: pointer; font-size: 14px; color: var(--accent); font-weight: 600; }
  .cz-helper .cz-inline { margin-top: 10px; }
  .cz-helper input[type="number"] { width: 84px; }
  .cz-summary { gap: 14px; }
  .cz-fee { display: grid; gap: 4px; background: var(--charge-soft); border-radius: 10px; padding: 12px 14px; font-size: 13.5px; }
  .cz-fee b { font-size: 15px; }
  .cz-spec { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: 13px; }
  .cz-spec li { display: grid; gap: 2px; border-bottom: 1px dashed var(--line); padding-bottom: 7px; }
  .cz-spec span { color: var(--muted); font-family: var(--body); }
  .cz-spec b { font-weight: 500; overflow-wrap: anywhere; }
  .cz-missing { margin: 0; font-size: 12.5px; font-weight: 600; color: var(--warn); }
  .cz-cta { display: grid; gap: 8px; }
  .cz-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 18px; border-radius: 8px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); text-decoration: none; font: 600 15px var(--body); cursor: pointer; }
  .cz-btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .cz-btn.small { min-height: 36px; font-size: 13.5px; }
  .cz-btn.disabled, .cz-btn:disabled { opacity: .45; cursor: not-allowed; }
</style>
