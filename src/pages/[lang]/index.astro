---
import Base from '../../layouts/Base.astro';
import { LANGS, SITE } from '../../config.mjs';
import { UI, term, tiersOf } from '../../i18n.mjs';
import products from '../../data/products.json';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = UI[lang];
---
<Base lang={lang} title={`${t.products} · ${SITE.name}`} description={SITE.tagline[lang]} path="">
  <h1 class="page-title">{t.allProducts}</h1>
  {products.length === 0 && <p class="empty">{t.noProducts}</p>}
  <ul class="grid">
    {products.map((p) => {
      const tiers = tiersOf(p);
      const cover = p.images && p.images[0];
      const group = p.sale && p.sale.mode === 'group';
      return (
        <li class="card">
          <a href={`/${lang}/p/${p.slug}/`}>
            <div class="thumb">
              {cover ? <img src={cover.thumb} alt={p.model} loading="lazy" width="480" height="480" /> : <div class="noimg" />}
              {p.sale && <span class={`pill ${group ? 'group' : 'stock'}`}>{group ? t.group : t.stock}</span>}
            </div>
            <div class="info">
              <span class="type">{term(p.type, lang)}</span>
              <strong>{p.model}</strong>
              <span class="meta num">{[p.outputPower, p.batterySpec].filter(Boolean).join(' · ')}</span>
              {tiers.length > 0 && <span class="price"><span class="num">${tiers[tiers.length - 1].price.toFixed(2)}–${tiers[0].price.toFixed(2)}</span></span>}
            </div>
          </a>
        </li>
      );
    })}
  </ul>
</Base>

<style>
  .page-title { font-size: clamp(30px, 5vw, 44px); margin: 32px 0 20px; }
  .empty { color: var(--muted); }
  .grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 16px; }
  .card a { display: flex; flex-direction: column; height: 100%; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; color: inherit; text-decoration: none; transition: border-color .15s; }
  .card a:hover { border-color: var(--accent); }
  .thumb { position: relative; aspect-ratio: 1; background: #eef2f1; max-width: 100%; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .noimg { width: 100%; height: 100%; }
  .pill { position: absolute; left: 10px; top: 10px; font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; padding: 3px 9px; border-radius: 99px; }
  .pill.stock { background: var(--ok-soft); color: var(--ok); }
  .pill.group { background: var(--charge-soft); color: var(--warn); }
  .info { display: grid; gap: 2px; padding: 12px 14px 14px; }
  .type { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
  .info strong { font-size: 17px; }
  .meta { font-size: 13px; color: var(--muted); }
  .price { margin-top: 6px; font-weight: 600; color: var(--accent); }
</style>
