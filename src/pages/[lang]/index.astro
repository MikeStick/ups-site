---
// 首页（/）：让客户一进来就知道 SKE 做哪些产品。
// 顺序：开场动画（HomeHero）→ 产品总览（UPS / 光伏与储能 / 电池 三组，每个栏目一张卡片：图、名称、一句话、规格范围、型号数）
// → 按场景找产品 → 在线选型工具 → Mini UPS 在线订购（以前首页就是 Mini UPS 列表，现在在 /mini-ups/）→ 为什么选择 SKE。
// 栏目清单在 src/lib/catalog.mjs（菜单也用）；文字在 src/lib/home-i18n.mjs。
// 卡片图片：网站管理里的图片位 cat_<key>（比如 cat_online）→ 没有就用这个栏目第一个产品的主图 → 再没有就用线条图标。
import Base from '../../layouts/Base.astro';
import HomeHero from '../../components/HomeHero.astro';
import { LANGS, SITE } from '../../config.mjs';
import { UI, tiersOf } from '../../i18n.mjs';
import { HM } from '../../lib/home-i18n.mjs';
import { AT, STATS } from '../../lib/about-i18n.mjs';
import { catalog } from '../../lib/catalog.mjs';
import { capacityOf, invKw, essSpec, ciSpec, battModule, hvModule, pbModule, isMini } from '../../lib/category.mjs';
import all from '../../data/products.json';
import site from '../../data/site.json';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const T = HM[lang], t = UI[lang], A = AT[lang];
// 类目卡片图没上传时，先借用 About 页同类产品线图（fam_*）
const FAM = { mini: 'fam_dc', offline: 'fam_backup', online: 'fam_hf', industrial: 'fam_if', modular: 'fam_modular', rack: 'fam_rack', inverter: 'fam_inverter' };
const asset = (k) => { const a = site.assets && site.assets[k]; return a && a[0] ? a[0] : null; };

// 规格范围：按栏目的单位从已发布产品里算；没有产品时用 home-i18n 里的备用文字
const fmtVa = (va) => (va >= 1000 ? `${+(va / 1000).toFixed(1)} kVA` : `${va} VA`);
const span = (vals, f) => { const v = [...new Set(vals.filter((x) => x > 0))].sort((a, b) => a - b); if (!v.length) return ''; return v.length === 1 ? f(v[0]) : `${f(v[0])} – ${f(v[v.length - 1])}`; };
const kwhOf = (key, p) => (key === 'homeess' ? essSpec(p).kwh : key === 'ciess' ? ciSpec(p).kwh : key === 'hvcab' ? hvModule(p).kwh : battModule(p).kwh);
function rangeOf(it, ps) {
  if (it.unit === 'va') return span(ps.map((p) => capacityOf(p).va), fmtVa);
  if (it.unit === 'kw') return span(ps.map((p) => invKw(p)), (x) => `${x} kW`);
  if (it.unit === 'kwh') return span(ps.map((p) => kwhOf(it.key, p)), (x) => `${+(+x).toFixed(1)} kWh`);
  if (it.unit === 'v') { const v = [...new Set(ps.map((p) => pbModule(p).v).filter(Boolean))].sort((a, b) => a - b); return v.length ? `${v.join(' / ')} V` : ''; }
  return '';
}
const groups = catalog(lang).map((g) => ({
  ...g,
  items: g.items.map((it) => {
    const ps = it.f ? all.filter(it.f) : [];
    const img = asset(`cat_${it.key}`) || (it.key === 'designer' ? { src: '/img/cat_designer.png' } : null) || (FAM[it.key] && asset(FAM[it.key])) || (ps.find((p) => p.images && p.images[0]) || {}).images?.[0] || null;
    return { ...it, n: ps.length, range: it.tool ? '' : rangeOf(it, ps) || T.fallback[it.key] || '', img };
  }),
}));
// 开场动画下面的一排产品照片：每组三张类目图（中间大、两边小），点了跳到产品总览里对应的组
const STRIP_PICK = { ups: ['online', 'modular', 'mini'], solar: ['inverter', 'homeess', 'ciess'], batt: ['wall', 'hvcab', 'pbr'] };
const byKey0 = Object.fromEntries(groups.flatMap((g) => g.items.map((x) => [x.key, x])));
const strip = groups.map((g) => ({ key: g.key, n: g.items.filter((x) => !x.tool).length, pics: STRIP_PICK[g.key].map((k) => byKey0[k]).filter(Boolean),
  names: g.items.filter((x) => !x.tool).map((x) => x.label) }));
const byKey = Object.fromEntries(groups.flatMap((g) => g.items.map((x) => [x.key, x])));
const minis = all.filter(isMini).sort((a, b) => (b.images && b.images.length ? 1 : 0) - (a.images && a.images.length ? 1 : 0)).slice(0, 4);
const wa = (msg) => `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(msg)}`;
const statPick = STATS.filter((s) => ['years', 'area', 'countries'].includes(s.k));

// 栏目线条图标（48 × 48）
const ICONS = {
  mini: '<rect x="12" y="8" width="24" height="32" rx="4"/><path d="M18 16h12M20 34h8"/><path d="M24 20l-3 6h6l-3 6"/>',
  offline: '<rect x="14" y="6" width="20" height="36" rx="3"/><circle cx="24" cy="16" r="3"/><path d="M19 26h10M19 31h10M19 36h10"/>',
  online: '<rect x="12" y="6" width="24" height="36" rx="3"/><rect x="17" y="11" width="14" height="8" rx="1"/><path d="M17 26h14M17 31h14M17 36h14"/>',
  aio: '<rect x="12" y="6" width="24" height="36" rx="3"/><rect x="17" y="11" width="14" height="7" rx="1"/><rect x="16" y="22" width="7" height="8" rx="1"/><rect x="25" y="22" width="7" height="8" rx="1"/><rect x="16" y="32" width="7" height="6" rx="1"/><rect x="25" y="32" width="7" height="6" rx="1"/>',
  rack: '<rect x="6" y="10" width="36" height="8" rx="1.5"/><rect x="6" y="20" width="36" height="8" rx="1.5"/><rect x="6" y="30" width="36" height="8" rx="1.5"/><path d="M10 14h.01M10 24h.01M10 34h.01M30 14h8M30 24h8M30 34h8"/>',
  modular: '<rect x="8" y="4" width="32" height="40" rx="2"/><path d="M12 10h24M12 17h24M12 24h24M12 31h24M12 38h24"/><path d="M33 10v1M33 17v1M33 24v1"/>',
  industrial: '<path d="M4 42V22l10 6v-6l10 6v-6l10 6V8h10v34z"/><path d="M38 14h2"/>',
  inverter: '<rect x="10" y="6" width="28" height="36" rx="3"/><rect x="15" y="11" width="18" height="9" rx="1"/><path d="M18 28l4 4 8-8"/>',
  homeess: '<path d="M6 22L24 8l18 14M10 19v23h28V19"/><rect x="19" y="26" width="10" height="16" rx="1"/><path d="M22 31h4M22 36h4"/>',
  ciess: '<rect x="6" y="10" width="15" height="30" rx="2"/><rect x="27" y="10" width="15" height="30" rx="2"/><path d="M13.5 14v22M34.5 14v22M4 42h40"/>',
  designer: '<circle cx="34" cy="12" r="5"/><path d="M4 40l8-18h20l8 18zM14 22l-3 18M30 22l3 18M7 31h34"/>',
  wall: '<path d="M8 4v40"/><rect x="16" y="8" width="18" height="32" rx="3"/><path d="M21 20h8M21 25h8M21 30h8"/>',
  floor: '<rect x="13" y="6" width="22" height="32" rx="3"/><circle cx="24" cy="16" r="4"/><circle cx="17" cy="41" r="2.5"/><circle cx="31" cy="41" r="2.5"/>',
  rackbatt: '<rect x="6" y="12" width="36" height="10" rx="1.5"/><rect x="6" y="26" width="36" height="10" rx="1.5"/><path d="M11 17h14M11 31h14M33 17h4M33 31h4"/>',
  hvcab: '<rect x="12" y="4" width="24" height="40" rx="2"/><rect x="16" y="8" width="16" height="6" rx="1"/><path d="M16 19h16M16 24h16M16 29h16M16 34h16M16 39h16"/>',
  pbr: '<rect x="6" y="14" width="36" height="24" rx="3"/><path d="M12 14v-4h6v4M30 14v-4h6v4M14 26h6M31 23v6M28 26h6"/>',
};
const APP_ICONS = {
  home: '<path d="M6 22L24 8l18 14M10 19v23h28V19M20 42V30h8v12"/>',
  shop: '<path d="M6 18h36l-3-9H9zM8 18v24h32V18M18 42V30h12v12"/>',
  it: '<rect x="10" y="4" width="28" height="40" rx="2"/><path d="M15 11h18M15 18h18M15 25h18M15 32h18"/>',
  factory: '<path d="M4 42V22l10 6v-6l10 6v-6l10 6V8h10v34z"/>',
  solar: '<path d="M4 40l8-18h24l8 18zM16 22l-3 18M32 22l3 18M7 31h34"/><circle cx="36" cy="9" r="4"/>',
  replace: '<rect x="6" y="16" width="16" height="22" rx="2"/><rect x="26" y="16" width="16" height="22" rx="2"/><path d="M14 8a10 10 0 0 1 18 2M30 6l2 4-4 1"/>',
};
const TOOL_ICON = '<rect x="6" y="6" width="36" height="36" rx="4"/><path d="M14 30l6-6 5 5 9-11"/><circle cx="34" cy="18" r="2"/>';
const ld = { '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, url: Astro.site ? `${String(Astro.site).replace(/\/$/, '')}/${lang}/` : undefined,
  ...(SITE.email ? { email: SITE.email } : {}),
  hasOfferCatalog: { '@type': 'OfferCatalog', name: T.prodEyebrow, itemListElement: groups.map((g) => ({ '@type': 'OfferCatalog', name: T.groups[g.key][0], itemListElement: g.items.filter((x) => !x.tool).map((x) => ({ '@type': 'OfferCatalog', name: x.label })) })) } };
---
<Base lang={lang} title={`${T.metaTitle} · ${SITE.name}`} description={T.metaDesc} path="">
  <HomeHero lang={lang} />

  <section class="strip" aria-label={T.prodEyebrow}>
    {strip.map((g) => (
      <a class:list={['st', `g-${g.key}`]} href={`#g-${g.key}`}>
        <span class="st-pics">
          {[g.pics[1], g.pics[0], g.pics[2]].map((it, i) => it && (
            <span class:list={['st-pic', { mid: i === 1 }]}>
              {it.img ? <img src={it.img.thumb || it.img.src} alt={it.label} loading="lazy" /> : <svg viewBox="0 0 48 48" aria-hidden="true" set:html={ICONS[it.key]} />}
            </span>
          ))}
        </span>
        <span class="st-b">
          <b>{T.strip[g.key][0]}</b>
          <small>{T.strip[g.key][1]}</small>
          <span class="st-n">{T.stripCats.replace('{n}', String(g.n))} · {T.stripGo} ↓</span>
        </span>
      </a>
    ))}
  </section>

  <section class="hblock" id="products">
    <div class="hhead"><span class="eyebrow">{T.prodEyebrow}</span><h2>{T.prodH}</h2><p>{T.prodP}</p></div>
    {groups.map((g, gi) => (
      <div class:list={['grp', `g-${g.key}`]} id={`g-${g.key}`}>
        <div class="grp-h">
          <span class="grp-n num">0{gi + 1}</span>
          <h3>{T.groups[g.key][0]}</h3>
          <p>{T.groups[g.key][1]}</p>
          <span class="grp-tag">{g.h}</span>
        </div>
        <ul class="cats" style={`--cols:${g.items.length === 5 ? 5 : 4}`}>
          {g.items.map((it) => (
            <li>
              <a class:list={['cat', { istool: it.tool }]} href={`/${lang}/${it.page}`}>
                <span class="cimg">
                  {it.img ? <img src={it.img.thumb || it.img.src} alt={it.label} loading="lazy" /> : <svg viewBox="0 0 48 48" aria-hidden="true" set:html={ICONS[it.key]} />}
                </span>
                <span class="cbody">
                  <b>{it.label}</b>
                  <small>{T.cats[it.key]}</small>
                  <span class="cmeta">
                    {it.range && <span class="num">{it.range}</span>}
                    {it.tool ? <em>{T.tool}</em> : it.n > 0 && <em>{it.n === 1 ? T.model1 : T.models.replace('{n}', String(it.n))}</em>}
                  </span>
                </span>
                <span class="carr" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <section class="hblock">
    <div class="hhead"><span class="eyebrow">{T.appEyebrow}</span><h2>{T.appH}</h2></div>
    <div class="apps">
      {T.apps.map((a) => (
        <div class="app">
          <svg viewBox="0 0 48 48" aria-hidden="true" set:html={APP_ICONS[a.k]} />
          <h3>{a.h}</h3>
          <div class="chips">{a.cats.map((k) => byKey[k] && <a href={`/${lang}/${byKey[k].page}`}>{byKey[k].label}</a>)}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="hblock tools-b">
    <div class="hhead"><span class="eyebrow">{T.toolsEyebrow}</span><h2>{T.toolsH}</h2></div>
    <div class="tools">
      {T.tools.map(([h, p, href]) => (
        <a class="tool" href={`/${lang}/${href}`}><svg viewBox="0 0 48 48" aria-hidden="true" set:html={TOOL_ICON} /><span><b>{h}</b><small>{p}</small></span><i aria-hidden="true">→</i></a>
      ))}
    </div>
  </section>

  {minis.length > 0 && (
    <section class="hblock">
      <div class="hhead row">
        <div><span class="eyebrow">{T.miniEyebrow}</span><h2>{T.miniH}</h2><p>{T.miniP}</p></div>
        <a class="btn primary" href={`/${lang}/mini-ups/`}>{T.miniAll} →</a>
      </div>
      <ul class="minis">
        {minis.map((p) => {
          const tiers = tiersOf(p), cover = p.images && p.images[0];
          return (
            <li><a href={`/${lang}/p/${p.slug}/`}>
              <span class="mimg">{cover ? <img src={cover.thumb} alt={p.model} loading="lazy" /> : <svg viewBox="0 0 48 48" aria-hidden="true" set:html={ICONS.mini} />}</span>
              <b>{p.model}</b>
              {p.outputPower && <small class="num">{p.outputPower}</small>}
              {tiers.length > 0 && (() => { const ps = tiers.map((x) => x.price), lo = Math.min(...ps), hi = Math.max(...ps); return <span class="price num">${lo.toFixed(2)}{hi > lo ? `–$${hi.toFixed(2)}` : ''}</span>; })()}
            </a></li>
          );
        })}
      </ul>
    </section>
  )}

  <section class="hblock why">
    <div class="why-in">
      <div>
        <span class="eyebrow">{T.whyEyebrow}</span>
        <h2>{T.whyH}</h2>
        <p>{T.whyP}</p>
        <div class="stats">{statPick.map((s) => <div><b class="num">{s.n}<small>{s.u}</small></b><span>{T.stats[s.k]}</span></div>)}</div>
        <div class="why-cta">
          <a class="btn dark" href={`/${lang}/about/`}>{T.ctaAbout}</a>
          <a class="btn line" href={`/${lang}/custom/`}>{T.ctaCustom}</a>
          {SITE.whatsapp && <a class="btn line" href={wa(T.ctaWa)} target="_blank" rel="noopener">{T.ctaWa}</a>}
        </div>
      </div>
      <ul class="why-list">{T.why.map(([a, b]) => <li><b>{a}</b><span>{b}</span></li>)}</ul>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</Base>

<style>
  .hblock { margin: 56px 0 0; }
  .hhead { max-width: 760px; margin: 0 0 22px; }
  .hhead.row { max-width: none; display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; flex-wrap: wrap; }
  .hhead.row > div { max-width: 720px; }
  .eyebrow { font: 600 12px var(--mono); text-transform: uppercase; letter-spacing: .12em; color: var(--charge); }
  .hhead h2 { font-size: clamp(32px, 4.6vw, 52px); margin: 8px 0 10px; }
  .hhead p { margin: 0; color: var(--muted); font-size: 16px; line-height: 1.55; }
  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: 0 20px; border-radius: 8px; font-weight: 600; text-decoration: none; border: 1px solid transparent; }
  .btn.primary { background: var(--charge); color: var(--ink); }
  .btn.dark { background: var(--accent); color: #fff; }
  .btn.line { background: var(--surface); color: var(--ink); border-color: var(--line); }
  .btn:hover { filter: brightness(.96); }
  /* —— 开场动画下的产品照片条 —— */
  .strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin: 26px 0 0; }
  .st { display: grid; grid-template-rows: auto 1fr; border-radius: 18px; overflow: hidden; border: 1px solid var(--line); background: var(--surface); color: var(--ink); text-decoration: none; transition: border-color .15s, transform .15s, box-shadow .15s; }
  .st:hover { border-color: var(--accent); transform: translateY(-3px); box-shadow: 0 14px 30px rgba(15,107,92,.12); }
  .st-pics { display: grid; grid-template-columns: 1fr 1.4fr 1fr; align-items: end; gap: 0; padding: 18px 14px 0; height: 190px; box-sizing: border-box; background: linear-gradient(#f1f4f3, #e6ecea); }
  .g-solar .st-pics { background: linear-gradient(#faf5e6, #f3ead0); } .g-batt .st-pics { background: linear-gradient(#eef2fa, #e0e7f4); }
  .st-pic { position: relative; height: 72%; display: grid; place-items: center; }
  .st-pic.mid { height: 100%; }
  .st-pic img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; object-position: center bottom; mix-blend-mode: multiply; transition: transform .25s; }
  .st:hover .st-pic img { transform: translateY(-4px); }
  .st-pic svg { width: 56%; max-width: 70px; fill: none; stroke: var(--accent); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .g-solar .st-pic svg { stroke: #b07f00; } .g-batt .st-pic svg { stroke: #2b4f8f; }
  .st-b { display: grid; gap: 4px; align-content: start; padding: 16px 18px 18px; }
  .st-b b { font-family: var(--display); text-transform: uppercase; font-size: 24px; line-height: 1.05; }
  .st-b small { color: var(--muted); font-size: 14px; line-height: 1.45; }
  .st-n { margin-top: 6px; font: 600 12.5px var(--mono); color: var(--accent); }
  #products .grp { scroll-margin-top: 16px; }
  /* —— 产品总览 —— */
  .grp { padding: 30px 0 34px; border-top: 1px solid var(--line); }
  .grp-h { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; margin-bottom: 18px; }
  .grp-n { font: 700 14px var(--mono); color: var(--accent); }
  .grp-h h3 { margin: 0; font-family: var(--display); text-transform: uppercase; font-size: clamp(26px, 3vw, 34px); line-height: 1.05; }
  .grp-h p { margin: 0; flex-basis: 100%; color: var(--muted); font-size: 15.5px; line-height: 1.5; }
  .grp-tag { order: 2; padding: 3px 10px; border-radius: 999px; font: 600 11px var(--mono); text-transform: uppercase; letter-spacing: .06em; background: #e3efeb; color: var(--accent); }
  .g-solar .grp-tag { background: #fbefc6; color: #7a5a00; } .g-batt .grp-tag { background: #e6ecf8; color: #2b4f8f; }
  .grp-h p { order: 3; }
  .cats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr)); gap: 16px; }
  .cat { position: relative; display: flex; flex-direction: column; height: 100%; box-sizing: border-box; border-radius: 16px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); text-decoration: none; overflow: hidden; transition: border-color .15s, transform .15s, box-shadow .15s; }
  .cat:hover { border-color: var(--accent); transform: translateY(-3px); box-shadow: 0 14px 30px rgba(15,107,92,.12); }
  .cat:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cimg { position: relative; aspect-ratio: 4 / 3; background: #f1f4f3; display: grid; place-items: center; overflow: hidden; }
  .cimg img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 14px; box-sizing: border-box; mix-blend-mode: multiply; transition: transform .25s; }
  .cat:hover .cimg img { transform: scale(1.04); }
  .cimg svg { width: 84px; height: 84px; fill: none; stroke: var(--accent); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .g-solar .cimg { background: #faf5e6; } .g-solar .cimg svg { stroke: #b07f00; }
  .g-batt .cimg { background: #eef2fa; } .g-batt .cimg svg { stroke: #2b4f8f; }
  .cat.istool { border-style: dashed; }
  .cbody { display: grid; gap: 5px; align-content: start; flex: 1; padding: 16px 18px 18px; min-width: 0; }
  .cbody b { font-size: 18px; line-height: 1.25; }
  .cbody small { color: var(--muted); font-size: 14px; line-height: 1.45; }
  .cmeta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin-top: auto; padding-top: 10px; font-size: 13px; }
  .cmeta .num { font-family: var(--mono); font-weight: 600; color: var(--ink); background: var(--bg); border-radius: 6px; padding: 3px 8px; }
  .cmeta em { font-style: normal; color: var(--accent); font-weight: 600; }
  .carr { position: absolute; right: 16px; bottom: 16px; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: var(--bg); color: var(--muted); transition: background .15s, color .15s, transform .15s; }
  .cat:hover .carr { background: var(--accent); color: #fff; transform: translateX(3px); }
  .cmeta { padding-right: 36px; }
  /* —— 按场景 —— */
  .apps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .app { padding: 18px; border-radius: 14px; border: 1px solid var(--line); background: var(--surface); display: grid; gap: 10px; align-content: start; }
  .app svg { width: 32px; height: 32px; fill: none; stroke: var(--accent); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
