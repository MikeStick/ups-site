---
// 工频机 UPS 栏目页（Industrial UPS）：配置器（供电 / 负载 / 电机启动 / 整流 / 冗余 / 选配 / 电池 + 机柜内部示意）→ 已发布型号 → 卖点 → 工频 vs 高频 → 应用 → 项目报价。只询价，不显示价格。
// 产品来自客户档案系统，细分品类 = 工频UPS。选型计算：src/lib/industrial-engine.mjs
import Base from '../../layouts/Base.astro';
import IndustrialVisual from '../../components/IndustrialVisual.astro';
import { LANGS, SITE } from '../../config.mjs';
import { IT } from '../../lib/industrial-i18n.mjs';
import { isIndustrial, phaseOf, capacityOf, fmtCap, seriesName } from '../../lib/category.mjs';
import { specValue } from '../../lib/offline-i18n.mjs';
import all from '../../data/products.json';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const T = IT[lang];
const models = all.filter(isIndustrial).map((p) => ({ p, c: capacityOf(p), ph: phaseOf(p), s: seriesName(p) }))
  .sort((a, b) => a.ph.localeCompare(b.ph) || a.s.localeCompare(b.s) || a.c.va - b.c.va);
const phases = [...new Set(models.map((x) => x.ph))].sort();
// 首屏的容量范围写整个系列（1–400 kVA），不按已发布的型号算：发布的通常只是一部分
const rangeTxt = '1–400 kVA';
const wa = (msg: string) => `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(msg)}`;
const CAB_SVG = '<svg viewBox="0 0 200 200" aria-hidden="true"><rect x="40" y="14" width="120" height="176" rx="6" fill="#2b2720"/><rect x="52" y="26" width="46" height="18" rx="3" fill="#5ef0a0" opacity=".7"/><rect x="52" y="54" width="96" height="120" rx="3" fill="#3a352a"/><rect x="76" y="80" width="18" height="70" rx="6" fill="#e59a4f"/><rect x="106" y="80" width="18" height="70" rx="6" fill="#e59a4f"/></svg>';
const APP_ICONS = [
  '<path d="M6 27h18M9 27V12l6-6 6 6v15M12 17h6M12 22h6"/>',
  '<path d="M15 3l-6 12h6l-2 12 9-15h-6l3-9z"/>',
  '<path d="M4 25h22M7 25l3-12h10l3 12M12 13V6h6v7"/>',
  '<path d="M4 24l7-10 5 6 4-5 6 9zM9 8l3 3"/>',
  '<path d="M15 4c5 7 8 11 8 15a8 8 0 0 1-16 0c0-4 3-8 8-15z"/>',
  '<path d="M5 22h20M7 22V10h16v12M7 16h16M10 26l-2 2M20 26l2 2"/>',
  '<path d="M12 4h6M13 4v8l-6 12a2 2 0 0 0 2 3h12a2 2 0 0 0 2-3l-6-12V4"/>',
  '<rect x="4" y="5" width="22" height="20" rx="3"/><path d="M15 10v10M10 15h10"/>',
];
---
<Base lang={lang} title={`${T.title} · ${SITE.name}`} description={T.metaDesc} path="industrial-ups/">
<div class="off ind">
  <nav class="crumbs"><a href={`/${lang}/`}>{T.crumbs}</a> / {T.title}</nav>

  <section class="hero">
    <div class="hero-in">
      <div>
        <span class="eyebrow">{T.eyebrow}</span>
        <h1>{T.h1a}<em>{T.h1b}</em></h1>
        <p>{T.lead}</p>
        <div class="hero-cta">
          <a class="btn primary" href="#config">{T.ctaBuilder}</a>
          {models.length > 0 && <a class="btn ghost" href="#models">{T.ctaModels}</a>}
        </div>
      </div>
      <div class="hero-facts">
        <div><b class="num">{rangeTxt}</b><span>{T.facts.range}</span></div>
        <div><b class="num">6 / 12</b><span>{T.facts.rect}</span></div>
        <div><b class="num">N+1</b><span>{T.facts.red}</span></div>
        <div><b class="num">{T.isoV}</b><span>{T.facts.iso}</span></div>
      </div>
    </div>
  </section>

  <IndustrialVisual lang={lang} />

  {models.length > 0 && (
    <section class="block" id="models" data-models>
      <div class="head"><span class="eyebrow">{T.modelsEyebrow}</span><h2>{T.modelsH}</h2></div>
      {phases.length > 1 && (
        <div class="filters"><div class="fgroup">
          <button type="button" class="chip on" data-f="">{T.fAll}</button>
          {phases.map((ph) => <button type="button" class="chip" data-f={ph}>{T.phaseTag[ph]}</button>)}
        </div></div>
      )}
      <div class="grid">
        {models.map(({ p, c, ph }) => {
          const img = p.images && p.images[0];
          const rows = [['outputVoltage', specValue(p, 'outputVoltage', lang)], ['efficiencyAcMode', specValue(p, 'efficiencyAcMode', lang)]].filter(([, v]) => v);
          return (
            <article class="pcard" data-ph={ph}>
              <a class="pimg" href={`/${lang}/p/${p.slug}/`}>
                {img ? <img src={img.thumb || img.src} alt={p.model} loading="lazy" /> : <Fragment set:html={CAB_SVG} />}
                <span class="tags"><span class="tag u">{T.phaseTag[ph]}</span></span>
              </a>
              <div class="pbody">
                <h3><a href={`/${lang}/p/${p.slug}/`}>{p.model}</a></h3>
                {fmtCap(c) && <span class="va">{fmtCap(c)}</span>}
                {rows.length > 0 && <ul>{rows.map(([, v]) => <li><b>{v}</b></li>)}</ul>}
                <div class="pact"><a class="btn sm line" href={`/${lang}/p/${p.slug}/`}>{T.details}</a></div>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  )}

  <section class="block">
    <div class="head"><span class="eyebrow">{T.whyEyebrow}</span><h2>{T.whyH}</h2></div>
    <div class="feats">{T.feats.map(([a, b], i) => <div class="card feat"><span class="fi num">0{i + 1}</span><h3>{a}</h3><p>{b}</p></div>)}</div>
  </section>

  <section class="block">
    <div class="head"><span class="eyebrow">{T.vsEyebrow}</span><h2>{T.vsH}</h2></div>
    <div class="vs two">
      {(['lf', 'hf'] as const).map((k) => (
        <div class:list={['card', { hi: k === 'lf' }]}>
          <span class:list={['tag', { on: k === 'lf' }]}>{T.vs[k].tag}</span>
          <h3>{T.vs[k].h}</h3>
          <ul>{T.vs[k].rows.map(([a, b]) => <li><span>{a}</span><b>{b}</b></li>)}</ul>
          <p class="best">{T.vs[k].best}</p>
          {k === 'hf' && <p class="see"><a href={`/${lang}/modular-ups/`}>{T.seeMod}</a> · <a href={`/${lang}/rack-ups/`}>{T.seeRack}</a></p>}
        </div>
      ))}
    </div>
  </section>

  <section class="block">
    <div class="head"><span class="eyebrow">{T.appsEyebrow}</span><h2>{T.appsH}</h2></div>
    <div class="apps">{T.apps.map((a, i) => <div class="app"><svg viewBox="0 0 30 30" aria-hidden="true" set:html={APP_ICONS[i]} /><span>{a}</span></div>)}</div>
  </section>

  <section class="block">
    <div class="head"><span class="eyebrow">{T.projEyebrow}</span><h2>{T.projH}</h2></div>
    <div class="oem">
      <div class="oem-list">{T.proj.map(([a, b]) => <div><b>{a}</b><span>{b}</span></div>)}</div>
      <div class="oem-cta">
        <h3>{T.projCtaH}</h3>
        <p>{T.projCtaP}</p>
        {SITE.whatsapp && <div><a class="btn primary" href={wa(T.projMsg)} target="_blank" rel="noopener">{T.projCta}</a></div>}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="cta-box">
      <div><h2>{T.ctaH}</h2><p>{T.ctaP}</p></div>
      <div class="btns">
        {SITE.whatsapp && <a class="btn dark" href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">WhatsApp {SITE.whatsappDisplay}</a>}
        {SITE.email && <a class="btn line" href={`mailto:${SITE.email}`}>{SITE.email}</a>}
      </div>
    </div>
  </section>
</div>
</Base>

<script is:inline>
  // 型号列表：按相数筛选
  (function () {
    var box = document.querySelector('[data-models]'); if (!box) return;
    box.addEventListener('click', function (e) {
      var b = e.target.closest('[data-f]'); if (!b) return;
      box.querySelectorAll('[data-f]').forEach(function (x) { x.classList.toggle('on', x === b); });
      box.querySelectorAll('.pcard').forEach(function (c) { c.hidden = !!b.dataset.f && c.dataset.ph !== b.dataset.f; });
    });
  })();
</script>

<style>
  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: 0 18px; border-radius: 8px; font-weight: 600; text-decoration: none; border: 1px solid transparent; cursor: pointer; font-family: var(--body); font-size: 15px; }
  .btn.primary { background: var(--charge); color: var(--ink); }
  .btn.ghost { color: #fff; border-color: #4b5f5b; background: transparent; }
  .btn.dark { background: var(--accent); color: #fff; }
  .btn.line { background: var(--surface); color: var(--ink); border-color: var(--line); }
  .btn.sm { min-height: 38px; padding: 0 14px; font-size: 14px; }
  .eyebrow { font: 600 13px var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--charge); }
  .crumbs { font-size: 13px; color: var(--muted); margin: 18px 0 0; }
  .crumbs a { color: var(--muted); }
  section.block { padding-block: 56px 0; }
  .ind :global(.head) { display: grid; gap: 10px; margin-bottom: 22px; max-width: 760px; }
  .ind :global(.head h2) { font-size: clamp(28px, 4.2vw, 42px); }
  .ind :global(.head p) { margin: 0; color: var(--muted); }
  .ind :global(section.block) { padding-block: 56px 0; }
  .ind :global(.eyebrow) { font: 600 13px var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--charge); }

  .hero { background: #17150f; color: #fff; position: relative; overflow: hidden; margin-top: 14px; border-radius: 16px; }
  .hero::after { content: ""; position: absolute; inset: 0; background: repeating-linear-gradient(90deg, rgba(255,255,255,.035) 0 1px, transparent 1px 64px), repeating-linear-gradient(0deg, rgba(255,255,255,.035) 0 1px, transparent 1px 64px); pointer-events: none; }
  .hero::before { content: ""; position: absolute; right: -80px; top: -80px; width: 420px; height: 420px; border-radius: 50%; background: radial-gradient(closest-side, rgba(229,154,79,.28), transparent); pointer-events: none; }
  .hero-in { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: 28px; padding: 44px 40px; align-items: center; }
  @media (max-width: 860px) { .hero-in { grid-template-columns: minmax(0, 1fr); padding: 28px 20px; } }
  .hero h1 { font-size: clamp(36px, 5.6vw, 62px); margin: 10px 0 14px; }
  .hero h1 em { font-style: normal; color: #f0a959; }
  .hero p { margin: 0; color: #d6cfbf; font-size: 17px; max-width: 580px; }
  .hero-cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 22px; }
  .hero-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .hero-facts div { border: 1px solid #3f3826; border-radius: 12px; padding: 14px; }
  .hero-facts b { display: block; font: 700 28px/1.05 var(--display); color: #f0a959; }
  .hero-facts span { font-size: 13px; color: #b5ad9a; }

  .card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 20px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px 18px; align-items: center; margin-bottom: 16px; }
  .fgroup { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .chip { font: 14px var(--body); padding: 6px 12px; border-radius: 99px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer; }
  .chip.on { background: var(--ink); color: #fff; border-color: var(--ink); }
  .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 460px) { .grid { grid-template-columns: minmax(0, 1fr); } }
  .pcard { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; display: grid; grid-template-rows: auto 1fr; }
  .pcard[hidden] { display: none; }
  .pimg { aspect-ratio: 1 / 1; overflow: hidden; background: #fff; display: grid; place-items: center; position: relative; border-bottom: 1px solid var(--line); }
  .pimg img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 4%; box-sizing: border-box; }
  .pimg :global(svg) { width: 62%; }
  .pimg .tags { position: absolute; left: 10px; top: 10px; display: flex; gap: 6px; }
  .tag { font: 600 11px var(--mono); text-transform: uppercase; letter-spacing: .05em; padding: 3px 8px; border-radius: 99px; background: var(--charge-soft); color: #7a5a00; }
  .tag.u { background: var(--ink); color: #fff; }
  .tag.on { background: #b4651e; color: #fff; }
  .pbody { padding: 14px 16px 16px; display: grid; gap: 8px; align-content: start; }
  .pbody h3 { font-size: 24px; }
  .pbody h3 a { color: inherit; text-decoration: none; }
  .pbody .va { font: 600 15px var(--mono); }
  .pbody ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 3px; font-size: 13px; color: var(--muted); }
  .pbody ul b { color: var(--ink); font-weight: 500; }
  .pact { display: flex; gap: 8px; margin-top: 4px; }
  .pact .btn { flex: 1; }

  .feats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  @media (max-width: 1000px) { .feats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .feats { grid-template-columns: minmax(0, 1fr); } }
  .feat { display: grid; gap: 8px; align-content: start; }
  .feat .fi { font: 700 14px var(--mono); color: #b4651e; }
  .feat h3 { font-size: 22px; }
  .feat p { margin: 0; font-size: 14px; color: var(--muted); }

  .vs { display: grid; gap: 14px; }
  .vs.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (max-width: 760px) { .vs.two { grid-template-columns: minmax(0, 1fr); } }
  .vs .card h3 { font-size: 26px; margin: 6px 0 8px; }
  .vs .card.hi { border-color: #b4651e; box-shadow: inset 0 0 0 1px #b4651e; }
  .vs ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; font-size: 14px; }
  .vs li { display: grid; grid-template-columns: 130px minmax(0, 1fr); gap: 10px; border-top: 1px dashed var(--line); padding-top: 8px; }
  .vs li span { color: var(--muted); }
  .vs li b { font-weight: 500; }
  .vs .best { font-size: 13px; color: #b4651e; font-weight: 600; margin: 10px 0 0; }
  .see { margin: 10px 0 0; font-size: 14px; font-weight: 600; }

  .apps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  @media (max-width: 760px) { .apps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .app { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 14px; display: grid; gap: 8px; justify-items: start; font-size: 14px; }
  .app svg { width: 30px; height: 30px; color: #b4651e; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  .oem { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; align-items: stretch; }
  @media (max-width: 860px) { .oem { grid-template-columns: minmax(0, 1fr); } }
  .oem-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .oem-list div { border: 1px solid var(--line); border-radius: 10px; padding: 12px; background: var(--surface); }
  .oem-list b { display: block; font-size: 15px; }
  .oem-list span { font-size: 13px; color: var(--muted); }
  .oem-cta { background: #17150f; color: #fff; border-radius: 12px; padding: 24px; display: grid; gap: 12px; align-content: center; }
  .oem-cta h3 { font-size: 30px; }
  .oem-cta p { margin: 0; color: #d6cfbf; }

  .cta { padding-block: 56px; }
  .cta-box { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 28px; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 18px; align-items: center; }
  @media (max-width: 760px) { .cta-box { grid-template-columns: minmax(0, 1fr); padding: 20px; } }
  .cta-box h2 { font-size: clamp(26px, 3.6vw, 38px); }
  .cta-box p { margin: 6px 0 0; color: var(--muted); }
  .cta-box .btns { display: flex; gap: 10px; flex-wrap: wrap; }
</style>
