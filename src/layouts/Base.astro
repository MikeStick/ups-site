---
import { SITE, LANGS, DEFAULT_LANG } from '../config.mjs';
import { UI } from '../i18n.mjs';
import { CO } from '../lib/contact-i18n.mjs';
import { CS } from '../lib/cases-i18n.mjs';
import { AT } from '../lib/about-i18n.mjs';
import { NW } from '../lib/news-i18n.mjs';
import { ST } from '../lib/search-i18n.mjs';
import { OT } from '../lib/offline-i18n.mjs';
import { catalog } from '../lib/catalog.mjs';
import SiteFooter from '../components/SiteFooter.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { RT } from '../lib/rack-i18n.mjs';
import { MT } from '../lib/modular-i18n.mjs';
import { IT } from '../lib/industrial-i18n.mjs';
import { OL } from '../lib/online-i18n.mjs';
import { SL } from '../lib/solar-i18n.mjs';
import { RB } from '../lib/rackbatt-i18n.mjs';
import { WB } from '../lib/wallbatt-i18n.mjs';
import { FB } from '../lib/floorbatt-i18n.mjs';
import { SD, NAV_GROUPS } from '../lib/designer-i18n.mjs';
import { AO } from '../lib/aio-i18n.mjs';
import { HV } from '../lib/hvcab-i18n.mjs';
import { PB } from '../lib/pbr-i18n.mjs';
import { HE } from '../lib/ess-i18n.mjs';
import { CI } from '../lib/cie-i18n.mjs';

// full：页面自己控制宽度（About 页有通栏区块），不套 .wrap
const { lang, title, description = '', path = '', full = false } = Astro.props;
const t = UI[lang];
const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
// path：不含语言前缀的路径，例如 "p/poe-36e-lfp-48v/"，用来生成其他语言版本的链接
const altHref = (l) => `/${l}/${path}`;
// 产品菜单：三栏（UPS / 光伏与储能 / 电池），清单在 src/lib/catalog.mjs（首页也用它）。手机上排成一列，每组一个小标题。
const NAV = catalog(lang).map((g) => ({ h: g.h, items: g.items.flatMap((x) => [[x.page, x.label], ...(x.sub ? [[x.sub.page, x.sub.label, 'sub']] : [])]) }));
const PRODUCT_PATHS = NAV.flatMap((g) => g.items.map(([h]) => h)).filter(Boolean);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={`${site}${altHref(lang)}`} />
  {LANGS.map((l) => <link rel="alternate" hreflang={l} href={`${site}${altHref(l)}`} />)}
  <link rel="alternate" hreflang="x-default" href={`${site}${altHref(DEFAULT_LANG)}`} />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
  <style is:global>
    :root {
      --bg: #f3f5f4; --surface: #ffffff; --ink: #15211f; --muted: #5d6b68; --line: #d6dedb;
      --accent: #0f6b5c; --accent-ink: #ffffff; --charge: #e0a800; --charge-soft: #fbefc6;
      --ok: #1d7a3e; --ok-soft: #dcf1e2; --warn: #a5480b;
      --display: "Barlow Condensed", "Arial Narrow", sans-serif;
      --body: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
      --mono: "IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace;
      color-scheme: light;
    }
    * { box-sizing: border-box; }
    [hidden] { display: none !important; }
    html { -webkit-text-size-adjust: 100%; }
    body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.55 var(--body); }
    img { max-width: 100%; display: block; }
    a { color: var(--accent); }
    .wrap { max-width: 1160px; margin: 0 auto; padding-inline: 16px; }
    .num { font-family: var(--mono); font-variant-numeric: tabular-nums; }
    :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    h1, h2 { font-family: var(--display); text-transform: uppercase; letter-spacing: .01em; line-height: 1.05; text-wrap: balance; }

    .top { background: var(--ink); color: #fff; }
    .top .wrap { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-block: 12px; flex-wrap: wrap; }
    .brand { color: #fff; text-decoration: none; font-family: var(--display); font-size: 24px; text-transform: uppercase; letter-spacing: .03em; }
    .brand small { display: block; font-family: var(--body); font-size: 12px; text-transform: none; letter-spacing: 0; color: #a9b8b4; }
    .top-right { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .nav-search { display: flex; align-items: center; gap: 6px; color: #fff; text-decoration: none; font: 600 13px var(--body); padding: 6px 10px; border-radius: 6px; border: 1px solid #4b5f5b; }
    .nav-search svg { width: 16px; height: 16px; }
    .nav-search:hover { background: #22302d; }
    @media (max-width: 1100px) { .nav-search span { display: none; } }
    /* 搜索浮层：顶部弹出，边输入边出结果 */
    .qs { position: fixed; inset: 0; z-index: 200; }
    .qs[hidden] { display: none; }
    .qs-back { position: absolute; inset: 0; background: rgba(10,18,16,.55); backdrop-filter: blur(2px); }
    .qs-panel { position: relative; width: min(760px, calc(100% - 24px)); margin: 70px auto 0; background: var(--surface); border-radius: 14px; box-shadow: 0 24px 60px rgba(0,0,0,.3); overflow: hidden; display: flex; flex-direction: column; max-height: calc(100vh - 100px); }
    .qs-box { display: flex; align-items: center; gap: 10px; padding: 0 16px; border-bottom: 1px solid var(--line); }
    .qs-box svg { width: 20px; height: 20px; color: var(--muted); flex: none; }
    .qs-box input { flex: 1; min-width: 0; border: 0; outline: 0; font: 500 17px var(--body); padding: 17px 0; background: transparent; color: var(--ink); }
    .qs-box input::-webkit-search-cancel-button { display: none; }
    .qs-close { border: 1px solid var(--line); background: var(--bg); border-radius: 6px; font: 600 11px var(--mono); padding: 4px 7px; color: var(--muted); cursor: pointer; }
    .qs-res { overflow-y: auto; padding: 8px; }
    .qs-hint { color: var(--muted); font-size: 13px; margin: 8px 10px; }
    .qs-sec { font: 600 11px var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 10px 10px 4px; }
    .qs-pages { display: flex; flex-wrap: wrap; gap: 6px; padding: 2px 8px 6px; }
    .qs-pages a { background: var(--charge-soft); color: var(--ink); text-decoration: none; border-radius: 99px; padding: 5px 12px; font: 600 13px var(--body); }
    .qs-it { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 8px 10px; border-radius: 10px; color: var(--ink); text-decoration: none; }
    .qs-it:hover, .qs-it.on { background: var(--bg); }
    .qs-it .qs-img { width: 56px; height: 44px; border-radius: 6px; background: var(--bg); overflow: hidden; display: grid; place-items: center; }
    .qs-it img { width: 100%; height: 100%; object-fit: contain; }
    .qs-it b { display: block; font: 700 16px/1.15 var(--display); }
    .qs-it small { display: block; font: 500 12px var(--mono); color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .qs-it em { font: 500 12.5px var(--mono); font-style: normal; color: var(--ink); white-space: nowrap; }
    .qs-all { display: block; margin: 6px 8px 4px; padding: 11px; border-radius: 10px; text-align: center; background: var(--ink); color: #fff; text-decoration: none; font-weight: 700; }
    .qs-none { padding: 14px 10px; color: var(--muted); }
    @media (max-width: 640px) { .qs-panel { margin-top: 10px; max-height: calc(100vh - 20px); } .qs-it { grid-template-columns: 48px minmax(0, 1fr); } .qs-it em { display: none; } }
    .nav-custom { color: #fff; text-decoration: none; font-weight: 600; font-size: 14px; padding: 6px 12px; border-radius: 6px; background: var(--accent); }
    .nav-custom[aria-current="page"] { background: transparent; box-shadow: inset 0 0 0 1px var(--accent); }
    .nav { display: flex; gap: 2px; }
    .nav a { color: #cfd9d6; text-decoration: none; font-size: 14px; padding: 6px 10px; border-radius: 6px; }
    .nav a:hover { color: #fff; }
    .nav a[aria-current="page"] { color: #fff; box-shadow: inset 0 0 0 1px #4b5f5b; }
    /* 产品：下拉菜单（Mini UPS / 离线式 UPS / 以后的品类） */
    .top .wrap { position: relative; }
    .nav-menu { position: static; }
    .nav-menu summary { list-style: none; cursor: pointer; color: #cfd9d6; font-size: 14px; padding: 6px 10px; border-radius: 6px; user-select: none; }
    .nav-menu summary::-webkit-details-marker { display: none; }
    .nav-menu summary i { font-style: normal; font-size: 10px; color: #a9b8b4; }
    .nav-menu summary:hover, .nav-menu[open] summary { color: #fff; }
    .nav-menu summary[aria-current="page"] { color: #fff; box-shadow: inset 0 0 0 1px #4b5f5b; }
    .nav-list { position: absolute; right: 0; top: calc(100% - 6px); z-index: 50; width: min(960px, calc(100vw - 32px)); box-sizing: border-box; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 12px 30px rgba(0,0,0,.18); padding: 14px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px 14px; }
    .nav-col { display: grid; align-content: start; gap: 1px; }
    .nav-col + .nav-col { border-left: 1px solid var(--line); padding-left: 14px; }
    .nav-gh { font: 600 11px var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--muted); padding: 4px 10px 8px; }
    .nav-list a { color: var(--ink) !important; text-decoration: none; font-size: 14px; padding: 8px 10px; border-radius: 7px; box-shadow: none !important; }
    .nav-list a:hover { background: var(--bg); }
    .nav-list a.sub { margin: -2px 0 2px 12px; padding: 5px 10px; font-size: 13px; color: var(--accent) !important; font-weight: 600; }
    .nav-list a.sub i { font-style: normal; margin-right: 6px; color: var(--muted); }
    @media (max-width: 700px) {
      .nav-list { grid-template-columns: minmax(0, 1fr); padding: 10px; gap: 4px; }
      .nav-col + .nav-col { border-left: 0; padding-left: 0; border-top: 1px solid var(--line); padding-top: 8px; }
      .nav-gh { padding-bottom: 4px; }
    }
    .nav-list a[aria-current="page"] { background: var(--ok-soft); font-weight: 600; }
    /* 语言：一个下拉菜单 */
    .lang-menu { position: relative; }
    .lang-menu summary { list-style: none; display: flex; align-items: center; gap: 6px; cursor: pointer; color: #fff; font: 600 13px var(--body); padding: 6px 10px; border-radius: 6px; border: 1px solid #4b5f5b; user-select: none; }
    .lang-menu summary::-webkit-details-marker { display: none; }
    .lang-menu summary svg { width: 16px; height: 16px; }
    .lang-menu summary i { font-style: normal; font-size: 10px; color: #a9b8b4; }
    .lang-menu[open] summary { background: #22302d; }
    .lang-list { position: absolute; right: 0; top: calc(100% + 6px); z-index: 50; min-width: 170px; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 12px 30px rgba(0,0,0,.18); padding: 6px; display: grid; }
    /* 手机上语言按钮会换到第二行左侧，菜单改为向右展开，避免超出屏幕 */
    @media (max-width: 640px) { .lang-list { right: auto; left: 0; } }
    .lang-list a { display: flex; gap: 10px; align-items: center; padding: 9px 10px; border-radius: 7px; color: var(--ink); text-decoration: none; font-size: 14px; }
    .lang-list a b { font: 600 12px var(--mono); color: var(--muted); width: 22px; }
    .lang-list a:hover { background: var(--bg); }
    .lang-list a[aria-current="true"] { background: var(--ok-soft); }
    .lang-list a[aria-current="true"]::after { content: "✓"; margin-left: auto; color: var(--accent); font-weight: 700; }
  </style>
</head>
<body id="top">
  <header class="top">
    <div class="wrap">
      <a class="brand" href={`/${lang}/`}>{SITE.name}<small>{SITE.tagline[lang]}</small></a>
      <div class="top-right">
      <nav class="nav" aria-label="Main">
        <details class="nav-menu" data-nav-menu>
          <summary aria-current={path === '' || PRODUCT_PATHS.includes(path) || path.startsWith('batteries/') || path.startsWith('p/') ? 'page' : undefined}>{t.products} <i aria-hidden="true">▾</i></summary>
          <div class="nav-list">
            {NAV.map((g) => (
              <div class="nav-col">
                <span class="nav-gh">{g.h}</span>
                {g.items.map(([href, label, cls]) => <a class={cls} href={`/${lang}/${href}`} aria-current={path === href ? 'page' : undefined}>{cls === 'sub' && <i aria-hidden="true">↳</i>}{label}</a>)}
              </div>
            ))}
          </div>
        </details>
        <a href={`/${lang}/cases/`} aria-current={path === 'cases/' ? 'page' : undefined}>{CS[lang].nav}</a>
        <a href={`/${lang}/news/`} aria-current={String(path || '').startsWith('news/') ? 'page' : undefined}>{NW[lang].nav}</a>
        <a href={`/${lang}/about/`} aria-current={path === 'about/' ? 'page' : undefined}>{AT[lang].nav}</a>
      </nav>
      <a class="nav-search" href={`/${lang}/search/`} data-qs-open aria-label={ST[lang].open} title={ST[lang].nav}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span>{ST[lang].nav}</span>
      </a>
      <a class="nav-custom" href={`/${lang}/contact/`} aria-current={path === 'contact/' ? 'page' : undefined}>{CO[lang].nav}</a>
      <details class="lang-menu" data-lang-menu>
        <summary aria-label="Language">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3 12h18M12 3c2.6 2.6 3.8 5.6 3.8 9s-1.2 6.4-3.8 9c-2.6-2.6-3.8-5.6-3.8-9S9.4 5.6 12 3z" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          <span>{lang.toUpperCase()}</span><i aria-hidden="true">▾</i>
        </summary>
        <div class="lang-list">
          {LANGS.map((l) => <a href={altHref(l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : 'false'}><b>{l.toUpperCase()}</b> {UI[l].langName}</a>)}
        </div>
      </details>
      </div>
    </div>
  </header>
  <div class="qs" data-qs hidden data-t={JSON.stringify(ST[lang])}>
    <div class="qs-back" data-qs-close></div>
    <div class="qs-panel" role="dialog" aria-modal="true" aria-label={ST[lang].nav}>
      <form class="qs-box" role="search" action={`/${lang}/search/`} data-qs-form>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input type="search" name="q" placeholder={ST[lang].ph} autocomplete="off" data-qs-q aria-label={ST[lang].nav} />
        <button type="button" class="qs-close" data-qs-close aria-label={ST[lang].close}>Esc</button>
      </form>
      <div class="qs-res" data-qs-res><p class="qs-hint">{ST[lang].hint}</p></div>
    </div>
  </div>
  <main class:list={[{ wrap: !full }]}>
    <slot />
  </main>
  <SiteFooter lang={lang} altHref={altHref} />
  <ChatWidget lang={lang} />
  <script>
    // 顶部搜索浮层：点放大镜 / 按 "/" 或 Ctrl+K 打开；索引第一次打开时下载（/[lang]/search.json）
    import { runSearch, matchPages } from '../lib/search-core.mjs';
    const qs = document.querySelector('[data-qs]');
    const qIn = document.querySelector('[data-qs-q]');
    const res = document.querySelector('[data-qs-res]');
    const lang = document.documentElement.lang || 'en';
    const T = JSON.parse(qs.dataset.t || '{}');
    let index = null, loading = null, sel = -1;
    const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const load = () => loading || (loading = fetch(`/${lang}/search.json`).then((r) => r.json()).then((j) => { index = j; return j; }));
    function draw() {
      const q = qIn.value.trim();
      if (!q || !index) { res.innerHTML = `<p class="qs-hint">${esc(T.hint || '')}</p>`; return; }
      const { list } = runSearch(index, { q });
      const pages = matchPages(index, q).slice(0, 6);
      const url = `/${lang}/search/?q=${encodeURIComponent(q)}`;
      let h = '';
      if (pages.length) h += `<div class="qs-sec">${esc(T.pages)}</div><div class="qs-pages">${pages.map((p) => `<a href="${p.u}">${esc(p.l)} →</a>`).join('')}</div>`;
      if (list.length) {
        h += list.slice(0, 7).map((it, i) => `<a class="qs-it${i === sel ? ' on' : ''}" href="${it.u}"><span class="qs-img">${it.img ? `<img src="${esc(it.img)}" alt="" loading="lazy">` : ''}</span><span><b>${esc(it.m)}</b><small>${esc(it.cl)}</small></span>${it.label ? `<em>${esc(it.label)}</em>` : ''}</a>`).join('');
        h += `<a class="qs-all" href="${url}">${esc((T.seeAll || '').replace('{n}', list.length))} →</a>`;
      } else if (!pages.length) h += `<p class="qs-none">${esc(T.none)}</p><a class="qs-all" href="/${lang}/contact/">${esc(T.ask)} →</a>`;
      res.innerHTML = h;
    }
    function open(e) {
      if (e) e.preventDefault();
      const own = document.querySelector('[data-sr-q]'); // 已经在搜索页：直接用页面上的搜索框
      if (own) { own.focus(); own.select(); own.scrollIntoView({ block: 'center', behavior: 'smooth' }); return; }
      qs.hidden = false; document.body.style.overflow = 'hidden';
      qIn.focus(); qIn.select();
      load().then(draw).catch(() => { location.href = `/${lang}/search/`; });
    }
    function close() { qs.hidden = true; document.body.style.overflow = ''; }
    document.querySelectorAll('[data-qs-open]').forEach((a) => a.addEventListener('click', open));
    document.querySelectorAll('[data-qs-close]').forEach((a) => a.addEventListener('click', close));
    let tm;
    qIn.addEventListener('input', () => { sel = -1; clearTimeout(tm); tm = setTimeout(draw, 80); });
    qIn.addEventListener('keydown', (e) => {
      const its = [...res.querySelectorAll('.qs-it')];
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault(); if (!its.length) return;
        sel = (sel + (e.key === 'ArrowDown' ? 1 : -1) + its.length) % its.length;
        its.forEach((a, i) => a.classList.toggle('on', i === sel)); its[sel].scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'Enter' && sel >= 0 && its[sel]) { e.preventDefault(); location.href = its[sel].href; }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !qs.hidden) { close(); return; }
      const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement && document.activeElement.tagName) || (document.activeElement && document.activeElement.isContentEditable);
      if (qs.hidden && !typing && (e.key === '/' || ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k'))) {
        open(e);
      }
    });
  </script>
  <script is:inline>
    (function () {
      // 点菜单外面或按 Esc 收起下拉菜单（语言、产品）
      var ms = document.querySelectorAll('[data-lang-menu], [data-nav-menu]');
      document.addEventListener('click', function (e) { ms.forEach(function (m) { if (m.open && !m.contains(e.target)) m.open = false; }); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') ms.forEach(function (m) { m.open = false; }); });
    })();
  </script>
</body>
</html>
