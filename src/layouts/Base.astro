---
import { SITE, LANGS, DEFAULT_LANG , RTL_LANGS } from '../config.mjs';
import { UI } from '../i18n.mjs';
import { CO } from '../lib/contact-i18n.mjs';
import { CS } from '../lib/cases-i18n.mjs';
import { AT } from '../lib/about-i18n.mjs';
import { NW } from '../lib/news-i18n.mjs';
import { OT } from '../lib/offline-i18n.mjs';
import { catalog } from '../lib/catalog.mjs';
import SiteFooter from '../components/SiteFooter.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { RT } from '../lib/rack-i18n.mjs';
import { MT } from '../lib/modular-i18n.mjs';
import { IT } from '../lib/industrial-i18n.mjs';
import { OL } from '../lib/online-i18n.mjs';
import { SL } from '../lib/solar-i18n.mjs';
import { RB } from '../lib/rackbatt-i18n.mjs';
import { WB } from '../lib/wallbatt-i18n.mjs';
import { FB } from '../lib/floorbatt-i18n.mjs';
import { SD, NAV_GROUPS } from '../lib/designer-i18n.mjs';
import { AO } from '../lib/aio-i18n.mjs';
import { HV } from '../lib/hvcab-i18n.mjs';
import { PB } from '../lib/pbr-i18n.mjs';
import { HE } from '../lib/ess-i18n.mjs';
import { CI } from '../lib/cie-i18n.mjs';

// full：页面自己控制宽度（About 页有通栏区块），不套 .wrap
const { lang, title, description = '', path = '', full = false } = Astro.props;
const t = UI[lang];
const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
// path：不含语言前缀的路径，例如 "p/poe-36e-lfp-48v/"，用来生成其他语言版本的链接
const altHref = (l) => `/${l}/${path}`;
// 产品菜单：三栏（UPS / 光伏与储能 / 电池），清单在 src/lib/catalog.mjs（首页也用它）。手机上排成一列，每组一个小标题。
const NAV = catalog(lang).map((g) => ({ h: g.h, items: g.items.flatMap((x) => [[x.page, x.label], ...(x.sub ? [[x.sub.page, x.sub.label, 'sub']] : [])]) }));
const PRODUCT_PATHS = NAV.flatMap((g) => g.items.map(([h]) => h)).filter(Boolean);
import { VT } from '../lib/visit-i18n.mjs';
import { SUP } from '../lib/service-i18n.mjs';
const CONTACT_US = { en: 'Contact us', es: 'Contáctenos', ru: 'Связаться с нами', ar: 'اتصل بنا' };
const VISIT_SUB = { en: 'Beijing · Shenzhen · Dongguan factory', es: 'Pekín · Shenzhen · fábrica de Dongguan', ru: 'Пекин · Шэньчжэнь · завод в Дунгуане', ar: 'بكين · شنتشن · مصنع دونغقوان' };
---
<!doctype html>
<html lang={lang} dir={RTL_LANGS.includes(lang) ? 'rtl' : 'ltr'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={`${site}${altHref(lang)}`} />
  {LANGS.map((l) => <link rel="alternate" hreflang={l} href={`${site}${altHref(l)}`} />)}
  <link rel="alternate" hreflang="x-default" href={`${site}${altHref(DEFAULT_LANG)}`} />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
  {RTL_LANGS.includes(lang) && <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" />}
  <style is:global>
    :root {
      --bg: #f3f5f4; --surface: #ffffff; --ink: #15211f; --muted: #5d6b68; --line: #d6dedb;
      --accent: #0f6b5c; --accent-ink: #ffffff; --charge: #e0a800; --charge-soft: #fbefc6;
      --ok: #1d7a3e; --ok-soft: #dcf1e2; --warn: #a5480b;
      --display: "Barlow Condensed", "Arial Narrow", sans-serif;
      --body: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
      --mono: "IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace;
      color-scheme: light;
    }
    /* 阿拉伯语：阿拉伯文字用 IBM Plex Sans Arabic（拉丁字母和数字仍用原字体）；阿拉伯文是连写的，不能加字间距 */
    [dir="rtl"] {
      --display: "Barlow Condensed", "IBM Plex Sans Arabic", "Arial Narrow", sans-serif;
      --body: "IBM Plex Sans", "IBM Plex Sans Arabic", system-ui, -apple-system, "Segoe UI", sans-serif;
      --mono: "IBM Plex Mono", "IBM Plex Sans Arabic", ui-monospace, Menlo, Consolas, monospace;
    }
    [dir="rtl"] *, [dir="rtl"] *::before, [dir="rtl"] *::after { letter-spacing: 0 !important; }
    [dir="rtl"] h1, [dir="rtl"] h2 { line-height: 1.25; }
    * { box-sizing: border-box; }
    [hidden] { display: none !important; }
    html { -webkit-text-size-adjust: 100%; }
    body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.55 var(--body); }
    img { max-width: 100%; display: block; }
    a { color: var(--accent); }
    .wrap { max-width: 1160px; margin: 0 auto; padding-inline: 16px; }
    .num { font-family: var(--mono); font-variant-numeric: tabular-nums; }
    :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    h1, h2 { font-family: var(--display); text-transform: uppercase; letter-spacing: .01em; line-height: 1.05; text-wrap: balance; }

    .top { background: var(--ink); color: #fff; }
    .top .wrap { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-block: 12px; flex-wrap: wrap; }
    .brand { color: #fff; text-decoration: none; font-family: var(--display); font-size: 24px; text-transform: uppercase; letter-spacing: .03em; }
    .brand small { display: block; font-family: var(--body); font-size: 12px; text-transform: none; letter-spacing: 0; color: #a9b8b4; }
    .top-right { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .nav-custom { color: #fff; text-decoration: none; font-weight: 600; font-size: 14px; padding: 6px 12px; border-radius: 6px; background: var(--accent); }
    .nav-custom[aria-current="page"] { background: transparent; box-shadow: inset 0 0 0 1px var(--accent); }
    /* 页眉 Contact 下拉：联系我们 / 预约拜访 */
    .contact-menu { position: relative; }
    .contact-menu summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 6px; user-select: none; }
    .contact-menu summary::-webkit-details-marker { display: none; }
    .contact-menu summary i { font-style: normal; font-size: 10px; opacity: .8; }
    .contact-menu[open] summary { filter: brightness(1.12); }
    .contact-list { position: absolute; right: 0; top: calc(100% + 6px); z-index: 50; min-width: 250px; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 12px 30px rgba(0,0,0,.18); padding: 6px; display: grid; gap: 2px; }
    [dir="rtl"] .contact-list { right: auto; left: 0; }
    @media (max-width: 640px) { .contact-list { right: auto; left: 0; } [dir="rtl"] .contact-list { left: auto; right: 0; } }
    .contact-list a { display: flex; gap: 12px; align-items: center; padding: 10px 12px; border-radius: 8px; color: var(--ink); text-decoration: none; }
    .contact-list a:hover { background: var(--bg); }
    .contact-list a[aria-current="page"] { background: var(--ok-soft); }
    .contact-list svg { width: 22px; height: 22px; flex: none; color: var(--accent); }
    .contact-list span { display: grid; gap: 1px; }
    .contact-list b { font-size: 14.5px; }
    .about-menu { position: relative; }
    .about-list { min-width: 200px; top: calc(100% + 2px); }
    .nav .about-list small { font-size: 12px; color: var(--muted); }
    .nav .about-list a { color: var(--ink); font-size: 14px; box-shadow: none; padding: 10px 12px; }
    .nav .about-list a[aria-current="page"] { background: var(--ok-soft); color: var(--ink); box-shadow: none; }
    .contact-list small { font-size: 12px; color: var(--muted); }
    .nav { display: flex; gap: 2px; }
    .nav a { color: #cfd9d6; text-decoration: none; font-size: 14px; padding: 6px 10px; border-radius: 6px; }
    .nav a:hover { color: #fff; }
    .nav a[aria-current="page"] { color: #fff; box-shadow: inset 0 0 0 1px #4b5f5b; }
    /* 产品：下拉菜单（Mini UPS / 离线式 UPS / 以后的品类） */
    .top .wrap { position: relative; }
    .nav-menu { position: static; }
    .nav-menu summary { list-style: none; cursor: pointer; color: #cfd9d6; font-size: 14px; padding: 6px 10px; border-radius: 6px; user-select: none; }
    .nav-menu summary::-webkit-details-marker { display: none; }
    .nav-menu summary i { font-style: normal; font-size: 10px; color: #a9b8b4; }
    .nav-menu summary:hover, .nav-menu[open] summary { color: #fff; }
    .nav-menu summary[aria-current="page"] { color: #fff; box-shadow: inset 0 0 0 1px #4b5f5b; }
    .nav-list { position: absolute; right: 0; top: calc(100% - 6px); z-index: 50; width: min(960px, calc(100vw - 32px)); box-sizing: border-box; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 12px 30px rgba(0,0,0,.18); padding: 14px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px 14px; }
    .nav-col { display: grid; align-content: start; gap: 1px; }
    .nav-col + .nav-col { border-left: 1px solid var(--line); padding-left: 14px; }
    .nav-gh { font: 600 11px var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--muted); padding: 4px 10px 8px; }
    .nav-list a { color: var(--ink) !important; text-decoration: none; font-size: 14px; padding: 8px 10px; border-radius: 7px; box-shadow: none !important; }
    .nav-list a:hover { background: var(--bg); }
    .nav-list a.sub { margin: -2px 0 2px 12px; padding: 5px 10px; font-size: 13px; color: var(--accent) !important; font-weight: 600; }
    .nav-list a.sub i { font-style: normal; margin-right: 6px; color: var(--muted); }
    @media (max-width: 700px) {
      .nav-list { grid-template-columns: minmax(0, 1fr); padding: 10px; gap: 4px; }
      .nav-col + .nav-col { border-left: 0; padding-left: 0; border-top: 1px solid var(--line); padding-top: 8px; }
      .nav-gh { padding-bottom: 4px; }
    }
    .nav-list a[aria-current="page"] { background: var(--ok-soft); font-weight: 600; }
    /* 语言：一个下拉菜单 */
    .lang-menu { position: relative; }
    .lang-menu summary { list-style: none; display: flex; align-items: center; gap: 6px; cursor: pointer; color: #fff; font: 600 13px var(--body); padding: 6px 10px; border-radius: 6px; border: 1px solid #4b5f5b; user-select: none; }
    .lang-menu summary::-webkit-details-marker { display: none; }
    .lang-menu summary svg { width: 16px; height: 16px; }
    .lang-menu summary i { font-style: normal; font-size: 10px; color: #a9b8b4; }
    .lang-menu[open] summary { background: #22302d; }
    .lang-list { position: absolute; right: 0; top: calc(100% + 6px); z-index: 50; min-width: 170px; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 12px 30px rgba(0,0,0,.18); padding: 6px; display: grid; }
    /* 手机上语言按钮会换到第二行左侧，菜单改为向右展开，避免超出屏幕 */
    @media (max-width: 640px) { .lang-list { right: auto; left: 0; } }
    .lang-list a { display: flex; gap: 10px; align-items: center; padding: 9px 10px; border-radius: 7px; color: var(--ink); text-decoration: none; font-size: 14px; }
    .lang-list a b { font: 600 12px var(--mono); color: var(--muted); width: 22px; }
    .lang-list a:hover { background: var(--bg); }
    .lang-list a[aria-current="true"] { background: var(--ok-soft); }
    .lang-list a[aria-current="true"]::after { content: "✓"; margin-left: auto; color: var(--accent); font-weight: 700; }
  </style>
</head>
<body id="top">
  <header class="top">
    <div class="wrap">
      <a class="brand" href={`/${lang}/`}>{SITE.name}<small>{SITE.tagline[lang]}</small></a>
      <div class="top-right">
      <nav class="nav" aria-label="Main">
        <details class="nav-menu" data-nav-menu>
          <summary aria-current={path === '' || PRODUCT_PATHS.includes(path) || path.startsWith('batteries/') || path.startsWith('p/') ? 'page' : undefined}>{t.products} <i aria-hidden="true">▾</i></summary>
          <div class="nav-list">
            {NAV.map((g) => (
              <div class="nav-col">
                <span class="nav-gh">{g.h}</span>
                {g.items.map(([href, label, cls]) => <a class={cls} href={`/${lang}/${href}`} aria-current={path === href ? 'page' : undefined}>{cls === 'sub' && <i aria-hidden="true">↳</i>}{label}</a>)}
              </div>
            ))}
          </div>
        </details>
        <details class="nav-menu about-menu" data-about-menu>
          <summary aria-current={path === 'about/' || path === 'cases/' || String(path || '').startsWith('news/') ? 'page' : undefined}>{AT[lang].nav} <i aria-hidden="true">▾</i></summary>
          <div class="contact-list about-list">
            <a href={`/${lang}/about/`} aria-current={path === 'about/' ? 'page' : undefined}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21V9l6-4v4l6-4v4l6-4v16z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M7 17h2M11 17h2M15 17h2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              <span><b>{AT[lang].nav}</b></span>
            </a>
            <a href={`/${lang}/cases/`} aria-current={path === 'cases/' ? 'page' : undefined}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M3 13h18" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
              <span><b>{CS[lang].nav}</b></span>
            </a>
            <a href={`/${lang}/news/`} aria-current={String(path || '').startsWith('news/') ? 'page' : undefined}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h12v16H6a2 2 0 0 1-2-2V5a1 1 0 0 1 1-1zM17 8h3v10a2 2 0 0 1-2 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8 8h6M8 12h6M8 16h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              <span><b>{NW[lang].nav}</b></span>
            </a>
          </div>
        </details>
        <details class="nav-menu about-menu" data-support-menu>
          <summary aria-current={path === 'service/' ? 'page' : undefined}>{SUP[lang].nav} <i aria-hidden="true">▾</i></summary>
          <div class="contact-list about-list">
            <a href={`/${lang}/service/`} aria-current={path === 'service/' ? 'page' : undefined}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3.6 17.4a1.4 1.4 0 0 0 2 2l5.7-5.7a4 4 0 0 0 5.4-5.4l-2.5 2.5-2-.5-.5-2z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
              <span><b>{SUP[lang].svc}</b><small>{SUP[lang].svcSub}</small></span>
            </a>
          </div>
        </details>
      </nav>
      <details class="contact-menu" data-contact-menu>
        <summary class="nav-custom" aria-current={path === 'contact/' || path === 'visit/' ? 'page' : undefined}>{CO[lang].nav} <i aria-hidden="true">▾</i></summary>
        <div class="contact-list">
          <a href={`/${lang}/contact/`} aria-current={path === 'contact/' ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H8l-4 4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8 9h8M8 12h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            <span><b>{CONTACT_US[lang] || CONTACT_US.en}</b><small>WhatsApp · Email · WeChat</small></span>
          </a>
          <a href={`/${lang}/visit/`} aria-current={path === 'visit/' ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M16 3v4M8 3v4M3 10h18M9 15l2 2 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span><b>{VT[lang].nav}</b><small>{VISIT_SUB[lang] || VISIT_SUB.en}</small></span>
          </a>
        </div>
      </details>
      <details class="lang-menu" data-lang-menu>
        <summary aria-label="Language">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3 12h18M12 3c2.6 2.6 3.8 5.6 3.8 9s-1.2 6.4-3.8 9c-2.6-2.6-3.8-5.6-3.8-9S9.4 5.6 12 3z" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          <span>{lang.toUpperCase()}</span><i aria-hidden="true">▾</i>
        </summary>
        <div class="lang-list">
          {LANGS.map((l) => <a href={altHref(l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : 'false'}><b>{l.toUpperCase()}</b> {UI[l].langName}</a>)}
        </div>
      </details>
      </div>
    </div>
  </header>
  <main class:list={[{ wrap: !full }]}>
    <slot />
  </main>
  <SiteFooter lang={lang} altHref={altHref} />
  <ChatWidget lang={lang} />
  <script is:inline>
    (function () {
      // 点菜单外面或按 Esc 收起下拉菜单（语言、产品）
      var ms = document.querySelectorAll('[data-lang-menu], [data-nav-menu], [data-contact-menu], [data-about-menu], [data-support-menu]');
      document.addEventListener('click', function (e) { ms.forEach(function (m) { if (m.open && !m.contains(e.target)) m.open = false; }); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') ms.forEach(function (m) { m.open = false; }); });
    })();
  </script>
  {RTL_LANGS.includes(lang) && (
    <script is:inline>
    // 阿拉伯语（从右往左）：只有数字和拉丁字母的文字（"1–30 kVA"、"0 ms"、"3/3 · 1/1"）按从左往右显示，
    // 否则浏览器会排成 "kVA 30–1"。用 <bdi dir="ltr"> 包起来；计算器等脚本后来改写的文字也会自动处理。
    (function () {
      var AR = /[\u0600-\u06FF]/, DIG = /\d/, PURE = /^\s*\d+\s*$/;
      // 数值 + 拉丁单位 / 数值范围，例如 0 ms、1–30 kVA、220 V、3/3、12V 100Ah
      var VSRC = '[~≈≥≤<>+]?\\d[\\d.,]*(?:\\s?[–\\-\\/×·:]\\s?\\d[\\d.,]*)*(?:\\s?[A-Za-zΩ°%µ][A-Za-z0-9Ω°%²³µ\\/.·-]*)?';
      var VAL = new RegExp('\\d[\\d.,]*\\s?[A-Za-zΩ°%–\\-\\/×]'), VALG = new RegExp(VSRC, 'g');
      function fix(root) {
        var w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null), list = [], mixed = [], n;
        while ((n = w.nextNode())) {
          var t = n.nodeValue, p = n.parentNode;
          if (!t || !DIG.test(t) || PURE.test(t) || !p || /^(SCRIPT|STYLE|BDI|TEXTAREA|OPTION|TITLE)$/.test(p.nodeName) || p.isContentEditable) continue;
          if (p.closest && p.closest('svg, [dir="ltr"], input, select')) continue;
          if (!AR.test(t)) list.push(n);
          else if (VAL.test(t)) mixed.push(n);
        }
        list.forEach(function (n) { var b = document.createElement('bdi'); b.setAttribute('dir', 'ltr'); n.parentNode.insertBefore(b, n); b.appendChild(n); });
        // 阿拉伯语句子里夹着的"数值 + 单位"（"زمن التحويل 0 ms"）：只把这一段包起来
        mixed.forEach(function (n) {
          var t = n.nodeValue, frag = document.createDocumentFragment(), last = 0, m;
          VALG.lastIndex = 0;
          while ((m = VALG.exec(t))) {
            if (m.index > last) frag.appendChild(document.createTextNode(t.slice(last, m.index)));
            var b = document.createElement('bdi'); b.setAttribute('dir', 'ltr'); b.textContent = m[0]; frag.appendChild(b);
            last = m.index + m[0].length;
          }
          if (last < t.length) frag.appendChild(document.createTextNode(t.slice(last)));
          n.parentNode.replaceChild(frag, n);
        });
        // 数字和单位分在两个标签里的（<b>0</b><small>W</small>）：整个元素的内容一起包起来
        var els = root.nodeType === 1 ? [root].concat([].slice.call(root.querySelectorAll('*'))) : [];
        els.forEach(function (el) {
          if (el.nodeName === 'BDI' || el.closest('svg, [dir="ltr"], script, style, select, textarea')) return;
          var kids = el.childNodes;
          if (kids.length < 2 || kids.length > 4) return;
          for (var i = 0; i < kids.length; i++) { var k = kids[i]; if (k.nodeType === 1 && !/^(B|SMALL|SPAN|SUP|SUB|I|EM|STRONG|BDI|OUTPUT|DATA|ABBR|CODE)$/.test(k.nodeName)) return; if (k.nodeType === 1 && k.children.length) return; }
          var t = el.textContent;
          if (t.length > 40 || !DIG.test(t) || AR.test(t) || !/[A-Za-z°%Ω³²·\/–-]/.test(t)) return;
