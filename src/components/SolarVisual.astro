---
// 光伏系统选型器：① 目标（停电备用 / 省电费 / 全离网）② 用电器（数量 + 每天小时）③ 地区（日照）④ 电网电压
// 右侧：实景示意（光伏板数量、逆变器、电池模块数量、电网），可切换白天 / 夜间 / 停电看能量流向；下面是选型结果。
// 计算全部在 src/lib/solar-engine.mjs（测试：node scripts/test-solar-engine.mjs）。
import { SITE } from '../config.mjs';
import { SL } from '../lib/solar-i18n.mjs';
import { APPLIANCES, REGIONS, PANEL_W } from '../lib/solar-engine.mjs';
import { isInverter, invKind, invKw, invPhase } from '../lib/category.mjs';
import all from '../data/products.json';
interface Props { lang: string }
const { lang } = Astro.props;
const T = SL[lang], C = T.c;
const models = all.filter(isInverter).map((p) => ({ m: p.model, slug: p.slug, kw: invKw(p), kind: invKind(p), phase: invPhase(p) })).filter((x) => x.kw > 0);
const cfg = { lang, wa: SITE.whatsapp, email: SITE.email, models, t: C, kind: T.kind };
const AP_ICONS: Record<string, string> = {
  light: '<path d="M12 3a6 6 0 0 0-3.5 10.9V16h7v-2.1A6 6 0 0 0 12 3zM9.5 19h5M10.5 21.5h3"/>',
  fan: '<circle cx="12" cy="11" r="2"/><path d="M12 9c0-4 4-5 4-2s-2 3-4 4M14 12c4 0 5 4 2 4s-3-2-4-4M10 12c-4 0-5-4-2-4s3 2 4 4M12 13v8M8 21h8"/>',
  tv: '<rect x="3" y="5" width="18" height="12" rx="1.5"/><path d="M8 21h8M12 17v4"/>',
  router: '<rect x="3" y="13" width="18" height="6" rx="1.5"/><path d="M7 16h.01M10 16h.01M8 9a6 6 0 0 1 8 0M10 11a3 3 0 0 1 4 0"/>',
  laptop: '<rect x="5" y="5" width="14" height="10" rx="1"/><path d="M3 19h18l-2-4H5z"/>',
  fridge: '<rect x="6" y="2" width="12" height="20" rx="2"/><path d="M6 9h12M9 5v2M9 12v3"/>',
  freezer: '<rect x="3" y="8" width="18" height="12" rx="2"/><path d="M3 12h18M10 10h4"/>',
  washer: '<rect x="4" y="3" width="16" height="18" rx="2"/><circle cx="12" cy="13" r="4.5"/><path d="M7 6h3"/>',
  micro: '<rect x="2" y="6" width="20" height="12" rx="1.5"/><rect x="5" y="9" width="10" height="6" rx="1"/><path d="M18 9v1M18 12v1"/>',
  ac: '<rect x="2" y="5" width="20" height="8" rx="2"/><path d="M5 10h14M7 16c0 2 2 2 2 4M12 16c0 2 2 2 2 4M17 16c0 2-2 2-2 4"/>',
  pump: '<circle cx="9" cy="13" r="5"/><path d="M14 13h6v-3M9 8V4h4M2 13h2"/>',
  heater: '<rect x="7" y="2" width="10" height="20" rx="4"/><path d="M12 7c-1.5 2 1.5 3 0 5M10 18h4"/>',
};
const fmt = (s: string, o: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(o[k] ?? ''));
---
<section class="block sv" id="designer" data-sv>
  <script type="application/json" data-sv-cfg set:html={JSON.stringify(cfg)} />
  <div class="head"><span class="eyebrow">{C.eyebrow}</span><h2>{C.h}</h2><p>{C.p}</p></div>
  <div class="sv-stage">
    <div class="sv-ctl">
      <div class="sv-grp">
        <div class="sv-gh"><span class="sv-n">1</span><b>{C.s1}</b></div>
        <div class="sv-goals">
          {Object.entries(C.goal).map(([k, [a, b]]) => (
            <button type="button" class:list={['sv-card', { on: k === 'backup' }]} data-goal={k} aria-pressed={k === 'backup' ? 'true' : 'false'}><b>{a}</b><small>{b}</small></button>
          ))}
        </div>
        <div class="sv-sub" data-outage-box>
          <span>{C.outage}</span>
          <div class="sv-step"><button type="button" data-oh="-1" aria-label="−">−</button><output data-oh-v>6</output><button type="button" data-oh="1" aria-label="+">+</button></div>
          <span class="sv-unit">{C.hours}</span>
        </div>
        <div class="sv-sub" data-auto-box hidden>
          <span>{C.autonomy}</span>
          <div class="sv-seg">{[0, 1, 2].map((d) => <button type="button" class:list={[{ on: d === 0 }]} data-auto={d}>{C.days[d]}</button>)}</div>
        </div>
      </div>

      <div class="sv-grp">
        <div class="sv-gh"><span class="sv-n">2</span><b>{C.s2}</b><small>{C.s2n}</small></div>
        <div class="sv-aps">
          {APPLIANCES.map((a) => (
            <div class:list={['sv-ap', { on: a.n > 0 }]} data-ap={a.id}>
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={AP_ICONS[a.id]} />
              <div class="sv-ap-t"><b>{C.ap[a.id]}</b><small>{a.w} W</small></div>
              <div class="sv-step sm"><button type="button" data-d="-1" aria-label="−">−</button><output data-n>{a.n}</output><button type="button" data-d="1" aria-label="+">+</button></div>
              <label class="sv-h"><input type="number" min="0" max="24" step="0.5" value={a.h} data-h aria-label={`${C.ap[a.id]} ${C.perDay}`} /><span>{C.perDay}</span></label>
            </div>
          ))}
        </div>
      </div>

      <div class="sv-grp">
        <div class="sv-gh"><span class="sv-n">3</span><b>{C.s3}</b><small>{C.s3n}</small></div>
        <div class="sv-chips">
          {Object.keys(REGIONS).map((k) => <button type="button" class:list={['sv-chip', { on: k === 'africa' }]} data-reg={k} title={fmt(C.sun, { h: REGIONS[k] })}>{C.reg[k]}</button>)}
        </div>
        <p class="sv-note" data-sun></p>
        <div class="sv-subl">{C.panel}</div>
        <div class="sv-chips" data-panels>
          {PANEL_W.map((w) => <button type="button" class:list={['sv-chip', { on: w === 550 }]} data-pw={w}>{w} W</button>)}
          <label class="sv-pw-other"><span>{C.panelOther}</span><input type="number" min="50" max="1000" step="5" data-pwx aria-label={C.panelHint} /><span>W</span></label>
        </div>
      </div>

      <div class="sv-grp">
        <div class="sv-gh"><span class="sv-n">4</span><b>{C.s4}</b></div>
        <div class="sv-goals three">
          {Object.entries(C.ph).map(([k, [a, b]]) => (
            <button type="button" class:list={['sv-card', { on: k === '1' }]} data-ph={k} aria-pressed={k === '1' ? 'true' : 'false'}><b>{a}</b><small>{b}</small></button>
          ))}
        </div>
      </div>
    </div>

    <div class="sv-view">
      <div class="sv-modes" role="group" aria-label={C.mode}>
        <span>{C.mode}</span>
        {Object.entries(C.modes).map(([k, v]) => <button type="button" class:list={[{ on: k === 'day' }]} data-mode={k}>{v}</button>)}
      </div>
      <div class="sv-scene" data-scene data-m="day">
        <svg viewBox="0 0 760 420" role="img" aria-label={C.h}>
          <defs>
            <linearGradient id="svSkyDay" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7cc4f5"/><stop offset="1" stop-color="#d8f0ff"/></linearGradient>
            <linearGradient id="svSkyNight" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#0b1530"/><stop offset="1" stop-color="#233157"/></linearGradient>
            <linearGradient id="svSkyCut" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5b6b8c"/><stop offset="1" stop-color="#c7b49a"/></linearGradient>
            <linearGradient id="svPanel" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#1e3a8a"/><stop offset=".5" stop-color="#2563eb"/><stop offset="1" stop-color="#1e3a8a"/></linearGradient>
          </defs>
          <rect class="sky day" width="760" height="420"/>
          <rect class="sky night" width="760" height="420" fill="url(#svSkyNight)"/>
          <rect class="sky cut" width="760" height="420" fill="url(#svSkyCut)"/>
          <g class="stars">{[[60, 40], [150, 90], [240, 30], [520, 60], [610, 30], [700, 80], [420, 40]].map(([x, y]) => <circle cx={x} cy={y} r="1.6"/>)}</g>
          <g class="sun"><circle cx="90" cy="70" r="30"/>{Array.from({ length: 8 }, (_, i) => <path d={`M90 70 m0 -42 v-12`} transform={`rotate(${i * 45} 90 70)`}/>)}</g>
          <g class="moon"><circle cx="90" cy="70" r="22"/><circle cx="100" cy="62" r="20" class="moon-cut"/></g>
          <rect class="ground" x="0" y="380" width="760" height="40"/>
          <!-- 电网 -->
          <g class="grid-g" data-gridg>
            <path class="pole" d="M690 380 V120 M666 136 H714 M672 150 H708"/>
            <text x="690" y="400" class="lbl">{C.vis.grid}</text>
            <g class="xcut"><path d="M676 168 l28 28 M704 168 l-28 28"/></g>
          </g>
          <!-- 光伏阵列：数量由脚本画 -->
          <g data-pv></g>
          <text x="130" y="372" class="lbl">{C.vis.sun}</text>
          <text x="130" y="232" class="lbl big" data-pv-l></text>
          <!-- 房子 -->
          <g class="house">
            <rect x="390" y="240" width="210" height="140" class="wall"/>
            <polygon points="370,240 495,165 620,240" class="roof"/>
            <rect x="420" y="272" width="54" height="44" rx="3" class="win" data-win/>
            <rect x="520" y="290" width="44" height="90" rx="3" class="door"/>
            <circle cx="447" cy="294" r="10" class="lamp"/>
          </g>
          <text x="495" y="400" class="lbl">{C.vis.home}</text>
          <!-- 能量流向 -->
          <path class="w w-pv" d="M232 286 H262"/>
          <path class="w w-home" d="M322 250 H390 M390 250 H447 V284"/>
          <path class="w w-batt" d="M322 284 H336 V350 H322"/>
          <path class="w w-grid" d="M300 224 V136 H666"/>
          <!-- 逆变器 + 电池 -->
          <g class="inv"><rect x="262" y="224" width="60" height="84" rx="6"/><rect x="270" y="232" width="44" height="22" rx="2" class="lcd"/><text x="292" y="247" class="lcd-t" data-lcd>5 kW</text><circle cx="276" cy="294" r="3" class="led"/><circle cx="286" cy="294" r="3" class="led b"/></g>
          <text x="232" y="216" class="lbl" text-anchor="end">{C.vis.inv}</text>
          <g data-batt></g>
          <text x="292" y="400" class="lbl" data-batt-l>{C.vis.batt}</text>
        </svg>
      </div>
      <p class="sv-mtext" data-mtext>{C.modeText.day}</p>
      <div class="sv-read">
        <div class="sv-kpis">
          <div><span>{C.out.daily}</span><b data-k-daily>—</b></div>
          <div><span>{C.out.peak}</span><b data-k-peak>—</b></div>
          <div><span>{C.out.surge}</span><b data-k-surge>—</b></div>
        </div>
        <dl class="sv-rows" data-rows></dl>
        <div class="sv-recs" data-recs></div>
        <ul class="sv-checks" data-checks></ul>
      </div>
    </div>

    <div class="sv-final">
      <div class="sv-sum" data-sum></div>
      {(SITE.whatsapp || SITE.email) && <button type="button" class="sv-go" data-open aria-haspopup="dialog">{C.send}</button>}
    </div>
    <details class="sv-assume">
      <summary>{C.assumeH}</summary>
      <ul>{C.assume.map((a) => <li>{a}</li>)}</ul>
    </details>
  </div>

  <div class="sv-pop" data-pop hidden role="dialog" aria-modal="true" aria-labelledby="sv-pop-h">
    <div class="sv-pop-box">
      <button type="button" class="sv-pop-x" data-close aria-label={C.close}>×</button>
      <h3 id="sv-pop-h">{C.popH}</h3>
      <p>{C.popP}</p>
      <pre data-msg></pre>
      <div class="sv-pop-acts">
        {SITE.whatsapp && <a class="sv-pop-btn wa" data-wa href="#" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1a15 15 0 0 1-6.3-5.6c-.5-.8-.9-1.8-.9-2.7s.5-1.7.8-2c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.8-1c.2-.3.4-.2.6-.1l1.8.9c.3.1.4.2.5.3.1.2.1.8-.1 1.4z"/></svg>{C.viaWa}</a>}
        {SITE.email && <a class="sv-pop-btn mail" data-mail href="#"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2.4V17h16V7.4l-8 5.3-8-5.3zM5.6 7l6.4 4.2L18.4 7H5.6z"/></svg>{C.viaMail}<small>{SITE.email}</small></a>}
      </div>
    </div>
  </div>
</section>

<script>
  import { sizeSolar, REGIONS } from '../lib/solar-engine.mjs';
  const root = document.querySelector('[data-sv]') as HTMLElement | null;
  if (root) {
    const c = JSON.parse(root.querySelector('[data-sv-cfg]')!.textContent || '{}'), T = c.t;
    const $ = (s: string) => root.querySelector(s) as HTMLElement;
    const $$ = (s: string) => Array.from(root.querySelectorAll(s)) as HTMLElement[];
    const fmt = (s: string, o: any) => String(s).replace(/\{(\w+)\}/g, (_: string, k: string) => (o[k] !== undefined ? o[k] : ''));
    const st: any = { goal: 'backup', outageH: 6, autonomy: 0, region: 'africa', phase: '1', mode: 'day', panelW: 550 };
    let lastMsg = '', lastSubj = '', last: any = null, pvKey = '', bKey = '';
    const items = () => {
      const o: any = {};
      $$('[data-ap]').forEach((row) => { o[row.dataset.ap!] = { n: +(row.querySelector('[data-n]') as HTMLElement).textContent!, h: parseFloat((row.querySelector('[data-h]') as HTMLInputElement).value) || 0 }; });
      return o;
    };
    // 示意图：光伏板（最多画 12 块）、电池模块（最多 4 块）
    function drawPv(n: number, w: number) {
      const key = n + '|' + w; if (key === pvKey) return; pvKey = key;
      const show = Math.min(n, 12), cols = 4; let h = '';
      for (let i = 0; i < show; i++) {
        const r = Math.floor(i / cols), k = i % cols, x = 34 + k * 48 - r * 8, y = 250 + r * 30;
        h += `<g class="pnl" style="--d:${i * 50}ms"><polygon points="${x + 10},${y} ${x + 52},${y} ${x + 44},${y + 26} ${x + 2},${y + 26}" fill="url(#svPanel)"/><path d="M${x + 24} ${y} L${x + 18} ${y + 26} M${x + 38} ${y} L${x + 32} ${y + 26} M${x + 6} ${y + 13} H${x + 48}" class="pnl-l"/></g>`;
      }
      h += `<path class="pv-stand" d="M40 340 V${250 + Math.ceil(show / cols) * 30} M220 340 V${250 + Math.ceil(show / cols) * 30}"/>`;
      $('[data-pv]').innerHTML = h;
      $('[data-pv-l]').textContent = n ? `${n} × ${w} W` : '';
    }
    function drawBatt(m: number) {
      const key = String(m); if (key === bKey) return; bKey = key;
      const show = Math.min(Math.max(m, 0), 3); let h = '';
      for (let i = 0; i < show; i++) {
        const y = 362 - i * 18;
        h += `<g class="bm" style="--d:${i * 80}ms"><rect x="266" y="${y}" width="52" height="16" rx="3"/><rect x="272" y="${y + 6}" width="20" height="4" rx="2" class="bm-soc"/></g>`;
      }
      if (m > 3) h += `<text x="336" y="${362 - 2 * 18 + 12}" class="lbl bm-more">+${m - 3}</text>`;
      $('[data-batt]').innerHTML = h;
    }
    function setMode(m: string) {
      st.mode = m; $('[data-scene]').dataset.m = m;
      $$('[data-mode]').forEach((b) => b.classList.toggle('on', b.dataset.mode === m));
      $('[data-mtext]').textContent = T.modeText[m];
    }
    function update() {
      $$('[data-ap]').forEach((row) => row.classList.toggle('on', +(row.querySelector('[data-n]') as HTMLElement).textContent! > 0));
      ($('[data-outage-box]') as any).hidden = st.goal !== 'backup';
      ($('[data-auto-box]') as any).hidden = st.goal !== 'off';
      $('[data-scene]').classList.toggle('offgrid', st.goal === 'off');
      ($('[data-mode="cut"]') as any).hidden = st.goal === 'off';
      $('[data-sun]').textContent = fmt(T.sun, { h: REGIONS[st.region] });
      const r = sizeSolar({ items: items(), goal: st.goal, outageH: st.outageH, autonomy: st.autonomy, region: st.region, phase: st.phase, panelW: st.panelW, models: c.models });
      last = r;
      const rows = $('[data-rows]'), go = $('[data-open]') as HTMLButtonElement | null;
      if (!r) {
        ['daily', 'peak', 'surge'].forEach((k) => ($(`[data-k-${k}]`).textContent = '—'));
        rows.innerHTML = `<div class="enter">${T.out.enter}</div>`; $('[data-recs]').innerHTML = ''; $('[data-checks]').innerHTML = ''; $('[data-sum]').innerHTML = '';
        if (go) go.disabled = true; drawPv(0, st.panelW); drawBatt(0); return;
      }
      if (go) go.disabled = false;
      $('[data-k-daily]').innerHTML = `${r.dailyKwh}<small> kWh</small>`;
      $('[data-k-peak]').innerHTML = `${r.peakW}<small> W</small>`;
      $('[data-k-surge]').innerHTML = `${r.surgeW}<small> W</small>`;
      drawPv(r.panels, r.panelW); drawBatt(r.modules);
      $('[data-lcd]').textContent = `${r.units > 1 ? r.units + '×' : ''}${r.invKw} kW`;
      $('[data-batt-l]').textContent = r.modules ? `${T.vis.batt} · ${r.battInst} kWh` : T.vis.batt;
      const inv = fmt(T.out.invN, { n: r.units, k: r.invKw }).replace(/^1 × /, '') + (r.units > 1 ? ` ${T.out.par}` : '');
      const batt = r.modules ? fmt(T.out.battN, { m: r.modules, k: r.battInst }) : T.out.battNone;
      const pv = fmt(T.out.pvN, { n: r.panels, w: r.panelW, k: r.kwpInst });
      const row = (k: string, v: string) => `<div><dt>${k}</dt><dd>${v}</dd></div>`;
      rows.innerHTML = row(T.out.inv, inv) + row(T.out.batt, r.modules ? `<a href="/${c.lang}/batteries/rack-lithium/">${batt}</a>` : batt) + row(T.out.pv, pv) + row(T.out.gen, fmt(T.out.genN, { k: r.monthKwh }));
      const link = (m: any, best: boolean) => `<a href="/${c.lang}/p/${m.slug}/"${best ? ' class="best"' : ''}><b>${m.m}</b><span>${c.kind[m.kind] || ''} · ${m.kw} kW${best && r.units > 1 ? ' × ' + r.units : ''}</span></a>`;
      $('[data-recs]').innerHTML = r.model ? `<span>${T.out.model}</span>` + link(r.model, true) + (r.alts.length ? `<span>${T.out.alt}</span>` + r.alts.map((m: any) => link(m, false)).join('') : '') : `<span>${T.out.model}</span><p class="cu">${T.out.custom}</p>`;
      $('[data-checks]').innerHTML = r.checks.map((x: any) => `<li class="${x.level}">${T.chk[x.id]}</li>`).join('');
      const invTxt = (r.model ? `${r.model.m} · ` : '') + inv;
      $('[data-sum]').innerHTML = `<div><span>${T.sumSys}</span><b>${invTxt} · ${batt} · ${pv}</b></div><div><span>${T.sumLoad}</span><b>${r.dailyKwh} kWh / day · ${r.peakW} W</b></div>`;
      const it = items();
      const itTxt = Object.keys(it).filter((k) => it[k].n > 0).map((k) => `${it[k].n} × ${T.ap[k]} (${it[k].h} h)`).join(', ');
      const goalTxt = T.goal[st.goal][0] + (st.goal === 'backup' ? ` · ${st.outageH} ${T.hours}` : st.goal === 'off' && st.autonomy ? ` · ${T.days[st.autonomy]}` : '');
      lastMsg = fmt(T.msg, { goal: goalTxt, reg: T.reg[st.region], ph: `${T.ph[st.phase][0]} ${T.ph[st.phase][1]}`, items: itTxt, kwh: r.dailyKwh, peak: r.peakW, inv: invTxt, batt, pv });
      lastSubj = `${T.subj} · ${invTxt}`;
    }
    // —— 事件 ——
    $$('[data-goal]').forEach((b) => b.addEventListener('click', () => { st.goal = b.dataset.goal; $$('[data-goal]').forEach((x) => { const on = x === b; x.classList.toggle('on', on); x.setAttribute('aria-pressed', String(on)); }); if (st.goal === 'off' && st.mode === 'cut') setMode('night'); update(); }));
    $$('[data-oh]').forEach((b) => b.addEventListener('click', () => { st.outageH = Math.max(0, Math.min(24, st.outageH + +b.dataset.oh!)); $('[data-oh-v]').textContent = st.outageH; update(); }));
    $$('[data-auto]').forEach((b) => b.addEventListener('click', () => { st.autonomy = +b.dataset.auto!; $$('[data-auto]').forEach((x) => x.classList.toggle('on', x === b)); update(); }));
    $$('[data-ap]').forEach((row) => {
      row.querySelectorAll('[data-d]').forEach((b) => b.addEventListener('click', () => { const o = row.querySelector('[data-n]') as HTMLElement; o.textContent = String(Math.max(0, Math.min(50, +o.textContent! + +(b as HTMLElement).dataset.d!))); update(); }));
      row.querySelector('[data-h]')!.addEventListener('input', update);
    });
    $$('[data-reg]').forEach((b) => b.addEventListener('click', () => { st.region = b.dataset.reg; $$('[data-reg]').forEach((x) => x.classList.toggle('on', x === b)); update(); }));
    $$('[data-ph]').forEach((b) => b.addEventListener('click', () => { st.phase = b.dataset.ph; $$('[data-ph]').forEach((x) => { const on = x === b; x.classList.toggle('on', on); x.setAttribute('aria-pressed', String(on)); }); update(); }));
    $$('[data-mode]').forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode!)));
    // 光伏板规格：常用规格点选，或者手动填（50–1000 W）
    $$('[data-pw]').forEach((b) => b.addEventListener('click', () => { st.panelW = +b.dataset.pw!; ($('[data-pwx]') as HTMLInputElement).value = ''; $$('[data-pw]').forEach((x) => x.classList.toggle('on', x === b)); update(); }));
    $('[data-pwx]').addEventListener('input', (e: any) => { const v = parseFloat(String(e.target.value).replace(',', '.')); if (v >= 50 && v <= 1000) { st.panelW = Math.round(v); $$('[data-pw]').forEach((x) => x.classList.remove('on')); update(); } });
    const pop = $('[data-pop]'); let opener: HTMLElement | null = null;
    function openPop() {
      $('[data-msg]').textContent = lastMsg;
      const wa = root!.querySelector('[data-wa]') as HTMLAnchorElement | null, mail = root!.querySelector('[data-mail]') as HTMLAnchorElement | null;
      if (wa) wa.href = 'https://wa.me/' + c.wa + '?text=' + encodeURIComponent(lastMsg);
      if (mail) mail.href = 'mailto:' + c.email + '?subject=' + encodeURIComponent(lastSubj) + '&body=' + encodeURIComponent(lastMsg);
      pop.hidden = false; document.body.style.overflow = 'hidden';
      (pop.querySelector('.sv-pop-btn') as HTMLElement | null)?.focus();
    }
    function closePop() { pop.hidden = true; document.body.style.overflow = ''; opener?.focus(); }
    const ob = root.querySelector('[data-open]') as HTMLElement | null;
    ob?.addEventListener('click', () => { if (!last) return; opener = ob; openPop(); });
    pop.addEventListener('click', (e: any) => { if (e.target === pop || e.target.closest('[data-close]')) closePop(); else if (e.target.closest('.sv-pop-btn')) setTimeout(closePop, 300); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !pop.hidden) closePop(); });
    setMode('day'); update();
  }
</script>

