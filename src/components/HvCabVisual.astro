---
// 高压磷酸铁锂电池柜配置器：① 用在 UPS / 高压逆变器 ② 直流电压（自动 / 204.8 V / 409.6 V）③ 负载 kW ④ 备电时间
// → 推荐电池柜型号 × 并联柜数、总能量、备电时间、放电电流（每柜分担多少）。
// 右侧：机房场景——一排 19 英寸电池柜（顶部主控 BMS + 模块），直流母线接到 UPS / 逆变器，再到负载；可切换"停电放电 / 充电"看电流方向。
// 计算在 src/lib/hvcab-engine.mjs（测试：node scripts/test-hvcab-engine.mjs）。
import { SITE } from '../config.mjs';
import { HV } from '../lib/hvcab-i18n.mjs';
import { HV_GENERIC, KW_PRESETS, TIME_PRESETS, HV_BUS } from '../lib/hvcab-engine.mjs';
import { isHvCab, hvModule } from '../lib/category.mjs';
import all from '../data/products.json';
interface Props { lang: string }
const { lang } = Astro.props;
const T = HV[lang], C = T.c;
const pub = all.filter(isHvCab).map((p) => ({ m: p.model, slug: p.slug, ...hvModule(p) })).filter((x) => x.v > 100 && x.kwh > 0);
const models = pub.length ? pub : HV_GENERIC;
const cfg = { lang, wa: SITE.whatsapp, email: SITE.email, models, t: C };
const tLabel = (h) => (h < 1 ? `${Math.round(h * 60)} ${C.mu}` : `${h} ${C.hu}`);
---
<section class="block hvv" id="builder" data-hvv>
  <script type="application/json" data-hvv-cfg set:html={JSON.stringify(cfg)} />
  <div class="head"><span class="eyebrow">{C.eyebrow}</span><h2>{C.h}</h2><p>{C.p}</p></div>
  <div class="rb-stage">
    <div class="rb-ctl">
      <div class="rb-grp">
        <div class="rb-gh"><span class="rb-n">1</span><b>{C.s0}</b></div>
        <div class="rb-in"><div class="rb-seg">{(['ups', 'inv'] as const).map((k, i) => <button type="button" class:list={{ on: i === 0 }} data-app={k}>{C.apps[k]}</button>)}</div></div>
      </div>
      <div class="rb-grp">
        <div class="rb-gh"><span class="rb-n">2</span><b>{C.s1}</b></div>
        <div class="rb-in">
          <div class="rb-chips">
            <button type="button" class="rb-chip on" data-lv="auto">{C.auto}</button>
            {[204.8, 409.6].map((v) => <button type="button" class="rb-chip" data-lv={v}>{C.lvN.replace('{v}', String(v))}<small>{C.busN.replace('{bus}', String(HV_BUS[v]))}</small></button>)}
          </div>
        </div>
      </div>
      <div class="rb-grp">
        <div class="rb-gh"><span class="rb-n">3</span><b>{C.s2}</b></div>
        <div class="rb-in">
          <label class="rb-num"><span>{C.loadL}</span><input type="number" inputmode="decimal" min="0" step="any" value="10" data-kw /><b>kW</b></label>
          <div class="rb-chips">{KW_PRESETS.map((k) => <button type="button" class:list={['rb-chip', { on: k === 10 }]} data-kp={k}>{k} kW</button>)}</div>
        </div>
      </div>
      <div class="rb-grp">
        <div class="rb-gh"><span class="rb-n">4</span><b>{C.s3}</b></div>
        <div class="rb-in">
          <label class="rb-num"><span>{C.timeL}</span><input type="number" inputmode="decimal" min="0" step="any" value="60" data-min /><b>{C.mu}</b></label>
          <div class="rb-chips">{TIME_PRESETS.map((h) => <button type="button" class:list={['rb-chip', { on: h === 1 }]} data-tp={h}>{tLabel(h)}</button>)}</div>
        </div>
      </div>
      <div class="rb-read">
        <div class="rb-big"><span>{C.out.model}</span><b data-big>—</b></div>
        <dl class="rb-rows" data-rows></dl>
        <ul class="rb-checks" data-checks></ul>
      </div>
    </div>

    <div class="rb-view">
      <div class="rb-modes" role="group" aria-label={C.s4}>
        <span>{C.s4}</span>
        <button type="button" class="on" data-mode="dis">{C.modes.dis}</button><button type="button" data-mode="chg">{C.modes.chg}</button>
      </div>
      <div class="hv-room" data-room data-m="dis">
        <div class="hv-cabs" data-cabs></div>
        <div class="hv-side">
          <div class="hv-ups"><span class="hv-scr"><b data-scr>—</b></span><span class="hv-lbl" data-applbl>{C.vis.ups}</span><span class="hv-vent"></span></div>
          <div class="hv-load"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="6" rx="1" /><rect x="4" y="10" width="16" height="6" rx="1" /><path d="M7 6h.01M7 13h.01M8 20h8M12 16v4" /></svg><b>{C.vis.load}</b><small data-loadkw></small></div>
        </div>
        <div class="hv-bus"><span></span><em data-busv></em></div>
        <div class="hv-floor"></div>
      </div>
    </div>

    <div class="rb-final">
      <div class="rb-sum" data-sum></div>
      {(SITE.whatsapp || SITE.email) && <button type="button" class="rb-go" data-open aria-haspopup="dialog">{C.send}</button>}
    </div>
    <details class="rb-assume">
      <summary>{C.assumeH}</summary>
      <ul>{C.assume.map((a) => <li>{a}</li>)}</ul>
    </details>
  </div>

  <div class="rb-pop" data-pop hidden role="dialog" aria-modal="true" aria-labelledby="hv-pop-h">
    <div class="rb-pop-box">
      <button type="button" class="rb-pop-x" data-close aria-label={C.close}>×</button>
      <h3 id="hv-pop-h">{C.popH}</h3>
      <p>{C.popP}</p>
      <pre data-msg></pre>
      <div class="rb-pop-acts">
        {SITE.whatsapp && <a class="rb-pop-btn wa" data-wa href="#" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1a15 15 0 0 1-6.3-5.6c-.5-.8-.9-1.8-.9-2.7s.5-1.7.8-2c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.8-1c.2-.3.4-.2.6-.1l1.8.9c.3.1.4.2.5.3.1.2.1.8-.1 1.4z"/></svg>{C.viaWa}</a>}
        {SITE.email && <a class="rb-pop-btn mail" data-mail href="#"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2.4V17h16V7.4l-8 5.3-8-5.3zM5.6 7l6.4 4.2L18.4 7H5.6z"/></svg>{C.viaMail}<small>{SITE.email}</small></a>}
      </div>
    </div>
  </div>
</section>

<script>
  import { sizeHv, HV_ASSUME } from '../lib/hvcab-engine.mjs';
  const root = document.querySelector('[data-hvv]') as HTMLElement | null;
  if (root) {
    const c = JSON.parse(root.querySelector('[data-hvv-cfg]')!.textContent || '{}'), T = c.t;
    const $ = (s: string) => root.querySelector(s) as HTMLElement;
    const $$ = (s: string) => Array.from(root.querySelectorAll(s)) as HTMLElement[];
    const fmt = (s: string, o: any) => String(s).replace(/\{(\w+)\}/g, (_: string, k: string) => (o[k] !== undefined ? o[k] : ''));
    const num = (el: HTMLInputElement) => Math.max(0, parseFloat(String(el.value).replace(',', '.')) || 0);
    const tTxt = (h: number) => (h < 1 ? `${Math.round(h * 60)} ${T.mu}` : `${Math.round(h * 10) / 10} ${T.hu}`);
    const st: any = { app: 'ups', lv: 'auto', kw: 10, min: 60 };
    let lastMsg = '', lastSubj = '', last: any = null, drawn = '', prevN = 0;
    const MAXSHOW = 4;
    function draw(r: any) {
      const box = $('[data-cabs]');
      if (!r) { box.innerHTML = ''; drawn = ''; prevN = 0; return; }
      const key = `${r.n}|${r.mod.m}`;
      if (key === drawn) return;
      const grow = drawn && drawn.split('|')[1] === r.mod.m ? prevN : 0;
      drawn = key; prevN = r.n;
      const u = r.mod.u || 24, k = Math.max(4, Math.min(12, Math.round(u / 3)));
      const show = Math.min(r.n, MAXSHOW);
      let h = '';
      for (let i = 0; i < show; i++) {
        let mods = ''; for (let j = 0; j < k; j++) mods += '<span class="m"><i></i><i></i><i></i></span>';
        h += `<div class="cab${i >= grow ? ' ins' : ''}" style="--h:${Math.round(120 + u * 3.2)}px;--d:${(i - grow) * 90}ms"><span class="bms"><b>BMS</b><i></i></span><span class="mods">${mods}</span><span class="lb">${r.mod.kwh} kWh</span></div>`;
      }
      if (r.n > show) h += `<div class="more">+${r.n - show}</div>`;
      box.innerHTML = h;
    }
    function update() {
      const hours = st.min / 60;
      const r = sizeHv({ kw: st.kw, hours, level: st.lv, models: c.models });
      last = r;
      const go = $('[data-open]') as HTMLButtonElement | null;
      const row = (k: string, v: string) => `<div><dt>${k}</dt><dd>${v}</dd></div>`;
      $('[data-loadkw]').textContent = st.kw ? `${st.kw} kW` : '';
      $('[data-applbl]').textContent = st.app === 'ups' ? T.vis.ups : T.vis.inv;
      draw(r);
      if (!r) { $('[data-big]').textContent = '—'; $('[data-rows]').innerHTML = `<div class="enter">${T.out.enter}</div>`; $('[data-checks]').innerHTML = ''; $('[data-sum]').innerHTML = ''; $('[data-scr]').textContent = '—'; $('[data-busv]').textContent = ''; if (go) go.disabled = true; return; }
      if (go) go.disabled = false;
      const m = r.mod;
      $('[data-big]').innerHTML = `${m.m}<small> × ${r.n}</small>`;
      let h = row(T.out.n, String(r.n)) + row(T.out.total, `${r.totalKwh} kWh`) + row(T.out.usable, `${r.usableKwh} kWh`)
        + row(fmt(T.out.runtime, { kw: st.kw }), fmt(T.out.runtimeN, { t: tTxt(r.runtime) }))
        + row(T.out.amps, fmt(T.out.ampsN, { a: r.amps, p: r.perCabA }));
      if (r.maxKw) h += row(T.out.power, `${r.maxKw} kW`);
      if (r.kg) h += row(T.out.kg, `≤ ${r.kg} kg`);
      if (!m.slug) h += row(T.out.model, `<span class="cu">${T.out.custom}</span>`);
      $('[data-rows]').innerHTML = h;
      const ch = [];
      if (st.lv === 'auto') ch.push(fmt(T.chk.auto, { v: r.level, kw: st.kw }));
      if (r.switched) ch.push(fmt(T.chk.switched, { v: st.lv === 'auto' ? (st.kw > HV_ASSUME.autoKw ? 409.6 : 204.8) : st.lv, w: r.level }));
      if (r.byCurrent) ch.push(T.chk.current);
      if (r.overPar) ch.push(fmt(T.chk.par, { p: HV_ASSUME.maxPar }));
      $('[data-checks]').innerHTML = ch.map((x) => `<li>${x}</li>`).join('');
      $('[data-scr]').textContent = `${r.level} V`;
      $('[data-busv]').textContent = `${r.level} VDC · ${r.amps} A`;
      $('[data-sum]').innerHTML = `<div><span>${T.sum}</span><b>${m.m} × ${r.n} · ${r.totalKwh} kWh · ≈ ${tTxt(r.runtime)} @ ${st.kw} kW</b></div>`;
      const app = st.app === 'ups' ? T.apps.ups : T.apps.inv;
      lastMsg = fmt(T.msg, { app, v: r.level, kw: st.kw, t: tTxt(hours), model: m.m, n: r.n, kwh: r.totalKwh, use: r.usableKwh });
      lastSubj = `${T.subj} · ${m.m} × ${r.n}`;
    }
    const sync = (attr: string, v: any) => $$(`[${attr}]`).forEach((x) => x.classList.toggle('on', String(x.getAttribute(attr)) === String(v)));
    $$('[data-app]').forEach((b) => b.addEventListener('click', () => { st.app = b.dataset.app; sync('data-app', st.app); update(); }));
    $$('[data-lv]').forEach((b) => b.addEventListener('click', () => { st.lv = b.dataset.lv; sync('data-lv', st.lv); update(); }));
    $('[data-kw]').addEventListener('input', (e: any) => { st.kw = num(e.target); sync('data-kp', st.kw); update(); });
    $('[data-min]').addEventListener('input', (e: any) => { st.min = num(e.target); sync('data-tp', st.min / 60); update(); });
    $$('[data-kp]').forEach((b) => b.addEventListener('click', () => { st.kw = +b.dataset.kp!; ($('[data-kw]') as HTMLInputElement).value = String(st.kw); sync('data-kp', st.kw); update(); }));
    $$('[data-tp]').forEach((b) => b.addEventListener('click', () => { st.min = Math.round(+b.dataset.tp! * 60); ($('[data-min]') as HTMLInputElement).value = String(st.min); sync('data-tp', b.dataset.tp); update(); }));
    $$('[data-mode]').forEach((b) => b.addEventListener('click', () => { $('[data-room]').dataset.m = b.dataset.mode; $$('[data-mode]').forEach((x) => x.classList.toggle('on', x === b)); }));
    const pop = $('[data-pop]'); let opener: HTMLElement | null = null;
    function openPop() {
      $('[data-msg]').textContent = lastMsg;
      const wa = root!.querySelector('[data-wa]') as HTMLAnchorElement | null, mail = root!.querySelector('[data-mail]') as HTMLAnchorElement | null;
      if (wa) wa.href = 'https://wa.me/' + c.wa + '?text=' + encodeURIComponent(lastMsg);
      if (mail) mail.href = 'mailto:' + c.email + '?subject=' + encodeURIComponent(lastSubj) + '&body=' + encodeURIComponent(lastMsg);
      pop.hidden = false; document.body.style.overflow = 'hidden';
      (pop.querySelector('.rb-pop-btn') as HTMLElement | null)?.focus();
    }
    function closePop() { pop.hidden = true; document.body.style.overflow = ''; opener?.focus(); }
    const ob = root.querySelector('[data-open]') as HTMLElement | null;
    ob?.addEventListener('click', () => { if (!last) return; opener = ob; openPop(); });
    pop.addEventListener('click', (e: any) => { if (e.target === pop || e.target.closest('[data-close]')) closePop(); else if (e.target.closest('.rb-pop-btn')) setTimeout(closePop, 300); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !pop.hidden) closePop(); });
    update();
  }
</script>

<style>


  .rb-stage { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-areas: "ctl view" "fin fin" "as as"; gap: 22px; padding: 26px; border-radius: 18px; color: #e6efec;
    background: radial-gradient(120% 90% at 75% 40%, #12302b 0%, #0a1514 55%, #070d0d 100%); }
  .rb-ctl { grid-area: ctl; display: grid; gap: 12px; align-content: start; }
  .rb-view { grid-area: view; display: grid; gap: 12px; align-content: start; justify-items: center; }
  .rb-grp { width: 100%; box-sizing: border-box; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); border-radius: 14px; padding: 14px; }
  .rb-gh { display: flex; align-items: baseline; gap: 8px; margin-bottom: 10px; flex-wrap: wrap; }
  .rb-gh b { font-size: 15px; } .rb-gh small { color: #8fa7a1; font-size: 12px; }
  .rb-n { width: 22px; height: 22px; border-radius: 50%; display: inline-grid; place-items: center; font: 700 12px var(--mono); background: #5ef0a0; color: #062019; flex: none; align-self: center; }
  .rb-seg { display: inline-flex; border: 1px solid rgba(255,255,255,.15); border-radius: 10px; overflow: hidden; margin-bottom: 12px; }
  .rb-seg button { padding: 0 14px; min-height: 40px; border: 0; background: transparent; color: #cfdcd8; font: 600 13.5px var(--body); cursor: pointer; }
  .rb-seg button.on { background: #5ef0a0; color: #062019; }
  .rb-in { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: flex-end; }
  .rb-in[hidden] { display: none; }
  .rb-num { display: grid; grid-template-columns: auto auto; gap: 4px 8px; align-items: center; font-size: 12px; color: #8fa7a1; }
  .rb-num span { grid-column: 1 / 3; }
  .rb-num input { width: 120px; font: 700 22px var(--mono); padding: 8px 12px; border-radius: 9px; border: 1px solid rgba(255,255,255,.18); background: #0b1615; color: #fff; }
  .rb-num input:focus { outline: 2px solid #5ef0a0; outline-offset: 1px; }
  .rb-num b { font: 600 15px var(--mono); color: #8fa7a1; }
  .rb-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .rb-chip { padding: 0 12px; min-height: 34px; border-radius: 999px; border: 1px solid rgba(255,255,255,.16); background: transparent; color: #cfdcd8; font: 600 13px var(--mono); cursor: pointer; }
  .rb-chip.on { background: #5ef0a0; border-color: #5ef0a0; color: #062019; }
  .rb-mods { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 8px; }
  .rb-mod { display: grid; gap: 3px; text-align: left; padding: 10px; border-radius: 10px; border: 1px solid rgba(255,255,255,.1); background: rgba(0,0,0,.25); color: #cfdcd8; cursor: pointer; font-family: var(--body); }
  .rb-mod b { font-size: 14px; } .rb-mod small { font: 11.5px var(--mono); color: #8fa7a1; }
  .rb-mod.on { border-color: #5ef0a0; background: rgba(94,240,160,.1); color: #fff; box-shadow: 0 0 0 1px #5ef0a0 inset; }
  .rb-read { display: grid; gap: 8px; padding: 16px; border-radius: 14px; background: linear-gradient(135deg, rgba(94,240,160,.12), rgba(94,240,160,.02)); border: 1px solid rgba(94,240,160,.25); }
  .rb-big { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .rb-big span { color: #8fa7a1; font-size: 13px; }
  .rb-big b { font: 700 clamp(38px, 5vw, 54px)/1 var(--display); color: #5ef0a0; }
  .rb-big :global(small) { font-size: 18px; color: #cfdcd8; }
  .rb-rows { margin: 0; display: grid; font-size: 13.5px; }
  .rb-rows :global(div) { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; border-top: 1px dashed rgba(255,255,255,.1); }
  .rb-rows :global(dt) { color: #8fa7a1; } .rb-rows :global(dd) { margin: 0; text-align: right; font-family: var(--mono); font-size: 13px; }
  .rb-rows :global(a) { color: #fff; } .rb-rows :global(.cu) { color: #facc15; font-family: var(--body); }
  .rb-rows :global(.enter) { border: 0; color: #cfdcd8; }
  .rb-checks { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .rb-checks :global(li) { font-size: 12.5px; padding: 7px 10px; border-radius: 8px; background: rgba(250,204,21,.1); color: #fde68a; }
  .rb-modes { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; justify-self: stretch; }
  .rb-modes span { margin-right: 4px; font: 600 11px var(--mono); text-transform: uppercase; letter-spacing: .08em; color: #8fa7a1; }
  .rb-modes button { padding: 6px 12px; border-radius: 999px; border: 1px solid rgba(255,255,255,.18); background: transparent; color: #cfdcd8; font: 600 12.5px var(--body); cursor: pointer; }
  .rb-modes button.on { background: #fff; color: #0a1514; border-color: #fff; }
  .rb-big b { font-size: clamp(30px, 4vw, 44px); }
  .rb-modes { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; justify-self: stretch; }
  .rb-modes span { margin-right: 4px; font: 600 11px var(--mono); text-transform: uppercase; letter-spacing: .08em; color: #8fa7a1; }
  .rb-modes button { padding: 6px 12px; border-radius: 999px; border: 1px solid rgba(255,255,255,.18); background: transparent; color: #cfdcd8; font: 600 12.5px var(--body); cursor: pointer; }
  .rb-modes button.on { background: #fff; color: #0a1514; border-color: #fff; }
  .rb-big b { font-size: clamp(26px, 3.4vw, 40px); }
  .rb-chip small { display: block; font-size: 10px; font-weight: 500; opacity: .75; }
  .rb-seg { display: inline-flex; padding: 3px; border-radius: 999px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); }
  .rb-seg button { padding: 7px 14px; border: 0; border-radius: 999px; background: transparent; color: #cfdcd8; font: 600 13px var(--body); cursor: pointer; }
  .rb-seg button.on { background: #5ef0a0; color: #062019; }
  /* —— 机房：电池柜 → 直流母线 → UPS / 逆变器 → 负载 —— */
  .hv-room { --flow: #f59e0b; position: relative; width: 100%; box-sizing: border-box; display: grid; grid-template-columns: 1fr auto; grid-template-rows: auto auto auto; gap: 0 18px; align-items: end; padding: 20px 18px 0; border-radius: 14px; overflow: hidden;
    background: linear-gradient(180deg, #e2e5e6, #cfd4d6); box-shadow: inset 0 0 0 1px #b8bfc2, 0 24px 50px rgba(0,0,0,.45); }
  .hv-room[data-m="chg"] { --flow: #22c55e; }
  .hv-cabs { display: flex; align-items: flex-end; gap: 10px; min-height: 250px; }
  .hv-cabs :global(.cab) { position: relative; width: 74px; height: var(--h); border-radius: 5px; box-sizing: border-box; padding: 6px 6px 18px; display: grid; grid-template-rows: auto 1fr; gap: 6px;
    background: linear-gradient(90deg, #262d30, #343c3f 50%, #262d30); box-shadow: inset 0 0 0 2px #4a5458, 5px 10px 18px rgba(20,30,40,.35); }
