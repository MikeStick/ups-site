---
// 工商业户外储能柜配置器：① 用途（削峰填谷 / 备用电源 / 光伏 + 储能）② 功率 kW ③ 小时 ④ 光伏装机（只在光伏用途显示）⑤ 冷却（不限 / 风冷 / 液冷）
// → 推荐型号 × 柜数、总功率、总能量、持续时间、占地、总重、需要的选配，以及另一种冷却方式的对比方案。
// 右侧：厂区示意 SVG——电网和变压器、水泥台上一排户外柜（风冷画风扇、液冷画冷却管）、厂房（光伏用途时屋顶有光伏板，备用用途时有 STS 柜）；
// 可切换"夜间充电 / 高峰放电 / 电网停电"看能量流向。计算在 src/lib/cie-engine.mjs（测试：node scripts/test-cie-engine.mjs）。
import { SITE } from '../config.mjs';
import { CI } from '../lib/cie-i18n.mjs';
import { CI_GENERIC, KW_PRESETS, H_PRESETS } from '../lib/cie-engine.mjs';
import { isCiEss, ciSpec } from '../lib/category.mjs';
import all from '../data/products.json';
interface Props { lang: string }
const { lang } = Astro.props;
const T = CI[lang], C = T.c;
const pub = all.filter(isCiEss).map((p) => ({ m: p.model, slug: p.slug, ...ciSpec(p) })).filter((x) => x.kw > 0 && x.kwh > 0);
const models = pub.length ? pub : CI_GENERIC;
const cfg = { lang, wa: SITE.whatsapp, email: SITE.email, models, t: C, cool: T.cool, opt: { pv: T.optPv, sts: T.optSts } };
---
<section class="block civ" id="builder" data-civ data-app="peak">
  <script type="application/json" data-civ-cfg set:html={JSON.stringify(cfg)} />
  <div class="head"><span class="eyebrow">{C.eyebrow}</span><h2>{C.h}</h2><p>{C.p}</p></div>
  <div class="rb-stage">
    <div class="rb-ctl">
      <div class="rb-grp">
        <div class="rb-gh"><span class="rb-n">1</span><b>{C.s1}</b></div>
        <div class="rb-in"><div class="rb-seg">{(['peak', 'backup', 'pv'] as const).map((k, i) => <button type="button" class:list={{ on: i === 0 }} data-app={k}>{C.apps[k]}</button>)}</div></div>
      </div>
      <div class="rb-grp">
        <div class="rb-gh"><span class="rb-n">2</span><b>{C.s2}</b></div>
        <div class="rb-in">
          <label class="rb-num"><span>{C.kwL}</span><input type="number" inputmode="decimal" min="0" step="any" value="100" data-kw /><b>kW</b></label>
          <div class="rb-chips">{KW_PRESETS.map((k) => <button type="button" class:list={['rb-chip', { on: k === 100 }]} data-kp={k}>{k} kW</button>)}</div>
        </div>
      </div>
      <div class="rb-grp">
        <div class="rb-gh"><span class="rb-n">3</span><b>{C.s3}</b></div>
        <div class="rb-in"><div class="rb-chips">{H_PRESETS.map((h) => <button type="button" class:list={['rb-chip', { on: h === 2 }]} data-hp={h}>{h} {C.hu}</button>)}</div></div>
      </div>
      <div class="rb-grp pvonly">
        <div class="rb-gh"><span class="rb-n">4</span><b>{C.s4}</b></div>
        <div class="rb-in"><label class="rb-num"><span>{C.pvL}</span><input type="number" inputmode="decimal" min="0" step="any" value="200" data-pv /><b>kWp</b></label></div>
      </div>
      <div class="rb-grp">
        <div class="rb-gh"><span class="rb-n">5</span><b>{C.s5}</b></div>
        <div class="rb-in"><div class="rb-seg">{(['any', 'air', 'liquid'] as const).map((k, i) => <button type="button" class:list={{ on: i === 0 }} data-cool={k}>{C.cools[k]}</button>)}</div></div>
      </div>
      <div class="rb-read">
        <div class="rb-big"><span>{C.out.model}</span><b data-big>—</b></div>
        <dl class="rb-rows" data-rows></dl>
        <ul class="rb-checks" data-checks></ul>
      </div>
    </div>

    <div class="rb-view">
      <div class="rb-modes" role="group" aria-label={C.s6}>
        <span>{C.s6}</span>
        {(['chg', 'dis', 'cut'] as const).map((k, i) => <button type="button" class:list={{ on: i === 1 }} data-mode={k}>{C.modes[k]}</button>)}
      </div>
      <div class="ci-site" data-site data-m="dis" data-app="peak">
        <svg viewBox="0 0 560 320" role="img" aria-label={C.h}>
          <rect width="560" height="320" class="sky" />
          <circle cx="500" cy="42" r="16" class="sun" /><path d="M508 28a16 16 0 1 0 12 24a12 12 0 1 1-12-24z" class="moon" />
          <rect y="262" width="560" height="58" class="ground" />
          <g class="pylon"><path d="M36 262 L48 130 L60 262 M40 220 H56 M43 180 H53 M34 140 H62" /><text x="48" y="122" class="lbl">{C.vis.grid}</text><text x="70" y="160" class="x">✕</text></g>
          <rect x="72" y="214" width="34" height="48" rx="3" class="tx" /><path d="M78 226h22M78 236h22M78 246h22" class="txl" />
          <g class="fac"><path d="M408 262V170l26-20v20l26-20v20l26-20v20l26-20v112z" class="bld" /><rect x="430" y="214" width="18" height="48" class="door" /><path d="M462 196h14v14h-14zM486 196h14v14h-14z" class="win" /><text x="460" y="282" class="lbl">{C.vis.site}</text></g>
          <g class="pvroof"><polygon points="410,166 434,148 434,140 410,158" /><polygon points="436,166 460,148 460,140 436,158" /><polygon points="462,166 486,148 486,140 462,158" /><polygon points="488,166 512,148 512,140 488,158" /><text x="470" y="132" class="lbl">{C.vis.pv}</text></g>
          <g class="sts"><rect x="372" y="222" width="28" height="40" rx="3" /><text x="386" y="246" class="stl">{C.vis.sts}</text></g>
          <path d="M106 236 H128" class="ln g" /><path d="M362 236 H408" class="ln s" />
          <rect x="118" y="262" width="250" height="8" class="pad" />
          <g data-cabs></g>
        </svg>
      </div>
    </div>

    <div class="rb-final">
      <div class="rb-sum" data-sum></div>
      {(SITE.whatsapp || SITE.email) && <button type="button" class="rb-go" data-open aria-haspopup="dialog">{C.send}</button>}
    </div>
    <details class="rb-assume">
      <summary>{C.assumeH}</summary>
      <ul>{C.assume.map((a) => <li>{a}</li>)}</ul>
    </details>
  </div>

  <div class="rb-pop" data-pop hidden role="dialog" aria-modal="true" aria-labelledby="ci-pop-h">
    <div class="rb-pop-box">
      <button type="button" class="rb-pop-x" data-close aria-label={C.close}>×</button>
      <h3 id="ci-pop-h">{C.popH}</h3>
      <p>{C.popP}</p>
      <pre data-msg></pre>
      <div class="rb-pop-acts">
        {SITE.whatsapp && <a class="rb-pop-btn wa" data-wa href="#" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1a15 15 0 0 1-6.3-5.6c-.5-.8-.9-1.8-.9-2.7s.5-1.7.8-2c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.8-1c.2-.3.4-.2.6-.1l1.8.9c.3.1.4.2.5.3.1.2.1.8-.1 1.4z"/></svg>{C.viaWa}</a>}
        {SITE.email && <a class="rb-pop-btn mail" data-mail href="#"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2.4V17h16V7.4l-8 5.3-8-5.3zM5.6 7l6.4 4.2L18.4 7H5.6z"/></svg>{C.viaMail}<small>{SITE.email}</small></a>}
      </div>
    </div>
  </div>
</section>

<script>
  import { sizeCi, CI_ASSUME } from '../lib/cie-engine.mjs';
  const root = document.querySelector('[data-civ]') as HTMLElement | null;
  if (root) {
    const c = JSON.parse(root.querySelector('[data-civ-cfg]')!.textContent || '{}'), T = c.t;
    const $ = (s: string) => root.querySelector(s) as HTMLElement;
    const $$ = (s: string) => Array.from(root.querySelectorAll(s)) as HTMLElement[];
    const fmt = (s: string, o: any) => String(s).replace(/\{(\w+)\}/g, (_: string, k: string) => (o[k] !== undefined ? o[k] : ''));
    const num = (el: HTMLInputElement) => Math.max(0, parseFloat(String(el.value).replace(',', '.')) || 0);
    const st: any = { app: 'peak', kw: 100, hours: 2, pvKw: 200, cool: 'any' };
    let lastMsg = '', lastSubj = '', last: any = null, drawn = '';
    const row = (k: string, v: string) => `<div><dt>${k}</dt><dd>${v}</dd></div>`;
    const MAXSHOW = 5;
    function draw(r: any) {
      const g = $('[data-cabs]');
      if (!r || r.none) { g.innerHTML = ''; drawn = ''; return; }
      const key = `${r.n}|${r.mod.m}`;
      if (key === drawn) return;
      const prev = drawn && drawn.split('|')[1] === r.mod.m ? +drawn.split('|')[0] : 0;
      drawn = key;
      const show = Math.min(r.n, MAXSHOW), w = 40, gap = 8, x0 = 128, liq = r.mod.cool === 'liquid';
      const h = Math.max(70, Math.min(96, (r.mod.dims && r.mod.dims[2] ? r.mod.dims[2] : 2200) / 25));
      let s = '';
      for (let i = 0; i < show; i++) {
        const x = x0 + i * (w + gap), y = 262 - h;
        s += `<g class="cab${i >= prev ? ' ins' : ''}" style="--d:${(i - prev) * 80}ms"><rect x="${x}" y="${y}" width="${w}" height="${h}" rx="3" class="body"/><path d="M${x + w / 2} ${y + 4}V${y + h - 4}" class="seam"/><rect x="${x + 6}" y="${y + 8}" width="12" height="6" rx="1" class="hmi"/>`
          + (liq ? `<path d="M${x + 24} ${y + 10}v${h - 26}M${x + 30} ${y + 10}v${h - 26}" class="pipe"/>` : `<circle cx="${x + w / 2}" cy="${y + h - 18}" r="7" class="fan"/><path d="M${x + w / 2 - 6} ${y + h - 18}h12M${x + w / 2} ${y + h - 24}v12" class="fanb"/>`)
          + `<text x="${x + w / 2}" y="${y - 4}" class="kwh">${Math.round(r.mod.kwh)}</text></g>`;
      }
      if (r.n > show) s += `<text x="${x0 + show * (w + gap) + 6}" y="236" class="more">+${r.n - show}</text>`;
      g.innerHTML = s;
    }
    function update() {
      const r = sizeCi({ app: st.app, kw: st.kw, hours: st.hours, pvKw: st.pvKw, cool: st.cool, models: c.models });
      const go = $('[data-open]') as HTMLButtonElement | null;
      last = r && !r.none ? r : null;
      $('[data-site]').dataset.app = st.app; root.dataset.app = st.app;
      draw(r);
      if (!r || r.none) { $('[data-big]').textContent = '—'; $('[data-rows]').innerHTML = `<div class="enter">${r ? T.out.custom : T.out.enter}</div>`; $('[data-checks]').innerHTML = ''; $('[data-sum]').innerHTML = ''; if (go) go.disabled = true; return; }
      if (go) go.disabled = false;
      const m = r.mod, cool = c.cool[m.cool];
      $('[data-big]').innerHTML = `${m.slug ? `<a href="/${c.lang}/p/${m.slug}/">${m.m}</a>` : m.m}<small> × ${r.n}</small>`;
      const opts = [m.pv ? c.opt.pv : '', m.sts ? c.opt.sts : ''].filter(Boolean).join(' · ') || '—';
      let h = row(T.out.n, `${r.n} · ${cool}`) + row(T.out.power, `${r.totalKw} kW`) + row(T.out.energy, `${r.totalKwh} kWh`) + row(T.out.usable, `${r.usableKwh} kWh`)
        + row(fmt(T.out.runtime, { kw: st.kw }), fmt(T.out.runtimeN, { h: r.runtime })) + row(T.out.opts, opts);
      if (st.app === 'pv' && r.pvMax) h += row(T.out.pvMax, `${r.pvMax} kWp`);
      if (r.area) h += row(T.out.area, `≈ ${r.area} m²`);
      if (r.tons) h += row(T.out.weight, `≈ ${r.tons} t`);
      if (r.alt) h += row(fmt(T.out.alt, { cool: c.cool[r.alt.mod.cool] }), `${r.alt.mod.m} × ${r.alt.n} · ${r.alt.totalKwh} kWh`);
      $('[data-rows]').innerHTML = h;
      const ch = [];
      if (r.by === 'power') ch.push(fmt(T.chk.power, { kw: m.kw }));
      if (r.by === 'pv') ch.push(T.chk.pv);
      if (st.app === 'backup') ch.push(T.chk.sts);
      if (r.optMissing) ch.push(fmt(T.chk.optMissing, { opt: c.opt[r.needOpt] }));
      if (r.overPar) ch.push(fmt(T.chk.par, { p: CI_ASSUME.maxPar }));
      $('[data-checks]').innerHTML = ch.map((x) => `<li>${x}</li>`).join('');
      $('[data-sum]').innerHTML = `<div><span>${T.sum}</span><b>${m.m} × ${r.n} · ${r.totalKw} kW / ${r.totalKwh} kWh · ${cool}</b></div>`;
      lastMsg = fmt(T.msg, { app: T.apps[st.app], kw: st.kw, h: st.hours, pv: st.app === 'pv' ? `, PV ${st.pvKw} kWp` : '', model: m.m, n: r.n, cool, kwT: r.totalKw, kwh: r.totalKwh });
      lastSubj = `${T.subj} · ${m.m} × ${r.n}`;
    }
    const sync = (attr: string, v: any) => $$(`[${attr}]`).forEach((x) => x.classList.toggle('on', String(x.getAttribute(attr)) === String(v)));
    $$('[data-app]').forEach((b) => { if (b.tagName !== 'BUTTON') return; b.addEventListener('click', () => { st.app = b.dataset.app; sync('data-app', st.app); $$('[data-app]').forEach((x) => { if (x.tagName !== 'BUTTON') x.dataset.app = st.app; }); update(); }); });
    $$('[data-cool]').forEach((b) => b.addEventListener('click', () => { st.cool = b.dataset.cool; sync('data-cool', st.cool); update(); }));
    $('[data-kw]').addEventListener('input', (e: any) => { st.kw = num(e.target); sync('data-kp', st.kw); update(); });
    $('[data-pv]').addEventListener('input', (e: any) => { st.pvKw = num(e.target); update(); });
    $$('[data-kp]').forEach((b) => b.addEventListener('click', () => { st.kw = +b.dataset.kp!; ($('[data-kw]') as HTMLInputElement).value = String(st.kw); sync('data-kp', st.kw); update(); }));
    $$('[data-hp]').forEach((b) => b.addEventListener('click', () => { st.hours = +b.dataset.hp!; sync('data-hp', st.hours); update(); }));
    $$('[data-mode]').forEach((b) => b.addEventListener('click', () => { $('[data-site]').dataset.m = b.dataset.mode; $$('[data-mode]').forEach((x) => x.classList.toggle('on', x === b)); }));
    const pop = $('[data-pop]'); let opener: HTMLElement | null = null;
    function openPop() {
      $('[data-msg]').textContent = lastMsg;
      const wa = root!.querySelector('[data-wa]') as HTMLAnchorElement | null, mail = root!.querySelector('[data-mail]') as HTMLAnchorElement | null;
      if (wa) wa.href = 'https://wa.me/' + c.wa + '?text=' + encodeURIComponent(lastMsg);
      if (mail) mail.href = 'mailto:' + c.email + '?subject=' + encodeURIComponent(lastSubj) + '&body=' + encodeURIComponent(lastMsg);
      pop.hidden = false; document.body.style.overflow = 'hidden';
      (pop.querySelector('.rb-pop-btn') as HTMLElement | null)?.focus();
    }
    function closePop() { pop.hidden = true; document.body.style.overflow = ''; opener?.focus(); }
    const ob = root.querySelector('[data-open]') as HTMLElement | null;
    ob?.addEventListener('click', () => { if (!last) return; opener = ob; openPop(); });
    pop.addEventListener('click', (e: any) => { if (e.target === pop || e.target.closest('[data-close]')) closePop(); else if (e.target.closest('.rb-pop-btn')) setTimeout(closePop, 300); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !pop.hidden) closePop(); });
    update();
  }
</script>

<style>


  .rb-stage { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-areas: "ctl view" "fin fin" "as as"; gap: 22px; padding: 26px; border-radius: 18px; color: #e6efec;
    background: radial-gradient(120% 90% at 75% 40%, #12302b 0%, #0a1514 55%, #070d0d 100%); }
  .rb-ctl { grid-area: ctl; display: grid; gap: 12px; align-content: start; }
  .rb-view { grid-area: view; display: grid; gap: 12px; align-content: start; justify-items: center; }
  .rb-grp { width: 100%; box-sizing: border-box; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); border-radius: 14px; padding: 14px; }
  .rb-gh { display: flex; align-items: baseline; gap: 8px; margin-bottom: 10px; flex-wrap: wrap; }
  .rb-gh b { font-size: 15px; } .rb-gh small { color: #8fa7a1; font-size: 12px; }
  .rb-n { width: 22px; height: 22px; border-radius: 50%; display: inline-grid; place-items: center; font: 700 12px var(--mono); background: #5ef0a0; color: #062019; flex: none; align-self: center; }
  .rb-seg { display: inline-flex; border: 1px solid rgba(255,255,255,.15); border-radius: 10px; overflow: hidden; margin-bottom: 12px; }
  .rb-seg button { padding: 0 14px; min-height: 40px; border: 0; background: transparent; color: #cfdcd8; font: 600 13.5px var(--body); cursor: pointer; }
  .rb-seg button.on { background: #5ef0a0; color: #062019; }
  .rb-in { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: flex-end; }
  .rb-in[hidden] { display: none; }
  .rb-num { display: grid; grid-template-columns: auto auto; gap: 4px 8px; align-items: center; font-size: 12px; color: #8fa7a1; }
  .rb-num span { grid-column: 1 / 3; }
  .rb-num input { width: 120px; font: 700 22px var(--mono); padding: 8px 12px; border-radius: 9px; border: 1px solid rgba(255,255,255,.18); background: #0b1615; color: #fff; }
  .rb-num input:focus { outline: 2px solid #5ef0a0; outline-offset: 1px; }
  .rb-num b { font: 600 15px var(--mono); color: #8fa7a1; }
  .rb-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .rb-chip { padding: 0 12px; min-height: 34px; border-radius: 999px; border: 1px solid rgba(255,255,255,.16); background: transparent; color: #cfdcd8; font: 600 13px var(--mono); cursor: pointer; }
  .rb-chip.on { background: #5ef0a0; border-color: #5ef0a0; color: #062019; }
  .rb-mods { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 8px; }
  .rb-mod { display: grid; gap: 3px; text-align: left; padding: 10px; border-radius: 10px; border: 1px solid rgba(255,255,255,.1); background: rgba(0,0,0,.25); color: #cfdcd8; cursor: pointer; font-family: var(--body); }
  .rb-mod b { font-size: 14px; } .rb-mod small { font: 11.5px var(--mono); color: #8fa7a1; }
  .rb-mod.on { border-color: #5ef0a0; background: rgba(94,240,160,.1); color: #fff; box-shadow: 0 0 0 1px #5ef0a0 inset; }
  .rb-read { display: grid; gap: 8px; padding: 16px; border-radius: 14px; background: linear-gradient(135deg, rgba(94,240,160,.12), rgba(94,240,160,.02)); border: 1px solid rgba(94,240,160,.25); }
  .rb-big { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .rb-big span { color: #8fa7a1; font-size: 13px; }
  .rb-big b { font: 700 clamp(38px, 5vw, 54px)/1 var(--display); color: #5ef0a0; }
  .rb-big :global(small) { font-size: 18px; color: #cfdcd8; }
  .rb-rows { margin: 0; display: grid; font-size: 13.5px; }
  .rb-rows :global(div) { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; border-top: 1px dashed rgba(255,255,255,.1); }
  .rb-rows :global(dt) { color: #8fa7a1; } .rb-rows :global(dd) { margin: 0; text-align: right; font-family: var(--mono); font-size: 13px; }
  .rb-rows :global(a) { color: #fff; } .rb-rows :global(.cu) { color: #facc15; font-family: var(--body); }
  .rb-rows :global(.enter) { border: 0; color: #cfdcd8; }
  .rb-checks { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .rb-checks :global(li) { font-size: 12.5px; padding: 7px 10px; border-radius: 8px; background: rgba(250,204,21,.1); color: #fde68a; }
  .rb-modes { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; justify-self: stretch; }
  .rb-modes span { margin-right: 4px; font: 600 11px var(--mono); text-transform: uppercase; letter-spacing: .08em; color: #8fa7a1; }
  .rb-modes button { padding: 6px 12px; border-radius: 999px; border: 1px solid rgba(255,255,255,.18); background: transparent; color: #cfdcd8; font: 600 12.5px var(--body); cursor: pointer; }
  .rb-modes button.on { background: #fff; color: #0a1514; border-color: #fff; }
  .rb-big b { font-size: clamp(30px, 4vw, 44px); }
  .rb-modes { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; justify-self: stretch; }
  .rb-modes span { margin-right: 4px; font: 600 11px var(--mono); text-transform: uppercase; letter-spacing: .08em; color: #8fa7a1; }
  .rb-modes button { padding: 6px 12px; border-radius: 999px; border: 1px solid rgba(255,255,255,.18); background: transparent; color: #cfdcd8; font: 600 12.5px var(--body); cursor: pointer; }
  .rb-modes button.on { background: #fff; color: #0a1514; border-color: #fff; }
