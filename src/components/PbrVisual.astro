---
// 锂电替换铅酸电池查找器：两种用法（页签切换）
// ① 换一块电池：铅酸电压 + Ah → 同 Ah 锂电、可用电量相同的更小锂电；右侧天平比较重量，下面条形图比较可用电量。
// ② 组一个电池组：系统电压 + 能量（或负载 × 时间）→ 最多 3 种串并联方案（块数少优先）；右侧画出几串几并的接线。
// 计算在 src/lib/pbr-engine.mjs（测试：node scripts/test-pbr-engine.mjs）。
import { SITE } from '../config.mjs';
import { PB } from '../lib/pbr-i18n.mjs';
import { PB_GENERIC, AH_PRESETS, KWH_PRESETS } from '../lib/pbr-engine.mjs';
import { isPbReplace, pbModule } from '../lib/category.mjs';
import all from '../data/products.json';
interface Props { lang: string }
const { lang } = Astro.props;
const T = PB[lang], C = T.c;
const pub = all.filter(isPbReplace).map((p) => ({ m: p.model, slug: p.slug, ...pbModule(p) })).filter((x) => x.v > 0 && x.ah > 0);
const models = pub.length ? pub : PB_GENERIC;
const cfg = { lang, wa: SITE.whatsapp, email: SITE.email, models, t: C };
---
<section class="block pbv" id="builder" data-pbv data-tab="one">
  <script type="application/json" data-pbv-cfg set:html={JSON.stringify(cfg)} />
  <div class="head"><span class="eyebrow">{C.eyebrow}</span><h2>{C.h}</h2><p>{C.p}</p></div>
  <div class="pb-tabs" role="tablist">{(['one', 'bank'] as const).map((k, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} class:list={{ on: i === 0 }} data-tabbtn={k}>{C.tabs[k]}</button>)}</div>
  <div class="rb-stage">
    <div class="rb-ctl">
      <div class="pane-one">
        <div class="rb-grp">
          <div class="rb-gh"><span class="rb-n">1</span><b>{C.sV}</b></div>
          <div class="rb-in"><div class="rb-chips">{[12, 24, 48].map((v, i) => <button type="button" class:list={['rb-chip', { on: i === 0 }]} data-cls={v}>{C.vN.replace('{v}', String(v))}</button>)}</div></div>
        </div>
        <div class="rb-grp">
          <div class="rb-gh"><span class="rb-n">2</span><b>{C.sAh}</b></div>
          <div class="rb-in">
            <label class="rb-num"><span>{C.ahL}</span><input type="number" inputmode="decimal" min="0" step="any" value="7" data-ah /><b>{C.ahU}</b></label>
            <div class="rb-chips">{AH_PRESETS.map((a) => <button type="button" class:list={['rb-chip', { on: a === 7 }]} data-ahp={a}>{a} {C.ahU}</button>)}</div>
          </div>
        </div>
      </div>
      <div class="pane-bank">
        <div class="rb-grp">
          <div class="rb-gh"><span class="rb-n">1</span><b>{C.sSys}</b></div>
          <div class="rb-in"><div class="rb-chips">{[12, 24, 48].map((v) => <button type="button" class:list={['rb-chip', { on: v === 48 }]} data-sys={v}>{C.vN.replace('{v}', String(v))}</button>)}</div></div>
        </div>
        <div class="rb-grp">
          <div class="rb-gh"><span class="rb-n">2</span><b>{C.sBy}</b></div>
          <div class="rb-in">
            <div class="rb-seg">{(['kwh', 'load'] as const).map((k, i) => <button type="button" class:list={{ on: i === 0 }} data-by={k}>{C.by[k]}</button>)}</div>
            <div class="by-kwh">
              <label class="rb-num"><span>{C.kwhL}</span><input type="number" inputmode="decimal" min="0" step="any" value="5" data-kwh /><b>kWh</b></label>
              <div class="rb-chips">{KWH_PRESETS.map((k) => <button type="button" class:list={['rb-chip', { on: k === 5 }]} data-kwhp={k}>{k} kWh</button>)}</div>
            </div>
            <div class="by-load">
              <label class="rb-num"><span>{C.loadL}</span><input type="number" inputmode="decimal" min="0" step="any" value="1000" data-load /><b>W</b></label>
              <label class="rb-num"><span>{C.hoursL}</span><input type="number" inputmode="decimal" min="0" step="any" value="4" data-hours /><b>{C.hu}</b></label>
            </div>
          </div>
        </div>
        <div class="pb-opts" data-opts></div>
      </div>
      <div class="rb-read">
        <dl class="rb-rows" data-rows></dl>
        <ul class="rb-checks" data-checks></ul>
      </div>
    </div>

    <div class="rb-view">
      <div class="pb-scale pane-one" data-scale>
        <div class="pb-beam" data-beam>
          <div class="pb-pan l"><div class="pb-bat pb" data-bpb><span class="t"><i></i><i></i></span><b>{C.vis.pb}</b><small data-kpb></small></div></div>
          <div class="pb-pan r"><div class="pb-bat li" data-bli><span class="t"><i></i><i></i></span><b>{C.vis.li}</b><small data-kli></small></div></div>
        </div>
        <div class="pb-post"></div>
        <div class="pb-bars" data-bars></div>
      </div>
      <div class="pb-bank pane-bank" data-bank></div>
    </div>

    <div class="rb-final">
      <div class="rb-sum" data-sum></div>
      {(SITE.whatsapp || SITE.email) && <button type="button" class="rb-go" data-open aria-haspopup="dialog">{C.send}</button>}
    </div>
    <details class="rb-assume">
      <summary>{C.assumeH}</summary>
      <ul>{C.assume.map((a) => <li>{a}</li>)}</ul>
    </details>
  </div>

  <div class="rb-pop" data-pop hidden role="dialog" aria-modal="true" aria-labelledby="pb-pop-h">
    <div class="rb-pop-box">
      <button type="button" class="rb-pop-x" data-close aria-label={C.close}>×</button>
      <h3 id="pb-pop-h">{C.popH}</h3>
      <p>{C.popP}</p>
      <pre data-msg></pre>
      <div class="rb-pop-acts">
        {SITE.whatsapp && <a class="rb-pop-btn wa" data-wa href="#" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1a15 15 0 0 1-6.3-5.6c-.5-.8-.9-1.8-.9-2.7s.5-1.7.8-2c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.8-1c.2-.3.4-.2.6-.1l1.8.9c.3.1.4.2.5.3.1.2.1.8-.1 1.4z"/></svg>{C.viaWa}</a>}
        {SITE.email && <a class="rb-pop-btn mail" data-mail href="#"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2.4V17h16V7.4l-8 5.3-8-5.3zM5.6 7l6.4 4.2L18.4 7H5.6z"/></svg>{C.viaMail}<small>{SITE.email}</small></a>}
      </div>
    </div>
  </div>
</section>

<script>
  import { replaceOne, buildBank, loadToWh, LEVELS } from '../lib/pbr-engine.mjs';
  const root = document.querySelector('[data-pbv]') as HTMLElement | null;
  if (root) {
    const c = JSON.parse(root.querySelector('[data-pbv-cfg]')!.textContent || '{}'), T = c.t;
    const $ = (s: string) => root.querySelector(s) as HTMLElement;
    const $$ = (s: string) => Array.from(root.querySelectorAll(s)) as HTMLElement[];
    const fmt = (s: string, o: any) => String(s).replace(/\{(\w+)\}/g, (_: string, k: string) => (o[k] !== undefined ? o[k] : ''));
    const num = (el: HTMLInputElement) => Math.max(0, parseFloat(String(el.value).replace(',', '.')) || 0);
    const kwhTxt = (wh: number) => (wh >= 1000 ? `${Math.round(wh / 100) / 10} kWh` : `${Math.round(wh)} Wh`);
    const link = (m: any) => (m.slug ? `<a href="/${c.lang}/p/${m.slug}/">${m.m}</a>` : m.m);
    const st: any = { tab: 'one', cls: 12, ah: 7, sys: 48, by: 'kwh', kwh: 5, load: 1000, hours: 4, opt: 0 };
    let lastMsg = '', lastSubj = '', last: any = null;
    const row = (k: string, v: string) => `<div><dt>${k}</dt><dd>${v}</dd></div>`;
    function batSize(el: HTMLElement, dims: number[], fb: number) {
      const L = dims && dims.length ? dims[0] : fb * 1.6, H = dims && dims.length ? dims[2] : fb;
      el.style.width = `${Math.max(70, Math.min(130, L * 0.32))}px`; el.style.height = `${Math.max(46, Math.min(96, H * 0.4))}px`;
    }
    function one() {
      const r = replaceOne({ cls: st.cls, ah: st.ah, models: c.models });
      const go = $('[data-open]') as HTMLButtonElement | null;
      last = null;
      if (!r) { $('[data-rows]').innerHTML = `<div class="enter">${T.out.enter}</div>`; $('[data-checks]').innerHTML = ''; $('[data-sum]').innerHTML = ''; $('[data-bars]').innerHTML = ''; if (go) go.disabled = true; return; }
      if (r.none || r.tooBig) {
        $('[data-rows]').innerHTML = ''; $('[data-checks]').innerHTML = `<li>${r.none ? fmt(T.out.none, { v: st.cls }) : fmt(T.out.tooBig, { ah: r.maxAh })}</li>`;
        $('[data-sum]').innerHTML = ''; $('[data-bars]').innerHTML = ''; if (go) go.disabled = true; return;
      }
      if (go) go.disabled = false;
      const s = r.same, m = s.mod;
      let h = `<div class="pb-card pb0"><span>${T.out.pb} · ${st.cls} V ${st.ah} Ah</span><b>≈ ${r.pb.kg} kg <small>(${T.out.est})</small></b><em>${T.out.usable} ≈ ${kwhTxt(r.pb.usableWh)}</em></div>`;
      h += `<div class="pb-card pb1"><span>${T.out.pick}</span><b>${link(m)}</b><em>${m.kg ? `${m.kg} kg · ${fmt(T.out.save, { p: s.save })} · ` : ''}${T.out.usable} ${kwhTxt(s.usableWh)}${m.dims && m.dims.length ? ` · ${m.dims.join(' × ')} mm` : ''}</em></div>`;
      if (r.small) { const sm = r.small.mod; h += `<div class="pb-card pb2"><span>${T.out.small}</span><b>${link(sm)}</b><em>${sm.kg ? `${sm.kg} kg · ` : ''}${T.out.usable} ${kwhTxt(r.small.usableWh)}${sm.dims && sm.dims.length ? ` · ${sm.dims.join(' × ')} mm` : ''}</em></div>`; }
      $('[data-rows]').innerHTML = h; $('[data-checks]').innerHTML = '';
      // 天平：重的一边往下，最多倾斜 14°
      const kl = r.pb.kg, kr = m.kg || kl;
      const ang = Math.max(-14, Math.min(14, ((kr - kl) / Math.max(kl, kr)) * 14));
      $('[data-beam]').style.setProperty('--a', `${ang}deg`);
      $('[data-kpb]').textContent = `≈ ${kl} kg`; $('[data-kli]').textContent = m.kg ? `${m.kg} kg` : '';
      batSize($('[data-bpb]'), m.dims, 60); batSize($('[data-bli]'), m.dims, 60);
      const mx = Math.max(r.pb.usableWh, s.usableWh, r.small ? r.small.usableWh : 0);
      const bar = (lb: string, wh: number, cls: string) => `<div class="bar ${cls}"><span>${lb}</span><i style="--w:${Math.round((wh / mx) * 100)}%"></i><b>${kwhTxt(wh)}</b></div>`;
      $('[data-bars]').innerHTML = `<p>${T.out.usable}</p>` + bar(T.vis.pb, r.pb.usableWh, 'p') + bar(m.m, s.usableWh, 'l') + (r.small ? bar(r.small.mod.m, r.small.usableWh, 'l2') : '');
      $('[data-sum]').innerHTML = `<div><span>${T.sumOne}</span><b>${st.cls} V ${st.ah} Ah → ${m.m}${r.small ? ' / ' + r.small.mod.m : ''}</b></div>`;
      lastMsg = fmt(T.msgOne, { pb: `${st.cls} V ${st.ah} Ah`, model: m.m, wh: m.wh, kg: m.kg || '—' });
      lastSubj = `${T.subj} · ${m.m}`; last = r;
    }
    function drawBank(o: any) {
      const s = o.s, p = o.p, rows = Math.min(p, 4), W = 64, H = 40, gx = 22, gy = 18, x0 = 30, y0 = 26;
      const w = x0 * 2 + s * W + (s - 1) * gx, hgt = y0 + rows * (H + gy) + (p > rows ? 20 : 0) + 10;
      let g = `<svg viewBox="0 0 ${w} ${hgt}" role="img" aria-label="${s}S${p}P">`;
      g += `<line x1="${x0 - 14}" y1="${y0 + H / 2}" x2="${x0 - 14}" y2="${y0 + (rows - 1) * (H + gy) + H / 2}" class="nb"/>`;
      g += `<line x1="${w - x0 + 14}" y1="${y0 + H / 2}" x2="${w - x0 + 14}" y2="${y0 + (rows - 1) * (H + gy) + H / 2}" class="pb"/>`;
      for (let r = 0; r < rows; r++) {
        const y = y0 + r * (H + gy);
        g += `<line x1="${x0 - 14}" y1="${y + H / 2}" x2="${x0}" y2="${y + H / 2}" class="nb"/><line x1="${w - x0}" y1="${y + H / 2}" x2="${w - x0 + 14}" y2="${y + H / 2}" class="pb"/>`;
        for (let i = 0; i < s; i++) {
          const x = x0 + i * (W + gx);
          g += `<g class="cell" style="--d:${(r * s + i) * 50}ms"><rect x="${x}" y="${y}" width="${W}" height="${H}" rx="5"/><rect x="${x + 6}" y="${y + 6}" width="${W - 12}" height="6" rx="2" class="st"/><text x="${x + W / 2}" y="${y + H - 9}">${o.mod.v} V</text><text x="${x + 8}" y="${y - 3}" class="tm">−</text><text x="${x + W - 12}" y="${y - 3}" class="tm p">+</text></g>`;
          if (i < s - 1) g += `<path d="M${x + W} ${y + H / 2} H${x + W + gx}" class="sr"/>`;
        }
      }
      if (p > rows) g += `<text x="${w / 2}" y="${hgt - 6}" class="more">+${(p - rows) * s}</text>`;
      g += `<text x="${x0 - 14}" y="14" class="bl">−</text><text x="${w - x0 + 10}" y="14" class="bl p">+</text></svg>`;
      $('[data-bank]').innerHTML = `<div class="cfgtag">${s}S${p}P · ${LEVELS[st.sys]} V · ${kwhTxt(o.totalWh)}</div>${g}<p>${s > 1 ? `${s} × ${T.vis.series}` : ''}${s > 1 && p > 1 ? ' · ' : ''}${p > 1 ? `${p} × ${T.vis.parallel}` : ''}</p>`;
    }
    function bank() {
      const needWh = st.by === 'kwh' ? st.kwh * 1000 : loadToWh(st.load, st.hours);
      const r = buildBank({ sysV: st.sys, needWh, loadW: st.by === 'load' ? st.load : 0, models: c.models });
      const go = $('[data-open]') as HTMLButtonElement | null;
      last = null;
      if (!r || r.none) { $('[data-opts]').innerHTML = ''; $('[data-rows]').innerHTML = `<div class="enter">${r ? T.out.noBank : T.out.enter}</div>`; $('[data-checks]').innerHTML = ''; $('[data-bank]').innerHTML = ''; $('[data-sum]').innerHTML = ''; if (go) go.disabled = true; return; }
      if (go) go.disabled = false;
      if (st.opt >= r.opts.length) st.opt = 0;
      $('[data-opts]').innerHTML = r.opts.map((o: any, i: number) => `<button type="button" class="pb-opt${i === st.opt ? ' on' : ''}" data-opt="${i}"><small>${fmt(T.out.opt, { i: i + 1 })} · ${o.s}S${o.p}P</small><b>${o.mod.m} × ${o.n}</b><em>${kwhTxt(o.totalWh)}${o.kg ? ` · ${o.kg} kg` : ''}</em></button>`).join('');
      $$('[data-opt]').forEach((b) => b.addEventListener('click', () => { st.opt = +b.dataset.opt!; bank(); }));
      const o = r.opts[st.opt];
      let h = row(T.out.cfg, `${o.s}S${o.p}P`) + row(T.out.n, `${link(o.mod)} × ${o.n}`) + row(T.out.total, kwhTxt(o.totalWh)) + row(T.out.usable, kwhTxt(o.usableWh));
      if (o.amps) h += row(T.out.amps, `${o.amps} A`);
      if (o.kg) h += row(T.out.kg, `${o.kg} kg`);
      $('[data-rows]').innerHTML = h;
      const ch = []; if (o.byCurrent) ch.push(T.chk.current); if (o.s > 1) ch.push(T.chk.series);
      $('[data-checks]').innerHTML = ch.map((x) => `<li>${x}</li>`).join('');
      drawBank(o);
      const need = st.by === 'kwh' ? `${st.kwh} kWh` : `${st.load} W × ${st.hours} ${T.hu}`;
      $('[data-sum]').innerHTML = `<div><span>${T.sumBank}</span><b>${o.mod.m} × ${o.n} · ${o.s}S${o.p}P · ${kwhTxt(o.totalWh)} @ ${st.sys} V</b></div>`;
      lastMsg = fmt(T.msgBank, { v: st.sys, need, model: o.mod.m, n: o.n, cfg: `${o.s}S${o.p}P`, wh: o.totalWh, use: o.usableWh });
      lastSubj = `${T.subj} · ${o.mod.m} × ${o.n}`; last = o;
    }
    const update = () => (st.tab === 'one' ? one() : bank());
    const sync = (attr: string, v: any) => $$(`[${attr}]`).forEach((x) => x.classList.toggle('on', String(x.getAttribute(attr)) === String(v)));
    const bindNum = (sel: string, key: string, chips?: string) => $(sel).addEventListener('input', (e: any) => { st[key] = num(e.target); if (chips) sync(chips, st[key]); update(); });
    const bindChips = (attr: string, key: string, input?: string) => $$(`[${attr}]`).forEach((b) => b.addEventListener('click', () => { st[key] = +b.getAttribute(attr)!; if (input) ($(input) as HTMLInputElement).value = String(st[key]); sync(attr, st[key]); st.opt = 0; update(); }));
    $$('[data-tabbtn]').forEach((b) => b.addEventListener('click', () => { st.tab = b.dataset.tabbtn; root.dataset.tab = st.tab; $$('[data-tabbtn]').forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-selected', String(x === b)); }); update(); }));
    $$('[data-by]').forEach((b) => b.addEventListener('click', () => { st.by = b.dataset.by; root.dataset.by = st.by; sync('data-by', st.by); st.opt = 0; update(); }));
    root.dataset.by = 'kwh';
    bindChips('data-cls', 'cls'); bindChips('data-ahp', 'ah', '[data-ah]'); bindNum('[data-ah]', 'ah', 'data-ahp');
    bindChips('data-sys', 'sys'); bindChips('data-kwhp', 'kwh', '[data-kwh]'); bindNum('[data-kwh]', 'kwh', 'data-kwhp');
    bindNum('[data-load]', 'load'); bindNum('[data-hours]', 'hours');
    const pop = $('[data-pop]'); let opener: HTMLElement | null = null;
    function openPop() {
      $('[data-msg]').textContent = lastMsg;
      const wa = root!.querySelector('[data-wa]') as HTMLAnchorElement | null, mail = root!.querySelector('[data-mail]') as HTMLAnchorElement | null;
      if (wa) wa.href = 'https://wa.me/' + c.wa + '?text=' + encodeURIComponent(lastMsg);
      if (mail) mail.href = 'mailto:' + c.email + '?subject=' + encodeURIComponent(lastSubj) + '&body=' + encodeURIComponent(lastMsg);
      pop.hidden = false; document.body.style.overflow = 'hidden';
      (pop.querySelector('.rb-pop-btn') as HTMLElement | null)?.focus();
    }
    function closePop() { pop.hidden = true; document.body.style.overflow = ''; opener?.focus(); }
    const ob = root.querySelector('[data-open]') as HTMLElement | null;
    ob?.addEventListener('click', () => { if (!last) return; opener = ob; openPop(); });
    pop.addEventListener('click', (e: any) => { if (e.target === pop || e.target.closest('[data-close]')) closePop(); else if (e.target.closest('.rb-pop-btn')) setTimeout(closePop, 300); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !pop.hidden) closePop(); });
    update();
  }
</script>

<style>


  .rb-stage { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-areas: "ctl view" "fin fin" "as as"; gap: 22px; padding: 26px; border-radius: 18px; color: #e6efec;
    background: radial-gradient(120% 90% at 75% 40%, #12302b 0%, #0a1514 55%, #070d0d 100%); }
  .rb-ctl { grid-area: ctl; display: grid; gap: 12px; align-content: start; }
  .rb-view { grid-area: view; display: grid; gap: 12px; align-content: start; justify-items: center; }
  .rb-grp { width: 100%; box-sizing: border-box; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); border-radius: 14px; padding: 14px; }
  .rb-gh { display: flex; align-items: baseline; gap: 8px; margin-bottom: 10px; flex-wrap: wrap; }
  .rb-gh b { font-size: 15px; } .rb-gh small { color: #8fa7a1; font-size: 12px; }
  .rb-n { width: 22px; height: 22px; border-radius: 50%; display: inline-grid; place-items: center; font: 700 12px var(--mono); background: #5ef0a0; color: #062019; flex: none; align-self: center; }
  .rb-seg { display: inline-flex; border: 1px solid rgba(255,255,255,.15); border-radius: 10px; overflow: hidden; margin-bottom: 12px; }
  .rb-seg button { padding: 0 14px; min-height: 40px; border: 0; background: transparent; color: #cfdcd8; font: 600 13.5px var(--body); cursor: pointer; }
  .rb-seg button.on { background: #5ef0a0; color: #062019; }
  .rb-in { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: flex-end; }
  .rb-in[hidden] { display: none; }
  .rb-num { display: grid; grid-template-columns: auto auto; gap: 4px 8px; align-items: center; font-size: 12px; color: #8fa7a1; }
  .rb-num span { grid-column: 1 / 3; }
  .rb-num input { width: 120px; font: 700 22px var(--mono); padding: 8px 12px; border-radius: 9px; border: 1px solid rgba(255,255,255,.18); background: #0b1615; color: #fff; }
  .rb-num input:focus { outline: 2px solid #5ef0a0; outline-offset: 1px; }
  .rb-num b { font: 600 15px var(--mono); color: #8fa7a1; }
  .rb-chips { display: flex; flex-wrap: wrap; gap: 6px; }
