---
// 一体式锂电 UPS 备电配置器：① 负载 W ② 需要的备电小时 → 推荐型号 + 电池节数、备电时间，以及当前负载下所有型号 × 节数的备电表。
// 右侧：塔式 UPS 剖面（前面板 LCD 显示负载和备电时间，透明窗里是电池仓，选几节就插几节），可切换"有市电 / 停电"看能量流向。
// 计算在 src/lib/aio-engine.mjs（测试：node scripts/test-aio-engine.mjs）。
import { SITE } from '../config.mjs';
import { AO } from '../lib/aio-i18n.mjs';
import { AIO_GENERIC, LOAD_PRESETS, HOUR_PRESETS, aioOptions } from '../lib/aio-engine.mjs';
import { isAio, capacityOf } from '../lib/category.mjs';
import all from '../data/products.json';
interface Props { lang: string }
const { lang } = Astro.props;
const T = AO[lang], C = T.c;
const pub = all.filter(isAio).map((p) => ({ m: p.model, slug: p.slug, w: capacityOf(p).w, opts: aioOptions(p) })).filter((x) => x.w > 0 && x.opts.length).sort((a, b) => a.w - b.w);
const models = pub.length ? pub : AIO_GENERIC;
const cfg = { lang, wa: SITE.whatsapp, email: SITE.email, models, t: C, battN: T.battN };
const SLOTS = 6;
---
<section class="block aiv" id="builder" data-aiv>
  <script type="application/json" data-aiv-cfg set:html={JSON.stringify(cfg)} />
  <div class="head"><span class="eyebrow">{C.eyebrow}</span><h2>{C.h}</h2><p>{C.p}</p></div>
  <div class="rb-stage">
    <div class="rb-ctl">
      <div class="rb-grp">
        <div class="rb-gh"><span class="rb-n">1</span><b>{C.s1}</b></div>
        <div class="rb-in">
          <label class="rb-num"><span>{C.loadL}</span><input type="number" inputmode="decimal" min="0" step="any" value="500" data-load /><b>W</b></label>
          <div class="rb-chips">{LOAD_PRESETS.map((w) => <button type="button" class:list={['rb-chip', { on: w === 500 }]} data-lp={w}>{w} W</button>)}</div>
        </div>
      </div>
      <div class="rb-grp">
        <div class="rb-gh"><span class="rb-n">2</span><b>{C.s2}</b></div>
        <div class="rb-in">
          <label class="rb-num"><span>{C.hoursL}</span><input type="number" inputmode="decimal" min="0" step="any" value="4" data-hours /><b>{C.hu}</b></label>
          <div class="rb-chips">{HOUR_PRESETS.map((h) => <button type="button" class:list={['rb-chip', { on: h === 4 }]} data-hp={h}>{h} {C.hu}</button>)}</div>
        </div>
      </div>
      <div class="rb-read">
        <div class="rb-big"><span>{C.out.model}</span><b data-big>—</b></div>
        <dl class="rb-rows" data-rows></dl>
        <ul class="rb-checks" data-checks></ul>
      </div>
    </div>

    <div class="rb-view">
      <div class="rb-modes" role="group" aria-label={C.s3}>
        <span>{C.s3}</span>
        <button type="button" class="on" data-mode="ac">{C.modes.ac}</button><button type="button" data-mode="cut">{C.modes.cut}</button>
      </div>
      <div class="ai-scene" data-scene data-m="ac">
        <div class="ai-src"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 7 22M12 2l5 20M8 9h8M7 14h10M9.5 6h5" /></svg><b>{C.vis.grid}</b><i class="ai-x">✕</i></div>
        <div class="ai-line l1"><span></span></div>
        <div class="ai-ups">
          <div class="ai-lcd"><b data-lcd-load>—</b><small data-lcd-rt></small></div>
          <div class="ai-led"><i></i><i></i><i></i></div>
          <div class="ai-bay" data-bay>{Array.from({ length: SLOTS }, (_, i) => <div class="ai-slot" data-slot={i}><span class="ai-pk"><i></i><i></i><i></i><i></i></span></div>)}</div>
          <div class="ai-foot"></div>
        </div>
        <div class="ai-line l2"><span></span></div>
        <div class="ai-dst"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="13" height="10" rx="1.5" /><path d="M7 20h5M9.5 14v6M19 6v14M17 9h4" /></svg><b>{C.vis.load}</b><small data-dst-w></small></div>
        <div class="ai-cut">{C.vis.cut}</div>
      </div>
      <div class="ai-tbl" data-tbl></div>
    </div>

    <div class="rb-final">
      <div class="rb-sum" data-sum></div>
      {(SITE.whatsapp || SITE.email) && <button type="button" class="rb-go" data-open aria-haspopup="dialog">{C.send}</button>}
    </div>
    <details class="rb-assume">
      <summary>{C.assumeH}</summary>
      <ul>{C.assume.map((a) => <li>{a}</li>)}</ul>
    </details>
  </div>

  <div class="rb-pop" data-pop hidden role="dialog" aria-modal="true" aria-labelledby="ai-pop-h">
    <div class="rb-pop-box">
      <button type="button" class="rb-pop-x" data-close aria-label={C.close}>×</button>
      <h3 id="ai-pop-h">{C.popH}</h3>
      <p>{C.popP}</p>
      <pre data-msg></pre>
      <div class="rb-pop-acts">
        {SITE.whatsapp && <a class="rb-pop-btn wa" data-wa href="#" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1a15 15 0 0 1-6.3-5.6c-.5-.8-.9-1.8-.9-2.7s.5-1.7.8-2c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.8-1c.2-.3.4-.2.6-.1l1.8.9c.3.1.4.2.5.3.1.2.1.8-.1 1.4z"/></svg>{C.viaWa}</a>}
        {SITE.email && <a class="rb-pop-btn mail" data-mail href="#"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2.4V17h16V7.4l-8 5.3-8-5.3zM5.6 7l6.4 4.2L18.4 7H5.6z"/></svg>{C.viaMail}<small>{SITE.email}</small></a>}
      </div>
    </div>
  </div>
</section>

<script>
  import { sizeAio } from '../lib/aio-engine.mjs';
  const root = document.querySelector('[data-aiv]') as HTMLElement | null;
  if (root) {
    const c = JSON.parse(root.querySelector('[data-aiv-cfg]')!.textContent || '{}'), T = c.t;
    const $ = (s: string) => root.querySelector(s) as HTMLElement;
    const $$ = (s: string) => Array.from(root.querySelectorAll(s)) as HTMLElement[];
    const fmt = (s: string, o: any) => String(s).replace(/\{(\w+)\}/g, (_: string, k: string) => (o[k] !== undefined ? o[k] : ''));
    const num = (el: HTMLInputElement) => Math.max(0, parseFloat(String(el.value).replace(',', '.')) || 0);
    const bn = (n: number) => fmt(c.battN, { n });
    const st: any = { load: 500, hours: 4 };
    let lastMsg = '', lastSubj = '', last: any = null;
    function drawBay(n: number) {
      $$('[data-slot]').forEach((s) => {
        const i = +s.dataset.slot!, on = i < n, was = s.classList.contains('on');
        s.classList.toggle('on', on);
        if (on && !was) { s.classList.remove('ins'); void s.offsetWidth; s.classList.add('ins'); (s as HTMLElement).style.setProperty('--d', `${i * 70}ms`); }
      });
    }
    function update() {
      const r = sizeAio({ loadW: st.load, hours: st.hours, models: c.models });
      last = r && !r.over ? r : null;
      const go = $('[data-open]') as HTMLButtonElement | null;
      const row = (k: string, v: string) => `<div><dt>${k}</dt><dd>${v}</dd></div>`;
      $('[data-dst-w]').textContent = st.load ? `${st.load} W` : '';
      if (!r) { $('[data-big]').textContent = '—'; $('[data-rows]').innerHTML = `<div class="enter">${T.out.enter}</div>`; $('[data-checks]').innerHTML = ''; $('[data-sum]').innerHTML = ''; $('[data-tbl]').innerHTML = ''; drawBay(0); $('[data-lcd-load]').textContent = '—'; $('[data-lcd-rt]').textContent = ''; if (go) go.disabled = true; return; }
      // 备电表：当前负载下每个型号 × 每种节数
      const maxCols = Math.max(...r.table.map((x: any) => x.opts.length));
      let tb = `<table><caption>${fmt(T.table, { w: st.load })}</caption><tbody>`;
      for (const x of r.table) {
        tb += `<tr class="${x.ok ? '' : 'no'}"><th>${x.slug ? `<a href="/${c.lang}/p/${x.slug}/">${x.m}</a>` : x.m}</th>`;
        for (let i = 0; i < maxCols; i++) {
          const o = x.opts[i];
          if (!o) { tb += '<td></td>'; continue; }
          const pick = last && last.model.m === x.m && last.opt.wh === o.wh;
          tb += `<td class="${pick ? 'pick' : ''}"><small>${o.n ? bn(o.n) : o.wh + ' Wh'}</small><b>${x.ok ? `${o.h} ${T.hu}` : T.tNone}</b></td>`;
        }
        tb += '</tr>';
      }
      $('[data-tbl]').innerHTML = tb + '</tbody></table>';
      if (r.over) {
        $('[data-big]').textContent = '—'; $('[data-rows]').innerHTML = ''; $('[data-checks]').innerHTML = `<li>${fmt(T.chk.over, { w: r.maxW })}</li>`; $('[data-sum]').innerHTML = ''; drawBay(0);
        $('[data-lcd-load]').textContent = '>100%'; $('[data-lcd-rt]').textContent = ''; if (go) go.disabled = true; return;
      }
      if (go) go.disabled = false;
      const m = r.model, o = r.opt;
      $('[data-big]').innerHTML = `${m.m}<small>${o.n ? ' · ' + bn(o.n) : ''}</small>`;
      let h = row(T.out.runtime, fmt(T.out.runtimeN, { h: r.runtime })) + row(T.out.load, `${r.loadPct}%`) + row(T.out.energy, `${o.wh} Wh`);
      if (o.n) h += row(T.out.batt, String(o.n));
      if (o.kg) h += row(T.out.kg, `${o.kg} kg`);
      if (!m.slug) h += row(T.out.model, `<span class="cu">${T.out.custom}</span>`);
      $('[data-rows]').innerHTML = h;
      const ch = [];
      if (r.short) ch.push(fmt(T.chk.short, { h: r.runtime }));
      if (r.loadPct > 85) ch.push(fmt(T.chk.high, { p: r.loadPct }));
      $('[data-checks]').innerHTML = ch.map((x) => `<li>${x}</li>`).join('');
      drawBay(o.n || Math.min(6, Math.round(o.wh / 896)));
      $('[data-lcd-load]').textContent = `${r.loadPct}%`;
      $('[data-lcd-rt]').textContent = fmt(T.out.runtimeN, { h: r.runtime });
      $('[data-sum]').innerHTML = `<div><span>${T.sum}</span><b>${m.m}${o.n ? ' · ' + bn(o.n) : ''} · ${o.wh} Wh · ≈ ${r.runtime} ${T.hu} @ ${st.load} W</b></div>`;
      lastMsg = fmt(T.msg, { load: st.load, hours: st.hours, model: m.m, n: o.n || '—', wh: o.wh, rt: r.runtime });
      lastSubj = `${T.subj} · ${m.m}`;
    }
    const sync = (attr: string, v: number) => $$(`[${attr}]`).forEach((x) => x.classList.toggle('on', +x.getAttribute(attr)! === v));
    $('[data-load]').addEventListener('input', (e: any) => { st.load = num(e.target); sync('data-lp', st.load); update(); });
    $('[data-hours]').addEventListener('input', (e: any) => { st.hours = num(e.target); sync('data-hp', st.hours); update(); });
    $$('[data-lp]').forEach((b) => b.addEventListener('click', () => { st.load = +b.dataset.lp!; ($('[data-load]') as HTMLInputElement).value = String(st.load); sync('data-lp', st.load); update(); }));
    $$('[data-hp]').forEach((b) => b.addEventListener('click', () => { st.hours = +b.dataset.hp!; ($('[data-hours]') as HTMLInputElement).value = String(st.hours); sync('data-hp', st.hours); update(); }));
    $$('[data-mode]').forEach((b) => b.addEventListener('click', () => { $('[data-scene]').dataset.m = b.dataset.mode; $$('[data-mode]').forEach((x) => x.classList.toggle('on', x === b)); }));
    const pop = $('[data-pop]'); let opener: HTMLElement | null = null;
    function openPop() {
      $('[data-msg]').textContent = lastMsg;
      const wa = root!.querySelector('[data-wa]') as HTMLAnchorElement | null, mail = root!.querySelector('[data-mail]') as HTMLAnchorElement | null;
      if (wa) wa.href = 'https://wa.me/' + c.wa + '?text=' + encodeURIComponent(lastMsg);
      if (mail) mail.href = 'mailto:' + c.email + '?subject=' + encodeURIComponent(lastSubj) + '&body=' + encodeURIComponent(lastMsg);
      pop.hidden = false; document.body.style.overflow = 'hidden';
      (pop.querySelector('.rb-pop-btn') as HTMLElement | null)?.focus();
    }
    function closePop() { pop.hidden = true; document.body.style.overflow = ''; opener?.focus(); }
    const ob = root.querySelector('[data-open]') as HTMLElement | null;
    ob?.addEventListener('click', () => { if (!last) return; opener = ob; openPop(); });
    pop.addEventListener('click', (e: any) => { if (e.target === pop || e.target.closest('[data-close]')) closePop(); else if (e.target.closest('.rb-pop-btn')) setTimeout(closePop, 300); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !pop.hidden) closePop(); });
    update();
  }
</script>

<style>

  .rb-stage { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-areas: "ctl view" "fin fin" "as as"; gap: 22px; padding: 26px; border-radius: 18px; color: #e6efec;
    background: radial-gradient(120% 90% at 75% 40%, #12302b 0%, #0a1514 55%, #070d0d 100%); }
  .rb-ctl { grid-area: ctl; display: grid; gap: 12px; align-content: start; }
  .rb-view { grid-area: view; display: grid; gap: 12px; align-content: start; justify-items: center; }
  .rb-grp { width: 100%; box-sizing: border-box; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); border-radius: 14px; padding: 14px; }
  .rb-gh { display: flex; align-items: baseline; gap: 8px; margin-bottom: 10px; flex-wrap: wrap; }
  .rb-gh b { font-size: 15px; } .rb-gh small { color: #8fa7a1; font-size: 12px; }
  .rb-n { width: 22px; height: 22px; border-radius: 50%; display: inline-grid; place-items: center; font: 700 12px var(--mono); background: #5ef0a0; color: #062019; flex: none; align-self: center; }
  .rb-seg { display: inline-flex; border: 1px solid rgba(255,255,255,.15); border-radius: 10px; overflow: hidden; margin-bottom: 12px; }
  .rb-seg button { padding: 0 14px; min-height: 40px; border: 0; background: transparent; color: #cfdcd8; font: 600 13.5px var(--body); cursor: pointer; }
  .rb-seg button.on { background: #5ef0a0; color: #062019; }
  .rb-in { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: flex-end; }
  .rb-in[hidden] { display: none; }
  .rb-num { display: grid; grid-template-columns: auto auto; gap: 4px 8px; align-items: center; font-size: 12px; color: #8fa7a1; }
  .rb-num span { grid-column: 1 / 3; }
  .rb-num input { width: 120px; font: 700 22px var(--mono); padding: 8px 12px; border-radius: 9px; border: 1px solid rgba(255,255,255,.18); background: #0b1615; color: #fff; }
  .rb-num input:focus { outline: 2px solid #5ef0a0; outline-offset: 1px; }
  .rb-num b { font: 600 15px var(--mono); color: #8fa7a1; }
  .rb-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .rb-chip { padding: 0 12px; min-height: 34px; border-radius: 999px; border: 1px solid rgba(255,255,255,.16); background: transparent; color: #cfdcd8; font: 600 13px var(--mono); cursor: pointer; }
  .rb-chip.on { background: #5ef0a0; border-color: #5ef0a0; color: #062019; }
  .rb-mods { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 8px; }
  .rb-mod { display: grid; gap: 3px; text-align: left; padding: 10px; border-radius: 10px; border: 1px solid rgba(255,255,255,.1); background: rgba(0,0,0,.25); color: #cfdcd8; cursor: pointer; font-family: var(--body); }
  .rb-mod b { font-size: 14px; } .rb-mod small { font: 11.5px var(--mono); color: #8fa7a1; }
  .rb-mod.on { border-color: #5ef0a0; background: rgba(94,240,160,.1); color: #fff; box-shadow: 0 0 0 1px #5ef0a0 inset; }
  .rb-read { display: grid; gap: 8px; padding: 16px; border-radius: 14px; background: linear-gradient(135deg, rgba(94,240,160,.12), rgba(94,240,160,.02)); border: 1px solid rgba(94,240,160,.25); }
  .rb-big { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .rb-big span { color: #8fa7a1; font-size: 13px; }
  .rb-big b { font: 700 clamp(38px, 5vw, 54px)/1 var(--display); color: #5ef0a0; }
  .rb-big :global(small) { font-size: 18px; color: #cfdcd8; }
  .rb-rows { margin: 0; display: grid; font-size: 13.5px; }
  .rb-rows :global(div) { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; border-top: 1px dashed rgba(255,255,255,.1); }
  .rb-rows :global(dt) { color: #8fa7a1; } .rb-rows :global(dd) { margin: 0; text-align: right; font-family: var(--mono); font-size: 13px; }
  .rb-rows :global(a) { color: #fff; } .rb-rows :global(.cu) { color: #facc15; font-family: var(--body); }
  .rb-rows :global(.enter) { border: 0; color: #cfdcd8; }
  .rb-checks { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .rb-checks :global(li) { font-size: 12.5px; padding: 7px 10px; border-radius: 8px; background: rgba(250,204,21,.1); color: #fde68a; }
  .rb-modes { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; justify-self: stretch; }
  .rb-modes span { margin-right: 4px; font: 600 11px var(--mono); text-transform: uppercase; letter-spacing: .08em; color: #8fa7a1; }
  .rb-modes button { padding: 6px 12px; border-radius: 999px; border: 1px solid rgba(255,255,255,.18); background: transparent; color: #cfdcd8; font: 600 12.5px var(--body); cursor: pointer; }
  .rb-modes button.on { background: #fff; color: #0a1514; border-color: #fff; }
  .rb-big b { font-size: clamp(30px, 4vw, 44px); }
  /* —— 场景：市电 → UPS → 负载 —— */
  .ai-scene { --flow: #5ef0a0; position: relative; width: 100%; box-sizing: border-box; display: grid; grid-template-columns: 64px 1fr 150px 1fr 74px; align-items: center; padding: 22px 16px; border-radius: 14px;
    background: linear-gradient(180deg, #e7e4dc, #d8d4ca); box-shadow: inset 0 0 0 1px #c4bfb3, 0 24px 50px rgba(0,0,0,.45); }
  .ai-scene[data-m="cut"] { --flow: #f59e0b; }
  .ai-src, .ai-dst { position: relative; display: grid; justify-items: center; gap: 4px; color: #4b4840; font: 700 10px var(--mono); letter-spacing: .08em; }
  .ai-src svg, .ai-dst svg { width: 34px; height: 34px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .ai-dst small { font: 700 11px var(--mono); color: #1f2937; letter-spacing: 0; }
  .ai-x { display: none; position: absolute; top: -4px; right: 6px; font-style: normal; font-size: 18px; color: #dc2626; }
  .ai-scene[data-m="cut"] .ai-src { color: #a8a397; }
  .ai-scene[data-m="cut"] .ai-x { display: block; }
  .ai-line { position: relative; height: 8px; border-radius: 4px; background: #c9c5ba; overflow: hidden; }
  .ai-line span { position: absolute; inset: 2px 3px; border-radius: 2px; background: repeating-linear-gradient(90deg, var(--flow) 0 12px, transparent 12px 24px); animation: aiFlow .9s linear infinite; }
  .ai-scene[data-m="cut"] .l1 span { animation: none; background: repeating-linear-gradient(90deg, #dc2626 0 4px, transparent 4px 10px); opacity: .5; }
  @keyframes aiFlow { from { background-position: 0 0; } to { background-position: 24px 0; } }
  .ai-cut { display: none; position: absolute; left: 14px; top: 10px; padding: 3px 9px; border-radius: 999px; background: #dc2626; color: #fff; font: 700 10px var(--mono); letter-spacing: .08em; }
  .ai-scene[data-m="cut"] .ai-cut { display: block; }
  .ai-ups { position: relative; height: 250px; border-radius: 10px; padding: 12px 12px 0; box-sizing: border-box; display: grid; grid-template-rows: auto auto 1fr auto; gap: 8px;
    background: linear-gradient(90deg, #2a3133, #384143 50%, #2a3133); box-shadow: inset 0 0 0 2px #4a5658, 6px 12px 22px rgba(40,30,10,.35); }
  .ai-lcd { display: grid; justify-items: center; padding: 6px 4px; border-radius: 5px; background: #0b1a17; box-shadow: inset 0 0 0 1px #1d4a3c; }
  .ai-lcd b { font: 700 16px var(--mono); color: #5ef0a0; }
  .ai-lcd small { font: 700 10px var(--mono); color: #8fe8bd; min-height: 12px; }
  .ai-led { display: flex; justify-content: center; gap: 6px; }
  .ai-led i { width: 6px; height: 6px; border-radius: 50%; background: #3a4648; }
  .ai-led i:first-child { background: #22c55e; box-shadow: 0 0 6px #22c55e; }
  .ai-scene[data-m="cut"] .ai-led i:nth-child(2) { background: #f59e0b; box-shadow: 0 0 6px #f59e0b; animation: aiBlink 1s steps(1) infinite; }
  @keyframes aiBlink { 50% { opacity: .2; } }
  .ai-bay { display: grid; grid-template-columns: 1fr 1fr; grid-auto-rows: 1fr; gap: 5px; padding: 6px; border-radius: 5px; background: rgba(0,0,0,.35); box-shadow: inset 0 0 0 1px #4a5658; }
