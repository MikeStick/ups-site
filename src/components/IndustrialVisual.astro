    background: radial-gradient(120% 90% at 75% 30%, #2a2414 0%, #12110c 55%, #0a0a08 100%); }
  .iv-stage::before { content: ""; position: absolute; inset: 0; pointer-events: none; border-radius: 18px;
    background: repeating-linear-gradient(90deg, rgba(229,154,79,.05) 0 1px, transparent 1px 48px), repeating-linear-gradient(0deg, rgba(229,154,79,.05) 0 1px, transparent 1px 48px);
    mask-image: radial-gradient(80% 70% at 70% 40%, #000 30%, transparent 80%); }
