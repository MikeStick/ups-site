  .iv-chip b, .iv-rc b, .iv-opt b { font-size: 13.5px; }
  .iv-seg { display: inline-flex; border: 1px solid rgba(255,255,255,.15); border-radius: 10px; overflow: hidden; }
  .iv-seg.wrap { display: flex; flex-wrap: wrap; border: 0; gap: 6px; border-radius: 0; overflow: visible; }
  .iv-seg button { padding: 0 14px; min-height: 40px; border: 0; background: transparent; color: #d8d2c4; font: 600 13.5px var(--body); cursor: pointer; }
  .iv-seg button small { font-weight: 500; color: inherit; opacity: .75; }
  .iv-seg.wrap button { border: 1px solid rgba(255,255,255,.15); border-radius: 999px; min-height: 36px; }
  .iv-seg button.on { background: #f0a959; color: #231503; border-color: #f0a959; }
  .iv-seg.sm button { min-height: 36px; padding: 0 10px; font-family: var(--mono); }
  .iv-sub-l { font-size: 12px; color: #a59c86; margin: 4px 0 6px; }
