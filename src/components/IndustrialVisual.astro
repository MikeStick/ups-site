  .iv-gh-tip { position: relative; }
  .iv-tip { position: relative; display: inline-flex; margin-left: auto; align-self: center; }
  .iv-q { width: 20px; height: 20px; border-radius: 50%; border: 1px solid rgba(255,255,255,.35); background: rgba(255,255,255,.06); color: #d8d2c4; font: 700 12px/1 var(--mono); cursor: help; padding: 0; }
  .iv-q:hover, .iv-q:focus-visible { border-color: #f0a959; color: #f0a959; outline: none; }
  .iv-tipbox { position: absolute; z-index: 30; right: -8px; top: calc(100% + 10px); width: min(340px, 84vw); padding: 14px; border-radius: 12px; font-size: 12.5px; line-height: 1.5; color: #d8d2c4;
    background: #1f1a10; border: 1px solid rgba(240,169,89,.4); box-shadow: 0 18px 40px rgba(0,0,0,.55); opacity: 0; visibility: hidden; transform: translateY(-4px); transition: opacity .15s, transform .15s, visibility .15s; }
  .iv-tip:hover .iv-tipbox, .iv-tip:focus-within .iv-tipbox { opacity: 1; visibility: visible; transform: none; }
  .iv-otog { width: 100%; padding: 0; margin-bottom: 0; border: 0; background: none; color: inherit; font: inherit; text-align: left; cursor: pointer; }
  .iv-chev { width: 9px; height: 9px; margin-left: auto; border: solid #d8d2c4; border-width: 0 2px 2px 0; transform: rotate(45deg) translateY(-3px); transition: transform .25s; align-self: center; }
  .iv-otog.open .iv-chev { transform: rotate(-135deg) translateY(-1px); }
  .iv-chosen { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .iv-chosen :global(.iv-chipx) { display: inline-flex; align-items: center; gap: 6px; padding: 4px 4px 4px 10px; border-radius: 999px; font-size: 12.5px; color: #fff; background: rgba(240,169,89,.14); border: 1px solid rgba(240,169,89,.5); }
  .iv-chosen :global(.iv-chipx i) { width: 6px; height: 6px; border-radius: 50%; background: #f0a959; }
