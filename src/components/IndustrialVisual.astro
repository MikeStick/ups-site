  .iv-volts label, .iv-volts > div { display: grid; gap: 4px; font-size: 12px; color: #a59c86; }
  .iv-volts select { font: 600 15px var(--mono); padding: 8px 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,.15); background: #17150f; color: #fff; }
  .iv-num { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
  .iv-num input { width: 130px; font: 700 22px var(--mono); padding: 8px 12px; border-radius: 9px; border: 1px solid rgba(255,255,255,.18); background: #17150f; color: #fff; }
  .iv-num input:focus { outline: 2px solid #f0a959; outline-offset: 1px; }
  .iv-num b { font: 600 15px var(--mono); color: #a59c86; }
  .iv-chips { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
