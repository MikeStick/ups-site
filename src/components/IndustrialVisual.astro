  .iv-cab .lbl.sm { font-size: 11px; }
  .iv-cab :global(.lbl.xs) { font: 600 9px var(--mono); fill: #a59c86; text-anchor: middle; }
  .iv-cab .lcd rect { fill: #0c1a10; stroke: #284a33; }
  .iv-cab .lcd-a { font: 600 10px var(--mono); fill: #5ef0a0; letter-spacing: .18em; }
  .iv-cab .lcd-b { font: 700 15px var(--mono); fill: #5ef0a0; }
  .iv-cab .knob { fill: #c0392b; stroke: #7f1d1d; } .iv-cab .knob-h { fill: #fef2f2; }
  .iv-cab .core { fill: #2e3739 !important; }
