---
// 主图区：最多 6 张图 + 1 个 YouTube 视频。
// 视频只在点击后才加载 iframe（先显示缩略图），页面首屏不需要下载 YouTube 的脚本。
import { UI } from '../i18n.mjs';
const { images = [], youtube = null, alt = '', lang } = Astro.props;
const t = UI[lang];
const items = [
  ...images.map((im) => ({ kind: 'img', src: im.src, thumb: im.thumb })),
  ...(youtube ? [{ kind: 'video', id: youtube, thumb: `https://i.ytimg.com/vi/${youtube}/hqdefault.jpg` }] : []),
];
const first = items[0];
---
<div class="gallery" data-gallery>
  <div class="stage" data-stage>
    {first && first.kind === 'img' && <img src={first.src} alt={alt} width="1400" height="1400" fetchpriority="high" />}
    {first && first.kind === 'video' && (
      <button class="play" type="button" data-play={first.id} aria-label={t.playVideo}>
        <img src={first.thumb} alt="" /><span class="play-icon" aria-hidden="true"></span>
      </button>
    )}
  </div>
  {items.length > 1 && (
    <div class="thumbs" role="list" aria-label={t.morePhotos}>
      {items.map((it, i) => (
        <button
          type="button" role="listitem" class="thumb"
          aria-current={i === 0 ? 'true' : 'false'}
          data-kind={it.kind} data-src={it.kind === 'img' ? it.src : ''} data-id={it.kind === 'video' ? it.id : ''}
          aria-label={it.kind === 'video' ? t.playVideo : `${alt} ${i + 1}`}
        >
          <img src={it.thumb} alt="" loading="lazy" />
          {it.kind === 'video' && <span class="play-icon small" aria-hidden="true"></span>}
        </button>
      ))}
    </div>
  )}
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-gallery]').forEach(function (g) {
      var stage = g.querySelector('[data-stage]');
      var alt = (stage.querySelector('img') || {}).alt || '';
      function video(id) {
        stage.innerHTML = '<iframe src="https://www.youtube-nocookie.com/embed/' + id +
          '?autoplay=1&rel=0" title="Video" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>';
      }
      stage.addEventListener('click', function (e) {
        var b = e.target.closest('[data-play]'); if (b) video(b.getAttribute('data-play'));
      });
      g.querySelectorAll('.thumb').forEach(function (b) {
        b.addEventListener('click', function () {
          g.querySelectorAll('.thumb').forEach(function (x) { x.setAttribute('aria-current', 'false'); });
          b.setAttribute('aria-current', 'true');
          if (b.dataset.kind === 'video') { video(b.dataset.id); return; }
          stage.innerHTML = '';
          var img = document.createElement('img');
          img.src = b.dataset.src; img.alt = alt;
          stage.appendChild(img);
        });
      });
    });
  })();
</script>

<style>
  .gallery { display: grid; gap: 10px; min-width: 0; }
  .stage { aspect-ratio: 1; max-width: 100%; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .stage :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .stage :global(iframe) { width: 100%; height: 100%; border: 0; aspect-ratio: 1; }
  .play { position: relative; width: 100%; height: 100%; border: 0; padding: 0; background: #000; cursor: pointer; }
  .play img { width: 100%; height: 100%; object-fit: cover; opacity: .85; }
  .thumbs { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 8px; }
  @media (max-width: 520px) { .thumbs { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .thumb { position: relative; aspect-ratio: 1; padding: 0; border: 1.5px solid var(--line); border-radius: 8px; overflow: hidden; background: var(--surface); cursor: pointer; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .thumb[aria-current="true"] { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  .play-icon { position: absolute; left: 50%; top: 50%; width: 68px; height: 48px; margin: -24px 0 0 -34px; background: #e00; border-radius: 12px; }
  .play-icon::after { content: ""; position: absolute; left: 27px; top: 14px; border-style: solid; border-width: 10px 0 10px 17px; border-color: transparent transparent transparent #fff; }
  .play-icon.small { width: 30px; height: 22px; margin: -11px 0 0 -15px; border-radius: 6px; }
  .play-icon.small::after { left: 11px; top: 6px; border-width: 5px 0 5px 9px; }
</style>
