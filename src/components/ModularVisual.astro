---
// 模块化 UPS 可视化选型：① 选机框（最多 10 个功率模块）② 选功率模块规格 ③ 装几个模块
// 右侧实时显示机柜正面：选中的同一规格模块逐个插进槽位（不支持混插不同功率的模块）。
// 机框 + 模块规格能对上规格书里的型号时显示型号名；对不上的提示"可定制"。
import { SITE } from '../config.mjs';
import { catalog } from '../data/modular-catalog.mjs';
import ModularBattery from './ModularBattery.astro';
interface Props { lang: string }
const { lang } = Astro.props;
const FRAMES = [2, 3, 4, 6, 8, 10];
// 选配卡：插在机柜顶部的智能卡槽（最多 4 张），温湿度传感器是外接配件（通过 SNMP 卡接入）
const SLOTS = 4;
const CARDS = [
  { id: 'snmp', tag: 'SNMP', ports: 'rj', en: ['SNMP card', 'Web / SNMP monitoring over Ethernet, e-mail and trap alarms'], es: ['Tarjeta SNMP', 'Monitoreo web / SNMP por Ethernet, alarmas por correo y trap'], ru: ['Карта SNMP', 'Мониторинг через веб / SNMP по Ethernet, оповещения по e-mail и trap'] },
  { id: 'modbus', tag: 'MODBUS', ports: 'tb3', en: ['Modbus card', 'Modbus RTU / TCP to BMS, DCIM or SCADA'], es: ['Tarjeta Modbus', 'Modbus RTU / TCP hacia BMS, DCIM o SCADA'], ru: ['Карта Modbus', 'Modbus RTU / TCP в BMS, DCIM или SCADA'] },
  { id: 'dry', tag: 'RELAY', ports: 'tb6', en: ['Dry contact card', 'Relay outputs: mains failure, low battery, bypass, alarm'], es: ['Tarjeta de contactos secos', 'Salidas de relé: falla de red, batería baja, bypass, alarma'], ru: ['Карта сухих контактов', 'Релейные выходы: пропадание сети, разряд батарей, байпас, авария'] },
  { id: 'rs485', tag: 'RS485', ports: 'db9', en: ['RS485 / RS232 card', 'Serial port for monitoring software'], es: ['Tarjeta RS485 / RS232', 'Puerto serie para software de monitoreo'], ru: ['Карта RS485 / RS232', 'Последовательный порт для ПО мониторинга'] },
  { id: 'par', tag: 'PARA', ports: 'rj2', en: ['Parallel card', 'Parallel several cabinets for more capacity'], es: ['Tarjeta de paralelo', 'Conecta varios gabinetes en paralelo para más capacidad'], ru: ['Карта параллельной работы', 'Параллельное подключение шкафов для увеличения мощности'] },
  { id: 'lbs', tag: 'LBS', ports: 'rj2', en: ['LBS card', 'Load bus synchronization: keeps two systems in phase (2N)'], es: ['Tarjeta LBS', 'Sincroniza los buses de carga de dos sistemas (2N)'], ru: ['Карта LBS', 'Синхронизация шин нагрузки двух систем (2N)'] },
  { id: 'bms', tag: 'BMS', ports: 'tb3', en: ['Battery monitoring card', 'Voltage, internal resistance and temperature of every block'], es: ['Tarjeta de monitoreo de baterías', 'Voltaje, resistencia interna y temperatura de cada bloque'], ru: ['Карта мониторинга батарей', 'Напряжение, внутреннее сопротивление и температура каждого блока'] },
  { id: 'emd', tag: 'T/H', ext: true, en: ['Temperature & humidity sensor', 'Probe for the UPS / battery room, connects to the SNMP card'], es: ['Sensor de temperatura y humedad', 'Sonda para la sala de UPS / baterías, se conecta a la tarjeta SNMP'], ru: ['Датчик температуры и влажности', 'Датчик для помещения ИБП / батарей, подключается к карте SNMP'] },
];
const cards = CARDS.map((c) => ({ id: c.id, tag: c.tag, ports: c.ports || '', ext: !!c.ext, name: (c[lang] || c.en)[0], desc: (c[lang] || c.en)[1] }));
const MODS = [10, 15, 20, 30, 50, 60, 100];
const V = {
  en: {
    eyebrow: 'Visual builder', h: 'Build your system, slot by slot', p: 'Pick a frame and a power-module rating — modules slide in in real time, one rating per frame. Then size the batteries and send the whole configuration.',
    s1: 'Frame', s1n: 'Up to {n} power modules', slots: '{n} slots', s2: 'Power module', s2n: 'All modules in a frame have the same rating', s3: 'Modules installed', s4: 'Redundancy',
    total: 'System capacity', usable: 'Usable with N+1', tipL: 'What do N, N+1 and 2N mean?', redTip: [['N', 'No redundant module. All installed modules share the load; if one fails, the system capacity drops by one module. Lowest cost.'], ['N+1', 'One spare module. If any single module fails, the others still carry the full load and the module can be hot-swapped. The usual choice for IT rooms and data centers.'], ['2N', 'Two complete UPS systems in parallel, each able to carry the whole load alone. Even if an entire system (frame, bypass or battery) fails, the load stays protected. Highest reliability.']], s5: 'Option cards', noneSel: 'None selected — click to add', remove: 'Remove', s5n: 'Up to {n} intelligent card slots', slotsUsed: '{u} / {n} slots', full: 'All card slots are used', needSnmp: 'Needs the SNMP card — added automatically.', lbsHint: 'For 2N we recommend the LBS card so both systems stay synchronized.', ext: 'External', sumCards: 'Cards', noCards: 'None', cardsMsg: '\n• Option cards: {c}', perCab: ' (one set per cabinet)', usableN: 'No redundant module', usable2N: 'Usable with 2N (one system)', dual: '2N · two systems in parallel', sumUps: 'UPS', sumBat: 'Battery', fixFirst: 'Fix the load above before sending.', frame: 'Frame', used: '{u} of {n} slots used', free: '{f} free for future growth',
    model: 'Matching model', custom: 'Custom frame — ask us for this combination', lcd: 'ONLINE', send: 'Send this configuration', more: 'Size the batteries ↓',
    msg: 'Hello, I am interested in this modular UPS configuration:\n• Frame: {n} slots\n• Power modules: {u} × {m} kW (same rating)\n• System capacity: {t} kW{r}', red: '\n• Redundancy: N+1 (usable {x} kW)', red2: '\n• Redundancy: 2N — 2 identical systems in parallel (2 × {t} kW, usable {x} kW)',
    hint: 'Click a module to pull it out and see how the others share the load.',
    popH: 'Send this configuration', popP: 'Choose how you want to send it. The configuration below is filled in for you.', viaWa: 'WhatsApp message', viaMail: 'Email', subj: 'Modular UPS configuration', close: 'Close',
  },
  es: {
    eyebrow: 'Configurador visual', h: 'Arme su sistema, ranura por ranura', p: 'Elija un gabinete y la potencia del módulo: los módulos se insertan en tiempo real, una sola potencia por gabinete. Luego dimensione las baterías y envíe toda la configuración.',
    s1: 'Gabinete', s1n: 'Hasta {n} módulos de potencia', slots: '{n} ranuras', s2: 'Módulo de potencia', s2n: 'Todos los módulos de un gabinete tienen la misma potencia', s3: 'Módulos instalados', s4: 'Redundancia',
    total: 'Capacidad del sistema', usable: 'Utilizable con N+1', tipL: '¿Qué significan N, N+1 y 2N?', redTip: [['N', 'Sin módulo de reserva. Todos los módulos comparten la carga; si uno falla, la capacidad baja en un módulo. El menor costo.'], ['N+1', 'Un módulo de reserva. Si falla cualquier módulo, los demás siguen soportando toda la carga y se cambia en caliente. Lo habitual en salas de TI y centros de datos.'], ['2N', 'Dos sistemas UPS completos en paralelo, cada uno capaz de soportar solo toda la carga. Aunque falle un sistema entero (gabinete, bypass o baterías), la carga sigue protegida. Máxima confiabilidad.']], s5: 'Tarjetas opcionales', noneSel: 'Ninguna seleccionada — haga clic para añadir', remove: 'Quitar', s5n: 'Hasta {n} ranuras inteligentes', slotsUsed: '{u} / {n} ranuras', full: 'Todas las ranuras están ocupadas', needSnmp: 'Requiere la tarjeta SNMP: se añadió automáticamente.', lbsHint: 'Para 2N recomendamos la tarjeta LBS para mantener ambos sistemas sincronizados.', ext: 'Externo', sumCards: 'Tarjetas', noCards: 'Ninguna', cardsMsg: '\n• Tarjetas opcionales: {c}', perCab: ' (un juego por gabinete)', usableN: 'Sin módulo de reserva', usable2N: 'Utilizable con 2N (un sistema)', dual: '2N · dos sistemas en paralelo', sumUps: 'UPS', sumBat: 'Baterías', fixFirst: 'Corrija la carga antes de enviar.', frame: 'Gabinete', used: '{u} de {n} ranuras en uso', free: '{f} libres para crecer',
    model: 'Modelo correspondiente', custom: 'Gabinete a medida: consúltenos esta combinación', lcd: 'ONLINE', send: 'Enviar esta configuración', more: 'Calcular las baterías ↓',
    msg: 'Hola, me interesa esta configuración de UPS modular:\n• Gabinete: {n} ranuras\n• Módulos: {u} × {m} kW (misma potencia)\n• Capacidad: {t} kW{r}', red: '\n• Redundancia: N+1 (utilizable {x} kW)', red2: '\n• Redundancia: 2N — 2 sistemas iguales en paralelo (2 × {t} kW, utilizable {x} kW)',
    hint: 'Haga clic en un módulo para retirarlo y ver cómo los demás reparten la carga.',
    popH: 'Enviar esta configuración', popP: 'Elija cómo enviarla. La configuración de abajo ya está completada.', viaWa: 'Mensaje de WhatsApp', viaMail: 'Correo electrónico', subj: 'Configuración de UPS modular', close: 'Cerrar',
  },
  ru: {
    eyebrow: 'Визуальный конфигуратор', h: 'Соберите систему слот за слотом', p: 'Выберите шкаф и мощность модуля — модули устанавливаются в реальном времени, в одном шкафу одна мощность. Затем рассчитайте батареи и отправьте всю конфигурацию.',
    s1: 'Шкаф', s1n: 'До {n} силовых модулей', slots: '{n} слотов', s2: 'Силовой модуль', s2n: 'Все модули в шкафу одной мощности', s3: 'Установлено модулей', s4: 'Резервирование',
    total: 'Мощность системы', usable: 'Доступно при N+1', tipL: 'Что означают N, N+1 и 2N?', redTip: [['N', 'Без резервного модуля. Все модули делят нагрузку; при отказе одного мощность системы снижается на один модуль. Самый дешёвый вариант.'], ['N+1', 'Один резервный модуль. При отказе любого модуля остальные несут всю нагрузку, модуль меняется в горячем режиме. Обычный выбор для серверных и ЦОД.'], ['2N', 'Две полноценные системы ИБП параллельно, каждая может одна нести всю нагрузку. Даже при отказе целой системы (шкаф, байпас или батареи) нагрузка остаётся защищённой. Максимальная надёжность.']], s5: 'Опциональные карты', noneSel: 'Не выбрано — нажмите, чтобы добавить', remove: 'Убрать', s5n: 'До {n} интеллектуальных слотов', slotsUsed: '{u} / {n} слотов', full: 'Все слоты заняты', needSnmp: 'Нужна карта SNMP — добавлена автоматически.', lbsHint: 'Для 2N рекомендуем карту LBS — обе системы будут синхронизированы.', ext: 'Внешний', sumCards: 'Карты', noCards: 'Нет', cardsMsg: '\n• Опциональные карты: {c}', perCab: ' (комплект на каждый шкаф)', usableN: 'Без резервного модуля', usable2N: 'Доступно при 2N (одна система)', dual: '2N · две системы параллельно', sumUps: 'ИБП', sumBat: 'Батареи', fixFirst: 'Сначала исправьте нагрузку.', frame: 'Шкаф', used: 'занято {u} из {n} слотов', free: '{f} свободно для роста',
    model: 'Соответствующая модель', custom: 'Шкаф под заказ — уточните у нас эту комбинацию', lcd: 'ONLINE', send: 'Отправить конфигурацию', more: 'Рассчитать батареи ↓',
    msg: 'Здравствуйте, интересует конфигурация модульного ИБП:\n• Шкаф: {n} слотов\n• Модули: {u} × {m} кВт (одна мощность)\n• Мощность системы: {t} кВт{r}', red: '\n• Резервирование: N+1 (доступно {x} кВт)', red2: '\n• Резервирование: 2N — 2 одинаковые системы параллельно (2 × {t} кВт, доступно {x} кВт)',
    hint: 'Нажмите на модуль, чтобы извлечь его и увидеть, как остальные делят нагрузку.',
    popH: 'Отправить конфигурацию', popP: 'Выберите способ отправки. Конфигурация ниже уже заполнена.', viaWa: 'Сообщение в WhatsApp', viaMail: 'Электронная почта', subj: 'Конфигурация модульного ИБП', close: 'Закрыть',
  },
}[lang] || {};
// 规格书里有的组合：槽位数 + 模块规格 → 型号名（取同组合里第一个，Plus 优先于 PI / Mini 的顺序按目录）
const models: Record<string, string> = {};
for (const c of catalog()) { const k = `${c.slots}|${c.moduleKva}`; if (!models[k]) models[k] = c.model; }
const cfg = { models, wa: SITE.whatsapp, email: SITE.email, t: V, cards, slots: SLOTS };
---
<section class="block vb" id="visual" data-vb>
  <script type="application/json" data-vb-cfg set:html={JSON.stringify(cfg)} />
  <div class="head"><span class="eyebrow">{V.eyebrow}</span><h2>{V.h}</h2><p>{V.p}</p></div>
  <div class="vb-stage">
    <div class="vb-ctl">
      <div class="vb-grp">
        <div class="vb-gh"><span class="vb-n">1</span><b>{V.s1}</b><small>{V.s1n.replace('{n}', '10')}</small></div>
        <div class="vb-frames">
          {FRAMES.map((n) => (
            <button type="button" class:list={['vb-fr', { on: n === 10 }]} data-frame={n} aria-pressed={n === 10 ? 'true' : 'false'}>
              <span class="vb-fr-ico" style={`--n:${n}`}>{Array.from({ length: n }, () => <i></i>)}</span>
              <span>{V.slots.replace('{n}', String(n))}</span>
            </button>
          ))}
        </div>
      </div>
      <div class="vb-grp">
        <div class="vb-gh"><span class="vb-n">2</span><b>{V.s2}</b><small>{V.s2n}</small></div>
        <div class="vb-mods">
          {MODS.map((m) => <button type="button" class:list={['vb-mod', `m${m}`, { on: m === 30 }]} data-mod={m} aria-pressed={m === 30 ? 'true' : 'false'}><b>{m}</b><span>kW</span></button>)}
        </div>
      </div>
      <div class="vb-grp vb-row">
        <div>
          <div class="vb-gh"><span class="vb-n">3</span><b>{V.s3}</b></div>
          <div class="vb-step"><button type="button" data-cnt="-1" aria-label="−">−</button><output data-count>10</output><button type="button" data-cnt="1" aria-label="+">+</button></div>
        </div>
        <div>
          <div class="vb-gh vb-gh-tip"><span class="vb-n">4</span><b>{V.s4}</b>
            <span class="vb-tip">
              <button type="button" class="vb-q" aria-label={V.tipL} aria-describedby="vb-red-tip">?</button>
              <span class="vb-tipbox" id="vb-red-tip" role="tooltip">{V.redTip.map(([k, t]) => <span class="vb-tipr"><b>{k}</b><span>{t}</span></span>)}</span>
            </span>
          </div>
          <div class="vb-seg"><button type="button" class="on" data-red="0">N</button><button type="button" data-red="1">N+1</button><button type="button" data-red="2">2N</button></div>
        </div>
      </div>
      <div class="vb-grp">
        <button type="button" class="vb-gh vb-ctog" data-ctoggle aria-expanded="false" aria-controls="vb-cardlist"><span class="vb-n">5</span><b>{V.s5}</b><small>{V.s5n.replace('{n}', String(SLOTS))}</small><em class="vb-slotc" data-slotc>0 / {SLOTS}</em><span class="vb-chev" aria-hidden="true"></span></button>
        <div class="vb-chosen" data-chosen></div>
        <div class="vb-cards" id="vb-cardlist" data-cardlist hidden>
          {cards.map((c) => (
            <button type="button" class="vb-card" data-card={c.id} aria-pressed="false" title={c.desc}>
              <span class:list={['vb-card-ico', c.ports || 'ext']}><i></i><i></i><i></i></span>
              <span class="vb-card-t"><b>{c.name}</b><small>{c.desc}</small></span>
              {c.ext && <em class="vb-card-ext">{V.ext}</em>}
              <span class="vb-card-ck" aria-hidden="true"></span>
            </button>
          ))}
        </div>
        <p class="vb-cnote" data-cnote hidden></p>
      </div>
      <div class="vb-read">
        <div class="vb-big"><span>{V.total}</span><b><output data-total>300</output><small> kW</small></b></div>
        <div class="vb-sub"><span data-usable-l>{V.usableN}</span><b><output data-usable>300</output> kW</b></div>
        <div class="vb-sub"><span>{V.frame}</span><b data-used></b></div>
        <div class="vb-model" data-model></div>
      </div>
    </div>

    <div class="vb-view">
      <div class="vb-cabs">
      <div class="vb-cab" data-vbcab style="--slots:10"><span class="vb-emd" data-emd hidden><i></i><b>24°C · 45%</b></span><span class="vb-bus" aria-hidden="true"></span>
        <div class="vb-top">
          <div class="vb-lcd"><span class="vb-lcd-a">{V.lcd}</span><span class="vb-lcd-b" data-lcd>300 kW</span><span class="vb-lcd-c" data-lcd2>10 × 30 kW</span><svg class="vb-wave" viewBox="0 0 120 20" preserveAspectRatio="none" aria-hidden="true"><path d="M0 10 Q7.5 0 15 10 T30 10 T45 10 T60 10 T75 10 T90 10 T105 10 T120 10 T135 10 T150 10"/></svg></div>
          <div class="vb-leds"><i></i><i></i><i></i></div>
        </div>
        <div class="vb-bay" data-bay></div>
        <div class="vb-slots" data-vbslots></div>
        <div class="vb-base"><span>SKE<em data-cab-a hidden> · A</em></span></div>
      </div>
      <div class="vb-cabb" data-cabb hidden>
      <div class="vb-cab" data-vbcab2 style="--slots:10"><span class="vb-emd" data-emd2 hidden><i></i><b>24°C · 45%</b></span><span class="vb-bus" aria-hidden="true"></span>
        <div class="vb-top">
          <div class="vb-lcd"><span class="vb-lcd-a">{V.lcd}</span><span class="vb-lcd-b" data-lcdb>300 kW</span><span class="vb-lcd-c" data-lcdb2>10 × 30 kW</span><svg class="vb-wave" viewBox="0 0 120 20" preserveAspectRatio="none" aria-hidden="true"><path d="M0 10 Q7.5 0 15 10 T30 10 T45 10 T60 10 T75 10 T90 10 T105 10 T120 10 T135 10 T150 10"/></svg></div>
          <div class="vb-leds"><i></i><i></i><i></i></div>
        </div>
        <div class="vb-bay" data-bay2></div>
        <div class="vb-slots" data-vbslots2></div>
        <div class="vb-base"><span>SKE · B</span></div>
      </div>
      </div>
      </div>
      <div class="vb-par" data-par hidden><i></i><span>{V.dual}</span><i></i></div>
      <div class="vb-floor"><span class="vb-ring"></span><span class="vb-ring r2"></span></div>
      <div class="vb-dust" aria-hidden="true">{Array.from({ length: 14 }, (_, i) => <i style={`--x:${(i * 37) % 100}%;--t:${6 + (i % 5)}s;--d:${-(i * 0.7)}s`}></i>)}</div>
      <p class="vb-hint">{V.hint}</p>
    </div>
    <ModularBattery lang={lang} />
    <div class="vb-final">
      <div class="vb-sum" data-sum></div>
      <p class="vb-blk" data-blk hidden>{V.fixFirst}</p>
      {(SITE.whatsapp || SITE.email) && <button type="button" class="vb-btn primary vb-go" data-vb-open aria-haspopup="dialog">{V.send}</button>}
    </div>
  </div>
  <div class="vb-pop" data-vb-pop hidden role="dialog" aria-modal="true" aria-labelledby="vb-pop-h">
    <div class="vb-pop-box">
      <button type="button" class="vb-pop-x" data-vb-close aria-label={V.close}>×</button>
      <h3 id="vb-pop-h">{V.popH}</h3>
      <p>{V.popP}</p>
      <pre data-vb-msg></pre>
      <div class="vb-pop-acts">
        {SITE.whatsapp && <a class="vb-pop-btn wa" data-vb-wa href="#" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1a15 15 0 0 1-6.3-5.6c-.5-.8-.9-1.8-.9-2.7s.5-1.7.8-2c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.8-1c.2-.3.4-.2.6-.1l1.8.9c.3.1.4.2.5.3.1.2.1.8-.1 1.4z"/></svg>{V.viaWa}</a>}
        {SITE.email && <a class="vb-pop-btn mail" data-vb-mail href="#"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2.4V17h16V7.4l-8 5.3-8-5.3zM5.6 7l6.4 4.2L18.4 7H5.6z"/></svg>{V.viaMail}<small>{SITE.email}</small></a>}
      </div>
    </div>
  </div>
</section>

<script is:inline>
(function () {
  var root = document.querySelector('[data-vb]'); if (!root) return;
  var c = JSON.parse(root.querySelector('[data-vb-cfg]').textContent), T = c.t;
  var $ = function (s) { return root.querySelector(s); };
  var st = { n: 10, m: 30, u: 10, red: 0, out: -1, load: 0, bat: null, cards: [] };
  var CARD = {}; c.cards.forEach(function (x) { CARD[x.id] = x; });
  var fmt = function (s, o) { return String(s).replace(/\{(\w+)\}/g, function (_, k) { return o[k] !== undefined ? o[k] : ''; }); };
  var gen = 0;
  var lastMsg = '';
  // 数字滚动
  function countTo(el, to) {
    var from = +el.dataset.v || 0, t0 = performance.now(), d = 450; el.dataset.v = to;
    (function step(t) { var k = Math.min(1, (t - t0) / d); el.textContent = Math.round(from + (to - from) * (1 - Math.pow(1 - k, 3))); if (k < 1) requestAnimationFrame(step); })(t0);
  }
  // 卡槽：已选的智能卡插在机柜顶部，最新插入的那张有动画
  var PORTS = { rj: '<i class="p rj"></i>', rj2: '<i class="p rj"></i><i class="p rj"></i>', tb3: '<i class="p tb"></i><i class="p tb"></i><i class="p tb"></i>', tb6: '<i class="p tb"></i><i class="p tb"></i><i class="p tb"></i><i class="p tb"></i><i class="p tb"></i><i class="p tb"></i>', db9: '<i class="p db"></i>' };
  var lastCard = '';
  function bay() {
    var slot = st.cards.filter(function (id) { return !CARD[id].ext; });
    var h = '';
    for (var i = 0; i < c.slots; i++) {
      var id = slot[i];
      h += id ? '<span class="vb-ic' + (id === lastCard ? ' in' : '') + '"><b>' + CARD[id].tag + '</b><span class="pp">' + (PORTS[CARD[id].ports] || '') + '</span><i class="l"></i></span>' : '<span class="vb-ic empty"></span>';
    }
    $('[data-bay]').innerHTML = h; $('[data-bay2]').innerHTML = h;
    var emd = st.cards.indexOf('emd') >= 0; $('[data-emd]').hidden = !emd; $('[data-emd2]').hidden = !emd;
    $('[data-slotc]').textContent = fmt(T.slotsUsed, { u: slot.length, n: c.slots });
    var full = slot.length >= c.slots;
    root.querySelectorAll('[data-card]').forEach(function (b) {
      var on = st.cards.indexOf(b.dataset.card) >= 0;
      b.classList.toggle('on', on); b.setAttribute('aria-pressed', on);
      var dis = !on && full && !CARD[b.dataset.card].ext; b.disabled = dis; b.classList.toggle('dis', dis);
    });
    lastCard = '';
    // 折叠时外面只显示已选的卡（可以直接点 × 去掉）
    var ch = st.cards.map(function (id) { return '<span class="vb-chip"><i></i>' + CARD[id].name + '<button type="button" data-unc="' + id + '" aria-label="' + T.remove + ' ' + CARD[id].name + '">×</button></span>'; }).join('');
    $('[data-chosen]').innerHTML = ch || '<button type="button" class="vb-none" data-open-cards>' + T.noneSel + '</button>';
  }
  function setCards(open) {
    var t = $('[data-ctoggle]'); t.setAttribute('aria-expanded', open); $('[data-cardlist]').hidden = !open; t.classList.toggle('open', open);
  }
  $('[data-ctoggle]').addEventListener('click', function () { setCards($('[data-cardlist]').hidden); });
  $('[data-chosen]').addEventListener('click', function (e) {
    var u = e.target.closest('[data-unc]');
    if (u) { var b = root.querySelector('[data-card="' + u.dataset.unc + '"]'); if (b) b.click(); return; }
    if (e.target.closest('[data-open-cards]')) setCards(true);
  });
  function cardNote() {
    var n = [];
    if (st.cnote) n.push(st.cnote);
    if (st.cards.filter(function (id) { return !CARD[id].ext; }).length >= c.slots) n.push(T.full);
    if (st.red === 2 && st.cards.indexOf('lbs') < 0) n.push(T.lbsHint);
    var el = $('[data-cnote]'); el.textContent = n.join(' '); el.hidden = !n.length;
  }
  root.querySelectorAll('[data-card]').forEach(function (b) {
    b.addEventListener('click', function () {
      var id = b.dataset.card, i = st.cards.indexOf(id), extra = '';
      if (i >= 0) st.cards.splice(i, 1);
      else {
        st.cards.push(id); lastCard = id;
        // 温湿度传感器要接在 SNMP 卡上
        if (id === 'emd' && st.cards.indexOf('snmp') < 0) {
          if (st.cards.filter(function (x) { return !CARD[x].ext; }).length < c.slots) { st.cards.push('snmp'); lastCard = 'snmp'; extra = T.needSnmp; }
        }
      }
      if (id === 'snmp' && i >= 0) { var e = st.cards.indexOf('emd'); if (e >= 0) st.cards.splice(e, 1); }
      st.cnote = extra; bay(); update();
    });
  });
  function build(animate, animB) {
    gen++;
    var box = $('[data-vbslots]'), cab = $('[data-vbcab]');
    cab.style.setProperty('--slots', st.n);
    var h = '';
    for (var i = 0; i < st.n; i++) {
      if (i < st.u) {
        var out = i === st.out;
        h += '<button type="button" class="vb-m m' + st.m + (out ? ' out' : '') + (animate ? ' ins' : '') + '" data-i="' + i + '" style="--d:' + (i * 70) + 'ms">' +
          '<i class="led"></i><span class="grill"></span><b>' + st.m + '<small> kW</small></b><span class="hdl"></span><span class="ld" style="--l:0%"></span></button>';
      } else {
        h += '<div class="vb-empty"><i></i><i></i></div>';
      }
    }
    box.innerHTML = h;
    // 2N：第二台是同样配置的镜像（不能单独拔模块）
    var b2 = $('[data-vbslots2]'); $('[data-vbcab2]').style.setProperty('--slots', st.n);
    if (st.red === 2) b2.innerHTML = (animate || animB ? h.replace(/vb-m m/g, 'vb-m ins m') : h.replace(/ ins/g, '')).replace(/ out/g, ''); else b2.innerHTML = '';
    update();
  }
  function update() {
    var active = st.u - (st.out >= 0 ? 1 : 0);
    var dual = st.red === 2;
    var total = st.u * st.m, usable = dual ? total : Math.max(0, (st.u - st.red) * st.m);
    countTo($('[data-total]'), total);
    countTo($('[data-usable]'), usable);
    $('[data-usable-l]').textContent = dual ? T.usable2N : st.red ? T.usable : T.usableN;
    $('[data-cabb]').hidden = !dual; $('[data-par]').hidden = !dual; $('[data-cab-a]').hidden = !dual;
    root.querySelector('.vb-view').classList.toggle('dual', dual);
    $('[data-lcdb]').textContent = (st.u * st.m) + ' kW'; $('[data-lcdb2]').textContent = st.u + ' × ' + st.m + ' kW';
    $('[data-used]').textContent = fmt(T.used, { u: st.u, n: st.n }) + (st.n - st.u > 0 ? ' · ' + fmt(T.free, { f: st.n - st.u }) : '');
    $('[data-lcd]').textContent = (active * st.m) + ' kW';
    $('[data-lcd2]').textContent = active + ' × ' + st.m + ' kW';
    $('[data-count]').textContent = st.u;
    var model = c.models[st.n + '|' + st.m];
    $('[data-model]').innerHTML = model ? '<span>' + T.model + '</span><b>' + model + '</b>' : '<span class="cu">' + T.custom + '</span>';
    // 每个模块的负载条：假设系统带着"可用容量"的 70% 负载，平均分到在线的模块上
    // 有电池选型里填的实际负载就用它，否则假设带"可用容量"的 70%
    var load = st.load > 0 ? st.load : 0.7 * Math.max(st.m, usable || st.m);
    if (dual) load = load / 2; // 2N：两台各带一半
    var share = active ? load / active / st.m : 0;
    root.querySelectorAll('.vb-m').forEach(function (b) { var l = b.querySelector('.ld'); l.style.setProperty('--l', b.classList.contains('out') ? '0%' : Math.min(100, Math.round(share * 100)) + '%'); b.classList.toggle('hot', share > 1); });
    lastMsg = fmt(T.msg, { n: st.n, u: st.u, m: st.m, t: total, r: dual ? fmt(T.red2, { t: total, x: usable }) : st.red ? fmt(T.red, { x: usable }) : '' }) + (model ? '\n• Model: ' + model + (dual ? ' × 2' : '') : '');
    // 底部汇总：UPS + 电池，全部填完再发送
    var bat = st.bat;
    $('[data-sum]').innerHTML = '<div><span>' + T.sumUps + '</span><b>' + (dual ? '2 × ' : '') + total + ' kW · ' + st.u + ' × ' + st.m + ' kW · ' + (dual ? '2N' : st.red ? 'N+1' : 'N') + (model ? ' · ' + model : '') + '</b></div>' +
      (bat && bat.sum ? '<div><span>' + T.sumBat + '</span><b' + (bat.blocked ? ' class="bad"' : '') + '>' + bat.sum + '</b></div>' : '');
    var cn = st.cards.map(function (id) { return CARD[id].name; });
    $('[data-sum]').innerHTML += '<div><span>' + T.sumCards + '</span><b>' + (cn.length ? cn.join(' · ') + (dual ? ' × 2' : '') : T.noCards) + '</b></div>';
    if (cn.length) lastMsg += fmt(T.cardsMsg, { c: cn.join(', ') + (dual ? T.perCab : '') });
    if (!quiet) cardNote();
    var blk = !!(bat && bat.blocked), go = $('[data-vb-open]');
    $('[data-blk]').hidden = !blk; if (go) go.disabled = blk;
    // 把当前系统告诉电池选型（负载上限 = 系统容量的 80%）
    var sys = { total: total, usable: usable, n: st.n, u: st.u, m: st.m, red: st.red, model: model ? model + (dual ? ' × 2' : '') : '' };
    window.__skeSys = sys;
    if (!quiet) document.dispatchEvent(new CustomEvent('ske:system', { detail: sys }));
  }
  // 电池选型里改实际负载 → 模块负载条跟着变
  // quiet：这次刷新是电池选型触发的，不再回发 ske:system，避免来回循环
  var quiet = false;
  document.addEventListener('ske:load', function (e) { st.load = +(e.detail && e.detail.kw) || 0; st.bat = e.detail || null; quiet = true; update(); quiet = false; });
  root.querySelectorAll('[data-frame]').forEach(function (b) {
    b.addEventListener('click', function () {
      var n = +b.dataset.frame; if (n === st.n) return;
      // 原来插满了：换机框后也插满；没插满：保持数量（不超过新机框槽位）
      var wasFull = st.u === st.n;
      st.n = n; st.u = wasFull ? n : Math.min(st.u, n); st.out = -1;
      root.querySelectorAll('[data-frame]').forEach(function (x) { var on = x === b; x.classList.toggle('on', on); x.setAttribute('aria-pressed', on); });
      build(true);
    });
  });
  root.querySelectorAll('[data-mod]').forEach(function (b) {
    b.addEventListener('click', function () {
      var m = +b.dataset.mod; if (m === st.m) return;
      st.m = m; st.out = -1;
      root.querySelectorAll('[data-mod]').forEach(function (x) { var on = x === b; x.classList.toggle('on', on); x.setAttribute('aria-pressed', on); });
      // 换规格：先全部拔出，再插入新规格
      root.querySelectorAll('.vb-m').forEach(function (x) { x.classList.add('eject'); });
      var g = gen; setTimeout(function () { if (g === gen) build(true); }, 260);
    });
  });
  root.querySelectorAll('[data-cnt]').forEach(function (b) {
    b.addEventListener('click', function () {
      var u = Math.min(st.n, Math.max(1, st.u + +b.dataset.cnt)); if (u === st.u) return;
      var adding = u > st.u; st.u = u; st.out = -1;
      if (adding) {
        // 只让新插入的那个模块有动画
        build(false);
        var last = root.querySelectorAll('.vb-m')[u - 1]; if (last) { last.style.setProperty('--d', '0ms'); last.classList.add('ins'); }
      } else build(false);
    });
  });
  root.querySelectorAll('[data-red]').forEach(function (b) {
    b.addEventListener('click', function () {
      var was = st.red; st.red = +b.dataset.red; if (was === st.red) return;
      root.querySelectorAll('[data-red]').forEach(function (x) { x.classList.toggle('on', x === b); });
      // 进出 2N 要重画第二台机柜（进入时第二台的模块逐个插入）
      if (was === 2 || st.red === 2) build(false, st.red === 2); else update();
