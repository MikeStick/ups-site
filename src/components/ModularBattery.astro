---
// 模块化 UPS 电池选型：只问三件事 —— 实际负载功率、所需备电时间、铅酸还是锂电
// 计算在 src/lib/modular-engine.mjs 的 batteryPlan（恒功率法；锂电按 512 V 高压簇 + 3C 放电能力）
// 右侧实时画出电池组：铅酸 = 每串 40 节 12 V；锂电 = 每簇 10 个电池模块 + BMS
import { SITE } from '../config.mjs';
interface Props { lang: string }
const { lang } = Astro.props;
const TIMES = [5, 10, 15, 30, 60, 120];
const B = {
  en: {
    sys: 'Modular system', sysN: '{t} kW · {u} × {m} kW · {r}', change: 'Change ↑', ratio: 'Load ratio', band: 'Recommended {a}–{b}%', lt: 'Load', ltIt: 'IT / data center', ltInd: 'Industrial / surge loads',
    over: 'Not allowed: long-term load may not exceed 80% of the system capacity — max. {max} kW for {t} kW. Please choose a larger capacity above.',
    overN: 'Not allowed: with N+1 the remaining modules must carry the full load if one fails — max. {max} kW. Please choose a larger capacity above.',
    overWhy: 'Above 80% there is no headroom for start-up surges or growth, the modules run hot and their service life drops.',
    low: 'Below 30% the UPS runs inefficiently — a smaller system would be enough.', ok: 'In the recommended range.', hi: 'Allowed, but above the recommended range — little room for surges and growth.', under: 'Below the recommended range — spare capacity for future growth.',
    indNote: 'For factories and heavy motor loads we recommend a low-frequency (transformer) UPS.', blocked: 'Choose a larger system first',
    msgSys: '', band2: 'Recommended {a}–{b}% per UPS', over2: 'Not allowed: with 2N either UPS must carry the full load alone if the other fails, and that may not exceed 80% of one UPS ({t} kW) — max. {max} kW. Please choose a larger capacity above.', sets: 'Battery sets', setsN: '2 — one per UPS, each sized for the full load', perUps: 'per UPS',
    msgB: '\n\nBattery:\n• Actual load: {k} kW (load ratio {p})\n• Backup time: {t} min\n• Battery type: {b}\n• Suggested: {s}',
    eyebrow: 'Battery sizing', h: 'Size the batteries', p: 'Enter the real load and the backup time you need. We size the battery bank for the modular UPS — lead-acid or lithium.',
    s1: 'Actual load power', s1n: 'What the equipment really draws, not the UPS rating', s2: 'Backup time required', s2n: 'Minutes on battery after a power cut', other: 'Other', s3: 'Battery type',
    vrla: 'Lead-acid (VRLA)', vrlaN: 'Lowest cost · 3–5 years in a cool room', lfp: 'Lithium (LiFePO₄)', lfpN: 'Up to 70% lighter · 10+ years · BMS',
    rack: 'Battery racks', rackN: '{n} × steel rack, {t} tiers × {p} blocks', rackSize: 'Rack L × D × H', blockSize: 'Block L × W × H', cab: 'Battery cabinets', cabN: '{n} × high-voltage cabinet (BMS + 10 modules)', cabSize: 'Cabinet W × D × H', area: 'Floor space incl. service aisle', 
    rec: 'Recommended battery bank', blocks: 'blocks', strings: 'String', stringsN: '{s} × 40 × 12 V', ahBlock: 'Capacity per block', bus: 'DC voltage', weight: 'Weight (approx.)',
    total: 'Total', clusters: 'Cluster', clustersN: '{c} × 512 V · {a} Ah', modules: 'Battery modules', energy: 'Installed energy', need: 'Energy needed', idc: 'Max. DC current', brdc: 'DC breaker',
    spec: 'Matching standard: each cell must deliver ≥ {w} W for {t} min to 1.75 V/cell (25 °C). Check against the battery maker’s constant-power table.',
    byPower: 'Sized by discharge current (max. 3C), so this bank gives about {r} min at this load.',
    lfpSpec: 'High-voltage LFP with BMS, voltage window 448–584 V, inside the UPS range 360–600 V DC.',
    note: 'Includes aging (×1.25), design margin (×1.10) and 95% battery-mode efficiency. For reference only — final selection is confirmed by our engineers.',
    endV: 'end', send: 'Send this battery plan', min: 'min', kw: 'kW',
    msg: 'Hello, please quote batteries for a modular UPS:\n• Actual load: {k} kW\n• Backup time: {t} min\n• Battery type: {b}\n• Suggested: {s}',
    subj: 'Modular UPS battery plan',
  },
  es: {
    sys: 'Sistema modular', sysN: '{t} kW · {u} × {m} kW · {r}', change: 'Cambiar ↑', ratio: 'Nivel de carga', band: 'Recomendado {a}–{b}%', lt: 'Carga', ltIt: 'TI / centro de datos', ltInd: 'Industrial / cargas con arranque',
    over: 'No permitido: la carga continua no puede superar el 80% de la capacidad del sistema — máx. {max} kW para {t} kW. Elija una capacidad mayor arriba.',
    overN: 'No permitido: con N+1 los módulos restantes deben soportar toda la carga si uno falla — máx. {max} kW. Elija una capacidad mayor arriba.',
    overWhy: 'Por encima del 80% no queda margen para picos de arranque ni crecimiento, los módulos trabajan calientes y su vida útil baja.',
    low: 'Por debajo del 30% el UPS trabaja con baja eficiencia: bastaría un sistema más pequeño.', ok: 'Dentro del rango recomendado.', hi: 'Permitido, pero sobre el rango recomendado: poco margen para picos y crecimiento.', under: 'Por debajo del rango recomendado: capacidad libre para crecer.',
    indNote: 'Para fábricas y cargas con motores grandes recomendamos un UPS de baja frecuencia (con transformador).', blocked: 'Primero elija un sistema mayor',
    msgSys: '', band2: 'Recomendado {a}–{b}% por UPS', over2: 'No permitido: con 2N cada UPS debe soportar sola toda la carga si la otra falla, y no puede superar el 80% de una UPS ({t} kW) — máx. {max} kW. Elija una capacidad mayor arriba.', sets: 'Juegos de baterías', setsN: '2 — uno por UPS, cada uno para la carga completa', perUps: 'por UPS',
    msgB: '\n\nBaterías:\n• Carga real: {k} kW (nivel de carga {p})\n• Autonomía: {t} min\n• Tipo de batería: {b}\n• Sugerido: {s}',
    eyebrow: 'Dimensionamiento de baterías', h: 'Calcule las baterías', p: 'Indique la carga real y la autonomía que necesita. Dimensionamos el banco de baterías para el UPS modular: plomo-ácido o litio.',
    s1: 'Potencia real de la carga', s1n: 'Lo que consumen los equipos, no la potencia del UPS', s2: 'Autonomía requerida', s2n: 'Minutos con batería tras un corte', other: 'Otra', s3: 'Tipo de batería',
    vrla: 'Plomo-ácido (VRLA)', vrlaN: 'Menor costo · 3–5 años en sala fresca', lfp: 'Litio (LiFePO₄)', lfpN: 'Hasta 70% más liviano · 10+ años · BMS',
    rack: 'Racks de baterías', rackN: '{n} × rack de acero, {t} niveles × {p} bloques', rackSize: 'Rack L × P × A', blockSize: 'Bloque L × A × H', cab: 'Gabinetes de baterías', cabN: '{n} × gabinete de alto voltaje (BMS + 10 módulos)', cabSize: 'Gabinete A × P × H', area: 'Superficie con pasillo de servicio', 
    rec: 'Banco de baterías recomendado', blocks: 'bloques', strings: 'Cadena', stringsN: '{s} × 40 × 12 V', ahBlock: 'Capacidad por bloque', bus: 'Voltaje CC', weight: 'Peso (aprox.)',
    total: 'Total', clusters: 'Clúster', clustersN: '{c} × 512 V · {a} Ah', modules: 'Módulos de batería', energy: 'Energía instalada', need: 'Energía necesaria', idc: 'Corriente CC máx.', brdc: 'Interruptor CC',
    spec: 'Estándar a cumplir: cada celda debe entregar ≥ {w} W durante {t} min hasta 1,75 V/celda (25 °C). Verifique con la tabla de potencia constante del fabricante.',
    byPower: 'Dimensionado por corriente de descarga (máx. 3C); este banco da unos {r} min con esta carga.',
    lfpSpec: 'LFP de alto voltaje con BMS, ventana 448–584 V, dentro del rango del UPS 360–600 V CC.',
    note: 'Incluye envejecimiento (×1,25), margen de diseño (×1,10) y 95% de eficiencia en modo batería. Solo referencia: la selección final la confirman nuestros ingenieros.',
    endV: 'final', send: 'Enviar este plan de baterías', min: 'min', kw: 'kW',
    msg: 'Hola, por favor coticen baterías para un UPS modular:\n• Carga real: {k} kW\n• Autonomía: {t} min\n• Tipo de batería: {b}\n• Sugerido: {s}',
    subj: 'Plan de baterías para UPS modular',
  },
  ru: {
    sys: 'Модульная система', sysN: '{t} кВт · {u} × {m} кВт · {r}', change: 'Изменить ↑', ratio: 'Загрузка', band: 'Рекомендуется {a}–{b}%', lt: 'Нагрузка', ltIt: 'IT / ЦОД', ltInd: 'Промышленная / пусковые токи',
    over: 'Недопустимо: длительная нагрузка не может превышать 80% мощности системы — макс. {max} кВт для {t} кВт. Выберите систему большей мощности выше.',
    overN: 'Недопустимо: при N+1 оставшиеся модули должны нести всю нагрузку при отказе одного — макс. {max} кВт. Выберите систему большей мощности выше.',
    overWhy: 'Выше 80% нет запаса на пусковые токи и рост, модули перегреваются и срок службы сокращается.',
    low: 'Ниже 30% ИБП работает с низким КПД — хватит системы поменьше.', ok: 'В рекомендуемом диапазоне.', hi: 'Допустимо, но выше рекомендуемого — мало запаса на пуски и рост.', under: 'Ниже рекомендуемого — запас мощности на будущее.',
    indNote: 'Для заводов и мощных двигателей рекомендуем низкочастотный (трансформаторный) ИБП.', blocked: 'Сначала выберите систему мощнее',
    msgSys: '', band2: 'Рекомендуется {a}–{b}% на каждый ИБП', over2: 'Недопустимо: при 2N каждый ИБП должен один нести всю нагрузку при отказе другого, и она не может превышать 80% одного ИБП ({t} кВт) — макс. {max} кВт. Выберите систему большей мощности выше.', sets: 'Комплекты батарей', setsN: '2 — по одному на ИБП, каждый на полную нагрузку', perUps: 'на ИБП',
    msgB: '\n\nБатареи:\n• Реальная нагрузка: {k} кВт (загрузка {p})\n• Время автономии: {t} мин\n• Тип батарей: {b}\n• Предложено: {s}',
    eyebrow: 'Подбор батарей', h: 'Рассчитайте батареи', p: 'Укажите реальную нагрузку и нужное время автономии. Мы подберём батарейный массив для модульного ИБП — свинцово-кислотный или литиевый.',
    s1: 'Реальная мощность нагрузки', s1n: 'Сколько реально потребляет оборудование, а не мощность ИБП', s2: 'Требуемое время автономии', s2n: 'Минут работы от батарей после отключения', other: 'Другое', s3: 'Тип батарей',
    vrla: 'Свинцово-кислотные (VRLA)', vrlaN: 'Дешевле всего · 3–5 лет в прохладном помещении', lfp: 'Литиевые (LiFePO₄)', lfpN: 'До 70% легче · 10+ лет · BMS',
    rack: 'Стеллажи', rackN: '{n} × стальной стеллаж, {t} яруса × {p} блоков', rackSize: 'Стеллаж Д × Г × В', blockSize: 'Блок Д × Ш × В', cab: 'Батарейные шкафы', cabN: '{n} × высоковольтный шкаф (BMS + 10 модулей)', cabSize: 'Шкаф Ш × Г × В', area: 'Площадь с проходом для обслуживания', 
    rec: 'Рекомендуемый батарейный массив', blocks: 'блоков', strings: 'Цепочки', stringsN: '{s} × 40 × 12 В', ahBlock: 'Ёмкость блока', bus: 'Напряжение DC', weight: 'Масса (прибл.)',
    total: 'Всего', clusters: 'Кластеры', clustersN: '{c} × 512 В · {a} А·ч', modules: 'Батарейные модули', energy: 'Установленная энергия', need: 'Нужная энергия', idc: 'Макс. ток DC', brdc: 'Автомат DC',
    spec: 'Требование для подбора: каждый элемент должен отдавать ≥ {w} Вт в течение {t} мин до 1,75 В/эл. (25 °C). Сверьте с таблицей постоянной мощности производителя.',
    byPower: 'Подобрано по току разряда (макс. 3C), поэтому массив даёт около {r} мин при этой нагрузке.',
    lfpSpec: 'Высоковольтный LFP с BMS, окно 448–584 В, в пределах диапазона ИБП 360–600 В DC.',
    note: 'С учётом старения (×1,25), запаса (×1,10) и КПД 95% в режиме батареи. Только для ориентира — окончательный подбор подтверждают наши инженеры.',
    endV: 'конец разряда', send: 'Отправить расчёт батарей', min: 'мин', kw: 'кВт',
    msg: 'Здравствуйте, прошу предложение на батареи для модульного ИБП:\n• Реальная нагрузка: {k} кВт\n• Время автономии: {t} мин\n• Тип батарей: {b}\n• Предложено: {s}',
    subj: 'Расчёт батарей для модульного ИБП',
  },
}[lang] || {};
const cfg = { t: B };
---
<div class="mb-ctl" id="battery" data-mb>
      <script type="application/json" data-mb-cfg set:html={JSON.stringify(cfg)} />
      <div class="mb-sec"><span class="mb-eb">{B.eyebrow}</span><small>{B.p}</small></div>
      <div class="mb-grp">
        <div class="mb-gh"><span class="mb-n">6</span><b>{B.s1}</b><small>{B.s1n}</small></div>
        <div class="mb-kw">
          <input type="range" min="5" max="1200" step="5" value="200" data-kw-r aria-label={B.s1} />
          <label class="mb-num" data-kwbox><input type="number" min="1" max="2000" step="1" value="200" data-kw /><span>{B.kw}</span></label>
        </div>
        <div class="mb-meter" data-meter>
          <div class="mb-bar"><i class="z lo" data-zlo></i><i class="z rec" data-zrec></i><i class="z cap" data-zcap></i><span class="mk" data-mk></span></div>
          <div class="mb-scale"><span>0</span><span data-slo style="left:30%">30%</span><span data-scap style="left:80%">80%</span><span style="left:100%">100%</span></div>
          <div class="mb-ratio"><span>{B.ratio} <b data-pct></b></span><small data-band></small></div>
        </div>
        <p class="mb-msg" data-lmsg></p>
      </div>
      <div class="mb-grp">
        <div class="mb-gh"><span class="mb-n">7</span><b>{B.s2}</b><small>{B.s2n}</small></div>
        <div class="mb-times">
          {TIMES.map((t) => <button type="button" class:list={['mb-t', { on: t === 15 }]} data-t={t} aria-pressed={t === 15 ? 'true' : 'false'}><b>{t}</b><span>{B.min}</span></button>)}
          <label class="mb-num mb-tx"><input type="number" min="1" max="600" step="1" placeholder={B.other} data-tx /><span>{B.min}</span></label>
        </div>
      </div>
      <div class="mb-grp">
        <div class="mb-gh"><span class="mb-n">8</span><b>{B.s3}</b></div>
        <div class="mb-types">
          <button type="button" class="mb-ty on" data-bt="vrla" aria-pressed="true"><i class="ico pb"></i><b>{B.vrla}</b><small>{B.vrlaN}</small></button>
          <button type="button" class="mb-ty" data-bt="lfp" aria-pressed="false"><i class="ico li"></i><b>{B.lfp}</b><small>{B.lfpN}</small></button>
        </div>
      </div>
    </div>

    <div class="mb-out" data-mbout aria-live="polite">
      <span class="mb-eb">{B.rec}</span>
      <div class="mb-lock" data-lock hidden><b>{B.blocked}</b></div>
      <div class="mb-big"><b data-big></b><small data-bigu></small></div>
      <div class="mb-vis" data-vis></div>
      <dl class="mb-dl" data-dl></dl>
      <p class="mb-spec" data-spec></p>
      <p class="mb-note">{B.note}</p>
    </div>

<script>
  import { batteryPlan } from '../lib/modular-engine.mjs';
  import { vrlaLayout, lfpCabinet, sceneVrla, sceneLfp } from '../lib/battery-scene.mjs';
  const root = document.querySelector('[data-vb]') as HTMLElement | null; // 和 UPS 可视化选型在同一个面板里
  if (root) {
    const T = JSON.parse(root.querySelector('[data-mb-cfg]')!.textContent || '{}').t;
    const $ = (s: string) => root.querySelector(s) as HTMLElement;
    const fmt = (s: string, o: Record<string, any>) => s.replace(/\{(\w+)\}/g, (_, k) => (o[k] ?? ''));
    const n0 = (x: number) => Math.round(x).toLocaleString('en-US');
    const st = { kw: 200, t: 15, bt: 'vrla' };
    // 当前模块化系统（来自上面的可视化选型）；没有就按 10 × 30 kW N+1
    let sys: any = (window as any).__skeSys || { total: 300, usable: 300, u: 10, m: 30, red: 0, model: '' };
    let blocked = false;
    const kwN = $('[data-kw]') as HTMLInputElement, kwR = $('[data-kw-r]') as HTMLInputElement, tx = $('[data-tx]') as HTMLInputElement;

    // 电池实景：铅酸 = 钢制电池架 + 电池开关箱；锂电 = 高压电池柜（顶部主控箱 + 10 个模块）
    function vis(b: any, sets: number) {
      return b.type === 'lfp' ? sceneLfp(b, { sets }) : sceneVrla(b, vrlaLayout(b.ah), { sets });
    }
    const row = (k: string, v: string, cls = '') => '<div' + (cls ? ' class="' + cls + '"' : '') + '><dt>' + k + '</dt><dd>' + v + '</dd></div>';

    // 负载率规则：长期负载 ≤ 系统容量 80%；N+1 时还要 ≤ 坏一个模块后的容量
    // 推荐区间：IT / 数据中心 60–75%（无冗余 60–70%），工业冲击负载 50–65%；尽量不低于 30%
    // 2N：两台各带一半，坏一台时另一台独自带全部 → 严格执行 80% 规则：负载 ≤ 一台容量的 80%，每台平时 ≤ 40%
    // 负载率显示：N / N+1 = 负载 ÷ 系统容量；2N = 每台的负载率（负载 ÷ 2 ÷ 一台容量）
    function limits() {
      if (sys.red === 2) return { max: Math.floor(sys.total * 0.8), why: 'over2', band: [30, 40], cap: 40, lo: 20, div: sys.total * 2 };
      const cap80 = Math.floor(sys.total * 0.8);
      const byN = sys.red && sys.usable < cap80;
      return { max: byN ? sys.usable : cap80, why: byN ? 'overN' : 'over', band: sys.red ? [60, 75] : [60, 70], cap: 80, lo: 30, div: sys.total };
    }
    function loadCheck() {
      const L = limits(), pct = L.div ? st.kw / L.div * 100 : 0;
      blocked = st.kw > L.max;
      $('[data-pct]').textContent = Math.round(pct) + '%';
      $('[data-band]').textContent = fmt(sys.red === 2 ? T.band2 : T.band, { a: L.band[0], b: L.band[1] });
      $('[data-zlo]').style.width = L.lo + '%'; $('[data-zcap]').style.left = L.cap + '%';
      const slo = $('[data-slo]'), scap = $('[data-scap]'); slo.style.left = L.lo + '%'; slo.textContent = L.lo + '%'; scap.style.left = L.cap + '%'; scap.textContent = L.cap + '%';
      const zr = $('[data-zrec]'); zr.style.left = L.band[0] + '%'; zr.style.width = (L.band[1] - L.band[0]) + '%';
      $('[data-mk]').style.left = Math.min(100, pct) + '%';
      kwR.max = String(Math.max(1, L.max));
      let cls = 'ok', msg = T.ok;
      if (blocked) { cls = 'bad'; msg = fmt(T[L.why], { max: L.max, t: sys.total }) + ' ' + T.overWhy; }
      else if (pct < L.lo) { cls = 'warn'; msg = T.low; }
      else if (pct > L.band[1]) { cls = 'warn'; msg = T.hi; }
      else if (pct < L.band[0]) { cls = 'info'; msg = T.under; }
      const m = $('[data-lmsg]'); m.className = 'mb-msg ' + cls; m.textContent = msg;
      $('[data-meter]').className = 'mb-meter ' + cls;
      $('[data-kwbox]').classList.toggle('bad', blocked);
      $('[data-mbout]').classList.toggle('blocked', blocked);
      $('[data-lock]').hidden = !blocked;
      return pct;
    }
    function update() {
      const pct = loadCheck();
      if (blocked) {
        document.dispatchEvent(new CustomEvent('ske:load', { detail: { kw: st.kw, t: st.t, blocked: true, sum: st.kw + ' kW · ' + Math.round(pct) + '% — ' + T.blocked } }));
        return;
      }
      const two = sys.red === 2;
      const b: any = batteryPlan({ loadKw: st.kw, minutes: st.t, blocks: 40, type: st.bt });
      if (!b) return;
      let sum = '';
      if (b.type === 'lfp') {
        $('[data-big]').textContent = String(b.kwhInst);
        $('[data-bigu]').textContent = ' kWh';
        $('[data-dl]').innerHTML = row(T.clusters, fmt(T.clustersN, { c: b.clusters, a: b.ah }), 'hl') + row(T.modules, b.modules + ' × 51.2 V · ' + b.moduleKwh + ' kWh') +
          row(T.need, b.kwh + ' kWh') + row(T.bus, '512 V (448–584 V)') + row(T.idc, n0(b.iEnd) + ' A') + row(T.brdc, b.breakerDc ? b.breakerDc + ' A' : '—') + row(T.weight, '≈ ' + n0(b.kg) + ' kg') +
          (() => { const C = lfpCabinet(b.ah); return row(T.cab, fmt(T.cabN, { n: b.clusters })) + row(T.cabSize, '≈ ' + C.w + ' × ' + C.d + ' × ' + C.h + ' mm') + row(T.area, '≈ ' + (Math.round(b.clusters * C.w / 1000 * (C.d + 1000) / 1000 * 10) / 10) + ' m²'); })();
        $('[data-spec]').textContent = T.lfpSpec + (b.byPower ? ' ' + fmt(T.byPower, { r: b.runMin }) : '');
        sum = b.clusters + ' × 512 V ' + b.ah + ' Ah LFP (' + b.kwhInst + ' kWh)';
        if (two) $('[data-bigu]').textContent = ' kWh × 2';
      } else {
        $('[data-big]').textContent = String(b.blocksTotal);
        $('[data-bigu]').textContent = ' × 12 V ' + b.ah + ' Ah';
        $('[data-dl]').innerHTML = row(T.strings, fmt(T.stringsN, { s: b.strings }), 'hl') + row(T.ahBlock, b.ah + ' Ah') + row(T.total, b.blocksTotal + ' ' + T.blocks) +
          row(T.bus, '480 V (420 V ' + T.endV + ')') + row(T.idc, n0(b.iEnd) + ' A') + row(T.brdc, b.breakerDc ? b.breakerDc + ' A' : '—') + row(T.weight, '≈ ' + n0(b.kg) + ' kg') +
          (() => { const L = vrlaLayout(b.ah); return row(T.rack, fmt(T.rackN, { n: b.strings * L.racks, t: L.tiers, p: L.perTier })) + row(T.rackSize, '≈ ' + L.len + ' × ' + L.depth + ' × ' + L.height + ' mm') + row(T.blockSize, L.L + ' × ' + L.W + ' × ' + L.H + ' mm') + row(T.area, '≈ ' + (Math.round(b.strings * L.racks * L.area * 10) / 10) + ' m²'); })();
        $('[data-spec]').textContent = fmt(T.spec, { w: n0(b.wCellDesign), t: st.t });
        sum = b.strings + ' × 40 × 12 V ' + b.ah + ' Ah VRLA (' + b.blocksTotal + ' ' + T.blocks + ')';
        if (two) $('[data-bigu]').textContent += ' × 2';
      }
      if (two) { $('[data-dl]').innerHTML = row(T.sets, T.setsN, 'hl') + $('[data-dl]').innerHTML; sum = '2 × [' + sum + ']'; }
      $('[data-vis]').innerHTML = vis(b, two ? 2 : 1);
      // 交给 UPS 面板：底部汇总 + 发送内容
      const msg = fmt(T.msgB, { k: st.kw, p: Math.round(pct) + '%' + (two ? ' ' + T.perUps : ''), t: st.t, b: st.bt === 'lfp' ? T.lfp : T.vrla, s: sum });
      document.dispatchEvent(new CustomEvent('ske:load', { detail: { kw: st.kw, t: st.t, blocked: false, msg, sum: sum + ' · ' + st.t + ' min · ' + st.kw + ' kW (' + Math.round(pct) + '%)' } }));
    }

    const setKw = (v: number, from?: HTMLInputElement) => {
      if (!(v > 0)) return;
      st.kw = Math.min(2000, v);
      if (from !== kwN) kwN.value = String(st.kw);
      if (from !== kwR) kwR.value = String(Math.min(1200, st.kw));
      update();
    };
    kwN.addEventListener('input', () => setKw(parseFloat(kwN.value), kwN));
    // 超过上限：输入框变红、不出电池方案、不能发送，直到客户把负载改小或在上面选更大的系统
    document.addEventListener('ske:system', (e: any) => { sys = e.detail; update(); });
    kwR.addEventListener('input', () => setKw(parseFloat(kwR.value), kwR));
    const pickT = (t: number | null) => root.querySelectorAll('[data-t]').forEach((x) => { const on = Number((x as HTMLElement).dataset.t) === t; x.classList.toggle('on', on); x.setAttribute('aria-pressed', on ? 'true' : 'false'); });
    root.querySelectorAll('[data-t]').forEach((x) => x.addEventListener('click', () => { st.t = Number((x as HTMLElement).dataset.t); tx.value = ''; pickT(st.t); update(); }));
    tx.addEventListener('input', () => { const v = parseFloat(tx.value); if (v > 0) { st.t = Math.min(600, v); pickT(null); update(); } });
    root.querySelectorAll('[data-bt]').forEach((x) => x.addEventListener('click', () => {
      st.bt = (x as HTMLElement).dataset.bt!;
      root.querySelectorAll('[data-bt]').forEach((y) => { y.classList.toggle('on', y === x); y.setAttribute('aria-pressed', y === x ? 'true' : 'false'); });
      update();
    }));
    update();
  }
</script>

