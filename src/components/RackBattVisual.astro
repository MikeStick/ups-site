---
// 机架式磷酸铁锂电池组配置器：① 按能量 / 按负载和备电时间 ② 选模块（已发布型号，没有时用典型 48 V 模块）
// 右侧：19 英寸机柜正面，模块数量实时插入，前面板 SOC 灯随充放电变化，侧面直流母线显示电流方向。
// 计算在 src/lib/rackbatt-engine.mjs（测试：node scripts/test-rackbatt-engine.mjs）。
import { SITE } from '../config.mjs';
import { RB } from '../lib/rackbatt-i18n.mjs';
import { KWH_PRESETS, ASSUME } from '../lib/rackbatt-engine.mjs';
import { isRackBattery, battModule } from '../lib/category.mjs';
import all from '../data/products.json';
interface Props { lang: string }
const { lang } = Astro.props;
const T = RB[lang], C = T.c;
const mods = all.filter(isRackBattery).map((p) => ({ m: p.model, slug: p.slug, ...battModule(p) })).filter((x) => x.kwh > 0).sort((a, b) => a.kwh - b.kwh);
const list = mods.length ? mods : [{ m: C.generic, slug: '', ...ASSUME.generic, par: 0 }];
const cfg = { lang, wa: SITE.whatsapp, email: SITE.email, mods: list, t: C };
---
<section class="block rbv" id="builder" data-rbv>
  <script type="application/json" data-rbv-cfg set:html={JSON.stringify(cfg)} />
  <div class="head"><span class="eyebrow">{C.eyebrow}</span><h2>{C.h}</h2><p>{C.p}</p></div>
  <div class="rb-stage">
    <div class="rb-ctl">
      <div class="rb-grp">
        <div class="rb-gh"><span class="rb-n">1</span><b>{C.s1}</b></div>
        <div class="rb-seg"><button type="button" class="on" data-by="kwh">{C.by.kwh}</button><button type="button" data-by="load">{C.by.load}</button></div>
        <div class="rb-in" data-box="kwh">
          <label class="rb-num"><span>{C.kwhL}</span><input type="number" inputmode="decimal" min="0" step="any" value="10" data-kwh /><b>kWh</b></label>
          <div class="rb-chips">{KWH_PRESETS.map((k) => <button type="button" class:list={['rb-chip', { on: k === 10 }]} data-kp={k}>{k} kWh</button>)}</div>
        </div>
        <div class="rb-in" data-box="load" hidden>
          <label class="rb-num"><span>{C.loadL}</span><input type="number" inputmode="decimal" min="0" step="any" value="5" data-load /><b>kW</b></label>
          <label class="rb-num"><span>{C.hoursL}</span><input type="number" inputmode="decimal" min="0" step="any" value="4" data-hours /><b>{C.h}</b></label>
        </div>
      </div>
      <div class="rb-grp">
        <div class="rb-gh"><span class="rb-n">2</span><b>{C.s2}</b><small>{C.s2n}</small></div>
        <div class="rb-mods">
          {list.map((x, i) => (
            <button type="button" class:list={['rb-mod', { on: i === 0 }]} data-mi={i} aria-pressed={i === 0 ? 'true' : 'false'}>
              <b>{x.m}</b>
              <small>{[x.v && `${x.v} V`, x.ah && `${x.ah} Ah`, `${x.kwh} kWh`, x.u && `${x.u}U`].filter(Boolean).join(' · ')}</small>
            </button>
          ))}
        </div>
      </div>
      <div class="rb-read">
        <div class="rb-big"><span>{C.out.n}</span><b data-big>—</b></div>
        <dl class="rb-rows" data-rows></dl>
        <ul class="rb-checks" data-checks></ul>
      </div>
    </div>

    <div class="rb-view">
      <div class="rb-modes" role="group" aria-label={C.s3}>
        <span>{C.s3}</span>
        <button type="button" class="on" data-mode="dis">{C.modes.dis}</button><button type="button" data-mode="chg">{C.modes.chg}</button>
      </div>
      <div class="rb-cabs" data-cabs data-m="dis"></div>
      <div class="rb-inv"><i></i><span>{C.vis.inv}</span><i></i></div>
    </div>

    <div class="rb-final">
      <div class="rb-sum" data-sum></div>
      {(SITE.whatsapp || SITE.email) && <button type="button" class="rb-go" data-open aria-haspopup="dialog">{C.send}</button>}
    </div>
    <details class="rb-assume">
      <summary>{C.assumeH}</summary>
      <ul>{C.assume.map((a) => <li>{a}</li>)}</ul>
    </details>
  </div>

  <div class="rb-pop" data-pop hidden role="dialog" aria-modal="true" aria-labelledby="rb-pop-h">
    <div class="rb-pop-box">
      <button type="button" class="rb-pop-x" data-close aria-label={C.close}>×</button>
      <h3 id="rb-pop-h">{C.popH}</h3>
      <p>{C.popP}</p>
      <pre data-msg></pre>
      <div class="rb-pop-acts">
        {SITE.whatsapp && <a class="rb-pop-btn wa" data-wa href="#" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1a15 15 0 0 1-6.3-5.6c-.5-.8-.9-1.8-.9-2.7s.5-1.7.8-2c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.8-1c.2-.3.4-.2.6-.1l1.8.9c.3.1.4.2.5.3.1.2.1.8-.1 1.4z"/></svg>{C.viaWa}</a>}
        {SITE.email && <a class="rb-pop-btn mail" data-mail href="#"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2.4V17h16V7.4l-8 5.3-8-5.3zM5.6 7l6.4 4.2L18.4 7H5.6z"/></svg>{C.viaMail}<small>{SITE.email}</small></a>}
      </div>
    </div>
  </div>
</section>

<script>
  import { sizeRack, ASSUME } from '../lib/rackbatt-engine.mjs';
  const root = document.querySelector('[data-rbv]') as HTMLElement | null;
  if (root) {
    const c = JSON.parse(root.querySelector('[data-rbv-cfg]')!.textContent || '{}'), T = c.t;
    const $ = (s: string) => root.querySelector(s) as HTMLElement;
    const $$ = (s: string) => Array.from(root.querySelectorAll(s)) as HTMLElement[];
    const fmt = (s: string, o: any) => String(s).replace(/\{(\w+)\}/g, (_: string, k: string) => (o[k] !== undefined ? o[k] : ''));
    const num = (el: HTMLInputElement) => Math.max(0, parseFloat(String(el.value).replace(',', '.')) || 0);
    const st: any = { by: 'kwh', kwh: 10, load: 5, hours: 4, mi: 0, mode: 'dis' };
    let lastMsg = '', lastSubj = '', last: any = null, drawn = '', prevN = 0;
    // 机柜：每个模块按 U 高度画；最多画 3 个机柜，其余显示 +n
    function draw(r: any) {
      const box = $('[data-cabs]');
      if (!r) { box.innerHTML = ''; drawn = ''; prevN = 0; return; }
      const u = r.mod.u || 3, per = r.perCab || Math.floor((ASSUME.cabinetU - ASSUME.reserveU) / u);
      const key = `${r.n}|${u}|${r.mod.m}`;
      if (key === drawn) return;
      const grow = drawn && drawn.split('|').slice(1).join('|') === `${u}|${r.mod.m}` ? prevN : 0;
      drawn = key;
      const cabs = Math.ceil(r.n / per), show = Math.min(cabs, 3);
      let h = '', idx = 0;
      for (let ci = 0; ci < show; ci++) {
        const inCab = Math.min(per, r.n - ci * per);
        h += `<div class="rb-cab" style="--u:${u}"><div class="rb-cab-top"><span class="rb-lcd">${(inCab * r.mod.kwh).toFixed(1)} kWh</span><i></i><i></i></div><div class="rb-rails"><span class="rb-bus"></span>`;
        for (let k = 0; k < per; k++) {
          if (k < inCab) {
            const isNew = idx >= grow;
            h += `<div class="rb-m${isNew ? ' ins' : ''}" style="--d:${(idx - grow) * 60}ms"><span class="hdl"></span><span class="pw"></span><span class="soc"><i></i><i></i><i></i><i></i></span><span class="lb">${r.mod.v ? r.mod.v + 'V ' : ''}${r.mod.ah ? r.mod.ah + 'Ah' : r.mod.kwh + 'kWh'}</span><span class="pt"><i></i><i></i></span><span class="hdl"></span></div>`;
            idx++;
          } else h += `<div class="rb-e"></div>`;
        }
        h += `</div><div class="rb-cab-base">42U${cabs > 1 ? ` · ${ci + 1}/${cabs}` : ''}</div></div>`;
      }
      if (cabs > show) h += `<div class="rb-more">+${cabs - show}</div>`;
      box.innerHTML = h;
      prevN = r.n;
    }
    function update() {
      $$('[data-box]').forEach((b) => ((b as any).hidden = b.dataset.box !== st.by));
      const mod = c.mods[st.mi];
      const r = sizeRack({ mode: st.by, kwh: st.kwh, loadKw: st.by === 'load' ? st.load : 0, hours: st.hours, mod });
      last = r; draw(r);
      const go = $('[data-open]') as HTMLButtonElement | null;
      if (!r) { $('[data-big]').textContent = '—'; $('[data-rows]').innerHTML = `<div class="enter">${T.out.enter}</div>`; $('[data-checks]').innerHTML = ''; $('[data-sum]').innerHTML = ''; if (go) go.disabled = true; return; }
      if (go) go.disabled = false;
      const name = mod.slug ? mod.m : `${r.mod.kwh} kWh`;
      $('[data-big]').innerHTML = `${r.n}<small> × ${mod.slug ? mod.m : r.mod.kwh + ' kWh'}</small>`;
      const row = (k: string, v: string) => `<div><dt>${k}</dt><dd>${v}</dd></div>`;
      let h = row(T.out.total, `${r.totalKwh} kWh`) + row(T.out.usable, `${r.usableKwh} kWh`);
      if (st.by === 'load' && st.load > 0) h += row(fmt(T.out.time, { kw: st.load }), fmt(T.out.timeN, { h: r.hours }));
      if (r.maxKw) h += row(T.out.power, `${r.maxKw} kW`);
      if (r.mod.v) h += row(T.out.bank, fmt(T.out.bankN, { ah: r.ahTotal, v: r.mod.v }));
      if (r.cabinets) h += row(T.out.cab, fmt(T.out.cabN, { c: r.cabinets, p: r.perCab }));
      if (r.kg) h += row(T.out.kg, `≈ ${r.kg} kg`);
      h += mod.slug ? row(T.out.model, `<a href="/${c.lang}/p/${mod.slug}/">${mod.m}</a>`) : row(T.out.model, `<span class="cu">${T.out.custom}</span>`);
      $('[data-rows]').innerHTML = h;
      $('[data-checks]').innerHTML = r.checks.map((x: any) => `<li>${fmt(T.chk[x.id], x)}</li>`).join('');
      const mods = `${r.n} × ${name}`;
      const bank = r.mod.v ? fmt(T.out.bankN, { ah: r.ahTotal, v: r.mod.v }) : `${r.totalKwh} kWh`;
      $('[data-sum]').innerHTML = `<div><span>${T.sumBank}</span><b>${mods} · ${r.totalKwh} kWh · ${bank}</b></div>`;
      const need = st.by === 'load' ? `${st.load} kW × ${st.hours} ${T.h}` : `${st.kwh} kWh`;
      const extra = (r.cabinets ? `\n• ${T.out.cab}: ${fmt(T.out.cabN, { c: r.cabinets, p: r.perCab })}` : '') + (r.groups > 1 ? `\n• ${fmt(T.chk.groups, r.checks.find((x: any) => x.id === 'groups'))}` : '');
      lastMsg = fmt(T.msg, { need, mods, kwh: r.totalKwh, use: r.usableKwh, bank, extra });
      lastSubj = `${T.subj} · ${mods}`;
    }
    $$('[data-by]').forEach((b) => b.addEventListener('click', () => { st.by = b.dataset.by; $$('[data-by]').forEach((x) => x.classList.toggle('on', x === b)); update(); }));
    $('[data-kwh]').addEventListener('input', (e: any) => { st.kwh = num(e.target); $$('[data-kp]').forEach((x) => x.classList.toggle('on', +x.dataset.kp! === st.kwh)); update(); });
    $$('[data-kp]').forEach((b) => b.addEventListener('click', () => { st.kwh = +b.dataset.kp!; ($('[data-kwh]') as HTMLInputElement).value = String(st.kwh); $$('[data-kp]').forEach((x) => x.classList.toggle('on', x === b)); update(); }));
    $('[data-load]').addEventListener('input', (e: any) => { st.load = num(e.target); update(); });
    $('[data-hours]').addEventListener('input', (e: any) => { st.hours = num(e.target); update(); });
    $$('[data-mi]').forEach((b) => b.addEventListener('click', () => { st.mi = +b.dataset.mi!; $$('[data-mi]').forEach((x) => { const on = x === b; x.classList.toggle('on', on); x.setAttribute('aria-pressed', String(on)); }); update(); }));
    $$('[data-mode]').forEach((b) => b.addEventListener('click', () => { st.mode = b.dataset.mode; $('[data-cabs]').dataset.m = st.mode; $$('[data-mode]').forEach((x) => x.classList.toggle('on', x === b)); }));
    const pop = $('[data-pop]'); let opener: HTMLElement | null = null;
    function openPop() {
      $('[data-msg]').textContent = lastMsg;
      const wa = root!.querySelector('[data-wa]') as HTMLAnchorElement | null, mail = root!.querySelector('[data-mail]') as HTMLAnchorElement | null;
      if (wa) wa.href = 'https://wa.me/' + c.wa + '?text=' + encodeURIComponent(lastMsg);
      if (mail) mail.href = 'mailto:' + c.email + '?subject=' + encodeURIComponent(lastSubj) + '&body=' + encodeURIComponent(lastMsg);
      pop.hidden = false; document.body.style.overflow = 'hidden';
      (pop.querySelector('.rb-pop-btn') as HTMLElement | null)?.focus();
    }
    function closePop() { pop.hidden = true; document.body.style.overflow = ''; opener?.focus(); }
    const ob = root.querySelector('[data-open]') as HTMLElement | null;
    ob?.addEventListener('click', () => { if (!last) return; opener = ob; openPop(); });
    pop.addEventListener('click', (e: any) => { if (e.target === pop || e.target.closest('[data-close]')) closePop(); else if (e.target.closest('.rb-pop-btn')) setTimeout(closePop, 300); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !pop.hidden) closePop(); });
    update();
  }
</script>

<style>
  .rb-stage { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-areas: "ctl view" "fin fin" "as as"; gap: 22px; padding: 26px; border-radius: 18px; color: #e6efec;
    background: radial-gradient(120% 90% at 75% 40%, #12302b 0%, #0a1514 55%, #070d0d 100%); }
  .rb-ctl { grid-area: ctl; display: grid; gap: 12px; align-content: start; }
  .rb-view { grid-area: view; display: grid; gap: 12px; align-content: start; justify-items: center; }
  .rb-grp { width: 100%; box-sizing: border-box; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); border-radius: 14px; padding: 14px; }
  .rb-gh { display: flex; align-items: baseline; gap: 8px; margin-bottom: 10px; flex-wrap: wrap; }
  .rb-gh b { font-size: 15px; } .rb-gh small { color: #8fa7a1; font-size: 12px; }
  .rb-n { width: 22px; height: 22px; border-radius: 50%; display: inline-grid; place-items: center; font: 700 12px var(--mono); background: #5ef0a0; color: #062019; flex: none; align-self: center; }
  .rb-seg { display: inline-flex; border: 1px solid rgba(255,255,255,.15); border-radius: 10px; overflow: hidden; margin-bottom: 12px; }
  .rb-seg button { padding: 0 14px; min-height: 40px; border: 0; background: transparent; color: #cfdcd8; font: 600 13.5px var(--body); cursor: pointer; }
  .rb-seg button.on { background: #5ef0a0; color: #062019; }
  .rb-in { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: flex-end; }
  .rb-in[hidden] { display: none; }
  .rb-num { display: grid; grid-template-columns: auto auto; gap: 4px 8px; align-items: center; font-size: 12px; color: #8fa7a1; }
  .rb-num span { grid-column: 1 / 3; }
  .rb-num input { width: 120px; font: 700 22px var(--mono); padding: 8px 12px; border-radius: 9px; border: 1px solid rgba(255,255,255,.18); background: #0b1615; color: #fff; }
  .rb-num input:focus { outline: 2px solid #5ef0a0; outline-offset: 1px; }
  .rb-num b { font: 600 15px var(--mono); color: #8fa7a1; }
  .rb-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .rb-chip { padding: 0 12px; min-height: 34px; border-radius: 999px; border: 1px solid rgba(255,255,255,.16); background: transparent; color: #cfdcd8; font: 600 13px var(--mono); cursor: pointer; }
  .rb-chip.on { background: #5ef0a0; border-color: #5ef0a0; color: #062019; }
  .rb-mods { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 8px; }
  .rb-mod { display: grid; gap: 3px; text-align: left; padding: 10px; border-radius: 10px; border: 1px solid rgba(255,255,255,.1); background: rgba(0,0,0,.25); color: #cfdcd8; cursor: pointer; font-family: var(--body); }
  .rb-mod b { font-size: 14px; } .rb-mod small { font: 11.5px var(--mono); color: #8fa7a1; }
  .rb-mod.on { border-color: #5ef0a0; background: rgba(94,240,160,.1); color: #fff; box-shadow: 0 0 0 1px #5ef0a0 inset; }
  .rb-read { display: grid; gap: 8px; padding: 16px; border-radius: 14px; background: linear-gradient(135deg, rgba(94,240,160,.12), rgba(94,240,160,.02)); border: 1px solid rgba(94,240,160,.25); }
  .rb-big { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .rb-big span { color: #8fa7a1; font-size: 13px; }
  .rb-big b { font: 700 clamp(38px, 5vw, 54px)/1 var(--display); color: #5ef0a0; }
  .rb-big :global(small) { font-size: 18px; color: #cfdcd8; }
  .rb-rows { margin: 0; display: grid; font-size: 13.5px; }
  .rb-rows :global(div) { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; border-top: 1px dashed rgba(255,255,255,.1); }
  .rb-rows :global(dt) { color: #8fa7a1; } .rb-rows :global(dd) { margin: 0; text-align: right; font-family: var(--mono); font-size: 13px; }
  .rb-rows :global(a) { color: #fff; } .rb-rows :global(.cu) { color: #facc15; font-family: var(--body); }
  .rb-rows :global(.enter) { border: 0; color: #cfdcd8; }
  .rb-checks { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .rb-checks :global(li) { font-size: 12.5px; padding: 7px 10px; border-radius: 8px; background: rgba(250,204,21,.1); color: #fde68a; }
  /* —— 机柜 —— */
  .rb-modes { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; justify-self: stretch; }
  .rb-modes span { margin-right: 4px; font: 600 11px var(--mono); text-transform: uppercase; letter-spacing: .08em; color: #8fa7a1; }
  .rb-modes button { padding: 6px 12px; border-radius: 999px; border: 1px solid rgba(255,255,255,.18); background: transparent; color: #cfdcd8; font: 600 12.5px var(--body); cursor: pointer; }
  .rb-modes button.on { background: #fff; color: #0a1514; border-color: #fff; }
  .rb-cabs { display: flex; gap: 14px; align-items: flex-end; justify-content: center; flex-wrap: wrap; min-height: 200px; }
  .rb-cabs :global(.rb-cab) { width: 230px; padding: 8px 8px 0; border-radius: 8px; background: linear-gradient(180deg, #2c3537, #1a2022); box-shadow: inset 0 0 0 2px #3a4648, 18px 24px 50px rgba(0,0,0,.5); }
  .rb-cabs :global(.rb-cab-top) { display: flex; align-items: center; gap: 6px; height: 26px; margin-bottom: 6px; }
  .rb-cabs :global(.rb-lcd) { flex: 1; font: 700 12px var(--mono); color: #5ef0a0; background: #071a14; border-radius: 4px; padding: 4px 8px; box-shadow: inset 0 0 0 1px #1d4a3c; }
  .rb-cabs :global(.rb-cab-top i) { width: 7px; height: 7px; border-radius: 50%; background: #5ef0a0; box-shadow: 0 0 6px #5ef0a0; }
  .rb-cabs :global(.rb-cab-top i:last-child) { background: #3a4648; box-shadow: none; }
  .rb-cabs :global(.rb-rails) { position: relative; display: grid; gap: 2px; padding: 0 10px 0 6px; border-left: 3px solid #4a5759; border-right: 3px solid #4a5759; }
  .rb-cabs :global(.rb-bus) { position: absolute; right: -8px; top: 0; bottom: 0; width: 3px; border-radius: 2px; background: linear-gradient(180deg, transparent, #f59e0b 30%, #f59e0b 70%, transparent); background-size: 100% 200%; animation: rbBus 1.6s linear infinite; box-shadow: 0 0 8px rgba(245,158,11,.6); }
  .rb-cabs[data-m="chg"] :global(.rb-bus) { animation-direction: reverse; background-image: linear-gradient(180deg, transparent, #5ef0a0 30%, #5ef0a0 70%, transparent); box-shadow: 0 0 8px rgba(94,240,160,.6); }
  @keyframes rbBus { from { background-position: 0 100%; } to { background-position: 0 -100%; } }
  .rb-cabs :global(.rb-m), .rb-cabs :global(.rb-e) { height: calc(var(--u) * 8px); min-height: 18px; border-radius: 3px; }
  .rb-cabs :global(.rb-e) { background: repeating-linear-gradient(90deg, #121718 0 5px, #161c1d 5px 10px); box-shadow: inset 0 0 0 1px #262f31; }
  .rb-cabs :global(.rb-m) { display: grid; grid-template-columns: 5px 9px auto 1fr auto 5px; align-items: center; gap: 5px; padding: 0 4px; background: linear-gradient(180deg, #e9eef0, #b9c3c6); box-shadow: inset 0 0 0 1px #8b979a; }
  .rb-cabs :global(.rb-m .hdl) { height: 70%; border-radius: 2px; background: #6b7678; }
